[
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:0:0",
  "message_id": "BTL_MES_H121_058_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 78 01}怎么会这样！副队长大人\n中毒了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:1:0",
  "message_id": "BTL_MES_H121_058_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 6F 01}哎呀……副队长大人\n似乎中毒了呢。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:2:0",
  "message_id": "BTL_MES_H121_058_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 79 01}花村阳介先生……竟然中毒了……\n真是令人失望。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:3:0",
  "message_id": "BTL_MES_H121_058_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 7A 01}里中千枝小姐似乎中了毒。\n哪位能替她解毒呢？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:4:0",
  "message_id": "BTL_MES_H121_058_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 7B 01}天城雪子小姐似乎中毒了。\n尽快解毒才是团队和睦的秘诀……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:6:0",
  "message_id": "BTL_MES_H121_058_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 7C 01}巽完二先生中毒了。\n放着不管未免太残酷……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:7:0",
  "message_id": "BTL_MES_H121_058_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 7E 01}白钟直斗小姐中毒了。\n在下认为应尽快解毒……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:8:0",
  "message_id": "BTL_MES_H121_058_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 7D 01}小熊大人中毒了呢。不过……\n想必不至于被这点毒毒死……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:9:0",
  "message_id": "BTL_MES_H121_058_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 70 01}岳羽由加莉小姐\n中毒了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:10:0",
  "message_id": "BTL_MES_H121_058_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 71 01}伊织顺平先生中毒了。\n瞧……这脸色真够毒的……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:11:0",
  "message_id": "BTL_MES_H121_058_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 72 01}真田明彦先生中毒了。\n不快点治好……日后可就……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:12:0",
  "message_id": "BTL_MES_H121_058_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 73 01}哎呀……桐条美鹤小姐\n似乎中毒了呢……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:14:0",
  "message_id": "BTL_MES_H121_058_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 76 01}原来毒对埃癸斯小姐也有效……\n既然有效，那也没办法了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:15:0",
  "message_id": "BTL_MES_H121_058_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 74 01}天田乾先生中毒这件事……\n“乾”和“件”……没什么。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:16:0",
  "message_id": "BTL_MES_H121_058_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 75 01}虎狼丸大人中毒了！\n建议尽快解毒。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:17:0",
  "message_id": "BTL_MES_H121_058_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 77 01}荒垣真次郎先生中毒了。\n脸色真是一片绚丽的紫色……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:18:0",
  "message_id": "BTL_MES_H121_058_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 7F 01}善大人和玲小姐都中毒了。\n连中毒都要一起……真守规矩……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:19:0",
  "message_id": "BTL_MES_H121_058_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 80 01}善大人中毒了。\n在下认为必须尽快解毒。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:20:0",
  "message_id": "BTL_MES_H121_058_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 6E 01}队长大人中毒了呢。\n尽快解毒才是上策。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(057).BMD.json:21:0",
  "message_id": "BTL_MES_H121_058_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 6D 01}队长大人似乎中毒了。\n不如赶快解毒如何？\n{F2 26 00 00}{00}"
 }
]