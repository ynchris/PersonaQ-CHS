[
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:0:0",
  "message_id": "BTL_MES_H121_057_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B4 01}啊……副队长大人身上\n透着坚如磐“石”的意志……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:1:0",
  "message_id": "BTL_MES_H121_057_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 AB 01}啊……副队长大人\n成了一尊精美的石像！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:2:0",
  "message_id": "BTL_MES_H121_057_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B5 01}花村阳介先生……竟变成石头……\n真是令人失望。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:3:0",
  "message_id": "BTL_MES_H121_057_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B6 01}里中千枝小姐……若还能动，\n踢出的腿该多么坚硬啊……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:4:0",
  "message_id": "BTL_MES_H121_057_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B7 01}啊……天城雪子小姐成了石像……\n倒是件顶级的装饰品……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:6:0",
  "message_id": "BTL_MES_H121_057_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B8 01}巽完二先生变成石头了。\n真是硬邦邦的。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:7:0",
  "message_id": "BTL_MES_H121_057_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 BA 01}啊……白钟直斗小姐成了石像王子！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:8:0",
  "message_id": "BTL_MES_H121_057_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B9 01}哎呀……这里怎么会有\n狸猫摆件……啊，是小熊大人……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:9:0",
  "message_id": "BTL_MES_H121_057_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 AC 01}岳羽由加莉小姐的石像…\n在下给３颗星。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:10:0",
  "message_id": "BTL_MES_H121_057_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 AD 01}伊织顺平先生成了石像。\n嗯……倒也不值得摆出来……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:11:0",
  "message_id": "BTL_MES_H121_057_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 AE 01}真田明彦先生……\n如今的拳头想必非常坚硬吧。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:12:0",
  "message_id": "BTL_MES_H121_057_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 AF 01}桐条美鹤小姐的石像……\n美术馆应该会想要吧。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:14:0",
  "message_id": "BTL_MES_H121_057_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B2 01}石化的埃癸斯小姐……\n埃癸“石”！……咳咳！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:15:0",
  "message_id": "BTL_MES_H121_057_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B0 01}天田乾先生……不如趁此机会\n改名为“石田”如何？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:16:0",
  "message_id": "BTL_MES_H121_057_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B1 01}话说虎狼丸大人……\n怎么看都像是件摆设……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:17:0",
  "message_id": "BTL_MES_H121_057_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 B3 01}荒垣真次郎先生\n也很适合石像造型呢……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:18:0",
  "message_id": "BTL_MES_H121_057_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 BB 01}啊……善和玲都成了石头……\n两个人都成了石头！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:19:0",
  "message_id": "BTL_MES_H121_057_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 BC 01}啊……善大人被石化后，\n更面无表情了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(056).BMD.json:20:0",
  "message_id": "BTL_MES_H121_057_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 AA 01}队长大人！没有回应……\n似乎只是一块石头……\n{F2 26 00 00}{00}"
 },
