[
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:0:0",
  "message_id": "BTL_MES_H121_062_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 DC 01}副队长大人混乱了……\n请别认错敌人……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:1:0",
  "message_id": "BTL_MES_H121_062_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D3 01}副队长大人混乱了。\n……但愿不会袭击过来……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:2:0",
  "message_id": "BTL_MES_H121_062_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 DD 01}花村阳介先生……竟然混乱了……\n真是令人失望。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:3:0",
  "message_id": "BTL_MES_H121_062_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 DE 01}里中千枝小姐混乱了。\n哪位能替她治好呢？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:4:0",
  "message_id": "BTL_MES_H121_062_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 DF 01}天城雪子小姐似乎混乱了。\n敌人也会做这么有趣……麻烦的事！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:6:0",
  "message_id": "BTL_MES_H121_062_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 E0 01}巽完二先生混乱了。\n请小心别被打中。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:7:0",
  "message_id": "BTL_MES_H121_062_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 E2 01}白钟直斗小姐如今是混乱王子！\n……是也。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:8:0",
  "message_id": "BTL_MES_H121_062_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 E1 01}小熊大人混乱了呢……\n太麻烦了，就放着不管吧……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:9:0",
  "message_id": "BTL_MES_H121_062_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D4 01}岳羽由加莉小姐混乱了。\n敌人竟做出这么有趣……棘手的事！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:10:0",
  "message_id": "BTL_MES_H121_062_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D5 01}伊织顺平先生混乱了呢……\n姐姐大人的耳光或许能治好……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:11:0",
  "message_id": "BTL_MES_H121_062_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D6 01}真田明彦先生混乱了。\n但愿他不会袭击过来呢。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:12:0",
  "message_id": "BTL_MES_H121_062_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D7 01}桐条美鹤小姐似乎混乱了。\n尽快治好不是更安全么？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:14:0",
  "message_id": "BTL_MES_H121_062_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 DA 01}埃癸斯小姐混乱了……？\n既然会混乱，那也没办法。嗯。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:15:0",
  "message_id": "BTL_MES_H121_062_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D8 01}天田乾先生混乱了。\n但愿不会认错对手……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:16:0",
  "message_id": "BTL_MES_H121_062_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D9 01}虎狼丸大人混乱了呢……\n瞧……简直像条疯狗……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:17:0",
  "message_id": "BTL_MES_H121_062_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 DB 01}荒垣真次郎先生混乱了。\n不快治好，我们也会有危险吧？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:18:0",
  "message_id": "BTL_MES_H121_062_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 E3 01}善大人……玲小姐……竟同时混乱……\n真是守规矩呢……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:19:0",
  "message_id": "BTL_MES_H121_062_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 E4 01}善大人混乱了。\n但愿不会袭击过来……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:20:0",
  "message_id": "BTL_MES_H121_062_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D2 01}队长大人，您混乱了吗？\n这可有趣……麻烦了……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0006/battle/support/bsv121.bvp_(061).BMD.json:21:0",
  "message_id": "BTL_MES_H121_062_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 D1 01}队长大人，您混乱了吗？\n……确实混乱了吧？真麻烦……\n{F2 26 00 00}{00}"
 }
