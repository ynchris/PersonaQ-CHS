[
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:0:0",
  "message_id": "MARIE_FOE_FOLLOW_START1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 E7 01}啊！F.O.E\n发现我们了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:1:0",
  "message_id": "MARIE_FOE_FOLLOW_START2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 E8 01}喂……\n被 F.O.E 发现了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:2:0",
  "message_id": "MARIE_FOE_FOLLOW_START3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 E9 01}F.O.E 已经发现我们了……\n你小心点啊？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:3:0",
  "message_id": "MARIE_FOE_SENSOR1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 EA 01}哇！F.O.E \n也太近了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:4:0",
  "message_id": "MARIE_FOE_SENSOR2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 EB 01}那边，F.O.E！\n你看到了吧？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:5:0",
  "message_id": "MARIE_FOE_SENSOR3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 EC 01}F.O.E 太近了……\n撞上去会很可怕的哦？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:6:0",
  "message_id": "MARIE_FOE_FOLLOW_END1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 ED 01}啊……F.O.E \n没过来呢。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:7:0",
  "message_id": "MARIE_FOE_FOLLOW_END2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 EE 01}啊……\n那家伙不会追到这里呢。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:8:0",
  "message_id": "MARIE_FOE_FOLLOW_END3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 EF 01}甩开 F.O.E 了？\n真是的……那些家伙碍事死了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:9:0",
  "message_id": "MARIE_PARTY_HARF_DEAD1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F0 01}喂……同伴倒下得也太多了！\n先回去一趟啦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:10:0",
  "message_id": "MARIE_PARTY_HARF_DEAD2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F1 01}队伍都伤痕累累了……\n回去不是更好吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:11:0",
  "message_id": "MARIE_PARTY_HARF_DEAD3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F2 01}倒下的人也太多了吧？\n先回去一趟啦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:12:0",
  "message_id": "MARIE_PARTY_HPTP10_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F3 01}你这样不危险吗？\n体力精力什么的都没了……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:13:0",
  "message_id": "MARIE_PARTY_HPTP10_2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F4 01}停下，停下。\n你很危险啦。快恢复一下。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:14:0",
  "message_id": "MARIE_PARTY_HPTP10_3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F5 01}喂，你体力和精力都没了吧？\n这样下去可不行啊？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:15:0",
  "message_id": "MARIE_PARTY_HPTP10_4",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F6 01}队——长，体力和精力都没了。\n休息一下不是更好吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:16:0",
  "message_id": "MARIE_PARTY_HPTP10_5",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F7 01}队——长，体力没了，精力也没了。\n还前进也太乱来了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:17:0",
  "message_id": "MARIE_PARTY_HPTP10_6",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F8 01}队——长，体力精力什么的\n不是都没了吗。真的没事？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:18:0",
  "message_id": "MARIE_PARTY_HP10_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 F9 01}喂，你受伤也太严重了。\n先恢复一下。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:19:0",
  "message_id": "MARIE_PARTY_HP10_2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 FA 01}你的体力不妙吧？\n很不妙吧？……就是很不妙。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:20:0",
  "message_id": "MARIE_PARTY_HP10_3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 FB 01}你的体力很少了。\n这样下去很危险啦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:21:0",
  "message_id": "MARIE_PARTY_HP10_4",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 FC 01}队——长，体力掉太多了……\n很危险啦……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:22:0",
  "message_id": "MARIE_PARTY_HP10_5",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 FD 01}队——长，你又不是不死之身吧？\n现在这样不危险吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:23:0",
  "message_id": "MARIE_PARTY_HP10_6",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 FE 01}队——长，体力没了。\n快治一下啦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:24:0",
  "message_id": "MARIE_PARTY_TP10_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 FF 01}你已经没精力了吧。\n还要继续走？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:25:0",
  "message_id": "MARIE_PARTY_TP10_2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 00 01}你精力掉太多了……\n趁现在恢复一下啦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:26:0",
  "message_id": "MARIE_PARTY_TP10_3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 01 02}你精力掉太多了……\n马上就要没油了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:27:0",
  "message_id": "MARIE_PARTY_TP10_4",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 02 02}队——长，你已经没精力了吧？\n还要继续走？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:28:0",
  "message_id": "MARIE_PARTY_TP10_5",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 03 02}队——长，精力掉太多了……\n看得人提心吊胆。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:29:0",
  "message_id": "MARIE_PARTY_TP10_6",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 04 02}队——长，你没精力了吧？\n马上就要没油了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:30:0",
  "message_id": "MARIE_STAIR1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 05 02}啊……找到楼梯了……\n要走吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:31:0",
  "message_id": "MARIE_STAIR2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 06 02}啊！这不是楼梯嘛！\n……是找到了……然后怎么办？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:32:0",
  "message_id": "MARIE_STAIR3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 07 02}啊，看，楼梯。\n这里都待腻了，去下一层吧，下一层。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:33:0",
  "message_id": "MARIE_TREASURE1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 08 02}这不是宝箱嘛！\n快打开！看看里面。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:34:0",
  "message_id": "MARIE_TREASURE2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 09 02}宝箱什么的……也太老套了……\n不过可能还是有点高兴。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:35:0",
  "message_id": "MARIE_TREASURE3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 0A 02}啊……宝箱！！\n我、我才没有很期待呢。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:36:0",
  "message_id": "MARIE_FOUNTAIN1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 0B 02}能量点……能量点……\n哼……好像挺帅的。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:37:0",
  "message_id": "MARIE_FOUNTAIN2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 0C 02}啊……能量点。\n也许能采到什么哦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:38:0",
  "message_id": "MARIE_FOUNTAIN3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 0D 02}为什么能在能量点\n采到素材？也太莫名其妙了……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:39:0",
  "message_id": "MARIE_SEARCH_OBJ1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 0E 02}咦……\n调查一下前面。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:40:0",
  "message_id": "MARIE_SEARCH_OBJ2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 0F 02}啊，那附近很可疑。\n总觉得……是这样。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:41:0",
  "message_id": "MARIE_SEARCH_OBJ3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 10 02}咦？前面好像能看到什么……\n快调查一下。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:42:0",
  "message_id": "MARIE_SWITCH1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 11 02}附近有没有开关？\n我觉得应该有。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:43:0",
  "message_id": "MARIE_SWITCH2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 12 02}喂，前面是不是有开关？\n有的吧？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:44:0",
  "message_id": "MARIE_SWITCH3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 13 02}我觉得附近有开关。\n直觉就是这么说的。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:45:0",
  "message_id": "MARIE_KARITORUMONO1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 14 02}哇！？\n好像有“收割者”！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:46:0",
  "message_id": "MARIE_KARITORUMONO2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 15 02}总觉得……很不妙……\n是不是有“收割者”？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:47:0",
  "message_id": "MARIE_KARITORUMONO3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 16 02}啊！“收割者”\n正在靠近！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:48:0",
  "message_id": "MARIE_ARROW_DIZZINESS1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 17 02}喂，\n往那边走真的行？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:49:0",
  "message_id": "MARIE_ARROW_DIZZINESS2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 18 02}咦！？\n没法正常走路了？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:50:0",
  "message_id": "MARIE_ARROW_DIZZINESS3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 19 02}那只 F.O.E，\n麻烦死了，气死我了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:51:0",
  "message_id": "MARIE_ARROW_FASCINATION1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 1A 02}哇！\n往那边走的话！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:52:0",
  "message_id": "MARIE_ARROW_FASCINATION2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 1B 02}停、停下，停下！\n要撞上了！？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:53:0",
  "message_id": "MARIE_ARROW_FASCINATION3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 1C 02}这只 F.O.E 太狡猾了！\n差劲透了，气死我了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:54:0",
  "message_id": "MARIE_SHORTCUT1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 1D 02}咦……\n那面墙……可能有点怪。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:55:0",
  "message_id": "MARIE_SHORTCUT2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 1E 02}喂，我很在意前面的墙。\n调查一下。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:56:0",
  "message_id": "MARIE_SHORTCUT3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 1F 02}啊……那面墙……\n可能有什么秘密……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:57:0",
  "message_id": "MARIE_TRAVEL1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 20 02}啊，这里差不多都走遍了。\n挺厉害嘛！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:58:0",
  "message_id": "MARIE_TRAVEL2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 21 02}这一层已经待腻了吧？\n去下一层嘛，下一层。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:59:0",
  "message_id": "MARIE_TRAVEL3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 22 02}这一层已经摸透了吧……\n踏遍此地之人……好像挺帅的……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:63:0",
  "message_id": "MARIE_ITEM_MAX1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 26 02}行李太多了。\n稍微收拾一下怎么样？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:64:0",
  "message_id": "MARIE_ITEM_MAX2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 27 02}行李已经满了啦。\n快拿不下了啦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0008/dungeon/pack/pc024.arc_marie_support.bf.json:65:0",
  "message_id": "MARIE_ITEM_MAX3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 28 02}是不是快拿不下行李了？\n最好收拾一下哦。\n{F2 26 00 00}{00}"
 },
 {
