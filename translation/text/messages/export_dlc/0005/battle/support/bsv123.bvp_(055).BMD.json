 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:4:0",
  "message_id": "BTL_MES_H123_056_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 67 01}天城大人的体力所剩无几！\n请尽快安排恢复！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:6:0",
  "message_id": "BTL_MES_H123_056_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 68 01}巽大人……以这点体力战斗，\n未免太过勉强！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:7:0",
  "message_id": "BTL_MES_H123_056_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 6A 01}白钟大人的体力已十分危险。\n啊……敌人正盯着她！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:8:0",
  "message_id": "BTL_MES_H123_056_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 69 01}小熊大人的体力所剩无几。\n请小心！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:9:0",
  "message_id": "BTL_MES_H123_056_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 5C 01}岳羽大人的体力所剩无几。\n恐怕需要立即恢复！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:10:0",
  "message_id": "BTL_MES_H123_056_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 5D 01}伊织大人，以这点体力战斗\n实在勉强……请爱惜自己！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:11:0",
  "message_id": "BTL_MES_H123_056_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 5E 01}即使是真田大人，\n以这点体力战斗也太鲁莽了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:12:0",
  "message_id": "BTL_MES_H123_056_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 5F 01}桐条大人的伤势很严重。\n请立即恢复！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:14:0",
  "message_id": "BTL_MES_H123_056_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 62 01}埃癸斯大人的伤势，\n已经严重到不能忽视了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:15:0",
  "message_id": "BTL_MES_H123_056_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 60 01}天田大人，您还好吗？\n伤势似乎很严重……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:16:0",
  "message_id": "BTL_MES_H123_056_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 61 01}请替虎狼丸大人恢复。\n实在可怜得让人不忍直视。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:17:0",
  "message_id": "BTL_MES_H123_056_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 63 01}请留意荒垣大人的体力。\n已经减少很多了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:18:0",
  "message_id": "BTL_MES_H123_056_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 6B 01}善大人和玲大人的体力告急。\n请帮助他们。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(055).BMD.json:19:0",
  "message_id": "BTL_MES_H123_056_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 6C 01}善大人的伤势很严重。\n请优先替他恢复。\n{F2 26 00 00}{00}"
 },
 {
