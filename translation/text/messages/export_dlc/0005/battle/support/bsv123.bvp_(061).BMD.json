 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(061).BMD.json:17:0",
  "message_id": "BTL_MES_H123_062_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 DB 01}荒垣大人，请保持清醒！\n我们是同伴！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(061).BMD.json:18:0",
  "message_id": "BTL_MES_H123_062_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 E3 01}善大人，玲大人……\n何必连混乱都两位一起呢……\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(061).BMD.json:19:0",
  "message_id": "BTL_MES_H123_062_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 05 01 01 01 05 01 E4 01}善大人混乱了。\n请问有办法治好吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_dlc/0005/battle/support/bsv123.bvp_(061).BMD.json:20:0",
