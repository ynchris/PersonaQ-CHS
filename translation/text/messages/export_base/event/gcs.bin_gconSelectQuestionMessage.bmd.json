  "translation": "{F2 05 FF FF}{F1 41}迷人的笑容\n热情的眼神\n令人着迷的口才\n纯真的心\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:204:0",
  "message_id": "GCONSELECT_100",
  "translation": "{F2 05 FF FF}{F1 41}对男性的期待果然是…\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:205:0",
