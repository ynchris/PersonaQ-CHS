 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:6:0",
  "message_id": "GCONSELECT_001",
  "translation": "{F2 05 FF FF}{F1 41}只要有爱，\n不光年龄差，连性别都无所谓？\n{00}"
 },
 {
