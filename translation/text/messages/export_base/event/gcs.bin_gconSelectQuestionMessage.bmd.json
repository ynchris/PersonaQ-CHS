  "translation": "{F2 05 FF FF}{F1 41}想得到疗愈的话？\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:23:0",
  "message_id": "GCONSELECT_009_SELECT",
  "translation": "{F2 05 FF FF}{F1 41}疗愈音乐\n按摩\n软乎乎的肉垫\n{00}"
 },
 {
