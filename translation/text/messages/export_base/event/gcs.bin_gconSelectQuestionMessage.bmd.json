 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:209:0",
  "message_id": "GCONSELECT_102_SELECT",
  "translation": "{F2 05 FF FF}{F1 41}像妈妈一样会照顾人\n看似冷酷、实则狂野\n心灵手巧\n除此之外的…\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:210:0",
  "message_id": "GCONSELECT_103",
  "translation": "{F2 05 FF FF}{F1 41}什么样的人会让你心动？\n{00}"
