  "translation": "{F2 05 FF FF}{F1 41}说到催泪电影？\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:27:0",
  "message_id": "GCONSELECT_011_SELECT",
  "translation": "{F2 05 FF FF}{F1 41}战争片\n悲恋片\n汪喵王国\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:28:0",
  "message_id": "GCONSELECT_012",
  "translation": "{F2 05 FF FF}{F1 41}恋人遇到了危险！\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:29:0",
