  "message_id": "GCONSELECT_002_1",
  "translation": "{F2 05 FF FF}{F1 41}希望喜欢的人怎么追求你？\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:8:0",
  "message_id": "GCONSELECT_002_2",
  "translation": "{F2 05 FF FF}{F1 41}一起玩的话？\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:9:0",
  "message_id": "GCONSELECT_002_SELECT_1",
  "translation": "{F2 05 FF FF}{F1 41}想被热烈追求\n想被含蓄追求\n{00}"
 },
 {
