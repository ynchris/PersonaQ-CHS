  "message_id": "GCONSELECT_104_SELECT",
  "translation": "{F2 05 FF FF}{F1 41}才貌双全的凛然气质\n无敌的偶像笑容\n彬彬有礼的言辞\n除此之外的…\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:214:0",
  "message_id": "GCONSELECT_105",
  "translation": "{F2 05 FF FF}{F1 41}什么样的人会让你心动？\n{00}"
 },
 {
