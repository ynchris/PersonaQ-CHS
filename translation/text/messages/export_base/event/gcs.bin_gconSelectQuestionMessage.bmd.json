  "translation": "{F2 05 FF FF}{F1 41}没有这回事\n也许是吧\n无所谓\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:32:0",
  "message_id": "GCONSELECT_014",
