  "translation": "{F2 05 FF FF}{F1 41}吃剩的晚饭\n冰凉的麦茶\n某种草\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:20:0",
  "message_id": "GCONSELECT_008",
  "translation": "{F2 05 FF FF}{F1 41}可爱的人的特点是？\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:21:0",
