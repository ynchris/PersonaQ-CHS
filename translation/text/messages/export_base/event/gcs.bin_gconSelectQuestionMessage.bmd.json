  "message_id": "GCONSELECT_002_SELECT_2",
  "translation": "{F2 05 FF FF}{F1 41}当然是户外！\n一定要室内！\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:11:0",
  "message_id": "GCONSELECT_003_SELECT",
  "translation": "{F2 05 FF FF}{F1 41}性别有关系\n完全没关系！\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:12:0",
  "message_id": "GCONSELECT_004",
  "translation": "{F2 05 FF FF}{F1 41}如何向喜欢的人倾诉心意？\n{00}"
 },
 {
  "key": "export_base/event/gcs.bin_gconSelectQuestionMessage.bmd.json:13:0",
