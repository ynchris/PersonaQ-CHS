 },
 {
  "key": "export_base/event/e200/e210_302.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 30 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 0B 01}……诶，不会吧。\n居然松不开……真的假的！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
