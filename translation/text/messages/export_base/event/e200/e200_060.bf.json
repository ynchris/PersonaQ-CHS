 },
 {
  "key": "export_base/event/e200/e200_060.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}我是对阴影特别镇压兵装系列的\n最终型号，埃癸斯。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_060.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}简单来说，就是人形机器人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_060.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}果然是真正的机器人……！\n好厉害的技术，到底是怎么……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_060.bf.json:6:0",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}那个，可以……摸一下吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
