[
 {
  "key": "export_base/event/e200/e200_814.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 12 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}那、那个啊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 01}我们就这么听人安排，\n成了“命定之人”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}先不说命运，\n我们还不太了解彼此吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}却连手都被迫牵在一起……\n果然很奇怪吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 47 01 12 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:0:5",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}不过，命定之人或许\n就是这样突然出现的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:0:6",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}命运到来的瞬间又没法预料，\n也许我们也……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:0:7",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}……开玩笑的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:1:0",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 12 01 02 01 01 01}是开玩笑吗？{F5 47 02 01 47 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:1:1",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}一定是命运{F5 47 02 01 47 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:1:2",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}……{00}{00}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}玩笑还是认真的……\n你猜是哪一个？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}……不过，很多事就这样\n像玩笑般开始，\n回过神时又已经结束了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}最近经常觉得，\n眼下的机会只存在于当下。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}所以，我想\n不再对自己撒谎。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:3:0",
  "message_id": "MSG_002a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 47 01 02 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:3:1",
  "message_id": "MSG_002a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 03 01 01 01 01 01 07 01}对、对不起！\n突然说起这些大道理！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:3:2",
  "message_id": "MSG_002a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}总、总觉得好害羞……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞理世红着脸……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}呵呵，也许吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:5:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}我觉得啊，\n无论谁和谁之间，\n一定都有命运相连。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:5:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}但最终会变成什么关系，\n取决于当事人自己。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:5:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}为了尽可能建立美好的关系，\n我想至少\n不要对自己撒谎。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:5:4",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 15 01}……不然的话，\n失去的东西就太沉重了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
