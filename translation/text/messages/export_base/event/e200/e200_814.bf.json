  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 03 01 01 01 01 01 07 01}哇，直接无视？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_814.bf.json:8:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 14 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 03 01 01 01 01 01 04 01}我都能理解小熊的心情了。\n待会儿对它好点吧……\n{F2 23 00 00}{F1 21}{00}"
 },
