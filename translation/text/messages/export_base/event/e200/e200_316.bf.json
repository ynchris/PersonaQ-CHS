 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:12:1",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}真是个令人高兴的意外{F5 47 02 01 48 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:12:2",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}无所谓{F5 47 02 01 48 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}嗯、嗯，说得对。\n收集情报是调查的基础……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:14:0",
  "message_id": "MSG_0122",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 05 01 03 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}呵呵。\n同行的是{F1 81}，我就放心了。\n你应该能作出冷静的判断。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 03 01 01 01 01 01 07 01}你、你在说什么！\n这种时候请不要开玩笑！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:15:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 03 01 01 01 01 01 04 01}真、真是的……\n这里可只有我们两个人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:15:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}所……所以，那个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:15:3",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 0B 01}我是说，只有两个人，\n万一出事就麻烦了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 03 01 01 01 01 01 07 01}怎、怎么会无所谓！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:16:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}要是手一直松不开，\n就算是我……那、那个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:16:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 15 01}距离太近，会有很多不便……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:17:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}总之……\n先调查附近，收集情报吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:17:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}前进时请多留意，\n别遗漏任何线索。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:17:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 18 01}手的事……先忘掉吧。\n忘掉吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_316.bf.json:17:3",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 48 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}……那、那么，走吧。\n{F2 23 00 00}{F1 21}{00}"
 }
