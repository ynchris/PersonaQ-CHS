[
 {
  "key": "export_base/event/e200/e210_319.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里究竟是什么地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“联谊咖啡厅”终成眷属……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 11 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}……这是怎么回事？\n我应该在天鹅绒房间才对。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}完全不顾我的意愿，\n真是相当强硬的邀请呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}还有……\n这只手，究竟是什么意思？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}{F5 C1 04 01 01 01 01 01 02 01}看来，你们已经抵达了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 02 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 05 01}哎呀……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}{F5 C1 04 01 01 01 01 01 02 01}这里似乎是一条让邂逅命定伴侣的\n恋人们倾诉爱意的道路。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 04 01 01 01 01 01 02 01}前方究竟有什么在等待呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 04 01 01 01 01 01 02 01}你们可以手牵着手，\n怀着好奇与恐惧迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 02 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}命运……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1B 01}{F5 C1 04 01 01 01 01 01 02 01}我说，你们可以迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 04 01 01 01 01 01 02 01}来，迈出脚步吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞机械语音消失了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}也就是说……\n被“命运”选中的人，\n会被引导到这里来。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}问题在于这只手。\n用物理手段强行分开，倒是可以。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}也许会有一点疼，\n可以试试吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:11:0",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 06 01 02 01 01 01}你是认真的吗？{F5 47 02 01 3D 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:11:1",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}换个办法吧{F5 47 02 01 3D 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:11:2",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}这样就好{F5 47 02 01 3D 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 04 01}呵呵，开玩笑的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}您是我重要的客人，\n我不会让您吃苦头的。\n……至少现在不会。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 12 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}没有呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}如果不强行分开，\n看来就只能暂时\n维持现状了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}哎呀……这是在表明，\n你决心与我共度一生吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}无论面对怎样的试炼……\n永远、一辈子，都不逃走？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:14:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}你我的一生，长度可是\n大不相同的，即便如此也愿意？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:14:3",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 3D 01 12 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:14:4",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}呵呵，开玩笑的。\n别那么害怕。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 12 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}什么都不知道，\n一直待在这里也没用。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}在这里，我会暂时放下\n天鹅绒房间住客的身份……\n作为旅途中的伴侣陪着你。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:15:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}这也是某种“缘分”……\n一定有它的意义吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_319.bf.json:15:3",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3D 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}呵呵……\n就以命定伴侣的身份，好好享受吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]