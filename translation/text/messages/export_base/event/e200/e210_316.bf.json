  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里究竟是什么地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“联谊咖啡厅”终成眷属……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 03 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 04 01}唔……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}刚、刚才那个……\n是落穴陷阱吗……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}学长，你没事吧？\n有没有哪里受伤……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 03 01}{F5 86 3B 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 01 01}……！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 06 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}咦……啊，那个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 02 01 01 01 01 01 02 01}这……这只手是怎么回事！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}{F5 C1 04 01 01 01 01 01 02 01}看来，你们已经抵达了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 07 01}呀！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1E 01}{F5 C1 04 01 01 01 01 01 02 01}这里似乎是一条让邂逅命定伴侣的\n恋人们倾诉爱意的道路。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}{F5 C1 04 01 01 01 01 01 02 01}前方究竟有什么在等待呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}{F5 C1 04 01 01 01 01 01 02 01}你们可以手牵着手，\n怀着好奇与恐惧迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 09 01}咦，啊，那个，恋人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}难道指的是\n学长和我吗……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 21 01}{F5 C1 04 01 01 01 01 01 02 01}我说，你们可以迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 01}{F5 C1 04 01 01 01 01 01 02 01}来，迈出脚步吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞机械语音消失了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 0B 01}怎、怎么这样……\n再怎么说也太胡来了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:11:0",
  "message_id": "MSG_010a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 3B 01 10 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:11:1",
  "message_id": "MSG_010a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}呃、那个……\n问题实在太多，\n不知道该从哪里解决……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:12:0",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 12 01 02 01 01 01}找找能让手分开的办法吧{F5 47 02 01 3B 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:12:1",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}去找其他同伴吧{F5 47 02 01 3B 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:12:2",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}确认彼此是否命中注定吧{F5 47 02 01 3B 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}也、也是。\n一直保持这个状态，实在是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:13:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}那、那个……\n距离太近，会有各种不便……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}嗯……看来这里\n只有我们两个人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:14:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}只有两个人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:14:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 07 01}啊……不，那个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:14:3",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 03 01 01 01 01 01 0B 01}我是说，只、只有两个人的话，\n遇到紧急情况会很麻烦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 07 01}什……你、你在说什么啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:15:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 15 01}确认合不合适，难道你打算\n就在这里做验证实验……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:15:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 03 01 01 01 01 01 02 01}啊，不、不是……那个，\n刚才的话没有奇怪的意思……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:15:3",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 3B 01 14 01 02 01 01 01}{F5 61 02 01 01 01 01 01 17 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:15:4",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 18 01}{F5 C1 03 01 01 01 01 01 0B 01}什、什么也没有！\n请忘掉我刚才的话！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}总之……\n先调查附近，收集情报吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}学长，作为我的搭档，\n可要好好履行职责哦？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:16:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}……啊，不，这里的搭档，\n指的是助手！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_316.bf.json:16:3",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}……那、那么，走吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]