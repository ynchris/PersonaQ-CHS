[
 {
  "key": "export_base/event/e200/e210_805.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 31 01 11 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}……我说，{F1 81}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}假如，我们就这样\n一直无法分开……\n你会怎么办？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}我时刻都在身边……\n光想想就会厌烦吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 31 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}不过，所谓婚姻，或许正是\n需要怀着这样的觉悟去面对……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:1:0",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 31 01 0E 01 02 01 01 01}怎么突然这么说？{F5 47 02 01 31 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:1:1",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}婚前焦虑？{F5 47 02 01 31 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:1:2",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}好，那就结婚吧{F5 47 02 01 31 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 31 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}……不，没什么。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}一直和你牵着手，\n也许是短路了吧……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_805.bf.json:2:2",
  "message_id": "MSG_002",
