[
 {
  "key": "export_base/event/e200/e200_306.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里究竟是什么地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“联谊咖啡厅”终成眷属……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 01 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}这里就是被选为“命定伴侣”的\n两个人的世界……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 01}除了我和{F1 82}，\n似乎没有其他人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 07 01}这是……！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}大事不好！\n我们的手二十四小时紧密相连！\n无法分开！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 04 01 01 01 01 01 02 01}看来，你们已经抵达了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}啊，是那个神秘的声音。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 04 01 01 01 01 01 02 01}这里似乎是一条让邂逅命定伴侣的\n恋人们倾诉爱意的道路。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}{F5 C1 04 01 01 01 01 01 02 01}前方究竟有什么在等待呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}{F5 C1 04 01 01 01 01 01 02 01}你们可以手牵着手，\n怀着好奇与恐惧迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}如果不迈出脚步，\n该怎么做呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 04 01 01 01 01 01 02 01}我说，你们可以迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 04 01 01 01 01 01 02 01}来，迈出脚步吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞机械语音消失了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}也就是说，\n别废话，赶紧走。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}不过，要怎样解除\n双手相连的状态呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:11:0",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 12 01 02 01 01 01}真的松不开？{F5 47 02 01 42 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:11:1",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}一辈子都这样？{F5 47 02 01 42 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:11:2",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}不用松开{F5 47 02 01 42 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}如果强行分开，\n恐怕会变成血肉横飞的场面。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}您能接受的话，我可以执行，\n不过现在就下这个决定，\n是否太早了呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}就算如此，也请放心。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}{F1 82}，您的日常起居，\n从起床到就寝，不，是到终身，\n我都会提供周全的照顾。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}我也不觉得有必要松开，\n不过有一点不便。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}与阴影战斗时，若不同步行动，\n就可能绊倒彼此，\n无法发挥原本的战斗力。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:14:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}因此，\n我认为需要大量训练。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 04 01 01 01 01 01 04 01}待在您身边，\n是我最珍视的事。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 04 01 01 01 01 01 04 01}所以，就算一直这样，\n我也没有关系……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:15:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 04 01 01 01 01 01 04 01}{F1 82}，如果您觉得不方便，\n我也做好了妥善处理的准备。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_306.bf.json:15:3",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}也许能找到什么线索。\n我们搜索一下四周吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]