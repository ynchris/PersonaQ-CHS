 },
 {
  "key": "export_base/event/e200/e200_523.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 07 01}{F5 C1 04 01 01 01 01 01 04 01}我们变成王子和公主了！\n快看快看，礼服！好可爱！！\n{F2 23 00 00}{F1 21}"
