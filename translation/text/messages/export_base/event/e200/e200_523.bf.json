 },
 {
  "key": "export_base/event/e200/e200_523.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 4C 01 11 01 02 01 04 01}{F5 61 02 01 01 01 01 01 07 01}你知道刚才那个姿势吗？\n那叫“公主抱”哦！\n{F2 23 00 00}{F1 21}"
