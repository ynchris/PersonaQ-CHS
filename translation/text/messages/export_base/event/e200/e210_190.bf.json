[
 {
  "key": "export_base/event/e200/e210_190.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}刚才钟声一响，\n锁就哐啷哐啷地动起来了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 03 01}这样啊……\n看来迷宫与这钟声\n果然有所关联。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}只要走完剩下２座迷宫，\n拿到守卫守护的东西，\n这扇门就会打开……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 05 01}这扇门确实通往\n各位生活的现实世界。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}我做过种种确认，\n门的另一侧似乎没有阴影的气息……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}其中一扇门后，\n是我十分熟悉的世界的气息。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}而另一扇门后，\n则是伊丽莎白他们熟悉的气味……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0D 01 01 01 01 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 09 01}还剩２座……也就是说还剩一半。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 02 01 02 01 01 01 02 01}{F5 86 0D 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 0A 01}看来比想象中更轻松就能结束啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:5:0",
  "message_id": "SEL_TALK005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 02 01}真没劲{F5 47 02 01 02 01 07 01 01 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:5:1",
  "message_id": "SEL_TALK005",
  "translation": "{F2 05 FF FF}{F1 41}居然还剩一半……{F5 47 02 01 02 01 0B 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}哈哈，你也这么想吗？\n要是能来些更强的家伙就好了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}怎么，没看出来你还挺柔弱的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:8:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 02 01}{F5 86 0D 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 0D 01}不过，看起来也不用太着急。\n做好充分准备就没问题。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 07 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0E 01}我和风花找到下一个迷宫了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}是个叫“放学后的恶灵俱乐部”的活动，\n地点在２年４班……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 03 01 01 01 01 01 05 01}２年４班？\n八十神高中每个年级，\n都只有３个班吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}是啊……真奇怪。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 05 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 04 01}恶灵……俱乐部？\n这名字一听就不妙啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 13 01}……怎么，害怕了？\n你引以为傲的功夫呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 0B 01}什……居然小看我！\n好啊，我就去\n给那些鬼一脚看看！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 03 01 01 01 01 01 0A 01}有用吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_190.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 16 01}那么，请各位一路小心。\n{F2 23 00 00}{F1 21}{00}"
 }
]