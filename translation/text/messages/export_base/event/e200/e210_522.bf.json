 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 04 01}这个男人是我吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞看来，这似乎是合成照片……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 02 01}{F5 86 15 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 05 01}你和我抱在一起……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}我不记得有过这样的姿势……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}不止如此，我在这里\n待了很长时间，\n之前甚至从未见过你……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:2:4",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:2:5",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}难道这是……\n我失去记忆之前发生的事……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:3:0",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 01 01}一定是的{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:3:1",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}只是恶作剧{F5 47 02 01 02 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}也就是说，你与我\n曾经有过某种联系……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}身体靠得如此之近，\n应该不只是认识对方的程度。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0E 01}可我，连你也忘记了……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:4:4",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:4:5",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}必须尽快找回记忆……\n也是为了你。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}恶作剧？\n……为了什么？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 13 01}以前，玲曾经\n递给我一份奇怪的章鱼烧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}外表和平常一样，却非常沉重……\n仔细一看，不是章鱼烧，\n而是压得像石头一样硬的炒面。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:4",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}玲说，那是恶作剧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:5",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 16 01}她说，因为我看起来很悲伤，\n所以努力做了这个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:6",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}……直到现在，我也不明白。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:7",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}不明白她为何说我看起来悲伤，\n也不明白为什么我看起来悲伤，\n玲就要把炒面压成一团……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:8",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 19 01}这张照片也是同样的东西吗？\n我看起来很悲伤吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:5:9",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}……。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_522.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1B 01}{F5 C1 04 01 01 01 01 01 04 01}往前走，也许就能明白些什么。\n……走吧。\n{F2 23 00 00}{F1 21}{00}"
 },
