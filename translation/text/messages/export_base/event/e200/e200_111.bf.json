[
 {
  "key": "export_base/event/e200/e200_111.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞顺着大家的意思，\n　一场像是联谊的聚会突然开始了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 04 01}{F5 86 0C 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 08 01}哎呀，满眼都是可爱的女生，\n让人兴奋起来了啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}刚见面时我就觉得，\n千枝既帅气又可爱……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 0B 01}哈？怎、怎么突然说这个！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 02 01 01 01 04 01}{F5 86 0C 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 05 01}小雪呢，是那种\n典型的大和抚子式美人吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 05 01}小雪……啊，我？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 04 01}{F5 86 0C 01 0F 01 02 01 02 01}{F5 61 02 01 01 01 01 01 07 01}小直外表和内在的反差，\n让整个我都心动了啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 03 01 01 01 01 01 0B 01}诶，那、那个……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 02 01 02 01 04 01}{F5 86 0C 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 09 01}玲可爱得让人想保护她，\n怎么说呢，真是秀色可餐！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 03 01 01 01 01 01 08 01}说到用餐，\n我喜欢鸡蛋和乌冬面！\n再往上面撒一大把天妇罗碎！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}啊，玲，就差一点！\n我是在夸你，不是真的要吃饭！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 0A 01}你这嘴可真能说。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}真田学长，你忘了吗？\n我以前不是教过你，\n聊天要像传接球一样吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}别小看我，我记得清清楚楚。\n“聊天要像传接球”对吧！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:13:0",
  "message_id": "MSG_0122",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 04 01}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0F 01}蛋白粉主要分为\n乳清、大豆和鸡蛋制成的几种……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 03 01 01 01 01 01 05 01}蛋、蛋白粉？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 05 01}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 03 01 01 01 01 01 0A 01}你传错球了吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 04 01}是、是吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 03 01 01 01 01 01 06 01}啊……对了，玩游戏怎么样？\n必胜攻略里写着，\n联谊时要一起玩游戏哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 05 01}……必胜攻略？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}嗯，因为文化祭要办联谊咖啡厅，\n我就找了本联谊必胜攻略来预习。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 16 01}游戏吗，不错。\n打循环赛吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}那个，有个叫“古今东西”的游戏，\n据说肯定能让气氛热起来。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:21:1",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}定好题目后，按节奏轮流回答，\n答案重复或答不上来的人，\n就接受惩罚！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 19 01}说到惩罚……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:23:0",
  "message_id": "MSG_0212",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 03 01 01 01 01 01 06 01}……啊！\n当着大家的面读这个怎么样？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:24:0",
  "message_id": "MSG_0213",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}是我刚才在天鹅绒房间门前\n捡到的一张“信纸”。\n不知道是谁的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:25:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 03 01 01 01 01 01 05 01}天鹅绒房间门前的信纸……？\n上面写着什么……诗吗……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:25:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}“我是蔷薇……\n盛开在荒野中的一朵蔷薇”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:25:2",
  "message_id": "MSG_022",
  "translation": "{F2 05 01 FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 13 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:25:3",
  "message_id": "MSG_022",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}{F5 C1 03 01 01 01 01 01 0A 01}这下可绝对不能输了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:26:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 20 01}{F5 C1 03 01 01 01 01 01 0B 01}输了就要朗读诗！？\n太、太折磨人了……！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:27:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 21 01}哼，好。\n惩罚越重，比赛越让人热血沸腾。\n快，赶紧出题。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:28:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 0B 01 01 01}{F5 61 02 01 01 01 01 01 22 01}就是想一个有好多答案的问题吗？\n嗯，嗯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:29:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 23 01}咖喱里放的食材！！\n怎么样！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:30:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 24 01}{F5 C1 03 01 01 01 01 01 08 01}我最喜欢咖喱了！！\n是最好喝的饮料呢！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:31:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 05 01}{F5 61 02 01 01 01 01 01 25 01}我觉得……那不算饮料。\n不过，这个题目也行吧？\n……反正不觉得自己会输。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:32:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 01}好，就这么定了！\n这个题目我们也不会输！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:33:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 06 01 05 01 05 01 04 01}{F5 61 02 01 01 01 01 01 27 01}嗯，很轻松。\n我们在林间学校还做过呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:34:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 02 01}{F5 61 02 01 01 01 01 01 28 01}啊，真的啊……\n这种题目，女生比较有利吧。\n真田学长，你行吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:35:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 29 01}咖喱的食材吧？\n这谁不知道。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:36:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}{F5 C1 03 01 01 01 01 01 0A 01}呃，那最危险的可能是我……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:37:0",
  "message_id": "MSG_0332",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}{F5 C1 03 01 01 01 01 01 08 01}那就让我先来！\n“古今东西”游戏，开始啦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:38:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2C 01}预备——胡萝卜！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:39:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2D 01}水煮蛋的蛋白。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:40:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}停，停——！\n蛋白是怎么回事啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:41:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}哼，以为我只会说蛋白粉吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:42:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 30 01}我确实这么想，但问题不在这里。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:43:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 31 01}{F5 C1 03 01 01 01 01 01 05 01}有什么不对？\n我每次都放１０个。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:44:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 32 01}{F5 C1 03 01 01 01 01 01 0A 01}那算额外加的配料吧……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:45:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 02 01}{F5 86 0D 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 33 01}嗯？不一样吗？\n你说呢，{F1 81}。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:46:0",
  "message_id": "SEL_TALK042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 02 01}过关！{F5 47 02 01 03 01 03 01 01 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:46:1",
  "message_id": "SEL_TALK042",
  "translation": "{F2 05 FF FF}{F1 41}好，接受惩罚吧！{F5 47 02 01 03 01 03 01 01 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:47:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 34 01}{F5 C1 03 01 01 01 01 01 07 01}什么……！？\n蛋白里富含咖喱容易缺少的\n蛋白质啊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:48:0",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 35 01}别死不认输了，阿明。\n痛痛快快认输吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:49:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 36 01}{F5 C1 03 01 01 01 01 01 04 01}可恶，你们根本不明白……\n蛋白质有多重要……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:50:0",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 37 01}都说了不是这个问题。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:51:0",
  "message_id": "MSG_047",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 38 01}当然。\n好，下次请你吃咖喱！\n蛋白当然也放１０个。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_111.bf.json:52:0",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 39 01}{F5 C1 03 01 01 01 01 01 0A 01}那样也算过关啊……\n接下来从荒垣学长开始。\n预备——\n{F2 23 00 00}{F1 21}{00}"
 },
 {
