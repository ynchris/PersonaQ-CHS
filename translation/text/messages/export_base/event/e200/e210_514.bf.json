[
 {
  "key": "export_base/event/e200/e210_514.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 04 01}咦……婚礼！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 04 01 01 01 01 01 04 01}……啊，这是合成的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 04 01}你看，轮廓那里，\n模糊处理得还不够好。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞正如理世所说，\n　这似乎是合成照片……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 11 01 02 01 04 01}{F5 61 02 01 01 01 01 01 05 01}没想到这种地方\n会出现合成照片，\n刚才一下子吓到了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}合成照片我早就看惯了。\n经常有人寄过来。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}……不过，都是更过分的。\n可不是那种王子和公主\n幸福结婚的照片。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}要是那样的合成照片，\n我倒是完全欢迎。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:2:4",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 08 01}被喜欢的人像抱公主一样\n紧紧抱在怀里……\n果然是女孩子的憧憬嘛。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:2:5",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}当然，要是像学长这样出色的人才行！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:3:0",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 12 01 02 01 01 01}你是真心的吗？{F5 47 02 01 37 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:3:1",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}真的要结婚吗？{F5 47 02 01 37 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:3:2",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}像照片里一样抱起她{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}是真心的！\n敷衍的明明是学长！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 04 01}总是说“好好好”，\n就随便应付过去！\n我可是会受伤的哦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:5:0",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 05 01 03 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}……不过，因为是学长，就原谅你。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 05 01}咦……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:6:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}和、和学长……结婚……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:6:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 37 01 06 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:6:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}开玩笑的吧。\n呵呵，我才不会上当呢！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:6:4",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}真是的……被这里的气氛带跑了吗？\n这可不像学长哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:7:0",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 05 01 03 01 01 01}{F5 61 02 01 01 01 01 01 13 01}但、但是……\n如果只限现在，我也想顺着气氛……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:8:0",
  "message_id": "MSG_0052a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 37 01 06 01 03 01 01 01}{F5 61 02 01 01 01 01 01 14 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:8:1",
  "message_id": "MSG_0052a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 06 01 03 01 01 01}{F5 61 02 01 01 01 01 01 15 01}开玩笑的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:9:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 01 01 04 01 04 01}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}呀！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:9:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}学、学长……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:9:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:9:3",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}是学长的气息……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:9:4",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:9:5",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1B 01}{F5 C1 03 01 01 01 01 01 0B 01}不、不行！\n太害羞了！　到极限了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:10:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:10:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞放下了满脸羞红的理世……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:11:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 0A 01 03 01 04 01}{F5 61 02 01 01 01 01 01 1C 01}难道是因为我说很向往……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:11:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 37 01 05 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}嘿嘿……谢谢。\n学长果然温柔过头了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_514.bf.json:11:2",
