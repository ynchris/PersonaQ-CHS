[
 {
  "key": "export_base/event/e200/e210_807.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 33 01 11 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}那……那个，{F1 81}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 33 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 01}想问你一点事，\n其实只是随便聊聊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 33 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}那个……嗯。\n结婚以后，你有没有什么\n希望妻子为你做的事……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:1:0",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 33 01 12 01 02 01 01 01}希望吃到她亲手做的饭{F5 47 02 01 33 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:1:1",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}陪在身边就好{F5 47 02 01 33 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:1:2",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}没什么特别的{F5 47 02 01 33 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 33 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}这、这样啊……\n果然，亲手做的饭会让人高兴呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 33 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}我一直觉得，料理就是“爱”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 33 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}想让重要的人开心，\n所以用心、认真地制作……\n将心意传达给对方。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_807.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 33 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}要是丈夫像你一样……\n妻子也一定会\n努力做好每一餐吧。\n{F2 23 00 00}{F1 21}"
 },
 {
