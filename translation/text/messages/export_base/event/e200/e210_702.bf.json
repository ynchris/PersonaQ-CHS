 },
 {
  "key": "export_base/event/e200/e210_702.bf.json:6:1",
  "message_id": "SEL_TALK006",
  "translation": "{F2 05 FF FF}{F1 41}不开门{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_702.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞打开了教堂的大门……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_702.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 30 01 05 01 02 01 04 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}等等，别走啊！\n我们还不是那种关系吧！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_702.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 30 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}这种事总要一步一步来吧！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
