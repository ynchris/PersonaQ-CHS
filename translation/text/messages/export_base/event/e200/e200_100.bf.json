 },
 {
  "key": "export_base/event/e200/e200_100.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 03 01 01 01 01 01 04 01}这里好像还会继续问问题呢。\n真是的，什么命中注定的另一半啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_100.bf.json:2:0",
