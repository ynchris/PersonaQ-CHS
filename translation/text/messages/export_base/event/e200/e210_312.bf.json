 },
 {
  "key": "export_base/event/e200/e210_312.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 02 01 01 01 01 01 02 01}为、为什么握着我的手？\n这种样子被别人看到，\n肯定会被取笑的啊！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_312.bf.json:3:2",
