[
 {
  "key": "export_base/event/e200/e210_518.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 04 01 01 01 01 01 04 01}哎呀，这可真是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 04 01 01 01 01 01 04 01}这种独家偷拍照，\n是什么时候拍下的呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 04 01}明明一直很小心，\n不让我们的关系曝光……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 04 01 01 01 01 01 04 01}这下，只有请您\n负起责任了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 04 01 01 01 01 01 04 01}……虽然很想这么说，\n不过看来，这似乎是伪造的呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞正如伊丽莎白所说，\n　这似乎是合成照片……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 01 01 02 01 04 01}{F5 61 02 01 01 01 01 01 07 01}真是有趣的艺术作品。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}童话般的王子与公主装束。\n随意拼贴而成、\n用途不明的合成照片……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}而最有趣的，\n莫过于王室世代相传的绝招……\n“公主抱”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}听说，只要对王妃候选人使出此招，\n就能以１００％的成功率，\n将对方带回城堡……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:2:4",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}这样的秘技，\n真想亲身体验一次。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:3:0",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 10 01 02 01 01 01}没有这种秘技{F5 47 02 01 3C 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:3:1",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}公主的角色交给我了{F5 47 02 01 3C 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:3:2",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}像照片里一样抱起她{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}呵呵……开玩笑的。\n只是想来个俏皮笑话，\n小小地卖个乖……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}……卖拐？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 05 01}……卖怪？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}……总之，就是这种感觉。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 10 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}哎呀，可以吗？\n那就恭敬不如从命，带您回去……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}等等，王子原来是我啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 3C 01 10 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:5:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 10 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 03 01 01 01 01 01 08 01}我试着挑战了一下姐姐教的\n“先附和再吐槽”……\n您觉得如何……呵呵。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白似乎很满意……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 01 01 04 01 04 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 07 01}哎呀……哎呀呀呀。\n这可真是不得了！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}温暖的体温与不稳的重心……\n明明没有多高，\n却有种俯瞰世界的优越感……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:7:2",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 16 01}真是难以言喻的愉悦。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:7:3",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}{F5 C1 03 01 01 01 01 01 06 01}啊……！\n此时此刻，不正是高喊\n那句台词的绝佳时机吗……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:7:4",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}嗯～……咳，咳咳。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:7:5",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}大胆，还不低头。\n退～下～吧～。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:7:6",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 03 01 01 01 01 01 08 01}呼……\n我心满意足了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞把心满意足的伊丽莎白放了下来……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 0F 01 02 01 04 01}{F5 61 02 01 01 01 01 01 1B 01}听说公主这份工作，\n不是变成海里的泡沫，\n就是遭人用毒苹果谋划完美犯罪……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}甚至还会被迫嫁给野兽，\n必须完成超高难度的考验，\n才能上任呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:9:2",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}虽然只有片刻……\n能体验一番公主的心情，\n真是不胜荣幸。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:9:3",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3C 01 0F 01 02 01 04 01}{F5 61 02 01 01 01 01 01 1E 01}那么，差不多该继续前进了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:9:4",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}前方究竟有什么在等待我们呢……\n我的心因好奇而咚咚咚咚，\n欢舞个不停。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_518.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞气氛变得有些微妙……\n{F2 23 00 00}{F1 21}{00}"
 }
