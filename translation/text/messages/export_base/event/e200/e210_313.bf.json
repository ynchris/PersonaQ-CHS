  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 36 01 0C 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:10:3",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}啊，那个……\n真伤脑筋啊，{F1 81}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:10:4",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 04 01}就、就算让我们互诉爱意，\n也很让人为难呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:11:0",
  "message_id": "SEL_TALK011",
