 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:12:2",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 36 01 04 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:12:3",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 03 01 01 01 01 01 07 01}我、我说的分不开，\n是指手哦！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 03 01 01 01 01 01 07 01}咦，不，那个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}是、是开玩笑……吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:13:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 03 01 01 01 01 01 0A 01}真、真是的……你总这么从容。\n难道心跳加速的只有我吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 07 01}咦，那个……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 03 01 01 01 01 01 06 01}啊，对、对哦！\n一开始就当成恋人，\n反而就不会那么在意了，对吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:14:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}恋、恋人，恋人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:14:3",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 17 01}……怎么办，更害羞了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 18 01}总、总之，先走走看吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_313.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 36 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}带路就交给你了，那个……\n请多关照。\n{F2 23 00 00}{F1 21}{00}"
 }
