[
 {
  "key": "export_base/event/e200/e200_314.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里究竟是什么地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“联谊咖啡厅”终成眷属……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 03 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 04 01}好疼～……\n屁股要是摔青了可就麻烦了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 01}不过，真的太突然了，\n吓了我一跳。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}刚才还和风花一起看着，\n猜命定伴侣会是谁，\n下一秒就到那里了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}这迷宫的力量真可怕。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 05 01}咦，你牵着我的手呀？\n谢谢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}没事，可以松开了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 47 01 12 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:3:3",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 07 01}诶，好像松不开！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1B 01}{F5 C1 04 01 01 01 01 01 02 01}看来，你们已经抵达了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 03 01 01 01 01 01 01 01}哈？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 04 01 01 01 01 01 02 01}这里似乎是一条让邂逅命定伴侣的\n恋人们倾诉爱意的道路。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}{F5 C1 04 01 01 01 01 01 02 01}前方究竟有什么在等待呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1E 01}{F5 C1 04 01 01 01 01 01 02 01}你们可以手牵着手，\n怀着好奇与恐惧迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}手牵着手……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}诶，难道我们的手松不开，\n就是因为……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}{F5 C1 04 01 01 01 01 01 02 01}我说，你们可以迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}{F5 C1 04 01 01 01 01 01 02 01}来，迈出脚步吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞机械语音消失了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 03 01 01 01 01 01 07 01}诶，要我们一直像恋人一样\n十指相扣吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}等、等一下！\n这该不会是整人节目吧！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}……真是的。\n到底什么情况啊……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:11:0",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 12 01 02 01 01 01}大概会有办法{F5 47 02 01 47 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:11:1",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}真幸运{F5 47 02 01 47 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:11:2",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}今后长长久久，请多关照{F5 47 02 01 47 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}啊哈哈。还“大概”，\n也太随意了吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}不过，放轻松点也好。\n着急也没用嘛。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}真是的……开玩笑，还是认真的？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}……不过，{F1 82}，\n没想到你还挺会接话的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:13:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}呵呵，稍微放心了。\n要是气氛变得尴尬，\n我可就慌了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 15 01}长长久久……\n真是的，别说得这么奇怪！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}……不过，{F1 82}，\n没想到你还挺会接话的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:14:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 17 01}呵呵，稍微放心了。\n要是气氛变得尴尬，\n我可就慌了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 18 01}那个……总之，\n先探索一下附近吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}啊，还有……\n要是在这里被阴影袭击，\n我可只能给你加油哦？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_314.bf.json:15:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 47 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}所以，那个……加油啦？\n{F2 23 00 00}{F1 21}{00}"
 }
]