[
 {
  "key": "export_base/event/e200/e210_816.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 01 01 03 01 04 01}{F5 61 02 01 01 01 01 01 02 01}这条路……\n究竟有什么用意呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_816.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}起初我以为，是通过牵手限制行动，\n再利用婚礼照片扰乱心神，\n然后趁虚而入……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_816.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}可是，敌人始终没有出现的迹象，\n真不知道到底想干什么……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_816.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 0B 01}而、而且，那种羞人的照片……\n如果只是毫无意义地摆在那里，\n对我们来说也太添乱了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_816.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}学长也觉得奇怪吧？\n我、我穿着礼服，摆出那种姿势……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_816.bf.json:1:0",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 0E 01 02 01 01 01}非常可爱{F5 47 02 01 3B 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_816.bf.json:1:1",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}那就交换新郎的角色吧{F5 47 02 01 3B 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_816.bf.json:1:2",
  "message_id": "SEL_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}像照片里一样抱起她{00}{00}"
 },
 {
