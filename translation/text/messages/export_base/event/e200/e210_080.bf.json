  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 18 01}看看白钟。\n同样是男人，可比你冷静多了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_080.bf.json:21:0",
  "message_id": "MSG_020",
