[
 {
  "key": "export_base/event/e200/e200_520.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 05 01}{F5 C1 04 01 01 01 01 01 04 01}……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 04 01 01 01 01 01 04 01}这是……婚礼服装……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 04 01}而穿着这些服装的，\n是您和我……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞看来，这似乎是合成照片……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 02 01}{F5 86 24 01 01 01 04 01 04 01}{F5 61 02 01 01 01 01 01 05 01}是说……\n您和我要结婚吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:3:0",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}我想不是{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:3:1",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}一定是陷阱{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 07 01}不、不是吗？\n失礼了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 07 01}那个……如果可以的话，\n我也想体验一下……结婚。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 08 01}听说，结婚是两个羁绊深厚的人，\n立誓要共同培育\n更加深厚的羁绊的仪式。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 09 01}当然，这与天鹅绒房间的住人\n是无缘的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:4:4",
  "message_id": "MSG_004",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}正因如此，才令人憧憬。\n就像遥不可及的星星……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥微笑着……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 01 01}陷、陷阱！？\n黄豆粉在哪里！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥慌张地环顾四周……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}失礼，我失态了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}这件事还请保密，\n似乎有人在天鹅绒房间里\n设置了陷阱。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:8:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}没错，说起陷阱就是黄豆粉……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:8:3",
  "message_id": "MSG_008",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 03 01 01 01 01 01 0A 01}稍一疏忽，就会落下黄豆粉，\n或是桌上突然喷出黄豆粉……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:8:4",
  "message_id": "MSG_008",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}就在前几天，人格面具全书里\n还夹着一页黄豆粉……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:8:5",
  "message_id": "MSG_008",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 03 01 01 01 01 01 04 01}那可真难清理……\n怎么拍都拍不干净，还钻进袖口领口，\n弄得浑身沙沙的。沙沙的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥仍在警戒四周……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 12 01}……如果我要结婚，\n姐姐们一定会很高兴吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 13 01}有一次，她们还要求我\n立刻去结个婚。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 14 01}说是想玩什么\n“小姑子”的角色游戏……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:10:3",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 15 01}她们看起来非常开心，\n所以结婚想必\n是件很美好的事吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:10:4",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 16 01}如果允许，真希望有一天，\n我也能体验一下。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_520.bf.json:10:5",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 17 01}……那么，走吧？\n{F2 23 00 00}{F1 21}{00}"
 }
]