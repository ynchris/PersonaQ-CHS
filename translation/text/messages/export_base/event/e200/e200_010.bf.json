 },
 {
  "key": "export_base/event/e200/e200_010.bf.json:23:2",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}走吧，风花！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_010.bf.json:24:0",
