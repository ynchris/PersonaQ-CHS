  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 02 01}{F5 86 15 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 06 01}……我记得，需要丈夫和妻子吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_722.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 07 01}你和我谁当丈夫，谁当妻子，\n不用事先决定吗？\n{F2 23 00 00}{F1 21}{00}"
 },
