[
 {
  "key": "export_base/event/e200/e210_306.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里究竟是什么地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“联谊咖啡厅”终成眷属……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 01 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}这里就是被选为“命定伴侣”的\n两个人的世界……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 01}除了我和{F1 82}，\n似乎没有其他人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 07 01}这是……！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}大事不好！\n我们的手二十四小时紧密相连！\n无法分开！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 04 01 01 01 01 01 02 01}看来，你们已经抵达了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}啊，是之前那个神秘声音。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 04 01 01 01 01 01 02 01}这里似乎是一条让邂逅命定伴侣的\n恋人们倾诉爱意的道路。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 04 01 01 01 01 01 02 01}前方究竟有什么在等待呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}{F5 C1 04 01 01 01 01 01 02 01}你们可以手牵着手，\n怀着好奇与恐惧迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}如果不迈出脚步，\n该怎么做呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}{F5 C1 04 01 01 01 01 01 02 01}我说，你们可以迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 04 01 01 01 01 01 02 01}来，迈出脚步吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞机械语音消失了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}也就是说，\n别废话，赶紧走。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}不过，正如刚才所说，\n对我而言，最重要的是\n陪伴在{F5 C1 11 01 01 01 01 01 01 01}身边。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}因此，目前的状态有问题。\n判断需要尽快处理，\n我会努力解决。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:11:0",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 12 01 02 01 01 01}真冷淡啊{F5 47 02 01 32 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:11:1",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}请多关照{F5 47 02 01 32 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:11:2",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}不是命中注定吗？{F5 47 02 01 32 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}体温设定为３６度左右。\n是女性的平均值。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}我是对阴影特别压制兵装，\n“埃癸斯”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}特长是机械舞，\n以及将阴影打成蜂窝。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:13:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}关于你的数据尚少，\n我会逐步收集！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}我最重要的人是{F5 C1 11 01 01 01 01 01 01 01}。\n不是你。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}不过……很不可思议。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:14:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}从你身上，我感受到\n与那个人相似的“特别之处”。\n虽然无法准确说明……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 32 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}话说回来，这一层的气氛……\n有些特别呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_306.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}也许能找到什么线索。\n我们搜索一下四周吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]