  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 23 01}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:34:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 24 01}它说……名字不过是表象！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:35:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 25 01}{F5 C1 03 01 01 01 01 01 07 01}哇，好帅啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:36:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 01}刚才只是个小玩笑。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:36:1",
