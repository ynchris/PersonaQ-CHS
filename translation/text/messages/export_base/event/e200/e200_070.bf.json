 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:39:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2B 01}毕竟是主人给它起的名字，\n对它来说很重要吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:40:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:41:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0A 01 05 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2D 01}{F5 C1 03 01 01 01 01 01 03 01}喂……各位，不过是一只狗，\n也太着迷了吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:41:1",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 04 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}叫什么虎狼丸，\n明明只是小狗丸嘛。噗噗～\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_070.bf.json:42:0",
  "message_id": "MSG_041",
