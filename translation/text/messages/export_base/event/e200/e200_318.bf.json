[
 {
  "key": "export_base/event/e200/e200_318.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里究竟是什么地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“联谊咖啡厅”终成眷属……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 01 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}哎呀，这里……\n简直像童话世界一样……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 01}突然遇见未知的世界，\n我不禁跳得心心直跳。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}说错了。\n是心得跳跳直心。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}哎呀！\n这是怎么回事？\n我和您的手，紧紧贴在一起。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}惊讶之余，我差点就\n用力拧紧您的手了呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}{F5 C1 04 01 01 01 01 01 02 01}看来，你们已经抵达了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}请问是哪一位？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}{F5 C1 04 01 01 01 01 01 02 01}这里似乎是一条让邂逅命定伴侣的\n恋人们倾诉爱意的道路。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 04 01 01 01 01 01 02 01}前方究竟有什么在等待呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 04 01 01 01 01 01 02 01}你们可以手牵着手，\n怀着好奇与恐惧迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}也就是说……\n要我们前往不为人知的桃源乡？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1B 01}{F5 C1 04 01 01 01 01 01 02 01}我说，你们可以迈出脚步，\n也可以不迈出。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 04 01 01 01 01 01 02 01}来，迈出脚步吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞机械语音消失了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 09 01}看似能自由选择，实际却毫无自由。\n就像沦为命运奴隶的\n软弱人类一样……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}看来，这是个\n寓意相当深刻的活动呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}刚从迷宫外被突然叫来，\n转眼就变成一对一单挑般，\n只剩我们两个人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:10:3",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}而且，在通过试炼之前，\n似乎都无法松开彼此的手……\n总觉得有阴谋的气息。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:11:0",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 12 01 02 01 01 01}你看起来很开心{F5 47 02 01 49 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:11:1",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}总之先往前走吧{F5 47 02 01 49 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:11:2",
  "message_id": "SEL_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}我有点不好意思……{F5 47 02 01 49 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}坦白说，这份初次体验\n令我兴奋得跃跃欲试。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}这段令人心潮狂涌的旅程……\n还请允许我陪伴您同行。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}这段令人心潮狂涌的旅程……\n还请允许我陪伴您同行。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}为此，暂时擅离职守也无可奈何……\n是的，实在无可奈何。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}哎呀，这可不得了。\n您的脸似乎有些发红……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}心率和体温似乎也升高了，\n让我给您打一针吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:14:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}来，快把屁股露出来。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:14:3",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}……本想这么做，\n可惜我没带注射器。\n实在令人失望。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 15 01}那么，向深处前进吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 16 01}还请您陪我走到最后。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:16:0",
  "message_id": "MSG_0152",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 04 01 01 01 01 01 04 01}那么，向深处前进吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_318.bf.json:16:1",
  "message_id": "MSG_0152",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 49 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}还请您陪我走到最后。\n{F2 23 00 00}{F1 21}{00}"
 }
