[
 {
  "key": "export_base/event/e200/e200_506.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 04 01 01 01 01 01 04 01}这是……{F1 82}先生和我呢。\n这身衣服，是婚礼服装吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 04 01 01 01 01 01 04 01}不过，这不是真的。\n这张照片是假的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞正如埃癸斯所说，\n　这似乎是合成照片……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 01 01 02 01 04 01}{F5 61 02 01 01 01 01 01 04 01}刚才那张照片，\n哪里算是爱的纪念呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}在我看来，\n那只是一张合成照片……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F1 82}先生，您有什么感想呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:3:0",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 12 01 02 01 01 01}角色分配不对{F5 47 02 01 42 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:3:1",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}没什么感想{F5 47 02 01 42 01 01 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:3:2",
  "message_id": "SEL_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}很开心{F5 47 02 01 42 01 01 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 03 01 01 01 01 01 05 01}为什么呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}我的使命就是保护您。\n没有任何不对的地方。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 09 01}果然，那不过是\n一张合成照片而已。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}如果连让我们动摇都做不到，\n这里究竟为何要放这种东西呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}“开心”……吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 42 01 10 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_506.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 42 01 10 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}……这是为什么呢？\n我也稍微……有种奇怪的感觉。\n{F2 23 00 00}{F1 21}{00}"
 },
