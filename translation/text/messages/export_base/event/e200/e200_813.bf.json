  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞雪子似乎很害羞……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_813.bf.json:10:0",
