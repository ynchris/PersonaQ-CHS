 },
 {
  "key": "export_base/event/e200/e200_813.bf.json:8:3",
  "message_id": "MSG_007a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 46 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}我在说些什么啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_813.bf.json:9:0",
