[
 {
  "key": "export_base/event/e200/e200_805.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 41 01 11 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}喂，{F1 81}。\n有１件事想问你……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_805.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}新郎新娘像刚才照片里那样\n摆姿势，那个……很常见吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_805.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 41 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}光像现在这样牵着手，\n就羞得快要死了，\n还要在人前贴得那么近……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_805.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 41 01 04 01 03 01 01 01}{F5 61 02 01 01 01 01 01 05 01}不、不行……\n光是想象一下，我就……\n{F2 23 00 00}{F1 21}{00}"
 },
