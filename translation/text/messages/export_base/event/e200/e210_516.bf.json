 },
 {
  "key": "export_base/event/e200/e210_516.bf.json:3:0",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 3B 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 08 01}刚……刚才那到底\n是什么意思呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_516.bf.json:3:1",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}用那种骗小孩的合成照片，\n让我和你……当新、新郎新娘……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_516.bf.json:3:2",
