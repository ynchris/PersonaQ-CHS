[
 {
  "key": "export_base/event/e200/e220_033.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞又有一扇被锁链封住的门……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}又是这个啊。\n那个怪家伙是不是又要出来了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 04 01 01 01 01 01 03 01}你好你好。\n听见呼唤，立刻登场，大家好。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 03 01}你好你好，向您问好。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 02 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 04 01 01 01 01 01 03 01}经历一番苦恼，\n你们成功通过了第一个房间。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 03 01}然而，你们前方的道路\n似乎还十分漫长。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 04 01 01 01 01 01 03 01}决定命运的选择，\n即将再次出现在你们面前。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 04 01 01 01 01 01 03 01}那么，期待已久的第二题来了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:5:0",
  "message_id": "MSG_Q_001",
  "translation": "{F2 05 FF FF}{F1 41}希望喜欢的人为你做什么样的料理？\n※预定使用专用界面\n{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:6:0",
  "message_id": "SEL_Q_002",
  "translation": "{F2 05 FF FF}{F1 41}充满爱意的料理{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:6:1",
  "message_id": "SEL_Q_002",
  "translation": "{F2 05 FF FF}{F1 41}美味的料理{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:6:2",
  "message_id": "SEL_Q_002",
  "translation": "{F2 05 FF FF}{F1 41}注重营养的料理{00}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:7:0",
  "message_id": "MSG_Q_003",
  "translation": "{F2 05 FF FF}{F1 41}※开门演出\n{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:8:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0F 01 03 01 04 01}{F5 61 02 01 01 01 01 01 04 01}命中注定的另一半，还没好吗？\n还没好吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:9:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}哇哦，别担心，小猫咪。\n不管选中谁，小熊都是大家的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:10:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}总之，门开了。\n赶紧往前走吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e220_033.bf.json:11:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 03 01 01 01 01 01 02 01}至少听小熊说完啊！！\n{F2 23 00 00}{F1 21}{00}"
 }
]