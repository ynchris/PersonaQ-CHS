[
 {
  "key": "export_base/event/e200/e200_020.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞与此同时，天鹅绒房间……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 02 01 01 01 02 01}{F5 86 24 01 03 01 04 01 04 01}{F5 61 02 01 01 01 01 01 02 01}姐姐……那些客人\n为什么会相遇呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}这里的确不是所谓的现实，\n但像这样从“不同的时间”\n来到此处……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}是啊……时间向来\n只能朝着一个方向流动。\n而如今……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}……扭曲将化作裂痕，\n最终或许连现实世界\n也会受到影响……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 07 01}{F5 61 02 01 01 01 01 01 06 01}现实世界也会……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 04 01 01 01 01 01 02 01}我只是说……有这种可能。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 08 01}也就是说……确实有可能。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 23 01 0A 01 02 01 01 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 04 01 01 01 01 01 02 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0A 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 02 01}为什么偏偏是“文化祭”呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 04 01 01 01 01 01 02 01}如果并不是只要\n有一所“学校”就行的话……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}所谓“文化祭”，\n就是祭典……对吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 04 01 01 01 01 01 02 01}祭典……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 02 01 01 01 02 01}{F5 86 22 01 03 01 05 01 07 01}{F5 61 02 01 01 01 01 01 0E 01}还有一件令人在意的事……\n“不羁”的能力发生了变化。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}原本能自由召唤各种人格面具的\n{F1 82}大人，\n如今却无法卸下“俄耳甫斯”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}相应地，虽然变得能够\n同时召唤另一个人格面具，\n但这究竟是……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 11 01}原本能自由召唤各种人格面具的\n{F1 82}大人，\n如今却无法卸下“弥赛亚”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}相应地，虽然变得能够\n同时召唤另一个人格面具，\n但这究竟是……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 09 01 04 01 01 01}{F5 61 02 01 01 01 01 01 13 01}似乎与“不羁”本来的能力\n有着不同的形态。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}就像失去力量的“不羁”，\n强行扭曲了自身能力的形态……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:12:2",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}果然与这个世界有关……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 04 01}{F5 86 23 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 16 01}失去力量……是啊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}这个世界与所有人共享的\n无意识世界相连……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:13:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}它本应始终流动、不断变幻，\n是一个充满多样性的世界……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:13:3",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}可代表“无限可能性”的\n“不羁”，却失去了力量……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:13:4",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}也就是说，这个世界是\n“有限”的……不会改变……吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}有限……？\n姐姐，这是什么意思……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}……我还不知道。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}总之，\n不要忘记我们的职责。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:15:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1E 01}对于客人的旅途，\n我们可以“帮助”，\n却不能“干涉”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:15:3",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}从今往后，他们会把握\n怎样的命运，我们只能\n静静地注视……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 20 01}是的。\n至少在“帮助”这件事上，\n我们应当不遗余力。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:16:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 21 01}……说起来，姐姐。\n您是不是有什么话要对我说？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:16:2",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 01}我记得，是关于我和我的客人……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 23 01}……嗯，关于那件事……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:17:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 24 01}我的客人所在的时代，\n按公历来说，是２０１１年。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:17:2",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}在那个时候，你已经……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:18:0",
  "message_id": "MSG_0172",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 26 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 27 01}{F5 C1 03 01 01 01 01 01 05 01}姐姐？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 28 01}{F5 C1 04 01 01 01 01 01 02 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:20:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 29 01}{F5 C1 04 01 01 01 01 01 02 01}还是算了吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:21:0",
  "message_id": "MSG_0192",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}我们只是命运的旁观者。\n不能“干涉”……\n我自己刚刚才说过呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:22:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}……好的，我明白了。\n那么，我就把这件事\n忘得一干二净吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:23:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}两位姐姐，关于“帮助”一事，\n我倒是有个妙计。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:23:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2D 01}一旦实现，必定能成为\n两位客人的有力后盾。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:24:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}是吗……那就立刻\n着手准备吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:25:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}这样就好……\n那么，你们两个先回去吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:26:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 25 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 30 01}{F5 C1 03 01 01 01 01 01 04 01}从刚才开始，就一直说些\n让人听不懂的话。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:26:1",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 31 01}迪奥，帮我买个刨冰。\n要绿色的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e200_020.bf.json:27:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 32 01}{F5 C1 03 01 01 01 01 01 0A 01}……我知道了。\n{F2 23 00 00}{F1 21}{00}"
 }
]