 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 07 01}不结婚吗！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 07 01}啊，不，那个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 08 01}听说婚姻是拥有深厚羁绊的两人，\n宣誓将进一步加深彼此羁绊的\n一种仪式……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 09 01}当然，这与天鹅绒房间的住人\n是无缘的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:4:4",
  "message_id": "MSG_004",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}正因如此，才令人憧憬。\n就像遥不可及的星星……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:4:5",
  "message_id": "MSG_004",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 04 01}主人也一定\n不会允许的吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥垂头丧气……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}……好、好的！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}听说，结婚是两个羁绊深厚的人，\n立誓要共同培育\n更加深厚的羁绊的仪式。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}为使与您的羁绊更加坚固，\n并为您带来兴盛，\n我也会不断精进。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:6:3",
  "message_id": "MSG_006",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}今后也请您多多关照……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:6:4",
  "message_id": "MSG_006",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 03 01 01 01 01 01 07 01}……啊！\n我完全忘了主人的存在！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:6:5",
  "message_id": "MSG_006",
  "translation": "{F2 05 01 FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 24 01 14 01 04 01 01 01}{F5 61 02 01 01 01 01 01 11 01}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:6:6",
  "message_id": "MSG_006",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 04 01}恐怕，主人不会\n允许我与您结婚吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥垂头丧气……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 13 01}……不过，两位姐姐\n应该会很高兴。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 14 01}有一次，她们还要求我\n立刻去结个婚。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:8:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 15 01}说是想玩什么\n“小姑子”的角色游戏……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:8:3",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 16 01}她们看起来非常开心，\n所以结婚想必\n是件很美好的事吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:8:4",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 17 01}如果允许，真希望有一天，\n我也能体验一下。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e200/e210_520.bf.json:8:5",
