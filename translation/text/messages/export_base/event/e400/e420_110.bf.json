[
 {
  "key": "export_base/event/e400/e420_110.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0F 01 04 01 02 01}{F5 61 02 01 01 01 01 01 02 01}这是什么……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 03 01}不对劲，怎么会出现这种东西……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0C 01 01 01 02 01}{F5 61 02 01 01 01 01 01 04 01}难道那是……\n玲的阴影？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}不，不是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}只能认为，是栖息在这所学校的\n阴影们失控了……\n为了不让玲被带走……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 04 01 01 01 01 01 02 01}不让玲被带走？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 04 01 01 01 01 01 04 01}它们不想失去这里。\n一旦玲和我离开，这个世界\n就会消失，所以才把玲……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 04 01 01 01 01 01 04 01}可是……这股力量，真只是阴影……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 0A 01}这个世界会消失……\n是因为这里是玲创造的学校吗……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}你之前说过吧？\n创造这所学校的是玲……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}……不，是我创造的。\n那时候，我只想起了一半……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}其实是以玲的记忆为基础，\n由我使用了力量……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0E 01}玲的记忆……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0F 01}……善先生。\n能把一切告诉我们吗？\n关于您和玲小姐的事。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}还有，\n要怎样才能救出玲小姐……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 04 01 01 01 01 01 04 01}嗯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:11:0",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}我的真名……是柯罗诺斯。\n所谓“死神”中的一员……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:11:1",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}我是来迎接生命终结的少女……\n“玲”的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e420_110.bf.json:12:0",
  "message_id": "MSG_0103",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 14 01}为了带她前往，\n生命应当回归的地方……\n{F2 23 00 00}{F1 21}{00}"
 }
]