  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3C 01}成年人……啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_030.bf.json:51:1",
