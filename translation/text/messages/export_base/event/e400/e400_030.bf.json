 },
 {
  "key": "export_base/event/e400/e400_030.bf.json:18:0",
  "message_id": "MSG_0172",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 02 01 01 01 04 01}{F5 86 05 01 05 01 05 01 02 01}{F5 61 02 01 01 01 01 01 13 01}不过，真的快变成干货了……\n满身是汗，黏糊糊的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_030.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}热就脱掉。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_030.bf.json:20:0",
