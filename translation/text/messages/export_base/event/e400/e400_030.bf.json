 },
 {
  "key": "export_base/event/e400/e400_030.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 0F 01}恐怕，\n小熊的真身是海藻。\n{F2 23 00 00}{F1 21}{00}"
