[
 {
  "key": "export_base/event/e400/e400_040.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞打开被封住的门，\n　来到开阔处，\n　疲惫一下子涌了上来……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 05 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 03 01}真是的，\n这场祭典到底还要持续多久……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 03 01 01 01 01 01 04 01}汪呜……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 04 01}虎狼丸似乎也\n被这酷暑折磨得不轻。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 05 01}啊，你也穿得很厚嘛。\n在这里面确实难熬呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0C 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 0A 01}接下来该不会\n还要更热吧……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 05 01 04 01 02 01}{F5 61 02 01 01 01 01 01 07 01}跟不上的就回去。\n只会拖后腿。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}你这话……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}我说错了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}……道理倒是没错。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 11 01 07 01 01 01 07 01}{F5 61 02 01 01 01 01 01 0B 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 06 01 02 01 01 01 02 01}{F5 86 05 01 07 01 05 01 04 01}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 0A 01}有、有点可怕呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 04 01 01 01 01 01 02 01}嗯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 03 01 02 01 01 01 02 01}{F5 86 0C 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 0E 01}桐条学姐是不是特别烦躁啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:14:0",
  "message_id": "SEL_TALK014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}是吗？{F5 47 02 01 03 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:14:1",
  "message_id": "SEL_TALK014",
  "translation": "{F2 05 FF FF}{F1 41}一定是累了{F5 47 02 01 03 01 0B 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}是啊，一直都是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 0B 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}嗯，是啊……\n虽然她一直藏着……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:16:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 0B 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 02 01 01 01 02 01}{F5 86 0B 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 13 01}那个，桐条学姐！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:17:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}稍微休息一下吧？\n这里很消耗体力……\n学姐看起来也很难受。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 03 01 01 01 01 01 05 01}我？\n……不，我没事。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 03 01 07 01 01 01}{F5 61 02 01 01 01 01 01 16 01}学姐……来到这里后，\n你一直在勉强自己吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:19:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}接连遇上不习惯的事，\n但还是想作为高年级生带领大家……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:19:2",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}可是，至少累的时候，\n就表现出来吧……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:19:3",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}连这点软弱，\n也不能让我们看见吗？\n我们就这么不值得信任吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:19:4",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}……坦诚相对很麻烦，所以一直回避，\n可果然，不说出来就无法理解……\n彼此都是。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0B 01 04 01 05 01}{F5 61 02 01 01 01 01 01 1B 01}岳羽……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 03 01 07 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}……真田学长和荒垣学长也是。\n我们每个人都互相隐瞒着什么。\n就这样……“圆滑”地相处。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:21:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}可这不就说明，\n我们根本没有互相信任吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:21:2",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}我就直说了，\n我们彼此……并不需要对方。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:21:3",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}需要的只有人格面具能力。\n说得更透彻些……只有自己。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:21:4",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 05 01 07 01 01 01}{F5 61 02 01 01 01 01 01 20 01}我并不是想\n搞什么“好朋友俱乐部”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:21:5",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 21 01}只是想……\n再多了解彼此一点……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:21:6",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 0B 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 22 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:22:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0D 01 0C 01 04 01 01 01}{F5 61 02 01 01 01 01 01 23 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:23:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0E 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 24 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 25 01}{F5 C1 03 01 01 01 01 01 04 01}……算了。\n对不起，请忘掉吧。\n只是有点累了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:25:0",
  "message_id": "SEL_TALK025",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 03 01 02 01 01 01 02 01}继续说{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:25:1",
  "message_id": "SEL_TALK025",
  "translation": "{F2 05 FF FF}{F1 41}由加莉说得对{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:25:2",
  "message_id": "SEL_TALK025",
  "translation": "{F2 05 FF FF}{F1 41}……{00}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:26:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 26 01}{F5 C1 04 01 01 01 01 01 04 01}已经……算了。\n你也忘掉吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:27:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 27 01}{F1 81}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:28:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 15 01 02 01 01 01 02 01}{F5 86 29 01 07 01 02 01 04 01}{F5 61 02 01 01 01 01 01 28 01}小由……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:28:1",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 29 01}{F5 C1 04 01 01 01 01 01 04 01}善，善……\n小由很难过……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:29:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2A 01}{F5 C1 04 01 01 01 01 01 02 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:30:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 04 01 0B 01 01 01 04 01}{F5 61 02 01 01 01 01 01 2B 01}{F5 C1 03 01 01 01 01 01 0B 01}喂、喂喂喂……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:31:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 11 01 03 01 02 01}{F5 61 02 01 01 01 01 01 2C 01}老师……怎么办啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:32:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 02 01 01 01 02 01}{F5 86 02 01 0D 01 01 01 04 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 2D 01}……我是转学来的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:32:1",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2E 01}人生地不熟的时候，就发生了杀人案，\n还获得了人格面具能力，\n让我很混乱。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:32:2",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}说到底，我是个外来者，\n本来并没有为八十稻羽战斗的理由。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:33:0",
  "message_id": "MSG_0322",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0B 01 02 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 30 01}但我和阳介、小熊做了约定。\n想救出被绑架的大家。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:33:1",
  "message_id": "MSG_0322",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 31 01}虽然无法原谅卑鄙的犯人，\n但更重要的是，\n我想为一起战斗的伙伴们而战。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:33:2",
  "message_id": "MSG_0322",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 32 01}因为他们都是我非常珍视的人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:34:0",
  "message_id": "MSG_0323",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 02 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 33 01}……虽然我当着队长，\n但独自一人的话，一定很弱。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:34:1",
  "message_id": "MSG_0323",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 34 01}伙伴们面对自己的阴影后变强了，\n但我的阴影\n并没有出现。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:34:2",
  "message_id": "MSG_0323",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 35 01}相应地，是伙伴们\n让我得到了成长。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:34:3",
  "message_id": "MSG_0323",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 36 01}我觉得，是伙伴让自己变得坚强。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:35:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 37 01}伙伴……让人坚强……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:36:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 38 01}你们不需要伙伴吗？\n想守护的事物中，没有伙伴吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:37:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 01 01 05 01}{F5 61 02 01 01 01 01 01 39 01}怎么可能没有……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:38:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 02 01 01 01 05 01}{F5 86 0B 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 3A 01}我……和理世她们聊过后，\n就在想。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:38:1",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3B 01}我不只是为了消除影时间，\n或是其他种种理由而战……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:38:2",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 03 01 07 01 01 01}{F5 61 02 01 01 01 01 01 3C 01}也想认为，自己是为了\n我们……为了“伙伴们”而战。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:38:3",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3D 01}想认为，自己之所以在这里，\n也是为了一直并肩作战、\n同住一处的“伙伴们”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:39:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 13 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3E 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:39:1",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3F 01}岳羽说得对……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:39:2",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 40 01}我们战斗的目的只有一个……\n至少目前是这样。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:39:3",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 41 01}但光靠这一点，可没法让\n这么多人团结一心……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:39:4",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 42 01}不互相信任，\n就只是些临时拼凑的人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:39:5",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 43 01}桐条、阿明……还有我自己……\n我们有没有试着把后辈们\n当作独立的人，去理解他们？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:40:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0D 01 08 01 01 01 05 01}{F5 61 02 01 01 01 01 01 44 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:40:1",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 45 01}抱歉，竟然让你们\n有了这种想法……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:41:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 46 01}可是……该怎么做？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:42:0",
  "message_id": "SEL_TALK040",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 02 01 01 01 01 01}以后多沟通吧{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:42:1",
  "message_id": "SEL_TALK040",
  "translation": "{F2 05 FF FF}{F1 41}征集好点子！{F5 47 02 01 03 01 03 01 01 01}{00}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:43:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 0D 01 65 01 02 01}{F5 61 02 01 01 01 01 01 47 01}{F5 C1 03 01 01 01 01 01 08 01}赞成！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:43:1",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 48 01}为了能好好聊个够，\n办场庆功会怎么样？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:44:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 0D 01 65 01 02 01}{F5 61 02 01 01 01 01 01 49 01}{F5 C1 03 01 01 01 01 01 08 01}我！\n我觉得办庆功会最好！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:45:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4A 01}{F5 C1 03 01 01 01 01 01 07 01}哇，理世！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:46:0",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 03 01 65 01 01 01}{F5 61 02 01 01 01 01 01 4B 01}因为我不在现场，没看懂气氛，\n对不起啦☆\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:46:1",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 4C 01}不过，果然还是大家一起\n吃顿好饭最棒了！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:46:2",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 4D 01}出去以后，办场\n“大家辛苦了”的聚会如何？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:47:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 03 01 65 01 01 01}{F5 61 02 01 01 01 01 01 4E 01}我、我觉得特别好！\n我会大显身手的！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:48:0",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 03 01 65 01 01 01}{F5 61 02 01 01 01 01 01 4F 01}那就决定啦！\n也要邀请我们哦！\n不行？怎么样呢？我也不知道☆\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:49:0",
  "message_id": "MSG_047",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 50 01}{F5 C1 03 01 01 01 01 01 0B 01}那、那得赶紧想菜单了！\n回回回头见！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:50:0",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞导航通讯突然中断了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:51:0",
  "message_id": "MSG_049",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 02 01 01 01 02 01}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 0B 01 08 01 01 01 04 01}{F5 61 02 01 01 01 01 01 51 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:52:0",
  "message_id": "MSG_050",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0E 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 52 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:53:0",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 06 01 09 01 03 01 01 01}{F5 61 02 01 01 01 01 01 53 01}噗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:54:0",
  "message_id": "MSG_0512",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 54 01}呵呵呵呵……啊哈哈哈哈。\n一下子安静了！\n安静得不得了！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:55:0",
  "message_id": "MSG_052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 55 01}还说什么“没看懂气氛对不起啦”，\n真是的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:56:0",
  "message_id": "MSG_053",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0C 01 0F 01 02 01 02 01}{F5 61 02 01 01 01 01 01 56 01}风花要大显身手，是我听错了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:57:0",
  "message_id": "MSG_054",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0A 01 02 01 01 01}{F5 61 02 01 01 01 01 01 57 01}{F5 C1 03 01 01 01 01 01 0A 01}看来要见识地狱了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:57:1",
  "message_id": "MSG_054",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 58 01}……不过，好像也挺有趣。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:58:0",
  "message_id": "MSG_055",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 59 01}……那就由我来做。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:59:0",
  "message_id": "MSG_056",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 07 01 01 01}{F5 61 02 01 01 01 01 01 5A 01}{F5 C1 03 01 01 01 01 01 07 01}啊……说起来，\n我听过荒垣学长厨艺的传闻！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:60:0",
  "message_id": "MSG_057",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 5B 01}宿舍里发现的《家庭料理》教材上，\n到处都附着着\n荒垣先生的指纹！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:61:0",
  "message_id": "MSG_058",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 5C 01}{F5 C1 03 01 01 01 01 01 0B 01}啊！吵死了！\n我收回刚才的话！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:62:0",
  "message_id": "MSG_059",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 5D 01}男子汉说话要算数！\n我的那份拜托放双倍蛋白粉！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:63:0",
  "message_id": "MSG_060",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 5E 01}{F5 C1 03 01 01 01 01 01 0A 01}一份都不给你放。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:64:0",
  "message_id": "MSG_061",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0E 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 5F 01}呵……哈哈哈。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:64:1",
  "message_id": "MSG_061",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 60 01}是啊，回去后就办庆功派对。\n食材费用，桐条集团\n会全力支持。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:65:0",
  "message_id": "MSG_062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 61 01}{F5 C1 03 01 01 01 01 01 08 01}太好了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:66:0",
  "message_id": "MSG_063",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 07 01}{F5 61 02 01 01 01 01 01 62 01}这才像话！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:67:0",
  "message_id": "MSG_064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 63 01}确实，我们对彼此了解得太少了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:67:1",
  "message_id": "MSG_064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 64 01}拥有同样的能力、共同战斗的伙伴……\n可聚到一起，\n并不就自然成为了伙伴。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:67:2",
  "message_id": "MSG_064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 65 01}伙伴……是逐渐成为的啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:68:0",
  "message_id": "MSG_065",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 66 01}学姐……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:0",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 67 01}还没说过吧……\n我获得人格面具能力时的事。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:1",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 68 01}我之所以获得人格面具能力，\n是因为那是我的义务。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:2",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 69 01}几乎像实验品一样，\n被赋予了这种能力……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:3",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 6A 01}……不过，是啊。\n既是义务，也是希望。\n因为我想用这力量守护一些事物。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:4",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 6B 01}此后，我自认每天都心无旁骛地，\n沿着自己相信最好的道路前进。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:5",
  "message_id": "MSG_066",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 6C 01}可是我……也许在哪里走错了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:6",
  "message_id": "MSG_066",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 6D 01}我眼中只有自己。\n仿佛要只凭自己一个人，\n完成只属于自己的目的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:7",
  "message_id": "MSG_066",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 6E 01}明明身边还有\n与我目标相同的“伙伴”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:8",
  "message_id": "MSG_066",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 6F 01}不知不觉，增加了呢。\n我“想守护的事物”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:69:9",
  "message_id": "MSG_066",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 70 01}我……变软弱了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:70:0",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 71 01}……怎么可能。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:71:0",
  "message_id": "MSG_068",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 72 01}是吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:72:0",
  "message_id": "MSG_069",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 07 01 65 01 01 01}{F5 61 02 01 01 01 01 01 73 01}学姐……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:73:0",
  "message_id": "MSG_070",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 74 01}{F5 C1 03 01 01 01 01 01 0B 01}别、别这样，怎么连山岸也！\n好了，赶紧前进。\n不然派对就要延期了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:74:0",
  "message_id": "MSG_071",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 07 01 01 01}{F5 61 02 01 01 01 01 01 75 01}呵呵……是！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:75:0",
  "message_id": "MSG_072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 76 01}岳羽……谢谢你。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:76:0",
  "message_id": "MSG_073",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 77 01}{F5 C1 03 01 01 01 01 01 07 01}学姐………刚才那句，再说１遍！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:77:0",
  "message_id": "MSG_074",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 78 01}什……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e400/e400_040.bf.json:78:0",
  "message_id": "MSG_075",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 01 01 07 01}{F5 61 02 01 01 01 01 01 79 01}{F5 C1 03 01 01 01 01 01 08 01}桐条学姐难得这么温柔，再来一遍！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
