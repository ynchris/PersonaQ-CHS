 },
 {
  "key": "export_base/event/e400/e400_190.bf.json:42:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 07 01 01 01}{F5 61 02 01 01 01 01 01 47 01}那就决定了。\n再次请多关照，善。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e400/e400_190.bf.json:42:1",
  "message_id": "MSG_036",
