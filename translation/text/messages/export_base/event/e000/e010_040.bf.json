 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:41:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 02 01 01 01 02 01}{F5 86 05 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 25 01}{F5 C1 03 01 01 01 01 01 0A 01}所以说没有铜像啦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:42:0",
