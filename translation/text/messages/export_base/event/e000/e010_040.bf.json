 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:50:0",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2E 01}{F5 C1 03 01 01 01 01 01 07 01}……好像是有过。\n可那都是咱们上小学\n之前的事情了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:51:0",
  "message_id": "MSG_049",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}这七大不可思议够老的啊。\n{F2 23 00 00}{F1 21}{00}"
