  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 03 01 01 01 01 01 04 01}……。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:33:0",
  "message_id": "MSG_0312",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}{F5 C1 04 01 01 01 01 01 05 01}这都哪儿跟哪儿啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:34:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}咱们学校根本就\n没有铜像吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:35:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1F 01}是常见的“校园七大不可思议”呢。\n这所学校也有吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:36:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 20 01}所以说，铜像会在操场上……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:37:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 21 01}都说没有啦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e010_040.bf.json:38:0",
