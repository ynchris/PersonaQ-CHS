[
 {
  "key": "export_base/event/e000/e000_042.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 01 01 02 01}{F5 86 24 01 10 01 02 01 05 01}{F5 61 02 01 01 01 01 01 02 01}这究竟是怎么回事……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 02 01 02 01}{F5 61 02 01 01 01 01 01 03 01}密室中，出现了不速之客……也就是说，\n犯人就在你们之中！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 01 01}犯、犯人！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}开个玩笑。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:4:0",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 04 01}{F5 86 24 01 02 01 01 01 05 01}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 06 01}不管怎样，这也是某种“缘分”……\n或许，也是一切的开始吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:4:1",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}我是伊丽莎白，这是我弟弟迪奥多。\n我们都是这间“天鹅绒房间”的\n住民。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}天鹅绒房间……\n啊，难道就是那个，\n帮队长召唤人格面具的地方……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}是的。\n我们在这里协助客人\n召唤人格面具。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0C 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}原、原来是真的啊……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 0A 01}我之前还稍微有点怀疑呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}那么，为什么把我们带到这里？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}这……我们也不清楚。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}说得直白些，\n这话应该由我们来问才对。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_042.bf.json:11:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}能够进入这里的人，\n要么缔结过某种“契约”，\n要么就是……\n{F2 23 00 00}{F1 21}{00}"
 }
]