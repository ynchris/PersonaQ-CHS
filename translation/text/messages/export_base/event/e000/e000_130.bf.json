[
 {
  "key": "export_base/event/e000/e000_130.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞某所学校的走廊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞前去侦察的同伴们\n　已经回来了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 02 01 04 01}{F5 61 02 01 01 01 01 01 08 01}这里很奇怪啊？\n不管跟谁搭话，都像是说不通，\n根本不回答我的问题。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 09 01}问他们“这里是什么地方？”，\n就回答“八十神高中”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}可再问“那是在哪里？”，\n他们就只会说\n“八十神高中的文化祭真好玩”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 04 01}“吃大阪烧还是炒面，真难选啊”，\n“隔壁班有钓水气球”，\n这些话我都听过好多遍了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 12 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0C 01}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}没有任何学生\n对虎狼丸先生的出现发表意见。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 07 01}{F5 61 02 01 01 01 01 01 0E 01}一般都会说点什么吧……\n文化祭上居然来了一只狗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞同伴们都不安地\n　环顾着彼此的脸……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 0F 01}有人确认过学校外面的情况吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 10 01}确认过了……好像出不去。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 03 01 01 01 01 01 05 01}出不去……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}校门是有……\n可一迈出去，就又回到里面了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 13 01}……这是什么意思？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 04 01}就是字面上的意思……\n以为出去了，结果又回来了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}总之就是出不去。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:13:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 16 01}不只是校门，\n翻过围栏也一样。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 17 01}那个，那就按来时的方法……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 18 01}天鹅绒房间已经停止了\n作为电梯的功能。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}里面有“两扇”不可思议的门，\n可上面挂着足足“四把”坚固的锁，\n无法打开。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 03 01 01 01 01 01 0A 01}呃……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 1B 01}难道说……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}回不去了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 04 01}{F5 86 0B 01 0B 01 01 01 07 01}{F5 61 02 01 01 01 01 01 1D 01}呜……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}回不去了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}……不是，等等等等！\n这可不妙吧！很不妙吧！？\n这种奇妙体验就饶了我吧！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:21:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}{F5 C1 02 01 01 01 01 01 02 01}我可没法一直待在这里啊？\n还得去病房探望小千鸟呢！\n小千鸟说希望我去……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:22:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 21 01}吵死了……啊，手机呢！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:23:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞听到由加莉的话，同伴们\n　慌忙拿出了手机……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 01 01 02 01}{F5 86 0C 01 02 01 01 01 04 01}{F5 86 0B 01 07 01 01 01 07 01}{F5 61 02 01 01 01 01 01 22 01}{F5 C1 03 01 01 01 01 01 04 01}……没有信号？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:25:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 23 01}……是啊。\n也就是说，电话和邮件都不行了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:26:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 24 01}GPS 好像也用不了了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:27:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 25 01}{F5 C1 03 01 01 01 01 01 05 01}G、P……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:27:1",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 26 01}{F5 C1 03 01 01 01 01 01 0A 01}……这、这样啊，真伤脑筋。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:28:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 27 01}难道……我们有可能\n就这样出不去了……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:28:1",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0E 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 28 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:29:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 29 01}在天鹅绒房间里发生的一切，\n对客人而言都有其意义。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:29:1",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 02 01 01 01 04 01}{F5 86 22 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2A 01}而天鹅绒房间\n将各位引到了这里……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:29:2",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2B 01}也就是说，各位在这里\n有“必须完成的事”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:30:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}{F5 C1 03 01 01 01 01 01 05 01}必须完成的……事？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:31:0",
  "message_id": "MSG_064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 02 01}在各位完成应做之事以前，\n恐怕都只能维持现状……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:31:1",
  "message_id": "MSG_064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}至于究竟该做什么，\n还请各位亲自确认。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:32:0",
  "message_id": "SEL_TALK065",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 02 01 01 01 01 01}真冷淡啊{F5 47 02 01 03 01 0B 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:32:1",
  "message_id": "SEL_TALK065",
  "translation": "{F2 05 FF FF}{F1 41}帮帮我们吧{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:33:0",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}这间天鹅绒房间的客人，\n是您……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:33:1",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}所以眼前的状况，\n与您的命运息息相关。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:34:0",
  "message_id": "MSG_0662",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 06 01}当然，我和迪奥仍会\n一如既往地为您提供“协助”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:34:1",
  "message_id": "MSG_0662",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}……仅限“协助”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:35:0",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞看来她并不打算\n　做超出“协助”范围的事……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:36:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2D 01}至于那是什么，我们也不清楚。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:37:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}{F5 C1 03 01 01 01 01 01 06 01}我明白了！\n我们学校的文化祭取消了，\n所以让我们来这里尽情玩个够！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:38:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2F 01}不愧是兼具“顺应力”与“平常心”的\n顺平先生。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:39:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 30 01}{F5 C1 03 01 01 01 01 01 0B 01}我的名字可不是这么来的啊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:40:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 31 01}说是尽情玩……\n不知道是不是错觉，\n有个地方能感觉到阴影的反应……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:41:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 32 01}我想当然会有。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:42:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 33 01}{F5 C1 03 01 01 01 01 01 01 01}咦……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:43:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 34 01}这里不同于现实……时间与地点\n都无法确定。不，应该说，\n这些概念在这里没有意义。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:43:1",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 35 01}这里恐怕存在于\n比天鹅绒房间更“深”的地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:44:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 36 01}呃……所以说？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:45:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 37 01}就是类似塔尔塔罗斯的地方。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:46:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 38 01}{F5 C1 03 01 01 01 01 01 07 01}呃，真的假的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:47:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 39 01}你刚才说，我们在这种地方\n有必须完成的事吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:47:1",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3A 01}那答案就只有一个了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:48:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 0E 01 05 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3B 01}明彦！\n把战斗当乐趣可不是好习惯。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:49:0",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3C 01}那么，还有别的办法吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:49:1",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 02 01 01 01 02 01}{F5 86 0D 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 3D 01}眼下我们离不开这所学校，\n手机也不能用，\n根本没法求救。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:49:2",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3E 01}而这里有阴影出没的地方……\n除了去那里调查，还能怎么办？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:50:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0E 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3F 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:50:1",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 40 01}是啊……\n目前看来……也只能这样了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:51:0",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 41 01}没错，也只能这样了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:52:0",
  "message_id": "MSG_047",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 42 01}{F5 C1 03 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 02 01}别兴奋过头了，真是……\n本来我们可没工夫做这种事。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:53:0",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 02 01 01 01 05 01}{F5 86 0D 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 43 01}你觉得……会有“敌人”吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:54:0",
  "message_id": "MSG_049",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 44 01}谁知道呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:55:0",
  "message_id": "MSG_050",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0B 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 45 01}文化祭什么的，\n看起来还挺好玩的呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:56:0",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 46 01}文化祭取消后，由加莉小姐\n因为不用穿原定的女仆装，\n曾大大地松了一口气。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:56:1",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 47 01}……也就是说，由加莉小姐\n想在这里穿女仆装，对吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:57:0",
  "message_id": "MSG_052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 48 01}{F5 C1 03 01 01 01 01 01 0B 01}你到底是怎么理解成这样的！？\n我是觉得不用担心这件事，\n应该就能玩得开心了！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:58:0",
  "message_id": "MSG_053",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F4 87 05 01 01 01 01 01}{F5 86 0F 01 02 01 01 01 04 01}{F5 86 0E 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 49 01}山岸。\n你是在哪里感觉到阴影反应的？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:59:0",
  "message_id": "MSG_054",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4A 01}就在……这一层。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:60:0",
  "message_id": "MSG_055",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4B 01}那个，在楼上！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:61:0",
  "message_id": "MSG_056",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4C 01}那个，在楼下！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:62:0",
  "message_id": "MSG_057",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0B 01 01 01 05 01}{F5 61 02 01 01 01 01 01 4D 01}{F5 C1 03 01 01 01 01 01 0B 01}咦……也就是说，就在附近吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:63:0",
  "message_id": "MSG_058",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 4E 01}好，我们走吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:64:0",
  "message_id": "MSG_0582",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 0E 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 4F 01}……{F1 81}。\n和往常一样，由你担任现场队长。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:64:1",
  "message_id": "MSG_0582",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 50 01}不知道会发生什么。\n务必小心行事。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:65:0",
  "message_id": "SEL_TALK059",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}明白了{F5 47 02 01 03 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:65:1",
  "message_id": "SEL_TALK059",
  "translation": "{F2 05 FF FF}{F1 41}各位，出发吧！{F5 47 02 01 03 01 03 01 01 01}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:65:2",
  "message_id": "SEL_TALK059",
  "translation": "{F2 05 FF FF}{F1 41}真麻烦……{F5 47 02 01 03 01 07 01 01 01}{00}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:66:0",
  "message_id": "MSG_060",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 51 01}呵呵，有你这么冷静的人真可靠。\n那就拜托你了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:67:0",
  "message_id": "MSG_061",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 52 01}好，包在我身上！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:68:0",
  "message_id": "MSG_062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 53 01}{F5 C1 03 01 01 01 01 01 0A 01}啊，还真说出来了。\n你也太直白了吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e000/e000_130.bf.json:68:1",
