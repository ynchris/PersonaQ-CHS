[
 {
  "key": "export_base/event/e900/e915_100.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞３楼　摊位街\n　“甜蜜地狱”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伙伴们正细细品尝着甜食……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}{F5 86 0F 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 D1 0A}呼……甜味让人安心多了……\n队长也要来一点吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 21 0A}喝点热饮吧。\n放松心情，让头脑保持清醒，\n对队长来说也很重要。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 11 01 05 01 02 01}{F5 61 02 01 01 01 01 01 DD 03}{F5 C1 03 01 01 01 01 01 04 01}刚才真抱歉啊……\n在厕所那会儿，我吓得不行……\n真觉得自己没用……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这也没办法呀。\n每个人害怕的东西都不一样嘛。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 A9 0C}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 7C 03}雪子……小虎……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0A 01 13 01 03 01 01 01}{F5 61 02 01 01 01 01 01 81 07}居然会怕鬼，\n小千也有可爱的一面呢熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 83 03}{F5 C1 03 01 01 01 01 01 03 01}什么叫“也有”啊，喂。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}再说了，小熊你不也\n被小虎救了吗！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0F 01 03 01 01 01}{F5 61 02 01 01 01 01 01 00 06}{F5 C1 03 01 01 01 01 01 04 01}唔……！\n确、确实是帮了小熊熊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不过～那是因为不这样的话，\n小狗狗就没有表现的机会了熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 05 01 01 01 05 01}{F5 61 02 01 01 01 01 01 AE 0C}{F5 C1 03 01 01 01 01 01 04 01}呜噜噜……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7D 03}{F5 C1 03 01 01 01 01 01 08 01}对！\n小虎，再多吼他几声！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}顺便咬一口也可以哦。\n虽然应该不好吃。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1B 07}很好吃的～！\n听说小熊的右掌\n很好吃的～！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AC 0C}{F5 C1 03 01 01 01 01 01 08 01}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 71 07}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}呀啊！骗你的骗你的，住口熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}小熊和虎狼丸纠缠着，\n不知道跑到哪里去了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0F 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 11 0B}那、那个……\n大家都平安无事，真是太好了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:17:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}刚才在厕所里，真是千钧一发。\n我光是负责导航，都紧张得心怦怦跳……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}嗯，它走进厕所的时候，\n我还以为这次完了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0E 0A}多亏善急中生智，才化险为夷。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:19:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不，真的很可……\n咳，很危险。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:20:0",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 02 01 02 01 01 01 04 01}确实很危险{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:20:1",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}很可……？很可……？{F5 47 02 01 02 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 05 01 02 01}{F5 61 02 01 01 01 01 01 C0 03}{F5 C1 03 01 01 01 01 01 0A 01}……话虽这么说，\n你的脸色却一点没变呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:22:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3D 04}不愧是队长。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:23:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 0A}{F5 C1 03 01 01 01 01 01 0B 01}别重复两遍！\n那个……只是说错话了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞美鹤的举止变得有些慌乱……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:25:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 85 0A}听好了，我有义务\n保护你们这些年纪较小的同伴。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:25:1",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}所以，那个……区、区区灵异现象，\n是不能让我心生畏惧的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:25:2",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 48 0A}{F5 C1 03 01 01 01 01 01 0B 01}我的这份……觉悟！你明白吗？\n你能明白吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:26:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞看来还要说很久……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:26:1",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞还是别打扰她了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:27:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 CA 0A}这个迷宫似乎还要继续一阵子。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:27:1",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}希望不会再发生\n像厕所里那样的事了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:28:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 6B 03}{F5 C1 03 01 01 01 01 01 04 01}再来一次我真的受不了啊……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_100.bf.json:29:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞和伙伴们度过了一段愉快的时光……\n{F2 23 00 00}{F1 21}{00}"
 }
]