[
 {
  "key": "export_base/event/e900/e915_031.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２楼　节目走廊\n　“阿坎纳电影节”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伙伴们正在讨论着什么……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}{F5 86 0C 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 67 08}哟。\n我们刚才正在聊\n这里的电影……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}看看这个专题。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}“从此，两人幸福地生活在一起——\n　美好婚姻特辑”\n……是这么写的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0F 01 03 01 01 01}{F5 61 02 01 01 01 01 01 BD 11}{F5 C1 03 01 01 01 01 01 08 01}这个想看！\n必须看！只能去看了！\n要看就一起看！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 86 08}{F5 C1 03 01 01 01 01 01 0A 01}哦，原来这么想看啊……\n我还以为，高中生\n不会那么向往结婚呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 02 01 02 01}{F5 61 02 01 01 01 01 01 BA 02}玲听到“命中注定的人”，\n也特别感兴趣呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 5A 06}玲好像就是所谓的\n“爱做梦的少女”呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 05 01}据我所知，每个人都会做梦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 3E 06}{F5 C1 03 01 01 01 01 01 0A 01}咦？\n啊，是这样没错，\n不过这里说的不是那种梦……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}梦想不是用来做的，\n而是用来实现的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}实现……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……虽然大家都这么说，\n但我觉得不对。\n梦想，果然还是用来做的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 10 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 9B 11}{F5 C1 03 01 01 01 01 01 05 01}……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 0B 01 01 01}{F5 61 02 01 01 01 01 01 01 01}因为，“总有一天王子会来”之类的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:13:0",
  "message_id": "MSG_0122",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 8B 10}{F5 C1 03 01 01 01 01 01 07 01}……啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:14:0",
  "message_id": "MSG_0123",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 02 01 01 01 02 01}{F5 86 29 01 0D 01 02 01 04 01}{F5 61 02 01 01 01 01 01 50 10}{F5 C1 03 01 01 01 01 01 0B 01}那个……小阳，\n你真的是……王子吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:14:1",
  "message_id": "MSG_0123",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}“失望王子”里的失望，\n是某个国家的名字吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A0 02}{F5 C1 03 01 01 01 01 01 0A 01}不不不！\n要是失望国的王子，\n岂不是一辈子都摆脱不了失望！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 C2 11}{F5 C1 03 01 01 01 01 01 05 01}不是吗……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:17:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 07 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}啊……那个……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:18:0",
  "message_id": "MSG_0152",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 B9 02}{F5 C1 03 01 01 01 01 01 0B 01}是、是王子哦？\n失望国的第一王子哦？\n好，我要继承王位啦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:19:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 85 11}{F5 C1 03 01 01 01 01 01 0A 01}……真可怜啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:20:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 03 01 01 01 07 01}{F5 61 02 01 01 01 01 01 5C 06}因为花村学长是个特别好的人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:21:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 88 08}{F5 C1 03 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 04 01}好得过头了啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:22:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 04 03}{F5 C1 03 01 01 01 01 01 0B 01}别当着本人的面，\n营造这种“你只是个好人”的气氛啊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:23:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 02 01 02 01 01 01 04 01}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 D8 0B}我记得，直斗被称为“侦探王子”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:23:1",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这么说来，\n{F5 C1 0E 01 01 01 01 01 01 01}也是王子吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:24:0",
  "message_id": "SEL_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 01 01}当然{F5 47 02 01 02 01 0D 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:24:1",
  "message_id": "SEL_021",
  "translation": "{F2 05 FF FF}{F1 41}我是普通平民{F5 47 02 01 02 01 05 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:25:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0F 01 03 01 02 01}{F5 61 02 01 01 01 01 01 2D 10}{F5 C1 03 01 01 01 01 01 01 01}小直和{F5 C1 0E 01 01 01 01 01 01 01}\n也都是王子！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:26:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 6E 0B}这就是第三位了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:26:1",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}各国继承人齐聚一堂，\n看来八十神高中有特殊的\n教育方针和课程安排呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:27:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 98 11}是吗……\n我还在你身上感受到了\n某种与别人不同的东西……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:28:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 29 01 02 01 02 01 02 01}{F5 86 09 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 05 01}……咦？\n玲，善去哪儿了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:29:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 09 01 01 01}{F5 61 02 01 01 01 01 01 C0 11}他去巡视了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:29:1",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我跟他说，我一个人也没问题。\n只要不进迷宫就没有危险，\n而且还有大家在。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:29:2",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}善也一定觉得有大家在很开心。\n因为以前一直只有我们两个人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:30:0",
  "message_id": "MSG_0262",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 9F 10}善就拜托大家照顾了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:31:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 59 06}呵呵，当然。\n你们都很替对方着想，\n真是对好情侣呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:32:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 4E 10}{F5 C1 03 01 01 01 01 01 0B 01}情情情情侣什么的，才不是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:32:1",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……看起来像吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_031.bf.json:33:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞和伙伴们度过了一段愉快的时光……\n{F2 23 00 00}{F1 21}{00}"
 }
]