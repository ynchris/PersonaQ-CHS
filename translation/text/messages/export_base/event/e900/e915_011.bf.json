 },
 {
  "key": "export_base/event/e900/e915_011.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 11 01 04 01 01 01}{F5 61 02 01 01 01 01 01 90 11}我只靠这双拳头。\n虽然攻击距离短，但{F2 01 03 01}威力和破坏力\n都不输给武器{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_011.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}另外，人格面具\n{F2 01 03 01}擅长电击属性攻击{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_011.bf.json:17:0",
  "message_id": "MSG_0152",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 64 09}{F5 C1 03 01 01 01 01 01 08 01}千锤百炼的身体，\n加上擅长电击的人格面具！\n可谓战斗专家啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_011.bf.json:17:1",
  "message_id": "MSG_0152",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 04 01}……不过，要小心冰冻属性。\n只有那种攻击……该怎么说呢……\n是我的致命弱点……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_011.bf.json:18:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}我用钝器。\n只要够大够重，什么都行。\n攻击距离短，但{F2 01 03 01}威力强{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_011.bf.json:18:1",
  "message_id": "MSG_016",
