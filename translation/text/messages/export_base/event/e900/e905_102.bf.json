 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}啊，对了……\n你们是从２０１１年来的呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4F 09}感觉还真奇妙。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 02 01}{F5 61 02 01 01 01 01 01 84 08}{F5 C1 03 01 01 01 01 01 0A 01}我明明没换多久啊……\n真受打击……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}两年的差距，\n说不定比想象中大多了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 05 01 02 01 01 01 04 01}{F5 86 0F 01 05 01 02 01 02 01}{F5 61 02 01 01 01 01 01 F0 0A}那、那个，比如说……\n太空旅行之类的，已经实现了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4F 03}{F5 C1 03 01 01 01 01 01 01 01}啊？\n没有没有，怎么可能。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 02 01 02 01}{F5 61 02 01 01 01 01 01 8B 11}再怎么说，两年也不会\n有那么大的变化吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……还不能在月球上生活吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 05 01 01 01}{F5 61 02 01 01 01 01 01 6B 03}{F5 C1 03 01 01 01 01 01 0A 01}……不能。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 02 01 01 01 02 01}{F5 86 06 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 24 04}太空旅行之类的还不行……\n不过，汽车能在天上飞哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 88 11}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}咦！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 E3 0A}{F5 C1 03 01 01 01 01 01 08 01}果然如此！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3D 04}轻轻浮起来，然后嗖地飞出去。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 11 01 05 01 07 01}{F5 61 02 01 01 01 01 01 6E 11}{F5 C1 03 01 01 01 01 01 0B 01}等、雪子！？\n你在说什么……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 03 01 02 01 01 01 04 01}{F5 86 0C 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 A4 08}这、这也太难以置信了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:17:0",
  "message_id": "SEL_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}也不是不可能{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:17:1",
  "message_id": "SEL_017",
  "translation": "{F2 05 FF FF}{F1 41}肯定是骗人的{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 5C 06}{F1 81}，你的想法真灵活呢。\n看来完全不受常识的束缚。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 3F 06}其实，也不尽然。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}在你们的两年后，\n这项技术已经完成了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 F5 08}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}真的假的！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:22:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，接下来的事\n还是不要说太多为好。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:22:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}知道未来的知识后，\n会引起什么时间悖论，\n谁也无法预料。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:22:2",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}而且，我们也不能\n剥夺大家对未来的期待。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:23:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 66 03}{F5 C1 03 01 01 01 01 01 0B 01}对、对对！\n不能说，不能说！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}别那么小气嘛，再多说一点啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:25:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0F 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 F0 0A}{F5 C1 03 01 01 01 01 01 0B 01}顺平，别再追问了！\n时间悖论可是非常严重的事！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:26:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 84 08}{F5 C1 03 01 01 01 01 01 04 01}咦，是这样吗？\n那就没办法了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:27:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞顺平、风花和真田一边想象着\n　两年后的世界，一边离开了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:28:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 02 01 01 01 04 01}{F5 86 05 01 0D 01 04 01 02 01}{F5 61 02 01 01 01 01 01 83 03}{F5 C1 03 01 01 01 01 01 0B 01}呼……\n我说雪子！\n你怎么能撒那种谎啊！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:29:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7E 04}{F5 C1 03 01 01 01 01 01 0A 01}对、对不起……\n看着风花的样子，\n就忍不住想说点什么让她高兴……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:29:1",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不过，毕竟是撒谎，\n是不是该去道歉啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:30:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 3E 06}不，正如我所说，\n也不完全是谎话。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:31:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0A 01 04 01 02 01}{F5 86 06 01 0B 01 01 01 04 01}{F5 61 02 01 01 01 01 01 26 04}{F5 C1 03 01 01 01 01 01 05 01}咦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:32:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}最近的新闻里，\n有家汽车厂商正在进行试验，\n准备让“飞行汽车”投入实际使用。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:33:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 6A 03}{F5 C1 03 01 01 01 01 01 01 01}真的！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:34:0",
  "message_id": "MSG_034",
