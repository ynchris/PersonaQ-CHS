 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:35:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}桐条集团，恐怖如斯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
