 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7D 03}{F5 C1 03 01 01 01 01 01 08 01}啊，这款手机好怀念！\n我初中时特别想要这一款！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_102.bf.json:4:0",
  "message_id": "MSG_004",
