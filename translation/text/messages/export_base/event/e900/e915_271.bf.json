 },
 {
  "key": "export_base/event/e900/e915_271.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 01 01}那么，向虎狼丸学习如何？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_271.bf.json:17:1",
