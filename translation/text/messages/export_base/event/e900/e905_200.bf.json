 {
  "key": "export_base/event/e900/e905_200.bf.json:6:0",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 08 01 05 01 01 01}{F5 61 02 01 01 01 01 01 A1 0D}活着……是什么？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_200.bf.json:6:1",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_200.bf.json:6:2",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……自从玲对我说出\n“你不是一个人”的那一刻起，\n我就找到了自己存在的意义。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_200.bf.json:6:3",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}陪伴在她身边。\n那就是我的职责……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_200.bf.json:6:4",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}既然如此，我是否也同样\n因玲而活着呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_200.bf.json:6:5",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_200.bf.json:6:6",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我……\n为什么要把玲关起来呢？\n{F2 23 00 00}{F1 21}"
 },
 {
