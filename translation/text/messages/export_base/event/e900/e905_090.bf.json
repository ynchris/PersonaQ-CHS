[
 {
  "key": "export_base/event/e900/e905_090.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２楼　节目走廊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞加入了正在参观校舍的伙伴们……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 4E 0A}不过，这所学校……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2C 06}有什么奇怪的地方吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 02 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}暗淡的墙壁、吱呀作响的地板……\n难以开关的门，还有古典的木质风格……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 0E 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……真是年代久远啊。\n简直体现了所谓\n“古老而美好的时代”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 AC 11}{F5 C1 03 01 01 01 01 01 05 01}……是吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}你想想。\n墙这么薄，隔壁教室的声音一清二楚。\n走廊对这么多学生来说也太窄了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}所有设施都很陈旧，\n既谈不上实用，也算不上卫生……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}即便在这样的环境下，\n当年的学生也仍在努力学习啊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:5:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 21 0A}{F5 C1 03 01 01 01 01 01 08 01}……真了不起。\n作为旧时代教育现场的资料，\n这里应该很有保存价值。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 66 03}{F5 C1 03 01 01 01 01 01 0A 01}那个……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 D5 0C}……喂，桐条。\n你稍微想象一下。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 04 01}如果这里和“现在的”八十神高中一样，\n他们听了会怎么想？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}呵……怎么可能。\n你说这是现代的高中？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:9:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 04 01}{F5 86 0E 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}里中。\n你们就读的八十神高中\n是什么样子的？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 11 01 05 01 01 01}{F5 61 02 01 01 01 01 01 C0 03}{F5 C1 03 01 01 01 01 01 0A 01}那个……就是这样啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 0A}{F5 C1 03 01 01 01 01 01 01 01}你说什么！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 DD 03}{F5 C1 04 01 01 01 01 01 04 01}哈哈……\n该说这就是八十神的水准吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 04 01}{F5 86 0E 01 02 01 01 01 02 01}{F5 86 09 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 3E 06}依我看，这里和我们所知道的\n八十神高中，也就是现实中的学校，\n几乎一样。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0C 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过没有二年四班就是了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 3C 06}嗯，除此之外，\n很多细节也不一样……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:15:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}但至少论老旧程度，\n应该不相上下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 06 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}这里说不定还更干净呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}怎么会……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AE 11}不是所有学校都有大企业撑腰，\n配着最新的设施。\n月光馆的条件太优越了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 28 0A}{F5 C1 03 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 02 01}是、是这样啊。\n我不知道的事还真多……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:19:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4E 0A}原来地方城市的学校是这样。\n虽然不算实用，\n但也有种古典的韵味。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:19:2",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}在这里，像善这样的学生\n倒是很相称呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 72 0D}叫我吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞善恰好从旁边经过……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 D1 06}善确实……该说很有粗犷的老派学生风格吧。\n这身打扮在都市里不太常见。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 09 01 04 01 07 01}{F5 61 02 01 01 01 01 01 01 01}这种角色，完二已经占了啦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 07 01}{F5 61 02 01 01 01 01 01 B0 11}{F5 C1 03 01 01 01 01 01 05 01}{F5 C1 04 01 01 01 01 01 02 01}老派？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:24:1",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……鸡排吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:25:0",
  "message_id": "SEL_024",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 02 01 01 01 01 01}没错{F5 47 02 01 03 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:25:1",
  "message_id": "SEL_024",
  "translation": "{F2 05 FF FF}{F1 41}不对啦{F5 47 02 01 03 01 05 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 09 01 04 01 07 01}{F5 61 02 01 01 01 01 01 64 03}{F5 C1 03 01 01 01 01 01 0A 01}别教他假的！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 B7 0D}{F5 C1 03 01 01 01 01 01 05 01}老……老年？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_090.bf.json:28:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 6E 11}{F5 C1 03 01 01 01 01 01 0A 01}怎么变得这么悲凉啊！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
