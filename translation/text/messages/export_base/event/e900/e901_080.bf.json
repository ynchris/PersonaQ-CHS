  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 60 0F}{F5 C1 03 01 01 01 01 01 05 01}……咦？\n您似乎带着一件稀有物品呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e901_080.bf.json:1:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}欢迎光……\n咦，您似乎带着一件稀有物品呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
