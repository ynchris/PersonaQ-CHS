  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}我是受姐姐委托，\n负责经营这里的迪奥多。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e901_080.bf.json:0:2",
