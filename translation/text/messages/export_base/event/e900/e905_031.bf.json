[
 {
  "key": "export_base/event/e900/e905_031.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２楼　节目走廊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞完二似乎遇上了什么难题……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 08 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 8A 05}{F5 C1 03 01 01 01 01 01 07 01}啊，得救了！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0B 01}我完全听不懂他们在说什么，\n快想想办法啊！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 EA 09}来得正好，{F1 81}。\n你应该也有兴趣。\n不想听听吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 0A}就是那只熊……\n他……不，“那东西”到底是什么？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}那身布偶装的性能……\n非同寻常。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 44 09}毕竟穿成那样，\n还能和我们拥有同等的战斗力。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 D5 0C}{F5 C1 03 01 01 01 01 01 0A 01}……带着狗的我们有资格说这个吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……看来，他们正在讨论\n　小熊的布偶装。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 4E 0A}也许，那是伪装成布偶装的\n特殊战斗服……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}是不是使用人工肌肉纤维，\n来辅助行动……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不，那应该是里面那个人的实力吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}就像相扑力士的脂肪下\n藏着强健的肌肉，他也拥有\n穿着布偶装仍不逊色的运动能力？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 02 01 01 01 04 01}{F5 86 0E 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}可“里面那个人”是个纤细的少年。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}假设他拥有强健的肌肉，\n那么脱掉布偶装战斗，\n应该能发挥更强的实力。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}但他并没有这么做……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:10:3",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这难道不正说明，\n那套熊形战斗服本身，\n才是战斗力的主要来源？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不，那不对……\n因为除了那个少年以外，\n似乎还有别人进去过。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 0A}{F5 C1 03 01 01 01 01 01 01 01}什么……是谁！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4F 09}{F5 C1 03 01 01 01 01 01 0A 01}玲……\n她说“又重又热，还不能吃东西”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 48 0A}{F5 C1 03 01 01 01 01 01 07 01}只是普通的布偶装……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……但玲没有人格面具能力。\n也可能只有拥有这种能力，\n才能发挥那套服装的性能。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}要谈可能性，也可以这样想。\n那只是普通的布偶装，\n同时又是隐藏某种东西的手段……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}没有笨蛋会把所有情报\n都暴露给敌人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4E 0A}面对会运用战术的对手，的确如此。\n但对阴影有这种必要吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}没有必要……“目前”没有。\n如果阴影也像我们一样，\n会不断进化呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}原来如此。\n虽然现阶段没看出这种倾向，\n但也应该做好预测……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 03 01 02 01 01 01 04 01}{F5 86 13 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 AE 11}{F5 C1 03 01 01 01 01 01 0A 01}从刚才起就一直这样。\n真是的，两个都是战斗笨蛋……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:20:0",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}确实{F5 47 02 01 03 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:20:1",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}真田不是笨蛋{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:20:2",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}美鹤不是笨蛋{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D5 0C}单独看，两个人都有可靠的地方……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:21:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}可一凑在一起，不知道怎么回事，\n一个钻牛角尖，一个爱斗气，\n就都显露出来了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:22:0",
  "message_id": "MSG_0212",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}嗯，这也是一种撒娇吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 D5 0C}{F5 C1 04 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0A 01}就是笨蛋啊。\n还是终极的那种。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:23:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}真不敢相信他成绩还很好。\n我还以为他脑子里\n除了蛋白质就装不下别的了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D5 0C}她也差不多吧。\n你觉得她是完美的学生会长吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:24:1",
  "message_id": "MSG_023",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……要是连你都这么想，\n倒也有点可怜她了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 02 01 01 01 02 01}{F5 86 08 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}……不过，桐条学姐和真田学长\n看起来都挺开心呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:25:1",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}尤其桐条学姐，\n我还以为她在迷宫里一直很烦躁呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 B2 0C}……也许吧。\n面对学弟学妹，\n总得摆出可靠学长学姐的样子。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:26:1",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我已经不去学校了，\n倒是无所谓。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 8A 05}{F5 C1 03 01 01 01 01 01 0B 01}果然是出勤天数不够吗！？\n那到底要去多少天才能升年级啊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:28:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 D5 0C}{F5 C1 03 01 01 01 01 01 04 01}我哪知道。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_031.bf.json:29:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞和伙伴们一起待了一会儿……\n{F2 23 00 00}{F1 21}{00}"
 }
]