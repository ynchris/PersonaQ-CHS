[
 {
  "key": "export_base/event/e900/e921_030.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}哎呀，来得正好。\n有个好消息要告诉你。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e921_030.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}这片不稳定的“夹缝之地”，\n最适合试验操纵人格面具的秘术……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e921_030.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}我改良了古老的秘术，\n创造出一种新的秘术。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e921_030.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}以人格面具为牺牲，\n促进其他人格面具成长的秘术……\n{F2 01 03 01}“献祭合体”{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e921_030.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}当然，作为祭品的人格面具\n会消失……\n没问题吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e921_030.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以在天鹅绒房间\n　进行{F2 01 03 01}“献祭合体”{F2 01 01 01}了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e921_030.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 07 01}对了，献祭某些人格面具时，\n似乎会{F2 01 03 01}留下一部分力量{F2 01 01 01}。\n就像临别的赠礼一样。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e921_030.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}那些东西似乎可以{F2 01 03 01}作为“素材”，\n加工成装备{F2 01 01 01}。\n拿到迪奥那里去吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e921_030.bf.json:3:0",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 04 01 01 01}{F5 61 02 01 01 01 01 01 09 01}呵呵，快让我试试\n这项新的秘术吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]