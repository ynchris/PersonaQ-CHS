  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 AB 0C}汪呜……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_221.bf.json:13:0",
