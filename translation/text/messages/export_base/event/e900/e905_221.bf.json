 },
 {
  "key": "export_base/event/e900/e905_221.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 04 01}{F5 86 11 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 20 0C}{F5 C1 03 01 01 01 01 01 08 01}打靶真好玩呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_221.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 5A 06}嗯，很适合在短时间里转换心情。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_221.bf.json:2:1",
