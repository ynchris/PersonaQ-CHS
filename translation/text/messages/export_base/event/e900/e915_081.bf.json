 },
 {
  "key": "export_base/event/e900/e915_081.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 6B 03}{F5 C1 03 01 01 01 01 01 04 01}唉……\n小虎好像一点都不怕鬼，\n真羡慕啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
