 },
 {
  "key": "export_base/event/e900/e915_131.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 CA 0A}但首先，还是得先解决\n眼前这个祭典的问题呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_131.bf.json:25:0",
