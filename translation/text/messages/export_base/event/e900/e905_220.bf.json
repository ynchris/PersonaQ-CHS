[
 {
  "key": "export_base/event/e900/e905_220.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞３楼　摊位街\n　“半生不熟厨房”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞在吃饭的伙伴们中间，\n　真田和荒垣正面对面站着……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 02 01 01 01 02 01}{F5 86 0D 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 BE 09}你……你真厉害啊！\n你会做的菜，\n比这里卖的还多吧！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}哦、哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:3:0",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 F5 0C}{F5 C1 03 01 01 01 01 01 0B 01}你、你不也很厉害吗！\n对蛋白质和肌肉的了解，\n可不是一般的深。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 03 01 02 01 01 01 04 01}{F5 86 0F 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 48 0B}队长，快看！\n他们两个竟然\n像这样互相夸奖……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:5:0",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}有点诡异{F5 47 02 01 03 01 0B 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:5:1",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}吃了什么奇怪的东西？{F5 47 02 01 03 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 13 07}他们可真够勉强的熊。\n两个人脸都僵了熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2B 07}你也这么想吧？\n可没想到吧，\n这是他们自愿的熊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:7:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不过，看起来确实很勉强。\n两个人脸都僵了熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0D 01 02 01 01 01 04 01}{F5 86 13 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}你看，你那个……\n明明力气大，动作还挺敏捷。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:8:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}开始喝生鸡蛋时，我还以为\n你连脑子都变成肌肉了。\n没想到生鸡蛋还真厉害啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……真、真次郎才是。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0B 01}明明长相和举止都像不良少年，\n却毫不犹豫地\n牵着老奶奶过马路！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 04 01 02 01 01 01 02 01}{F5 86 02 01 0D 01 01 01 04 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 01 01}当面说出彼此的优点，\n可不是件容易的事。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:10:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 38 01}果然是那次敞开心扉\n好好谈过的成果啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 E7 02}{F5 C1 03 01 01 01 01 01 0A 01}……不，硬要说的话，\n这只是平时吵架的变种吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 13 01 02 01 01 01 02 01}{F5 86 0D 01 01 01 07 01 04 01}{F5 61 02 01 01 01 01 01 65 09}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 03 01}喂，真次郎！\n从刚才起你到底是在夸我还是损我，\n给我说清楚！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:12:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 02 01 01 01 01 01 02 01}你该不会觉得\n我就等于肌肉吧！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 06 01 01 01}{F5 61 02 01 01 01 01 01 FF 0C}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 03 01}你说什么！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:13:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 02 01 01 01 01 01 02 01}我也已经绞尽脑汁了！\n谁让你平时只会\n炫耀肌肉啊！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:13:2",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 02 01 01 01 01 01 02 01}你才是，什么长相举止像不良少年！？\n每句话都要挑刺，\n你是爱管闲事的小姑子吗！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 8A 11}哼，正合我意！\n只说表面话，\n果然不适合我们。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:14:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}就让拳头说话吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0B 01 01 01 05 01}{F5 61 02 01 01 01 01 01 CE 0A}{F5 C1 03 01 01 01 01 01 0B 01}等、等一下，不行！\n得好好谈谈，解决问题才行……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 63 07}你们两个！\n不要为了小熊争斗熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 A6 11}一边去，臭熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0B 01 01 01 05 01}{F5 86 0D 01 01 01 07 01 04 01}{F5 61 02 01 01 01 01 01 01 01}这是我们之间的问题。\n退后！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 02 01 02 01 01 01 04 01}{F5 86 04 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 A7 02}{F5 C1 03 01 01 01 01 01 0A 01}唉……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 01 01}这是在坦率地\n向彼此表达心情。\n不是挺好吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 BA 02}哈哈，要是这里是河滩就完美了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 03 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 01 01}我们也打一场？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 A0 02}{F5 C1 03 01 01 01 01 01 04 01}开什么玩笑！\n你拳头太重，我才不要。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 EC 0C}喂，你们几个也别\n一脸事不关己的样子。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 66 11}{F5 C1 03 01 01 01 01 01 07 01}糟，矛头指过来了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 D2 09}我们已经决定，\n要彻底碰撞彼此的心意。\n好，来吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0B 01 01 01 02 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 24 01}……强制参加？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:28:0",
  "message_id": "SEL_027",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 02 01 01 01 01 01}来就来！{F5 47 02 01 03 01 0D 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:28:1",
  "message_id": "SEL_027",
  "translation": "{F2 05 FF FF}{F1 41}随便陪他们玩玩吧……{F5 47 02 01 03 01 0B 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:29:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0A 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0B 07}{F5 C1 02 01 01 01 01 01 02 01}好，比赛开始了！\n拳与拳的肢体语言！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:29:1",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 02 01 01 01 01 01 02 01}男人之间爱与友情的殊死战，\n谁能站到最后！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:29:2",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 02 01 01 01 01 01 02 01}准备——开打！！！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:30:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 11 0B}{F5 C1 03 01 01 01 01 01 0A 01}这样不就和平时一样……\n不，可能更糟了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:31:0",
  "message_id": "MSG_0292",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 04 01}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 07 01}啊，善！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:32:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 07 01 01 01}{F5 61 02 01 01 01 01 01 A7 0D}……呵呵。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:33:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}大家都在笑……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:34:0",
  "message_id": "MSG_0312",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 CA 0A}{F5 C1 03 01 01 01 01 01 0A 01}这样……也可以吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_220.bf.json:35:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞和伙伴们一起待了一会儿……\n{F2 23 00 00}{F1 21}{00}"
 }
