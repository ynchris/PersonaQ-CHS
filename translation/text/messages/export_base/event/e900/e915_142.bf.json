[
 {
  "key": "export_base/event/e900/e915_142.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２楼　节目走廊\n　“阿坎纳电影节”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞千枝和雪子正看着\n　拳击电影的海报聊着天……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 02 01}{F5 86 06 01 05 01 05 01 04 01}{F5 61 02 01 01 01 01 01 3D 04}这部电影真感人。\n尤其是主角举起冠军腰带，\n大声喊出女主角名字的时候……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7F 03}就是就是！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}被逼到拳台边缘，\n却仍然准确躲开对手的拳头，\n然后使出必杀的右直拳！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7D 03}{F5 C1 03 01 01 01 01 01 08 01}正所谓如蝴蝶般飞舞，\n如蜜蜂般出击！\n啊，真让人热血沸腾～！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我也想打出那样的一拳啊～！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}拳击的话，说不定可以\n请真田先生教你呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 99 03}{F5 C1 03 01 01 01 01 01 07 01}啊，对哦！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 13 01 02 01 01 01 04 01}{F5 86 0D 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 8F 11}在吵什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞真田和荒垣走了过来……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 08 01}来得正好！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:8:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 02 01 01 01 02 01}{F5 86 05 01 11 01 05 01 04 01}{F5 61 02 01 01 01 01 01 66 03}其、其实，我觉得拳击\n特别帅气……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 09}哦，你也想开始练吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:10:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 04 01}{F5 86 0D 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}首先是架势。\n收紧腋下，双手轻轻握拳。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:10:1",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}下半身很重要。\n腿部如果过于用力，\n反而更容易被打乱架势。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:10:2",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}既要随时能踏进对手的近身范围，\n也要能化解对方的力量。\n膝盖要一直保持微微弯曲。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:11:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 07 01}是、是！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 13 01 02 01 01 01 02 01}{F5 86 06 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 3D 04}呵呵，感觉就像师父和徒弟呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}是个麻烦的师父就是了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞真田和千枝开始沿走廊奔跑……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 EC 03}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 04 01 01 01 01 01 03 01}呀呀呀——！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 64 09}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 08 01}{F5 C1 04 01 01 01 01 01 03 01}很好，就是这样！\n对，再快一点！！\n再强一点！！再热血一点！！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:17:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 D5 0C}{F5 C1 03 01 01 01 01 01 0A 01}唉……\n那家伙是想开武馆吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:18:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 09 01 03 01 01 01}{F5 61 02 01 01 01 01 01 3B 04}真田学堂和他的门生……呵呵。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:19:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，这阵子，\n阿明确实也受到了不少好的刺激。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:19:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}他可是很佩服里中的腿力。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:20:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}真田先生吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:21:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}功夫和拳击不同，\n会用到腿嘛。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:21:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 E7 0C}观察不同的招式，\n把优点吸收过来，\n对他来说也是训练的一部分吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:22:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 4E 09}{F5 C1 04 01 01 01 01 01 03 01}好，先到这里吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:23:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞真田和千枝回来了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:24:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}消耗大量能量，\n流了很多汗之后，该做什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:25:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}补充水分！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:26:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 2B 09}没错。\n不过，这时只喝普通的水可不行。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:26:1",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}必须像运动饮料一样，\n能同时补充盐分，\n否则水分几乎无法被吸收。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:26:2",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}如果没有运动饮料，\n也可以用水、食盐，\n再挤一点柠檬汁，自己调制。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:27:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4A 03}明白！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:28:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 64 09}最后当然是蛋白粉。\n一杯加三大匙，就是黄金比例。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:29:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4A 03}明白！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:30:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 AE 11}{F5 C1 03 01 01 01 01 01 0A 01}别什么都明白啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:31:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，我喝过蛋白粉，\n味道挺好的哦？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:31:1",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}平时喝味道很微妙，\n但像现在这样运动完、口干舌燥时，\n喝起来就特别好喝！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:31:2",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7D 03}就像水滋润了沙漠一样！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:32:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 02 01 02 01 01 01 04 01}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 90 11}那是只有真正的斗士才能品味的美味。\n{F5 C1 0D 01 01 01 01 01 01 01}，你下次也喝一杯吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:33:0",
  "message_id": "SEL_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}还是算了{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:33:1",
  "message_id": "SEL_031",
  "translation": "{F2 05 FF FF}{F1 41}我早就经常喝了{F5 47 02 01 02 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:34:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4F 09}{F5 C1 03 01 01 01 01 01 04 01}这样啊……\n我还以为你能理解\n它的美味呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:35:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 8E 11}{F5 C1 03 01 01 01 01 01 07 01}什……\n原来从你身上感受到的气场，\n是因为这个……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:36:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 61 06 01 01 01 01 01 13 02}{F5 C1 04 01 01 01 01 01 03 01}咕噜噜噜噜……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:37:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:37:1",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞好像听到了\n　野兽低吼般的声音……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:38:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 09 01 01 01 04 01}{F5 61 02 01 01 01 01 01 66 03}{F5 C1 03 01 01 01 01 01 0B 01}呜……\n这、这也没办法嘛！\n我肚子饿了啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:39:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}这是健康的证明。\n肌肉每天都在不断更新。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:39:1",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 64 09}那么，正式去补充营养吧。\n肉，去吃肉！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e915_142.bf.json:40:0",
