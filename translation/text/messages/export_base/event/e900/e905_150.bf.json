 },
 {
  "key": "export_base/event/e900/e905_150.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 C6 07}小虎……\n为什么学长学姐们\n什么都不肯告诉我们呢……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e900/e905_150.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我们就那么不可靠吗……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_150.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 DE 04}直接把这句话告诉他们，不就好了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_150.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞理世、阳介和小熊从摊位后走了出来……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_150.bf.json:6:0",
  "message_id": "MSG_006",
