 {
  "key": "export_base/event/e900/e905_271.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 19 07}那次也很好玩熊！\n只是蛋包饭难吃而已。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e900/e905_271.bf.json:9:0",
