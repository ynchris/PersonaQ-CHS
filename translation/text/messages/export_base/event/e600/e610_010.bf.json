[
 {
  "key": "export_base/event/e600/e610_010.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}各位，辛苦了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}出口的门已经打开。\n准备好后，随时可以进入。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 04 01}准备……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 15 01 02 01 01 01 05 01}{F5 86 29 01 10 01 10 01 02 01}{F5 86 07 01 05 01 02 01 04 01}{F5 61 02 01 01 01 01 01 05 01}……还没好吧！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}我们还没玩个够呢！\n留下的回忆还不够多嘛。\n对吧，玲、善？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0F 01 10 01 01 01}{F5 61 02 01 01 01 01 01 07 01}咦……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 08 01}那么，就让出口\n再维持一会儿吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 13 01 01 01}{F5 61 02 01 01 01 01 01 09 01}……嗯，谢谢！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:6:0",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 10 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}那个，我想，嗯……\n和大家一起走走。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:6:1",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 11 01 10 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}想和大家一起逛逛学校。\n……不行吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}当然可以啊！\n其实我也有想进去玩的项目！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 05 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0D 01}啊，理世还没进去过啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}对呀，我一直\n待在天鹅绒房间里嘛！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}阴影好像也已经消失了，\n我也想和大家一起进去看看。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:10:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 02 01}{F5 86 07 01 05 01 02 01 04 01}{F5 61 02 01 01 01 01 01 10 01}啊，学长还记得吗？\n说好我们两个一起逛鬼屋的！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:11:0",
  "message_id": "SEL_TALK009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 02 01}记得{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:11:1",
  "message_id": "SEL_TALK009",
  "translation": "{F2 05 FF FF}{F1 41}有这回事？{F5 47 02 01 02 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 11 01}好好好，说好了“大家一起”逛哦。\n那赶紧出发吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_010.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 04 01}啊，真是的！\n{F2 23 00 00}{F1 21}{00}"
 }
