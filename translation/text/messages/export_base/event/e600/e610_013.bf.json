[
 {
  "key": "export_base/event/e600/e610_013.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞屋顶的美食广场……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 06 01 04 01}{F5 61 02 01 01 01 01 01 02 01}唉，这是最后一顿了啊……\n这里的御好烧、炒面、章鱼烧\n还有冰淇淋……都好好吃啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0B 01 02 01 02 01}{F5 61 02 01 01 01 01 01 03 01}咦？\n这次不提肉了吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}千枝一直说，\n害我连肉的部位名称都记住了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}上了堂没用的课啊。\n……不过我也对蛋白粉的种类\n变得熟悉了不少。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 04 01}什么大豆、牛奶的，吵个不停。\n……真是的，不好意思，\n就原谅他吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0F 01 03 01 01 01}{F5 61 02 01 01 01 01 01 07 01}小垣太宠小明了熊。\n越宠他就越得寸进尺，\n要注意哦熊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 08 01}数据显示，小熊每天\n都会向阳介讨要冰淇淋。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}这就是所谓的“只说别人武士”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 03 01 01 01 01 01 07 01}哦，小埃，\n你已经很会用武士这个梗了嘛！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 0A 01}武、武士……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 29 01 09 01 10 01 02 01}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 08 01}预备，只说别人武士！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0F 01 07 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 03 01 01 01 01 01 05 01}……这样吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 07 01}厉害，还带创新的！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 13 01 07 01 02 01}{F5 61 02 01 01 01 01 01 0F 01}……噗。\n好、好土……！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 05 01 06 01 05 01}{F5 61 02 01 01 01 01 01 10 01}不能笑啦……噗噗噗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 02 01 02 01 01 01 04 01}{F5 86 04 01 07 01 02 01 02 01}{F5 61 02 01 01 01 01 01 11 01}哈哈哈。\n怎么说呢，终于有了实感……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}……结束了啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:15:0",
  "message_id": "SEL_TALK015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 01 01}辛苦了{F5 47 02 01 02 01 07 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:15:1",
  "message_id": "SEL_TALK015",
  "translation": "{F2 05 FF FF}{F1 41}大家一起回去吧{F5 47 02 01 02 01 07 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 13 01}你也是啊。\n不如说，最辛苦的就是你了。\n要带领那么多新的伙伴。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:17:0",
  "message_id": "MSG_0162",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 04 01 01 01 01 01 02 01}或许非你不可。\n换成别人，可能就救不了\n善和玲了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:17:1",
  "message_id": "MSG_0162",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 04 01 01 01 01 01 02 01}虽然很辛苦……不过真好啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 07 01 01 01}{F5 61 02 01 01 01 01 01 16 01}嗯……是啊。\n虽然和好不容易认识的伙伴分别，\n挺寂寞的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:19:0",
  "message_id": "MSG_0172",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}{F5 86 04 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 17 01}一定……还会见面的吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:20:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞大家逛遍了文化祭的每个角落，\n　尽情享受了漫长而快乐的时光……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e610_013.bf.json:21:0",
  "message_id": "MSG_0182",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞然后……\n{F2 23 00 00}{F1 21}{00}"
 }
]