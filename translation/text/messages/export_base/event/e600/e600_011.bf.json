[
 {
  "key": "export_base/event/e600/e600_011.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“联谊咖啡厅”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞天鹅绒房间的住民们也加入进来，\n　大家一起到这里参观……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 02 01}看来，阴影果然已经\n消失得无影无踪了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 03 01}……现在是否可以举办\n所谓的“联谊”了呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 0A 01}啊，原来你想参加啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 05 01}是的，据小熊大人教导，\n为了找到命中注定的另一半，\n会展开一场壮烈的较量……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:4:0",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 06 01 01 01}{F5 61 02 01 01 01 01 01 06 01}身为男子汉的一员，\n面对如此重大的决胜之机，\n我岂有不挺身参加的道理。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 08 01 07 01}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 03 01 01 01 01 01 04 01}小熊那家伙，\n又在教些没用的东西……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 02 01}{F5 86 05 01 02 01 01 01 07 01}{F5 86 0B 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 08 01}那就办场联谊呗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:6:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 09 01}顺平、真田学长、荒垣学长、\n天田、队长、迪奥先生。\n３对３，人数正合适啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 03 01 01 01 01 01 0A 01}我、我的命定之人就在这之中！？\n实在……不太像啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 08 01 02 01 01 01 02 01}{F5 86 04 01 03 01 05 01 04 01}{F5 61 02 01 01 01 01 01 0B 01}完二！机会来了！\n快混进去啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0C 01}好嘞！看我用魅力\n把他们一个个拿下！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 03 01 01 01 01 01 03 01}这梗到底还要玩几次啊！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 09 01 12 01 02 01 04 01}{F5 61 02 01 01 01 01 01 0E 01}那个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:10:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}我一直有些在意，这里究竟和\n学长们在文化祭举办的\n“联谊咖啡厅”有没有关系呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:10:2",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}除了名字，似乎没有相像之处……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 11 01}要说有，也算有。\n这些事物由玲的思念构成。\n大概是遇见你们后，发生了变化。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 05 01}变化……？\n说起来，这里为什么\n会举办文化祭啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 13 01}是为了镇魂的仪式……对吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}没错。\n为了不让玲悲伤，\n我在封印能力前做了些调整。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:14:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 15 01}以玲的记忆与想象为基础，\n将这个世界布置成了“祭典”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 16 01}所以才是祭典……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:15:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}……不过祭典的风格相当特别，\n这也是发生变化的结果吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 18 01}与你们相遇，\n玲大人的记忆和想象随之改变。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}正因如此，世界也改变了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 1A 01}善说过……\n相遇会带来改变。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1B 01}无论自己，还是自己的世界……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 03 01 02 01 01 01 04 01}{F5 86 29 01 11 01 10 01 02 01}{F5 61 02 01 01 01 01 01 1C 01}那个……\n大家玩得开心吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:19:0",
  "message_id": "SEL_TALK018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}托你的福{F5 47 02 01 03 01 07 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:19:1",
  "message_id": "SEL_TALK018",
  "translation": "{F2 05 FF FF}{F1 41}可辛苦了{F5 47 02 01 03 01 07 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:19:2",
  "message_id": "SEL_TALK018",
  "translation": "{F2 05 FF FF}{F1 41}现在也很开心{F5 47 02 01 03 01 07 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 05 01 10 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}太好了……\n虽然把大家卷进这么多事，\n但大家也收获了快乐呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 0E 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}是啊。\n对不起，都是因为我……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 1F 01}嗯，现在就说结束还太早呢。\n我们再去别处逛逛吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 13 01 01 01}{F5 61 02 01 01 01 01 01 20 01}嗯……谢谢！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 05 01 02 01 01 01 02 01}{F5 86 0A 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 21 01}{F5 C1 03 01 01 01 01 01 08 01}那么接下来……\n去小千枝最喜欢的地方～！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e600/e600_011.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 22 01}{F5 C1 03 01 01 01 01 01 0A 01}呃，怎么想都只有不祥的预感！\n{F2 23 00 00}{F1 21}{00}"
 }
]