 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:29:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 02 01 01 01 07 01}{F5 86 03 01 02 01 01 01 04 01}{F5 86 11 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2F 01}走吧。\n回去后，还有派对等着我们呢！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
