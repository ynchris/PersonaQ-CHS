 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:22:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 11 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:22:1",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0A 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}离开这里以后……\n我有个想好好谈谈的人。\n{F2 23 00 00}{F1 21}"
 },
 {
