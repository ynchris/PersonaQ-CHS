 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:22:3",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 21 01}可由加莉也说过，\n不好好和对方沟通，\n就不会明白。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:23:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 22 01}……大家来到这里后，\n似乎都变了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:23:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 23 01}不再一味回避冲突，\n而是通过碰撞试着理解彼此……\n试着成长。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:23:2",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 24 01}改变……就是成长吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:24:0",
  "message_id": "SEL_TALK022",
