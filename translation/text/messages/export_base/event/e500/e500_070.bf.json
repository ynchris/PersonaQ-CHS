 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:24:1",
  "message_id": "SEL_TALK022",
  "translation": "{F2 05 FF FF}{F1 41}你也想改变吗？{F5 47 02 01 03 01 07 01 04 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:25:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 09 01 04 01 07 01}{F5 61 02 01 01 01 01 01 25 01}我……曾在玲小姐身上\n感受到“什么”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:25:1",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 26 01}是别人没有的……某种光芒……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:25:2",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 27 01}那一定是，\n对生命无法抑制的憧憬……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:25:3",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 28 01}我想，我从玲小姐身上，\n比任何人都更强烈地感受到了它。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:25:4",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 29 01}所以，我才在意她……\n想为她做些什么……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:25:5",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2A 01}一定是因为，她和我……一样。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:25:6",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 09 01 04 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}……{F1 82}先生。\n身为机械的我，不会改变……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:25:7",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2C 01}但如果改变就是成长，\n我也想像大家一样改变。\n想不断地改变……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:26:0",
  "message_id": "SEL_TALK024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 08 01 04 01 01 01}一定能改变{F5 47 02 01 03 01 03 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:26:1",
  "message_id": "SEL_TALK024",
  "translation": "{F2 05 FF FF}{F1 41}大家一起成长吧{F5 47 02 01 03 01 03 01 05 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:26:2",
  "message_id": "SEL_TALK024",
  "translation": "{F2 05 FF FF}{F1 41}请人帮你改装吧{F5 47 02 01 03 01 03 01 05 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:27:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2D 01}{F5 C1 04 01 01 01 01 01 07 01}……是。\n谢谢您。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_070.bf.json:28:0",
