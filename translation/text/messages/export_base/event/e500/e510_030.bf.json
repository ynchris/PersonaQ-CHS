[
 {
  "key": "export_base/event/e500/e510_030.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞听到了像是锁链的声音……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 07 01}这是……“收割者”！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 03 01 01 01 01 01 0B 01}呃……\n就是那个强得离谱的家伙？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}为什么……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}……原来如此，我也不过是\n世界中的一枚齿轮。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}所以，这个世界才会将我……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 07 01}哎，哎，什么意思？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}世界存在所谓的法则……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}是维持均衡的力量……\n即使柯罗诺斯，也受其支配。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}我把自己关在这里，封印了力量。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:7:0",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}也就是说，应当回归的生命……\n玲的灵魂，\n没有回到应在的地方。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:7:1",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}这样均衡就会崩溃。\n均衡一旦崩溃，\n最终会导致世界毁灭……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:8:0",
  "message_id": "MSG_0063",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}所以……在那之前，本应被封印的\n柯罗诺斯，\n就注定要苏醒吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:8:1",
  "message_id": "MSG_0063",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0E 01}从我把自己关进这里时，\n倒计时就已经开始了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:8:2",
  "message_id": "MSG_0063",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}而现在就是时限……\n这片夹缝之地消灭的时刻。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:9:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 10 01}哦，消灭啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:10:0",
  "message_id": "MSG_007a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 03 01}{F5 86 0C 01 0C 01 03 01 01 01}{F5 61 02 01 01 01 01 01 11 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:10:1",
  "message_id": "MSG_007a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 01 01}咦，等等，那我们怎么办？\n你呢？玲呢！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:11:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 11 01 05 01 01 01}{F5 61 02 01 01 01 01 01 13 01}……消失。\n存在，还有一切。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:11:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}就像拖延的代价，你们和玲，\n都会变成从一开始就“不曾存在”……\n以此使一切重新吻合。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:11:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}将不会有任何人，\n记得你们曾经“存在”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:12:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 01 01 01 01 01 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 16 01}从一开始……就不曾存在？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:13:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 17 01}是的……你们，\n会变成一开始就“不曾出生”……\n就是这样……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:14:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0B 01 01 01 07 01}{F5 61 02 01 01 01 01 01 18 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}……哈！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:15:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 19 01}现在还来得及。\n你们回头，\n从那扇门回去吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:15:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}这样一来……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:16:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 02 01 01 01 07 01}{F5 86 11 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 1B 01}……就算我们平安无事，\n玲又会怎样呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:16:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}她说想要活过的意义，\n却连活过这件事都消失的话……\n也太可怜了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:17:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}可是……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:18:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 0D 01 01 01 01 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 1E 01}被封印的柯罗诺斯醒来后，\n会发生什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:19:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}会把我吸收进去吧。\n恢复成原本“完整的柯罗诺斯”，\n打算把玲和这里一起抹去……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:19:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}为了引我前往柯罗诺斯所在的时钟塔，\n才用蜘蛛把玲\n悬在了上面……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:20:0",
  "message_id": "MSG_0162",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 21 01}那只蜘蛛并不是学校里的阴影，\n而是柯罗诺斯的手下……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:20:1",
  "message_id": "MSG_0162",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 15 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 22 01}而你们，也是……诱饵……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:21:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 01 01 01 01 01 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 23 01}诱饵……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:22:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 24 01}是柯罗诺斯……正是柯罗诺斯，\n把你们从原来的世界召来的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:22:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}为了恢复我的记忆……\n为了让你们走遍迷宫……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:22:2",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 26 01}是柯罗诺斯选中了\n有能力做到这些的你们……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:23:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 27 01}原来如此。\n我们老老实实地，\n尽到了棋子的职责。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:23:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 28 01}……但现在，你还是棋子吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:24:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 05 01 01 01}{F5 61 02 01 01 01 01 01 29 01}咦……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:25:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}我们现在和你一起\n前往柯罗诺斯那里，\n也在他的计划之内吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:26:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}不……应该不是。\n恢复记忆后的我，\n本应把玲和这个世界一起消除……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:27:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0D 01 01 01 01 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 2C 01}可是，你并没有这么做吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:28:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 2D 01}嗯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:29:0",
  "message_id": "SEL_TALK025",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 02 01 02 01 01 01 01 01}为什么？{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:29:1",
  "message_id": "SEL_TALK025",
  "translation": "{F2 05 FF FF}{F1 41}善已经变了{F5 47 02 01 02 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:30:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}为什么……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:31:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}变了……我吗……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:32:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0D 01 01 01 07 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 30 01}你已经改变了。\n或许，你自己\n还没意识到。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:32:1",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}{F5 61 02 01 01 01 01 01 31 01}{F5 C1 04 01 01 01 01 01 07 01}光是这一点，\n就已经打乱了柯罗诺斯的计划。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:33:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 04 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 32 01}那种家伙，\n少在那里摆神的架子。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:34:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 33 01}虽然不太明白，\n总之把那家伙打倒就行了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:35:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 34 01}{F5 C1 04 01 01 01 01 01 04 01}没错。\n这里可没有退缩这个选项。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:36:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 35 01}{F5 C1 04 01 01 01 01 01 02 01}大家……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:37:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 06 01 06 01 05 01 01 01}{F5 61 02 01 01 01 01 01 36 01}来到这里是某个人的阴谋也好，\n是出于什么算计也好，都无所谓。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:37:1",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 37 01}我很高兴能来到这里。\n因为结识了好多好多伙伴。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:38:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 38 01}就是啊！\n都这个时候了，\n善就别再自责了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:39:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 09 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 39 01}善……\n你该做的事情没有变。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:39:1",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3A 01}请好好和玲谈一谈。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:40:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 05 01 01 01}{F5 61 02 01 01 01 01 01 3B 01}……嗯。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:41:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0E 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 3C 01}好……走吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_030.bf.json:42:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3D 01}呀呼！\n看小熊的必杀猫拳\n教训他一顿熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
