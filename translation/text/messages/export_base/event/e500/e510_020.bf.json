  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 04 01 01 01 01 01 03 01}大家，对不起……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 03 01}善，对不起……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:1:3",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 04 01 01 01 01 01 03 01}都怪我太任性……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞声音消失了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 11 01 03 01 04 01}{F5 61 02 01 01 01 01 01 06 01}小玲……\n她很痛苦熊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 07 01}活过的意义……\n究竟谁能拥有呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 08 01}……为什么需要理由？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}现在活着，身处此地。\n那是一种现象。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}无论有没有意义，\n都没有关系……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 04 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 04 01}嗯……\n也许确实如此，可是……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}……我原本这么想。\n直到遇见玲。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:8:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 02 01 01 01 02 01}{F5 86 15 01 01 01 05 01 04 01}{F5 61 02 01 01 01 01 01 0D 01}现在，我还不明白……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0E 01}不是有没有意义的问题。\n而是“想要”啊……\n想要自己可以存在的意义。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}可以……存在？\n想得到谁的许可，才得以存在吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 05 01 02 01}{F5 61 02 01 01 01 01 01 10 01}一定是想得到“某个人”的认可。\n如果可以，最好是自己珍视的人……吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}为什么？\n既然已经活着，\n应该不需要任何人的许可。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:13:0",
  "message_id": "SEL_TALK012",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 02 01 02 01 01 01 02 01}即便如此也想被人认可{F5 47 02 01 02 01 0D 01 01 01}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:13:1",
  "message_id": "SEL_TALK012",
  "translation": "{F2 05 FF FF}{F1 41}没有谁是独自活着的{F5 47 02 01 02 01 0D 01 01 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}想要……被人认可……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}并不是……独自活着……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 05 01}{F5 86 04 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 14 01}互相支持、互相协助、\n互相鼓励……我们不就是这样\n过着每一天的吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 04 01}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 04 01 01 01 01 01 02 01}在痛苦、寂寞、快撑不住的时候，\n因为心中会浮现某个人的脸庞，\n才能咬紧牙关坚持下去。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}是啊……\n因为珍视的人也在努力，\n才会觉得，自己也要加油。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}我想，没有谁\n是孤零零地活着的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 18 01}孤零零……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 2B 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}没事，我在这里哦。\n你不是一个人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_020.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 04 01 01 01 01 01 04 01}并不……孤单……\n{F2 23 00 00}{F1 21}{00}"
 }
]