[
 {
  "key": "export_base/event/e500/e500_090.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞时钟塔内的气氛变了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 05 01 65 01 02 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 07 01}队长，请等一下！\n上一层有巨大的反应！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}我想应该就是\n那个蜘蛛般的阴影！\n请小心！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}上面就是塔顶吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 14 01 02 01 02 01}{F5 61 02 01 01 01 01 01 05 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}怎么了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 04 01 01 01 01 01 02 01}我在想……该对玲说些什么。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 04 01 01 01 01 01 02 01}我能告诉她\n“活过的意义”吗……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 04 01 01 01 01 01 02 01}从未活过的我……\n能拥有正确的答案吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:6:0",
  "message_id": "SEL_TALK006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 02 01 01 01 01 01}“对不起”{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:6:1",
  "message_id": "SEL_TALK006",
  "translation": "{F2 05 FF FF}{F1 41}说什么都好{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:6:2",
  "message_id": "SEL_TALK006",
  "translation": "{F2 05 FF FF}{F1 41}取决于你自己{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}嗯，我会道歉。\n无论多少次……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}可是，仅仅这样……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 03 01 01 01 07 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 0C 01}……真笨啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 03 01 01 01 07 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 0D 01}嗯，就是这样。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 03 01 01 01 07 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 0E 01}是啊……\n这种事，哪有什么标准答案。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}{F5 86 02 01 0D 01 01 01 07 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 0F 01}只要用你自己的话说就好。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}她想要的不是漂亮话。\n一直陪在身边的善的话语，\n一定能传到玲的心里。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}我的……话语……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 09 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}重要的是，你愿意认真面对她。\n就是这种态度本身。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}哪怕话说得笨拙也没关系。\n语言表面的意思，\n根本不是问题。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}我……在这里看着你们，\n终于明白了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}活着，就是改变。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:15:0",
  "message_id": "MSG_0142",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}与他人的相遇，会改变自己……\n由加莉、美鹤、我，\n都是如此。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:15:1",
  "message_id": "MSG_0142",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 05 01 01 01}{F5 61 02 01 01 01 01 01 17 01}因为相遇，所以改变了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 18 01}嗯……是啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 19 01}哪怕微小的事，\n辗转相连也能汇成巨大的潮流。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}彼此相互影响，\n万物自然而然地变化……\n世界，就是如此。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:17:2",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}也就是说……活着，\n不只是自己的事。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:17:3",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}改变着周围，也被周围改变。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:17:4",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}所以……\n生命，绝不只属于一个人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 07 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}嗯……我也这么想。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}玲哭着说，想要活过的意义。\n我没能告诉她。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:19:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}但现在，我觉得……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:20:0",
  "message_id": "MSG_0182",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0B 01 05 01 01 01}{F5 61 02 01 01 01 01 01 21 01}玲曾经活过，这件事本身，\n就是玲活过的意义。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:20:1",
  "message_id": "MSG_0182",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 01}活着这件事本身，\n就是活着的人的使命……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:21:0",
  "message_id": "MSG_0183",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 15 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 23 01}……你怎么想？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:22:0",
  "message_id": "SEL_TALK019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}一定是这样{F5 47 02 01 03 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:22:1",
  "message_id": "SEL_TALK019",
  "translation": "{F2 05 FF FF}{F1 41}不知道{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:22:2",
  "message_id": "SEL_TALK019",
  "translation": "{F2 05 FF FF}{F1 41}我的想法不同{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:23:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 24 01}{F5 C1 04 01 01 01 01 01 02 01}这只是我的想法，\n并不是什么唯一的真理……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:23:1",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}{F5 C1 04 01 01 01 01 01 02 01}可如果你也有相同的想法，\n我就觉得自己仿佛得到了救赎……\n……这是为什么呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:23:2",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 05 01 07 01 01 01}{F5 61 02 01 01 01 01 01 26 01}我相信，\n每个人都有意义。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:24:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 27 01}{F5 C1 04 01 01 01 01 01 02 01}是吗……\n这只是我的想法。\n并不是什么唯一的真理。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:24:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 05 01 07 01 01 01}{F5 61 02 01 01 01 01 01 28 01}但我相信，\n每个人都有意义。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:25:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 29 01}你也改变了某个人。\n你让某个人活了下去。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:25:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}那正是你活过的意义……\n我是这样相信的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:25:2",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2B 01}……不过，你的意义，\n也不该由我擅自决定。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:26:0",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}……谢谢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:26:1",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2D 01}一定是我把你们召来的。\n不是作为柯罗诺斯的棋子，\n而是我召来的……我愿意这样相信。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:26:2",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 13 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}没遇见你们的话，我连自己软弱的心\n都不会察觉，更无法\n真正救赎玲。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:26:3",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0B 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}与你们相遇，是我的命运，\n也是我的救赎。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:27:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 30 01}你……变成真正的男子汉了啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_090.bf.json:28:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 31 01}男子汉……？\n虽然不太明白……不过，感觉不坏。\n{F2 23 00 00}{F1 21}{00}"
 }
]