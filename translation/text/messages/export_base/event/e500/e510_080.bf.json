 {
  "key": "export_base/event/e500/e510_080.bf.json:36:1",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2A 01}{F5 C1 04 01 01 01 01 01 04 01}我觉得，伙伴们\n会拉着我变得更好。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e510_080.bf.json:36:2",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}……所以，我也想成为\n能拉着大家前进的自己。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e510_080.bf.json:37:0",
