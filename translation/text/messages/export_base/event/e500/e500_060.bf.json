[
 {
  "key": "export_base/event/e500/e500_060.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞来到了一处稍显开阔的地方……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞正歇口气时，\n　顺平和由加莉过来搭话……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 0B 01 02 01 01 01 05 01}{F5 86 0C 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}学长学姐他们，好像有点变了。\n原本紧绷的脸，\n变得柔和了些……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}我以前觉得桐条学姐\n是无所不能的完美超人，\n可她也只是个女孩子啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:2:0",
  "message_id": "SEL_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}确实如此{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:2:1",
  "message_id": "SEL_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}都忘了这点{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:2:2",
  "message_id": "SEL_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}也有可爱的一面{F5 47 02 01 03 01 07 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}啊，你刚才的表情很顺平。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 0C 01 09 01 06 01 02 01}{F5 61 02 01 01 01 01 01 05 01}都说了，\n别把人当成一种分类啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}真是的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 02 01 01 01 05 01}{F5 86 0C 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 07 01}说实话，我自己也没主动\n试着接近桐条学姐他们……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}虽然只比我们大１岁，\n但他们背负的东西那么沉重，\n对我而言就像另一个世界……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}还没谈到互相理解，\n就因为不想踩到地雷，\n主动逃开了吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:5:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}仔细想想，我对他们\n其实什么都不了解。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}我也有自己\n单方面烦躁的地方。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}父亲的事……心情还很复杂。\n给自己套上了多余的偏见，\n擅自下结论……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}也许我根本没有\n真正看过学长学姐们……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:7:0",
  "message_id": "SEL_TALK007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}不坦诚相对就不会改变{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:7:1",
  "message_id": "SEL_TALK007",
  "translation": "{F2 05 FF FF}{F1 41}能察觉真好{F5 47 02 01 03 01 07 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}嗯，确实是这样。\n谢谢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}学长学姐们，也各自背负着\n使命和坚定的信念吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:8:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}我却说得像是“不说就不是伙伴，\n必须和我们分担”一样……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:8:3",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}可我之前，\n真的有认真试着倾听吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:8:4",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}不过，不好好说出来……\n不真正和对方面对面交流，\n就什么都不会改变呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 06 01 01 01}{F5 61 02 01 01 01 01 01 13 01}哎呀，由加莉，成熟的表情呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0B 01 07 01 01 01}{F5 61 02 01 01 01 01 01 14 01}真是的，别逗我了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:11:0",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 02 01}{F5 86 0B 01 07 01 07 01 05 01}{F5 61 02 01 01 01 01 01 15 01}……不过，顺平也教会了我一些事。\n队长也是……好多好多。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:11:1",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 16 01}还有理世、风花……\n是大家让我察觉到了。\n……必须好好感谢才行。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 03 01 66 01 01 01}{F5 61 02 01 01 01 01 01 17 01}哪里……我才是\n从由加莉身上学到了东西。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:12:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}谢谢你，由加莉……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 03 01 01 01 01 01 0B 01}总、总觉得好害羞。\n我才该说谢谢……呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}嗯，真是美好的友情啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 03 01 65 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}果然，能成为大家的伙伴，\n我非常开心！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 07 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}啊，真是的！\n越来越害羞了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:17:0",
  "message_id": "SEL_TALK016",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 02 01 01 01 01 01}为什么？{F5 47 02 01 03 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:17:1",
  "message_id": "SEL_TALK016",
  "translation": "{F2 05 FF FF}{F1 41}我也要说声谢谢{F5 47 02 01 03 01 07 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}{F5 C1 03 01 01 01 01 01 0B 01}等，你这么认真地问，\n不是显得我像个笨蛋嘛！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}{F5 C1 03 01 01 01 01 01 0B 01}都说了很害羞！\n怎么连你也这样，快停下啦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 11 01 04 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}那、那么，这个话题结束！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e500/e500_060.bf.json:20:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0F 01 07 01 01 01}{F5 61 02 01 01 01 01 01 20 01}好！\n大家快去救玲吧！\n{F2 23 00 00}{F1 21}{00}"
 }
]