[
 {
  "key": "export_base/event/e100/e100_280.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞宝箱里装着的，\n　似乎是一只兔子玩偶……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞脚上挂着一块姓名牌，\n　上面写着“NIKO”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 05 01}尼可……是这么念吗？\n是什么意思呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 05 01}{F5 86 29 01 0D 01 02 01 02 01}{F5 61 02 01 01 01 01 01 03 01}嗯……一定是笑脸的意思！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}啊，你是说跟“笑眯眯”的\n日语发音一样？\n会是这个意思吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}这兔子是上面迷宫里\n出现过的那只吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}……不过，颜色又不一样。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 07 01}说起来，我们也算是\n一路追着它才来到这里的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}善，玲。\n你们对这只兔子有印象吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 0B 01 01 01}{F5 61 02 01 01 01 01 01 09 01}不知道。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}这样啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 09 01 02 01 05 01}{F5 61 02 01 01 01 01 01 0B 01}我在哪里……见过这个……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 02 01 01 01 04 01}{F5 86 29 01 03 01 03 01 02 01}{F5 61 02 01 01 01 01 01 0C 01}……善？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 04 01 01 01 01 01 05 01}四座……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 04 01 01 01 01 01 05 01}这里有四座迷宫……\n里面……藏着什么东西……\n由“守卫”看守着……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 04 01 01 01 01 01 05 01}我在这里，有必须完成的事……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:10:3",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 04 01 01 01 01 01 05 01}使命……对，我曾经……有个使命……\n可是，却失去了……记忆……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}想起来了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}……不行。\n只有……这些……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 13 01}即便如此，也是进展。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}“守卫”是指刚才那种\n女王模样的阴影吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}嗯，没错……\n像那样强大的阴影，\n正守护着某些东西……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 16 01}是这只玩偶触发了\n记忆的恢复吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 17 01}大概……是的。\n碰到它的时候，感觉像是……\n有道裂缝打开了，记忆就浮现出来……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:16:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 18 01}……玲呢？\n有没有想起什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}都说了不知道……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 04 01 01 01 01 01 05 01}这样啊……\n那么，这只玩偶\n就由我保管吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 29 01 08 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 05 01}{F5 86 0E 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 1C 01}刚才那个女王模样的阴影，\n说过“不会让你离开这里”吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:21:0",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0E 01 0A 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:21:1",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0A 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}目前，可以这样推测……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:21:2",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}有“某个人”，\n“故意”把我们困在了这个世界……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:21:3",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}逃出去的线索，或许就在\n早已身处此地的善和玲\n被夺走的记忆之中……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:21:4",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 21 01}而只要探索剩下的“三座”迷宫，\n取得“守卫”看守的东西，\n似乎就能找回那些记忆……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 22 01}嗯……\n一定是那个“人”，\n把我的记忆藏进了迷宫……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:22:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 23 01}……可是，玲还没有恢复记忆。\n玲的记忆又被藏到哪里去了……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 13 01 02 01 04 01}{F5 61 02 01 01 01 01 01 24 01}{F5 C1 03 01 01 01 01 01 07 01}又是钟声……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 25 01}我们那边也响起过这个钟声。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 08 01 01 01 07 01}{F5 61 02 01 01 01 01 01 26 01}这钟声有什么含义吗……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 02 01 01 01 07 01}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0D 01 02 01 01 01 04 01}{F5 61 02 01 01 01 01 01 27 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:26:1",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 28 01}看来停了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 05 01 65 01 02 01}{F5 61 02 01 01 01 01 01 29 01}{F5 C1 02 01 01 01 01 01 02 01}不好了！！\n天鹅绒房间里“两扇门”上的锁，\n好像要打开了！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:28:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}{F5 C1 03 01 01 01 01 01 01 01}什么……！？\n山岸，详细说说！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:29:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}那个……天鹅绒房间里的\n“两扇门”上，\n不是挂着“四把锁”吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:29:1",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2C 01}就在刚才，其中“一把”\n似乎快要打开了……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:29:2",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2D 01}伊丽莎白小姐说，\n那“门”是用来连接不同空间的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:30:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 09 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}也就是说……那是“出口”？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:31:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}真如善所说的那样吗……！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:32:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 30 01}{F5 C1 03 01 01 01 01 01 0B 01}我、我也不清楚……\n总之，请大家先回来。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:33:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 31 01}四座迷宫，四把锁……\n你觉得这是巧合吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:34:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 32 01}不。\n这正符合你刚才的推测。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:34:1",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 33 01}探索迷宫，取得守卫看守的东西，\n锁就会打开，对吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:34:2",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 34 01}虽然还不清楚善的记忆\n与这件事有多大关系，但若能\n顺便找回记忆，要做的事也一样。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:34:3",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 35 01}如果我们的迷宫探索，\n妨碍了把我们困在这里的那个人，\n对方自然就会现身阻挠。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:34:4",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 36 01}到时候打倒对方就行。\n很简单。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:35:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0E 01 0A 01 02 01 01 01}{F5 61 02 01 01 01 01 01 37 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:36:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 38 01}{F5 C1 03 01 01 01 01 01 05 01}怎么了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:37:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 39 01}你偶尔也会说点\n像样的话嘛……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:38:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 3A 01}{F5 C1 03 01 01 01 01 01 07 01}我说的话一直都很像样！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:39:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3B 01}……是吗。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:39:1",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 02 01 01 01 02 01}{F5 86 0E 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 3C 01}好，那就回去吧。\n在这里久留也不安全。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_280.bf.json:40:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3D 01}我们先走一步。\n待会儿再慢慢聊。\n{F2 23 00 00}{F1 21}{00}"
 }
]