[
 {
  "key": "export_base/event/e100/e110_150.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞天鹅绒房间……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 04 01}{F5 61 02 01 01 01 01 01 02 01}说起来，这２扇门……\n很让人在意呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 03 01}嗯……因为上着锁，\n不知道通向哪里，\n但恐怕……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 04 01}恐怕？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}其中一扇，通向\n你们原来的地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 04 01 01 01 01 01 04 01}……也就是说，这就是出口？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 07 01}从其中一侧，能感觉到\n熟悉的气味和空气……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}不过……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 02 01 02 01 02 01}{F5 86 15 01 01 01 01 01 05 01}{F5 61 02 01 01 01 01 01 09 01}我也这么认为。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}善？是这样吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}为什么这么想？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}在你们来之前，\n连这间小屋本身都不存在……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}所以，这里是属于你们的地方……\n里面的门，也是属于你们的门……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}……我只是，有这种感觉。\n没有确切的证据……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:10:3",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}……忘了吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 09 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞直斗走近门，\n　试着转动了门把手……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 03 01 01 01 01 01 04 01}果然打不开……\n这样看来，现在\n只能先放着不管了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 12 01}……这里不会发生无意义的事。\n总有一天，\n它的作用会自然显现。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 04 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 13 01}话说回来，\n你们不是还有别的事要问？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:14:2",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}好像是无法获得\n新的人格面具的现象……对吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}哎呀，你听见了熊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 16 01}那位使用支援型人格面具的小姐，\n就在这个房间和你们通信。\n不想听也听得见。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}那个，不用理小熊，\n请继续说吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 18 01}只能先看看了。\n能请你坐到那里吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞按照玛格丽特的指示，\n　在沙发上坐下……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:19:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞雪子被安排坐在了自己身旁……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 19 01}这是塔罗牌。\n用来观测你们……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特在桌上\n　摊开了约２０张牌……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:22:0",
  "message_id": "MSG_0212",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞然后翻开了\n　{F1 82}面前的一张卡片……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}“塔”……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:23:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 23 01 02 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}那、那个……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}不，“塔”先不说。\n现在真正有意义的，\n是没有出现“愚者”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}{F5 C1 03 01 01 01 01 01 05 01}“愚者”……是什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 02 01 01 01 04 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1F 01}“愚者”的数字是０……\n象征“起始”与“无限可能”\n的阿尔卡那……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:27:1",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}正如其含义，{F1 82}大人\n能够自如地运用\n众多的人格面具。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:27:2",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 21 01}我们将这种能力\n称为……“不羁”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:28:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 22 01}不羁……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:29:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 23 01}不过，或许是受到这里的影响，\n原本的“不羁”之力，\n似乎改变了形态……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:30:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}{F5 86 23 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 24 01}属于你自身的“伊邪那岐”，\n在这里似乎无法卸下……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:31:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 25 01}属于你自身的“伊邪那岐大神”，\n在这里似乎无法卸下……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:32:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 01}那么，就是无法更换了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:33:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 27 01}不，“不羁”的力量\n并没有消失。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:33:1",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 28 01}真是“无限可能”……\n竟然会这样……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:34:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 29 01}哎，什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:35:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}在那个无法卸下的人格面具“之外”，\n似乎还能\n“再装备１个人格面具”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:35:1",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2B 01}而这“另１个”，\n可以自由召唤……\n也就是说，能够更换……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:36:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 07 01}{F5 61 02 01 01 01 01 01 2C 01}{F5 C1 03 01 01 01 01 01 01 01}也就是同时用２个！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:37:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2D 01}不过，可以更换的那１个\n无法发挥全部力量，\n应将它视为辅助。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:38:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 02 01 01 01 07 01}{F5 86 23 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2E 01}“伊邪那岐”是“主”，\n可以更换的人格面具是“副”……\n能够同时装备这２个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:38:1",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2F 01}如此理解即可。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:39:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 02 01 01 01 07 01}{F5 86 23 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 30 01}“伊邪那岐大神”是“主”，\n可以更换的人格面具是“副”……\n能够同时装备这２个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:39:1",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 31 01}如此理解即可。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:40:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 08 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 32 01}{F5 C1 03 01 01 01 01 01 0A 01}学长，太厉害了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:41:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 33 01}不，恐怕不止如此……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:42:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特再次在桌上\n　摊开了约２０张牌……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:43:0",
  "message_id": "MSG_0412",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞随后，翻开了\n　雪子面前的１张牌……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:44:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 05 01 03 01 01 01}{F5 61 02 01 01 01 01 01 34 01}“愚者”……\n果然如此……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:45:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 35 01}怎……怎么了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:46:0",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 36 01}你们所有人，都受到了\n“愚者”的加护……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:47:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 37 01}{F5 C1 03 01 01 01 01 01 05 01}所有人……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:48:0",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 38 01}以自身的人格面具为“主”，\n以能够更换的人格面具为“副”，\n同时装备……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:48:1",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 39 01}看来，你们所有人\n都能够做到。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:49:0",
  "message_id": "MSG_047",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3A 01}{F5 C1 03 01 01 01 01 01 0B 01}什……哎，真的？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:50:0",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 3B 01}但这样异常的现象……为什么……？\n仿佛“愚者”的力量增强了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:50:1",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3C 01}就像还有另一位\n拥有不羁之力的人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:50:2",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3D 01}难道，这２扇门中的另一扇……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:51:0",
  "message_id": "MSG_049",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3E 01}{F5 C1 03 01 01 01 01 01 07 01}哎？\n还有另一个不羁？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:52:0",
  "message_id": "MSG_050",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 3F 01}……啊，不，没什么。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:53:0",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 09 01 01 01}{F5 61 02 01 01 01 01 01 40 01}我和善也能拥有人格面具吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:54:0",
  "message_id": "MSG_052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 41 01}……失礼了。\n善大人和玲大人原本就没有\n人格面具，恐怕无法做到。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:55:0",
  "message_id": "MSG_053",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 0B 01 01 01}{F5 61 02 01 01 01 01 01 42 01}这样啊……\n人格面具明明很帅的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:56:0",
  "message_id": "MSG_054",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 43 01}善和玲为什么没有人格面具？\n可他们又能和阴影战斗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:57:0",
  "message_id": "MSG_055",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 44 01}……这恐怕与\n这个地方本身的谜团密切相关。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:57:1",
  "message_id": "MSG_055",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 45 01}这里是“夹缝之地”……\n如同在意识深处，\n静静漂浮的浮岛……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:57:2",
  "message_id": "MSG_055",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 46 01}原本，并不是有血有肉的人类\n会存在的地方。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:57:3",
  "message_id": "MSG_055",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 47 01}既然他们原本就在这里……\n例如，可能已经与人格面具、\n阴影之类的存在同化了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:58:0",
  "message_id": "MSG_056",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 48 01}{F5 C1 03 01 01 01 01 01 01 01}善他们是人格面具！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:59:0",
  "message_id": "MSG_057",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 49 01}只是举例而已……\n目前还无法得出\n任何确定的结论。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:59:1",
  "message_id": "MSG_057",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 04 01}{F5 61 02 01 01 01 01 01 4A 01}{F5 C1 04 01 01 01 01 01 02 01}那么，各位带着这个吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:60:0",
  "message_id": "MSG_058",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特拿出了\n　“空白卡片”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:61:0",
  "message_id": "MSG_059",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 4B 01}至今的战斗中，\n应该曾从阴影身上获得过吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:61:1",
  "message_id": "MSG_059",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 4C 01}空白，也就是尚未受到\n任何命运引导的状态……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:61:2",
  "message_id": "MSG_059",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 4D 01}原本只能召唤固有人格面具的各位，\n如今能够召唤\n各种各样的人格面具……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:61:3",
  "message_id": "MSG_059",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 4E 01}若命运如此期望，\n这些卡片自然也会开始\n发挥自己的作用……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:62:0",
  "message_id": "MSG_0592",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4F 01}请使用这些吧。\n新的人格面具卡片。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:63:0",
  "message_id": "MSG_060",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“空白卡片”分别\n　变成了不同的人格面具！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:64:0",
  "message_id": "MSG_061",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 51 01}……那么，还有疑问吗？\n我能说明的大致就是这些。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:65:0",
  "message_id": "MSG_062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 52 01}嗯，也就是说……\n搭档和我们处于相同的状态。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:65:1",
  "message_id": "MSG_062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 53 01}以自己的为“主”，\n以能够更换的人格面具为“副”，\n可以同时装备……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:65:2",
  "message_id": "MSG_062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 54 01}{F5 C1 03 01 01 01 01 01 0A 01}……真的假的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:66:0",
  "message_id": "MSG_063",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 02 01 02 01 01 01 04 01}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 55 01}哎？\n学长和我们也适用同样的规则？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:67:0",
  "message_id": "SEL_TALK064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 01 01}只在这里而已{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:67:1",
  "message_id": "SEL_TALK064",
  "translation": "{F2 05 FF FF}{F1 41}别把我和你们混为一谈{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:67:2",
  "message_id": "SEL_TALK064",
  "translation": "{F2 05 FF FF}{F1 41}即便如此也要叫学长{F5 47 02 01 02 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:68:0",
  "message_id": "MSG_065",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 56 01}{F5 C1 03 01 01 01 01 01 08 01}就算只在这里，\n也感觉能和学长并肩了，真不错！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:69:0",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 57 01}{F5 C1 03 01 01 01 01 01 08 01}学长永远都是我的学长！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:70:0",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 58 01}若与阴影陷入苦战，\n可以试着更换召唤的人格面具。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:70:1",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 59 01}其他各位还不熟悉更换人格面具，\n就由你来多加尝试吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:70:2",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 5A 01}那么，祝各位武运昌隆。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:71:0",
  "message_id": "MSG_068",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞按 X 键打开的菜单中，\n　新增了{F2 01 03 01}“人格面具”{F2 01 01 01}选项。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_150.bf.json:71:1",
  "message_id": "MSG_068",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞可以从{F2 01 03 01}“人格面具”{F2 01 01 01}中\n　装备副人格面具。\n{F2 23 00 00}{F1 21}{00}"
 }
]