[
 {
  "key": "export_base/event/e100/e100_170.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞天鹅绒房间……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 03 01}抱歉，劳烦各位跑一趟。\n准备工作终于完成了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 05 01}准备工作？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 05 01}既然已经能召唤多个人格面具，\n接下来就该用到“合体”了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}合体……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 07 01}所谓合体，就是以两个以上的\n人格面具为基础，\n召唤出一个新人格面具的秘仪……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 08 01}我们天鹅绒房间的住民，\n平时就是通过这一秘仪，\n为客人提供帮助。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}因此，合体可以说是\n天鹅绒房间的核心功能。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:5:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}之所以耽搁到现在，是因为\n我们需要调查此地是否足够稳定，\n能否进行合体。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:5:4",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}合体就请姐姐来主持，好吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 22 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}我明白了。\n身为姐姐，就包容一下\n迪奥的任性吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 04 01}任性……吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0F 01}各位会误入这片不稳定的\n“夹缝之地”，恐怕也与\n我家主人的缺席不无关系。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}倘若各位的命运需要这份帮助，\n作为天鹅绒房间的住民，\n我们也将尽力协助。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:8:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}虽然无法像主人那样……\n但今后将由我主持人格面具合体，\n为各位提供助力。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:8:3",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}召唤强大的人格面具，\n正是强化自身的最佳手段……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:8:4",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}若觉得敌人过于强大，\n不妨来这里尝试合体。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以通过{F2 01 03 01}“合体”{F2 01 01 01}，\n　以两个以上的人格面具为素材，\n　创造出一个新人格面具了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:10:0",
  "message_id": "MSG_0092",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 02 01}为方便管理多个人格面具，\n我也会准备好“人格面具全书”。\n需要时请吩咐我。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:11:0",
  "message_id": "MSG_0093",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以使用\n　{F2 01 03 01}“人格面具全书”{F2 01 01 01}，\n　查看与召唤人格面具了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}既然如此，顺便也确保一下\n与{F2 01 03 01}“其他世界”{F2 01 01 01}之间的通信吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:12:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 16 01}我会寻找那些和现在的您一样，\n被困在某处的人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:12:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}想必一定能为各位\n提供一些帮助。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:12:3",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}今后还请多多关照……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以通过\n　{F2 01 03 01}“擦肩通信”{F2 01 01 01}，\n　与其他世界取得联系了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 02 01 01 01 04 01}{F5 86 13 01 03 01 05 01 07 01}{F5 61 02 01 01 01 01 01 17 01}还真是件正经的“好事”啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_170.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 19 01}真令人失望。\n{F2 23 00 00}{F1 21}{00}"
 }
]