[
 {
  "key": "export_base/event/e100/e100_123.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 65 01 04 01}{F5 61 02 01 01 01 01 01 02 01}咦、咦……？\n那只 F.O.E 的行动，\n是不是有规律呀？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}它好像一直沿着\n固定的地方绕圈……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 04 01}嗯，真的呢。\n那边的池塘周围有什么吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 05 01 01 01 02 01}{F5 61 02 01 01 01 01 01 05 01}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 06 01}“那里是 F.O.E 的领地。\n闯进去撞上那家伙的话，\n就会遭到毫不留情的袭击。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}……虎狼丸先生如此警告大家。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 03 01 01 01 01 01 0A 01}哦、哦。\n不愧是生活在\n争夺领地的世界里的啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 13 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 09 01}那就是说，只要看穿那家伙的行动，\n就能避开它了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}是的。\n毕竟是强敌，\n我想还是避免战斗比较好。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0B 01}什么嘛，真没意思。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 04 01}明彦，你这家伙真是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}总之，看到 F.O.E 后，\n别想着无谓的战斗，要避开它。\n明白了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞在对战力有信心之前，\n　{F2 01 03 01}最好还是避开 F.O.E{F2 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_123.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定一边观察 F.O.E \n的行动，　一边谨慎前进……\n{F2 23 00 00}{F1 21}{00}"
 }
]