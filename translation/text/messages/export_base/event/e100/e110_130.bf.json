[
 {
  "key": "export_base/event/e100/e110_130.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“不可思议之国的你”内……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 02 01}这一带，似乎是\n爱丽丝茶会的场景。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 03 01}不是庆祝生日，\n而是庆祝平凡日子的茶会吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}所以，１年里有３６４天\n都在开派对呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 01 01}那不就有３６４天都能吃肉了！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 06 01}你为什么默认茶会上有肉啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 07 01}话说，你平时\n不就天天在办吃肉节嘛。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 03 01 01 01 01 01 07 01}{F5 C1 04 01 01 01 01 01 04 01}……也是哦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 0A 01}还真每天都吃肉啊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}话说，爱丽丝\n到底讲了个什么故事来着？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}可爱的小熊在神奇森林里，\n不停搭讪时髦的女孩子，\n最后变成黄油的故事熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 01 01}咦！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}可爱的小熊在神奇森林里，\n不停搭讪时髦的女孩子，\n最后黄油无限畅饮！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0E 01}黄油又不是自助饮料！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 03 01 01 01 01 01 03 01}还有，小熊！别乱编故事啊。\n玲会相信的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}你这么说，\n可里中也对爱丽丝没兴趣吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 04 01 01 01 01 01 02 01}哈？\n我知道啦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:13:0",
  "message_id": "MSG_0122",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}救了被欺负的乌龟，\n被带到神奇国度，\n然后打倒鲷鱼、比目鱼和扑克兵吧！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 03 01 01 01 01 01 01 01}咦！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:14:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}救了被欺负的乌龟，\n被带到神奇国度，\n然后鲷鱼、比目鱼刺身无限吃到撑！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 15 01}不对，是打倒红心女王后，\n小锤子里冒出金银财宝和美食，\n结局大概是“挖这里，汪汪”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 03 01 01 01 01 01 01 01}咦咦！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}打倒红心女王后，\n小锤子里冒出金银财宝和美食，\n到处一挖就有超大份加肉套餐！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 18 01}嗯，可喜可贺！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 03 01 01 01 01 01 04 01}原来是这样的美食故事……\n我一直记错了！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 04 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 03 01 01 01 01 01 0B 01}啊，够了，吐槽都跟不上！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1B 01}{F5 C1 04 01 01 01 01 01 04 01}那美食有多少？\n４辆卡车那么多！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 03 01 01 01 01 01 0A 01}都说了，故事不对。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}是啊，这种时候\n应该问“相当于几头牛”才对。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1E 01}{F5 C1 03 01 01 01 01 01 04 01}你们要胡扯到什么时候。\n快说点什么，花村学长……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}所以，听了半天还是不明白，\n爱丽丝到底是什么故事？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 20 01}{F5 C1 03 01 01 01 01 01 0A 01}啊，放弃吐槽了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 05 01}{F5 86 29 01 02 01 04 01 02 01}{F5 61 02 01 01 01 01 01 21 01}嗯，是让人兴奋的故事！\n有１０头牛那么多的兴奋！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 22 01}兴奋……？\n是食物吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:28:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 05 01 04 01 01 01}{F5 61 02 01 01 01 01 01 23 01}兴奋就是兴奋！\n就是心里面，轻飘飘的感觉！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:28:1",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 24 01}要是能在章鱼烧的海洋里游泳，\n善也会轻飘飘的吧！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:29:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}{F5 C1 04 01 01 01 01 01 05 01}小熊变成黄油，打倒扑克兵，\n用小锤子变出美食……\n那就是章鱼烧的海洋？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:30:0",
  "message_id": "MSG_0282",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 01}……是真的吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:31:0",
  "message_id": "SEL_TALK029",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 29 01 02 01 04 01 02 01}{F5 86 02 01 02 01 01 01 04 01}怎么可能{F5 47 02 01 02 01 0B 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:31:1",
  "message_id": "SEL_TALK029",
  "translation": "{F2 05 FF FF}{F1 41}大致没错{F5 47 02 01 02 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:31:2",
  "message_id": "SEL_TALK029",
  "translation": "{F2 05 FF FF}{F1 41}最后外星人入侵地球{F5 47 02 01 02 01 0D 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:32:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 27 01}不对？为什么？\n我总结了你们的话。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:33:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 08 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 28 01}{F5 C1 03 01 01 01 01 01 07 01}哎，原来你是认真的？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:34:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 29 01}{F5 C1 03 01 01 01 01 01 0A 01}别被这一连串胡扯骗了啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:35:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2A 01}原来如此，外星人呢。\n嗯，采用这个！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:36:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}{F5 C1 03 01 01 01 01 01 0A 01}不，我们问的是\n谁知道正确的故事吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:37:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 05 01}{F5 86 09 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 2C 01}简单来说，是名叫爱丽丝的少女\n误入神奇国度的童话。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:37:1",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2D 01}在那里，动植物会说话，\n身高可以变化，她就在这个\n充满现实中不可能之事的世界冒险。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:38:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2E 01}{F5 C1 04 01 01 01 01 01 05 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:38:1",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:38:2",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 30 01}这样就完了？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:38:3",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 31 01}能从这个故事中得到什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:39:0",
  "message_id": "SEL_TALK037",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 02 01 02 01 01 01 01 01}能收获快乐{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:39:1",
  "message_id": "SEL_TALK037",
  "translation": "{F2 05 FF FF}{F1 41}只是逃避现实{F5 47 02 01 02 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:39:2",
  "message_id": "SEL_TALK037",
  "translation": "{F2 05 FF FF}{F1 41}谁知道……{F5 47 02 01 02 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:40:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 32 01}是吗……\n原来是有意义的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:41:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 33 01}连你们也不知道？\n那算什么……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:42:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 05 01}{F5 86 0A 01 02 01 01 01 04 01}{F5 61 02 01 01 01 01 01 34 01}{F5 C1 04 01 01 01 01 01 02 01}所以，小熊\n什么时候变成黄油？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:43:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 35 01}嗯，说不定\n已经变成黄油了哦。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:43:1",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 36 01}想尝尝味道吗熊？\n嘿嘿。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:44:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 37 01}{F5 C1 03 01 01 01 01 01 08 01}尝尝味道……就是试吃？\n我要！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:45:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 06 01 06 01 07 01 02 01}{F5 61 02 01 01 01 01 01 38 01}那就得先充分融化呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_130.bf.json:46:0",
  "message_id": "MSG_044",
