[
 {
  "key": "export_base/event/e100/e100_112.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}队长，要不要像刚才说的那样，\n重新调整一下“编队”？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}既然大家都到齐了，\n我想还是先好好考虑一下\n由谁站在前线比较好。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 04 01}队长，我有个提议。\n去迷宫之前，要不要重新调整“编队”，\n决定由谁站在前线？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}既然大家都到齐了，\n考虑好每个人的长处和短处，\n一定能更顺利地前进！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:2:0",
  "message_id": "SEL_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}明白了{F5 47 02 01 03 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:2:1",
  "message_id": "SEL_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}应该怎么做？{F5 47 02 01 03 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}调整编队时，\n有些地方需要注意。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}队列分为前排和后排，\n站在后排的人\n受到敌人攻击时伤害会较小。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}不过，使用近战武器的人\n站在后排时，威力会降低，\n而且无法攻击敌人的后排。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 09 01}像我这样擅长近战攻击的类型，\n站在后面可就打不到敌人了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0A 01}如果使用我、由加莉小姐、天田\n以及善的武器，即使站在后排，\n也能正常攻击。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0B 01}为了在战斗中占据优势，\n要根据各自使用的武器安排队列。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}专注进攻、巩固防守，\n还是注重平衡……请视情况调整。\n拜托你了，队长。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_112.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0D 01}战斗中也能在前排和后排之间移动，\n请大家根据情况\n灵活应对哦！\n{F2 23 00 00}{F1 21}{00}"
 }
]