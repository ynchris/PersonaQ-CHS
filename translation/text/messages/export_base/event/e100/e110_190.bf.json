 },
 {
  "key": "export_base/event/e100/e110_190.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 05 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 04 01}唔唔……现在这迷你小熊的个头，\n怎么伸手伸脚都够不到那把钥匙熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_190.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}要是能刚好变大一点就好了……\n没那么方便啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_190.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}看起来叠四个人那么高就够得着……\n要不咱们叠个人塔？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_190.bf.json:3:0",
  "message_id": "SEL_TALK003",
