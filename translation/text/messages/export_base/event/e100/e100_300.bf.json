[
 {
  "key": "export_base/event/e100/e100_300.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}就像各位坠落到这里一样，\n我的客人和他的朋友们，\n也误入了这个地方。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}不过，他们来自与各位\n不同的地点、不同的时间……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}寻找出口时，我们遇到了\n伊丽莎白和迪奥，听他们\n说明了事情的经过。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0D 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 05 01}也就是说……跟我们处境相同啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 05 01 02 01 02 01}{F5 61 02 01 01 01 01 01 06 01}听说还有其他人格面具使，\n真把我吓了一跳。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 07 01}我们也是……\n这到底是怎么回事……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 08 01}你们也是进了电视里吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 05 01}……啊？电视？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}等等。\n你们生活的地方，\n影时间是什么情况？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 05 01}影时间？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 02 01}{F5 86 23 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 0C 01}……不如先互相介绍一下吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}那么，这位便是我的客人……\n和各位的队长一样，\n他也拥有“不羁”之力。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 0D 01 01 01 01 01 01 01}{F5 C1 0E 01 01 01 01 01 01 01}。\n我是八十神高中二年级的学生。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 03 01 01 01 01 01 07 01}诶，跟我们同龄？看着好成熟哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 10 01}八十神……是说这里？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 11 01}嗯，某种意义上算是吧。\n因为这里似乎是……\n类似八十神高中的地方。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}这、这是什么意思？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 01 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 13 01}这里和现实中的八十神高中很像，\n但似乎是另一个地方。\n……大概吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 05 01}大概？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 01 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 15 01}……或许。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 03 01 01 01 01 01 0A 01}不是换个说法的问题啦。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:17:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}话说，不羁之力……\n就是和队长一样的能力吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 02 01 01 01 04 01}{F5 86 22 01 01 01 02 01 07 01}{F5 61 02 01 01 01 01 01 18 01}两位不羁之力的持有者齐聚一堂……\n这就是“庇护”的缘由吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 01 01 07 01}{F5 86 02 01 0D 01 01 01 02 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 19 01}初次见面。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:20:0",
  "message_id": "SEL_TALK020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}没想到除了我还有别人……{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:20:1",
  "message_id": "SEL_TALK020",
  "translation": "{F2 05 FF FF}{F1 41}感觉很有缘{F5 47 02 01 03 01 07 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:20:2",
  "message_id": "SEL_TALK020",
  "translation": "{F2 05 FF FF}{F1 41}今后请多关照{F5 47 02 01 03 01 03 01 01 01}{00}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 01 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 1A 01}我也很惊讶。\n……不过，不羁之力在这里\n似乎有点不一样。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:22:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 03 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 1B 01}嗯，我也是。\n请多关照。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:23:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 01 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 1C 01}本大爷要把你一口吞掉……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 07 01}{F5 61 02 01 01 01 01 01 1D 01}{F5 C1 03 01 01 01 01 01 0A 01}这算什么。\n不羁之力持有者的问候方式吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:25:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 02 01 02 01 01 01 02 01}{F5 86 04 01 03 01 05 01 05 01}{F5 61 02 01 01 01 01 01 1E 01}我叫花村阳介。\n同样是高二，\n算是这家伙的搭档吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:26:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}搭档……原来如此，\n就像我和阿真一样啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:27:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 20 01}……啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:28:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 21 01}那个，我叫里中千枝。\n也是高二……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:28:1",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F1 25}里中千枝\n{F5 61 02 01 01 01 01 01 22 01}{F5 C1 03 01 01 01 01 01 0A 01}总、总觉得有点紧张啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:29:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 02 01 05 01}{F5 61 02 01 01 01 01 01 23 01}人家最喜欢布丁啦☆\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:30:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 24 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}你……小心我给你印个鞋印！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:31:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 25 01}呵呵。\n感觉有点像顺平和由加莉呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:32:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 06 01 05 01 05 01 02 01}{F5 61 02 01 01 01 01 01 26 01}那接下来该我了吧？\n我叫天城雪子，高中二年级。\n我和千枝他们都是同班同学。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:33:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 02 01 01 01 04 01}{F5 86 0C 01 07 01 03 01 07 01}{F5 61 02 01 01 01 01 01 27 01}我……发现了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:33:1",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 28 01}……她是个美女啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:34:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 29 01}那小千鸟怎么办？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:35:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 07 01 05 01 02 01 02 01}{F5 61 02 01 01 01 01 01 2A 01}接下来轮到高中一年级的啦！\n我是久慈川理世。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:36:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}{F5 C1 03 01 01 01 01 01 05 01}久慈川……\n咦，好像在哪儿听过……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:37:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}虽然不会战斗，但我很擅长支援。\n请多关照！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:38:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 06 01 02 01 02 01}{F5 86 0C 01 02 01 01 01 04 01}{F5 86 10 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 2D 01}果然，你们之中也有\n与风花小姐能力同类的人。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:39:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 2E 01}嗯，是啊。\n刚才见面的时候真吓了一跳。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:40:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 08 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 2F 01}啊，我叫巽完二……请多关照。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:41:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 02 01 01 01 02 01}{F5 86 07 01 09 01 02 01 05 01}{F5 61 02 01 01 01 01 01 30 01}诶，完二，这就完啦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:42:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 02 01 05 01}{F5 61 02 01 01 01 01 01 31 01}说说你的兴趣嘛。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:43:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 05 01 01 01 01 01}{F5 86 08 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 32 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}啰、啰唆死了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:44:0",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 07 01}{F5 86 0B 01 01 01 02 01 04 01}{F5 61 02 01 01 01 01 01 33 01}兴趣？\n……光看外表倒是挺那什么的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:45:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 34 01}{F5 C1 03 01 01 01 01 01 0A 01}确实挺那什么。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:46:0",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 35 01}我叫白钟直斗。\n请多关照。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:47:0",
  "message_id": "MSG_047",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 36 01}……鞋底好厚啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:48:0",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 37 01}{F5 C1 03 01 01 01 01 01 0B 01}诶，啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:49:0",
  "message_id": "MSG_049",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 38 01}{F5 C1 03 01 01 01 01 01 08 01}好厉害！\n是能让身高一下子长高的魔法道具啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:50:0",
  "message_id": "MSG_050",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 39 01}{F5 C1 03 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 02 01}请、请别再说了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:51:0",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3A 01}最后轮到小熊啦！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:51:1",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3B 01}小熊是八十稻羽引以为傲的\n本地百货“JUNES”备受喜爱的\n软萌吉祥物，熊熊～！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:51:2",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F1 25}小熊\n{F5 61 02 01 01 01 01 01 3C 01}告诉你们哦，小熊只要大胆地\n脱下这身可爱的熊皮……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:52:0",
  "message_id": "MSG_052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3D 01}{F5 C1 03 01 01 01 01 01 08 01}{F5 C1 04 01 01 01 01 01 02 01}里面就会蹦出一个\n衣着华丽、惹人怜爱的美少年，熊！\n这就叫一份享受，双倍美味，熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:53:0",
  "message_id": "MSG_053",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3E 01}啊，嗯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:54:0",
  "message_id": "MSG_054",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 3F 01}{F5 C1 03 01 01 01 01 01 0A 01}倒不如说，为什么玩偶装那边\n才像你的常态啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:55:0",
  "message_id": "MSG_055",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 22 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 40 01}那么，\n各位也自我介绍一下如何？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:56:0",
  "message_id": "MSG_056",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞自己这边也依次\n　进行了自我介绍……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:56:1",
  "message_id": "MSG_056",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞善和玲也说出了名字，\n　以及早已身处这里、\n　失去记忆等事情……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:57:0",
  "message_id": "MSG_057",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 29 01 01 01 03 01 04 01}{F5 61 02 01 01 01 01 01 41 01}请、请多多关照……是的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:58:0",
  "message_id": "MSG_058",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 42 01}你们是……八十神高中的学生？\n穿的制服和我们一样呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:59:0",
  "message_id": "MSG_059",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 09 01 01 01}{F5 61 02 01 01 01 01 01 43 01}是的，我们是八十神高中的学生！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:60:0",
  "message_id": "MSG_060",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 44 01}这样啊，虽然没什么印象……\n你们几年级？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:61:0",
  "message_id": "MSG_061",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 45 01}他们失去了记忆，似乎也不清楚。\n暂且当作一年级了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:62:0",
  "message_id": "MSG_062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 46 01}哦，同年级啊。\n还好没再多出几个学长学姐。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:63:0",
  "message_id": "MSG_063",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 47 01}{F5 C1 03 01 01 01 01 01 08 01}同龄……这样啊！\n小完，请多关照！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:64:0",
  "message_id": "MSG_064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 05 01 06 01 01 01}{F5 61 02 01 01 01 01 01 48 01}{F5 C1 03 01 01 01 01 01 02 01}小完……哦、哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:65:0",
  "message_id": "MSG_065",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 49 01}完二先生的体温正在上升！\n已达到危险水平！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:66:0",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 06 01 01 01}{F5 61 02 01 01 01 01 01 4A 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}啊——！\n胡说八道！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:67:0",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 4B 01}各位差不多聊完了吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:67:1",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 4C 01}……我可一直在等着呢。\n一直。等了很久。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:68:0",
  "message_id": "SEL_TALK068",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}请说{F5 47 02 01 03 01 0D 01 01 01}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:68:1",
  "message_id": "SEL_TALK068",
  "translation": "{F2 05 FF FF}{F1 41}抱歉{F5 47 02 01 03 01 07 01 01 01}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:68:2",
  "message_id": "SEL_TALK068",
  "translation": "{F2 05 FF FF}{F1 41}对不起{F5 47 02 01 03 01 07 01 01 01}{00}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:69:0",
  "message_id": "MSG_069",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 04 01 02 01 01 01 02 01}{F5 86 0C 01 0B 01 03 01 04 01}{F5 61 02 01 01 01 01 01 4D 01}你们那位蓝衣服的，是这种性格啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:70:0",
  "message_id": "MSG_070",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4E 01}挺高高在上的吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:71:0",
  "message_id": "MSG_071",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4F 01}难道刚才那个登场姿势也是她安排的？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:72:0",
  "message_id": "MSG_072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 50 01}{F5 C1 03 01 01 01 01 01 0A 01}还让我们排好队，提前演练了呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:73:0",
  "message_id": "MSG_073",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 51 01}{F5 C1 03 01 01 01 01 01 08 01}哦，挺帅的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:74:0",
  "message_id": "MSG_074",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 05 01 03 01 01 01}{F5 61 02 01 01 01 01 01 52 01}{F5 C1 03 01 01 01 01 01 04 01}你以为排练了多少遍啊。\n我都怀疑她才是最终头目……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:75:0",
  "message_id": "MSG_075",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 23 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 53 01}说起刚才那座迷宫，\n看样子里面并没有出口。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:76:0",
  "message_id": "MSG_076",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 54 01}是的，出口似乎不在迷宫里，\n而是在天鹅绒房间。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:77:0",
  "message_id": "MSG_077",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 55 01}就是山岸说的\n“挂着四把锁的门”吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:78:0",
  "message_id": "MSG_078",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 56 01}是的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:78:1",
  "message_id": "MSG_078",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 57 01}其中一把眼看就要打开，\n因此剩下的是“三把”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:79:0",
  "message_id": "MSG_079",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 58 01}还有三把……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:80:0",
  "message_id": "MSG_080",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 59 01}根据善的记忆，迷宫也还剩三座。\n可以先认为两者相互对应，\n着手寻找下一座迷宫。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:80:1",
  "message_id": "MSG_080",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 5A 01}眼下似乎也没有别的办法了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:81:0",
  "message_id": "MSG_0802",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 5B 01}……我有个提议。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:81:1",
  "message_id": "MSG_0802",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 5C 01}我们和你们一样，\n都被困在这里，无法离开。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:81:2",
  "message_id": "MSG_0802",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 5D 01}目前看来，要想出去，\n就得探索迷宫，\n取得守卫看守的东西。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:81:3",
  "message_id": "MSG_0802",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 5E 01}既然目标相同，战力自然越多越好。\n与其分头行动，\n不如携手作战，如何？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:82:0",
  "message_id": "MSG_081",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 02 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 5F 01}嗯，当然。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:83:0",
  "message_id": "MSG_082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0F 01 02 01 05 01}{F5 61 02 01 01 01 01 01 60 01}{F5 C1 03 01 01 01 01 01 07 01}答应得也太快了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:84:0",
  "message_id": "MSG_083",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 05 01 02 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 61 01}也就是要成为同伴，对吧？\n我没有拒绝的理由。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:85:0",
  "message_id": "MSG_084",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 62 01}{F5 C1 03 01 01 01 01 01 0A 01}话是这么说没错……\n总觉得你这人，真厉害啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:86:0",
  "message_id": "MSG_085",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 63 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 C1 03 01 01 01 01 01 05 01}{F5 C1 04 01 01 01 01 01 02 01}是吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:87:0",
  "message_id": "MSG_086",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0C 01 0B 01 03 01 04 01}{F5 61 02 01 01 01 01 01 64 01}真要一起行动啊？\n一下子就成大部队了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:88:0",
  "message_id": "MSG_087",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 65 01}呵呵。\n有各种各样的人，真有意思。\n穿玩偶装的小熊也很可爱。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:89:0",
  "message_id": "MSG_088",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 66 01}{F5 C1 03 01 01 01 01 01 0A 01}不……我觉得那个得多留个心眼……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:90:0",
  "message_id": "MSG_089",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 24 01 02 01 04 01 04 01}{F5 86 23 01 06 01 02 01 02 01}{F5 61 02 01 01 01 01 01 67 01}既然还有很长的路要走，\n或许得再多帮各位一把……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_300.bf.json:91:0",
  "message_id": "MSG_0892",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 68 01}迪奥，带我去天鹅绒房间。\n也请各位一同前来。\n{F2 23 00 00}{F1 21}{00}"
 }
]