[
 {
  "key": "export_base/event/e100/e100_320.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞保健室……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞里面的布置已经大变样了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}欢迎来到伊丽莎白的房间……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 03 01}要吃药？\n要打针？\n还·是·说……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 04 01}欢迎来到“保健室”……\n不，现在是“伊丽莎白的房间”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 0A 01}您这是在做什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 06 01}我参考了你书架上的书。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 03 01 01 01 01 01 0B 01}请、请不要胡说！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 03 01 02 01 01 01 01 01}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 08 01}参考这所学校流传的七大不可思议，\n我在这里放了一本“委托笔记”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 09 01}据说，“只要在保健室的笔记上\n写下愿望，就能实现”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}我已经先写好了，\n接下来该由各位实现了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 0A 01}七大不可思议不是这么回事吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 0C 01}我准备的报酬样样都是好东西。\n各位不妨顺手实现这些愿望，\n为迷宫探索增添一些乐趣？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}不过，有些委托会有期限，\n还请留意。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以在保健室\n　接受{F2 01 03 01}“委托”{F2 01 01 01}了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0F 01 02 01 01 01 04 01}{F5 86 0B 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 0A 01}总觉得……明明被困在这里，\n是不是太悠闲了啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}可是，还有三个迷宫，\n感觉路还很长。不安排好节奏，\n说不定半路就累坏了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 02 01 01 01 04 01}{F5 86 07 01 05 01 02 01 02 01}{F5 61 02 01 01 01 01 01 10 01}似乎只有迷宫里才有阴影的气息，\n偶尔回这边的文化祭休息一下，\n怎么样？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}也认识了这么多伙伴，\n一定会很开心的！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 08 01}赞成熊！\n小熊想和大家一起狂欢！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 13 01}也是，机会难得嘛！\n我们学校的文化祭都泡汤了。\n这次补回来，补回来！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}真、真的可以吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 15 01}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0E 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 16 01}现在是做这些的时候吗，真是的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 17 01}人格面具是心灵的力量……对吧？\n那“玩得开心”，\n不也算是补充必要的能量吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 18 01}啊，说了半天，\n荒垣学长也很喜欢祭典吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 02 01 01 01 02 01}{F5 86 0D 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 19 01}什么啊，阿真，原来是这样？\n好，把所有小吃摊都吃遍吧！\n我记得有家章鱼烧摊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 03 01 01 01 01 01 04 01}你自己去。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:22:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 1B 01}{F5 C1 03 01 01 01 01 01 07 01}章鱼烧……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_320.bf.json:22:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}伊丽莎白，出发！\n{F2 23 00 00}{F1 21}{00}"
 }
]