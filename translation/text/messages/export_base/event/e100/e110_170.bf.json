[
 {
  "key": "export_base/event/e100/e110_170.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞天鹅绒房间……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 03 01}啊，来了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 07 01}咦，玛丽？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}这怎么回事？\n突然就到这里了。\n文化祭？什么的……太狡猾了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 06 01}她叫玛丽……\n看来已经有人认识她了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}姑且也算天鹅绒房间的住民，\n与我们一起生活。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 03 01 01 01 01 01 05 01}天鹅绒房间的……住民？\n不是搭档的亲戚吗！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}才不是什么住民。\n只是碰巧待在那里。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}长鼻子呢？\n长鼻子从车里不见了，\n回过神就到了这里……莫名其妙。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}不知道她为什么会来。\n或许也和我们一样，\n是被“召唤”而来的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}总之，既然来了，\n也让她派上用场吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:8:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}嗯……\n那么，来确保与\n{F2 01 03 01}“此处以外的世界”{F2 01 01 01}的通信吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:9:0",
  "message_id": "MSG_0073",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}{F5 86 23 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 0E 01}她会寻找那些\n和如今的你一样，\n被困在某处的人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:9:1",
  "message_id": "MSG_0073",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}一定能为各位\n提供助力。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:10:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 03 01 01 01 01 01 07 01}哈！？\n又要干那个工作？\n我可没听说。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:11:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}我现在才说，你当然没听过。\n空闲的时候，就像平时那样\n写写小诗如何？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 0B 01}什……小诗？哈？不知道！\n那、那个只是记下别的世界的事情，\n才不是我写的你怎么会知道啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 04 01 01 01 01 01 05 01}是吗，真是热心工作。\n那这次也拜托你了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 04 01}呜……笨蛋……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以通过\n　{F2 01 03 01}“擦肩通信”{F2 01 01 01}，\n　与其他世界取得联系了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 02 01 04 01 01 01}{F5 61 02 01 01 01 01 01 15 01}小诗……是什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:17:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 16 01}才不是小诗。\n是心灵的呐喊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:18:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0F 01 03 01 01 01}{F5 61 02 01 01 01 01 01 17 01}{F5 C1 03 01 01 01 01 01 02 01}激情……！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:18:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}善，善，激情好帅啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:19:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 07 01}{F5 61 02 01 01 01 01 01 19 01}……是吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:20:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 03 01 01 01 01 01 07 01}啊，怎么办！\n刚吞下的甜甜圈，好好吃！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:21:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}那不是很好吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:22:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 02 01 02 01 04 01}{F5 86 15 01 02 01 01 01 07 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1C 01}既然能召唤多个人格面具，\n接下来，\n就需要“合体”了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:23:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}{F5 C1 04 01 01 01 01 01 07 01}合体……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:24:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}合体，是以２个以上的人格面具\n为基础，召唤新１个的秘仪。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:24:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}天鹅绒房间的住民，\n平时正是用这种秘仪帮助客人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:24:2",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 20 01}可以说，这就是\n天鹅绒房间本来的功能。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:24:3",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 21 01}如今终于准备妥当，\n所以请各位过来了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:25:0",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 02 01 02 01 01 01 04 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 22 01}各位遵循某种命运的安排，\n误入了这片“夹缝之地”……\n连我也一样。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:25:1",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 23 01}既然如此，也就意味着\n帮助各位，是我的命运……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:25:2",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 24 01}虽然无法做到与主人一样，\n但今后由我主持人格面具合体，\n助各位一臂之力。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:25:3",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 25 01}召唤强大的人格面具，\n就是增强各位实力的最佳方法。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:25:4",
  "message_id": "MSG_0222",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 26 01}陷入苦战时，\n不妨先试试合体。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:26:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以通过{F2 01 03 01}“合体”{F2 01 01 01}，\n　以两个以上的人格面具为素材，\n　创造出一个新人格面具了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:27:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 02 01}为了管理多个人格面具，\n也需要“人格面具全书”吧。\n我会让你能够使用。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:28:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以使用\n　{F2 01 03 01}“人格面具全书”{F2 01 01 01}，\n　查看与召唤人格面具了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:29:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 27 01}不过，还真忙啊……\n保健室、装备店，\n还有天鹅绒房间……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:29:1",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 28 01}就没有人来帮忙吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_170.bf.json:30:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以使用\n　{F2 01 03 01}“人格面具全书”{F2 01 01 01}，\n　查看与召唤人格面具了！\n{F2 23 00 00}{F1 21}{00}"
 }
]