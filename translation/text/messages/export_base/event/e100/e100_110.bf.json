 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:52:0",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 02 01 07 01}{F5 61 02 01 01 01 01 01 35 01}比想象中还要……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:53:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 04 01 01 01}{F5 61 02 01 01 01 01 01 36 01}{F5 C1 03 01 01 01 01 01 0B 01}怎、怎么了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:54:0",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 29 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 37 01}{F5 C1 03 01 01 01 01 01 08 01}是草莓！\n“草草一大堆、莓颗五脏六腑”！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:55:0",
  "message_id": "MSG_047",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 38 01}原来还有这种含义呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:56:0",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 39 01}埃癸斯小姐，你从刚才起\n就一直被玲牵着鼻子走呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:57:0",
  "message_id": "MSG_049",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3A 01}接下来，是能够\n恢复体力的地方……对吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:57:1",
  "message_id": "MSG_049",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3B 01}请放心。\n我已经物色好了。\n请往这边走。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:58:0",
  "message_id": "MSG_050",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 3C 01}{F5 C1 03 01 01 01 01 01 0A 01}姐姐……您还没说完感想呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:59:0",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3D 01}总之，这样一来，各位应该就能\n做好战斗准备了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:59:1",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3E 01}如果与阴影交战时陷入苦战，\n请考虑调整装备。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:59:2",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3F 01}此外，选择哪些成员\n在前线作战也十分重要。\n请不要忘了调整“编队”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_110.bf.json:59:3",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 40 01}那么，请各位\n一路小心。\n{F2 23 00 00}{F1 21}{00}"
 },
