[
 {
  "key": "export_base/event/e100/e110_360.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 02 01}本来就快到０点了，\n看来时间也没差得太离谱？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 03 01 01 01 01 01 05 01}咦，再怎么说，\n也没过那么久吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}我们到这里的时候，\n连傍晚都还没到吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 02 01 05 01}{F5 61 02 01 01 01 01 01 05 01}嗯，不是才３点左右吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 05 01}啊？\n现在不是影时间吗？\n这里还有阴影呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 09 01 01 01 03 01 02 01}{F5 61 02 01 01 01 01 01 07 01}影时间……刚才也提到过。\n“你们似乎并不知道影时间”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 04 01}{F5 86 0E 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 08 01}嗯……刚才只听你们\n简单说了些情况……\n现在先说说我们的事吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}影时间是每晚零点降临的\n“隐藏的时间”……\n没有资质的人无法感知。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}在影时间里，\n我们称作塔尔塔罗斯的高塔中，\n会出现阴影。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:5:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}而每逢满月，\n还会出现格外巨大的阴影……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:5:4",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}我们正是为了消灭这些阴影，\n让影时间消失而战斗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 03 01 01 01 01 01 0A 01}……怎、怎么感觉\n跟我们这边差得好远啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0F 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}那个，你们呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 02 01 01 01 02 01}{F5 86 09 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 0F 01}我们正在追查杀人犯。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}杀、杀人犯！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}我们住的八十稻羽镇，\n发生了连环杀人案。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}凶手的杀人手法，\n是把被害者扔进电视里……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:10:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}电视里面是阴影的世界。\n其实，小熊也来自那里。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 0A 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 14 01}小熊以前住在电视里。\n阳介他们来了之后，\n小熊才来到外面的世界，熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 15 01}住在有阴影的世界里？\n……这不是和善、玲很像吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}我和小熊一样？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}那我们也能像小熊一样，\n和大家一起去外面的世界吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 18 01}一定可以的，熊！\n阳介他们来之前，\n小熊根本没想过要出去。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:14:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}可外面实在太好玩了，\n小熊还想着，\n要是早点出来就好了，熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 03 01 01 01 01 01 07 01}一样的！\n大家来之前，\n我也没想过要“回去”！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 07 01}{F5 61 02 01 01 01 01 01 1B 01}……是啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}喂～那边叫善的男生～\n难道不乐意和小熊一样吗，熊？\n像小熊这样人见人爱，很光荣哦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 1D 01}{F5 C1 03 01 01 01 01 01 04 01}接下来才是重点，\n你先安静点。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:18:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 07 01}{F5 86 04 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1E 01}在那个电视里的世界，\n如果起雾时还留在里面，\n就会被自己的阴影袭击而死。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:18:2",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}只要拥有人格面具能力，\n就能进入电视。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:18:3",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}……也能把别人放进去。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0D 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 21 01}{F5 C1 03 01 01 01 01 01 07 01}……也就是说，凶手在利用\n人格面具能力杀人？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 02 01 01 01 04 01}{F5 86 09 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 22 01}虽然还有很多不明之处……\n但我们一定会抓住凶手。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 07 01}{F5 61 02 01 01 01 01 01 23 01}战斗的理由，完全不同啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:22:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 02 01 01 01 04 01}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 24 01}总之，这里不是电视内部，\n恐怕也不是各位所说的\n塔尔塔罗斯。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:22:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}也就是说，我们对这个世界\n几乎一无所知。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:22:2",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 26 01}我认为，应该暂时放下\n各自的常识，去了解\n这个世界特有的“规则”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:23:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 27 01}啊，嗯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞伙伴们不约而同地\n　面面相觑……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:25:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 28 01}只能往前走了。\n去２－２……我们班。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:26:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 02 01 02 01 01 01 02 01}{F5 86 07 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 29 01}那里恐怕也变成迷宫了。\n一定要做好准备哦，学长！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:27:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2A 01}还有，休息也很重要熊。\n刚才阳介不是也说了吗。\n“欲速则不哒”嘛！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:28:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}{F5 C1 03 01 01 01 01 01 04 01}你这家伙，是故意的吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:29:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}玩的时候就好好玩，干的时候就认真干！\n这才是最有效率的熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:30:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2D 01}咦，意外地很有道理……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:31:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}{F5 C1 03 01 01 01 01 01 09 01}所以小由加，来约会吧～？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:32:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}{F5 C1 03 01 01 01 01 01 05 01}咦，为什么会得出这种结论？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:33:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 30 01}不用理它。\n这只野兽就这样。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_360.bf.json:34:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 31 01}啊，明白。\n{F2 23 00 00}{F1 21}{00}"
 }
]