[
 {
  "key": "export_base/event/e100/e100_310.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}……干吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里也有一位陌生的少女……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 05 01}{F5 61 02 01 01 01 01 01 03 01}原来“两扇门”指的是这个。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 04 01}我的客人与伊丽莎白的客人……\n分别通往两个不同地方的两扇门……\n是这个意思吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 05 01}喂，为什么不理我！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:4:0",
  "message_id": "SEL_TALK004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}你是谁？{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:4:1",
  "message_id": "SEL_TALK004",
  "translation": "{F2 05 FF FF}{F1 41}玛格丽特的妹妹？{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 02 01 01 01 02 01}{F5 86 23 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 06 01}啊……抱歉。\n忘了介绍，这孩子叫玛丽。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}姑且算是天鹅绒房间的住客，\n和我们待在一起。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 03 01 01 01 01 01 01 01}诶，玛丽！？\n你怎么在这里？\n……住客！？什么意思！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}才不是什么住客。\n只是碰巧待在这里而已。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 04 01}{F5 86 25 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0A 01}所以，到底怎么回事？\n人也太多了。\n角色都重复了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:7:2",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}……狗狗毛茸茸的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 08 01}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}……她就是这样的孩子，\n不过，多少也能帮上各位的忙。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}今后，与其他世界的交流\n就交给玛丽负责。\n各位有需要，尽管找她。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 03 01 01 01 01 01 07 01}哈！？\n又要干那个活？\n我可没听说。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}我刚刚才说，你当然没听过。\n闲下来时，也可以像平常一样\n写写诗，不是吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 03 01 01 01 01 01 0B 01}什……诗？哈？我不知道！\n那、那是……记下别的世界的事，\n才不是我写的你怎么会知道啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 04 01 01 01 01 01 05 01}是吗，工作真认真呢。\n那这次也拜托你了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 03 01 01 01 01 01 04 01}呜……笨蛋……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 29 01 02 01 04 01 02 01}{F5 61 02 01 01 01 01 01 14 01}诗……是什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}都说了不是诗。\n是内心的呐喊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0F 01 03 01 01 01}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 03 01 01 01 01 01 02 01}激情……！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:17:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 01}善，善，激情，好帅气！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 02 01 05 01}{F5 61 02 01 01 01 01 01 18 01}……是吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 03 01 01 01 01 01 07 01}啊，怎么办！\n刚咽下去的甜甜圈，好好吃！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 04 01 01 01 01 01 05 01}那不是很好吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 25 01 02 01 01 01 05 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1B 01}今后的合体就由我来负责吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:21:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}“三角合体”……\n也就是使用三个人格面具的合体，\n我也能够进行……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:21:2",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}各位有需要时，\n尽管吩咐。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:22:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}我将为各位开放更高深的秘术……\n使用三个人格面具的合体。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:23:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞现在可以使用三个人格面具，\n　进行{F2 01 03 01}“三角合体”{F2 01 01 01}了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}那么，这里就交给两位了。\n我会继续在保健室，\n为各位恢复体力。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:24:1",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}另外……看来能空出些时间，\n我想将之前一直考虑的某件事\n付诸行动。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:25:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 05 01}{F5 61 02 01 01 01 01 01 21 01}某件事……是指什么呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:26:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 22 01}来到这个世界后，\n我有些“在意”的事情，\n想就此进行一番“研究”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:27:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 23 01}那么，这里就交给两位了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:27:1",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 24 01}……哎呀，这可如何是好。\n没有需要我负责的工作了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:28:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 25 01}姐姐！\n那就来和我一起经营装备店……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:29:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 01}这个除外。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:30:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0C 01 01 01 02 01}{F5 61 02 01 01 01 01 01 27 01}{F5 C1 03 01 01 01 01 01 07 01}好无情。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:31:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 02 01}{F5 86 22 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 28 01}那么，来到这个世界后，\n我有些“在意”的事情，\n就让我进行一番“研究”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:32:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 29 01}作为“研究”的一环，\n我会向各位提出“委托”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:32:1",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}当然，我也会准备\n与各位付出相称的报酬，\n还请踊跃接受。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:33:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}{F5 C1 03 01 01 01 01 01 0A 01}这不就是个人爱好吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:34:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 2C 01}那么，我在“保健室”等候各位。\n还有些事要办，我先告辞了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:35:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 2D 01}我打算在一个叫“保健室”的地方\n筑巢。各位稍后请来坐坐……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:36:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 24 01 02 01 04 01 05 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2E 01}……等一下。\n伊丽莎白……\n我有很多事想问你。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:37:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}好的，请问是什么事？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:38:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 30 01}关于你，以及你的客人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:38:1",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 31 01}在这之后，你会……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:39:0",
  "message_id": "MSG_038a",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 23 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 32 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:40:0",
  "message_id": "MSG_0382",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 33 01}不，之后再说吧。\n现在必须先对这个世界\n有更多了解……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:41:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 34 01}{F5 C1 03 01 01 01 01 01 05 01}……好的，那么稍后再谈。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:42:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白离开了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:43:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 03 01 02 01 01 01 04 01}{F5 86 13 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 35 01}要去趟保健室吗？\n既然有报酬，\n听听也不吃亏吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e100_310.bf.json:44:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 07 01}{F5 61 02 01 01 01 01 01 36 01}……我也去。\n不知为何，我实在很不放心……\n{F2 23 00 00}{F1 21}{00}"
 }
]