[
 {
  "key": "export_base/event/e100/e110_260.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 02 01}{F5 86 03 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 02 01}真让人吃惊……你们很强呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 03 01}那、那个……你们是……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 04 01}如你们所见，是人格面具使。\n……和你们一样。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 0B 01}果、果然是这样啊……\n可怎么突然就出现了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}你们看着不怎么样，\n本事倒不小。怎么样，\n待会儿来比试一场……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 09 01 02 01 07 01}{F5 61 02 01 01 01 01 01 07 01}你确定？\n小心被桐条骂。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 22 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 08 01}抱歉打扰各位畅谈。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 05 01}咦……？\n和玛格丽特小姐穿着一样的衣服……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}是的，我和姐姐玛格丽特一样，\n作为天鹅绒房间的居民，\n为客人提供帮助。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:9:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 01 01 07 01}{F5 86 22 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 0B 01}我是伊丽莎白，\n身边这位是愚弟迪奥多。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}今后请多关照……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 01 01 07 01}{F5 86 22 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 0D 01}刚才从姐姐那里听说了各位的情况，\n似乎是遇上了非常有趣……\n困难的事情。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 0A 01}啊，她刚说有趣了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e100/e110_260.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 04 01 02 01 01 01 02 01}{F5 86 03 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 0F 01}详细情况，等离开这里再聊吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
