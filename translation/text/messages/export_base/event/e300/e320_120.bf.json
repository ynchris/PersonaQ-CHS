[
 {
  "key": "export_base/event/e300/e320_120.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞使用了门禁卡。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 07 01}哦，门打开了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 07 01 06 01 02 01}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 03 01 01 01 01 01 0B 01}太好……出来了……！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 0B 01}还以为这辈子\n都得待在里面了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 08 01}不过，不觉得还挺有趣的吗？\n有种身处极限状态的感觉。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 0A 01}不，完全不觉得。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}由加莉亲刚才还哭丧着脸，\n说“想回去了”呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 06 01 01 01 01 01 CE 01}{F5 86 0C 01 11 01 04 01 01 01}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}好痛！都说了巴掌也别打！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 15 01 02 01 01 01 05 01}{F5 86 29 01 02 01 09 01 02 01}{F5 86 0E 01 08 01 01 01 04 01}{F5 61 02 01 01 01 01 01 09 01}真是的……\n一放松下来就这样。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}不过，多亏你们，我们得救了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}门禁卡是玲找到的。\n她一个人去了黑暗中寻找。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}原来如此……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 05 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}玲，真的谢谢你。\n你很努力呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}嘿嘿……因为{F1 82}和善\n一直鼓励我，所以没关系！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}那么，三位都是冠军。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 03 01 01 01 01 01 08 01}太好了，我是冠军！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 0D 01 65 01 04 01}{F5 61 02 01 01 01 01 01 11 01}喂喂，大家听得见吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 07 01}哦，小理世！\n这么说，导航恢复了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 03 01 65 01 01 01}{F5 61 02 01 01 01 01 01 13 01}太好了，终于连上了！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 01 01 65 01 01 01}{F5 61 02 01 01 01 01 01 14 01}真是吓死我了。\n突然之间，我们的声音\n就传不过去了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 15 01}{F5 C1 03 01 01 01 01 01 0A 01}……那不就是灵异现象吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 11 01 04 01 01 01}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}呀！\n不要不要，别说了！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 0D 01 65 01 02 01}{F5 61 02 01 01 01 01 01 17 01}没、没关系的！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:18:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}陷阱似乎也顺利解除了，\n这下可以继续前进了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}一放松，肚子就饿了！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:19:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}出去以后，一起吃御好烧、\n苹果糖、棉花糖、大判烧，\n还有可丽饼和巧克力香蕉吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:20:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1B 01}嗯，想吃多少都给你买。\n算是我的犒劳。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e320_120.bf.json:21:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0F 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 03 01 01 01 01 01 01 01}你的烤肉！？\n那那个也拜托了！\n{F2 23 00 00}{F1 21}{00}"
 }
]