[
 {
  "key": "export_base/event/e300/e310_050.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞看来前方的昏暗通道\n　还要延伸很远……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 04 01}{F5 86 04 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0A 01}喂，脚下这么黑……\n总觉得会有那种东西吧？\n不如说，可能已经踩到了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:2:0",
  "message_id": "SEL_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 01 01}踩到脚？{F5 47 02 01 02 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:2:1",
  "message_id": "SEL_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}踩到幽灵？{F5 47 02 01 02 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:2:2",
  "message_id": "SEL_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}踩到那个？{F5 47 02 01 02 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}脚从刚才起\n就一直被踩个不停啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 04 01}先说好，你也\n踩了我好多次哦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 05 01}哎，幽灵能踩到吗？\n用这种方式驱鬼，也太可怜了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}是说黑得发亮的小强熊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:6:0",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 03 01 04 01}{F5 61 02 01 01 01 01 01 07 01}嗅嗅……没问题！\n感觉好像没有熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 02 01 01 01 04 01}{F5 86 04 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 03 01 01 01 01 01 0A 01}你的鼻子不靠谱。\n以前还从你里面跑出来过吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 06 01 05 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 07 01}里面……玩偶服里面？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 04 01}只是把冰棒棍放在里面稍微久了一点，\n它们就聚过来了熊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 11 01 03 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}那种爬来爬去的感觉，现在想起……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 08 01 0C 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0C 01}呕……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 04 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 03 01 01 01 01 01 08 01}还让小熊浑身发颤熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 02 01}你这家伙，真是没救了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 05 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0F 01}总之，拜那些小强所赐，\n我把整个房间都大扫除了一遍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0D 01 01 01 01 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 10 01}你和小熊住在一起？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}是小熊硬挤进了\n我房间的壁橱里！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 01 01 01 01 01 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 12 01}……那不就是……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 13 01}同……居……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 05 01 03 01 01 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 04 01}可恶，才不想对着小熊\n用这么美好的词！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}那小熊待在阳介家时，\n就打扮成女孩子吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 05 01}{F5 61 02 01 01 01 01 01 16 01}{F5 C1 03 01 01 01 01 01 0A 01}体贴的方向也太离谱了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 02 01 01 01 02 01}{F5 86 0A 01 11 01 03 01 04 01}{F5 61 02 01 01 01 01 01 17 01}等阳介有了女朋友，\n小熊就会乖乖搬出去哦……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 18 01}这是打算住好几年吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 19 01}{F5 C1 03 01 01 01 01 01 03 01}喂，你这话给我等等。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 0A 01 02 01 01 01 04 01}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1A 01}听说小熊原本\n住在电视里，\n为什么出来了呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}那边净是阴影，\n小熊孤零零的熊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:25:0",
  "message_id": "MSG_0232",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 03 01 01 01 01 01 08 01}这里有老师、阳介，还有女生，\n冰淇淋也很好吃熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:26:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}是吗……\n我也是在屋久岛重新启动后，\n才与大家会合……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:26:1",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1E 01}小熊现在感受到的充实心情，\n我好像能理解。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:27:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}小埃……你好温柔熊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:27:1",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 11 01 03 01 01 01}{F5 61 02 01 01 01 01 01 20 01}小熊遇到大家以后，\n才第一次知道自己是空荡荡的熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:28:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 21 01}空荡荡……吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:29:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 21 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 22 01}不过现在里面已经长出身体了，\n每天都好快乐，每天都闪闪发亮熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:30:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 23 01}{F5 C1 03 01 01 01 01 01 05 01}闪闪发亮……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:31:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 21 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 24 01}小埃不会觉得闪闪发亮吗熊？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:31:1",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}小熊和老师、阳介、\n小菜菜，还有大家在一起时，\n就觉得眼前的景色闪闪发亮熊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:31:2",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 21 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 01}然后，就会开心得、快乐得，\n快要哭出来熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:32:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 27 01}因为快乐……而哭泣？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:32:1",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 28 01}小熊的话，真不可思议……\n我也会有\n能够理解的那一天吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:33:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 21 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 29 01}一定会有熊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:33:1",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 21 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}{F5 C1 03 01 01 01 01 01 09 01}到时候，小埃就和小熊约会吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:34:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}恕我拒绝。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:35:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0A 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}{F5 C1 03 01 01 01 01 01 07 01}唯独这点就是不肯让步熊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:36:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 2D 01}差不多该出发了！\n做好准备。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:37:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}遵命！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:38:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}了解。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:39:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 11 01 08 01 01 01 04 01}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 08 01 02 01 01 01 02 01}{F5 61 02 01 01 01 01 01 30 01}{F5 C1 03 01 01 01 01 01 05 01}……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:39:1",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 31 01}你在干嘛？\n大家都要走了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:40:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 32 01}{F5 C1 03 01 01 01 01 01 0B 01}{F5 C1 04 01 01 01 01 01 04 01}啊，好的。\n请、请先走吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:41:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 33 01}……脚怎么了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:42:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞天田的鞋带\n　似乎断了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:43:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 34 01}找个东西代替鞋带……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:43:1",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 35 01}找个东西……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:44:0",
  "message_id": "MSG_0412",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 36 01}……没有啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:45:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 37 01}那个，没关系的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:46:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 38 01}踩到会摔倒的吧。\n没办法了，先用这个。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:47:0",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞完二开始撕开\n　随身带着的手巾……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:48:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 39 01}{F5 C1 03 01 01 01 01 01 0B 01}咦！？那、那个……不用这样！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:49:0",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3A 01}我家是染坊。\n这种东西要多少有多少。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e310_050.bf.json:49:1",
  "message_id": "MSG_046",
