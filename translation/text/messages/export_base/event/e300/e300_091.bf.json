[
 {
  "key": "export_base/event/e300/e300_091.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞似乎听见这扇门的另一边，\n　传来了顺平的声音……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 07 01}{F5 86 29 01 0D 01 02 01 04 01}{F5 61 02 01 01 01 01 01 02 01}小顺，你在那边吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 03 01 01 01 01 01 07 01}{F5 C1 04 01 01 01 01 01 03 01}哦！\n这个声音，是玲吗！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 03 01}太好了，快救救我们！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}有人受伤了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F1 25}{F5 C1 0E 01 01 01 01 01 01 01}的声音\n{F5 61 02 01 01 01 01 01 06 01}{F5 C1 04 01 01 01 01 01 03 01}没事，大家都平安。\n不过，好像出不去了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 04 01 01 01 01 01 03 01}由加莉都害怕得\n哭着喊“救我，顺平”了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}{F5 C1 04 01 01 01 01 01 03 01}好痛！\n由加莉，用拳头也太狠了吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 04 01 01 01 01 01 03 01}听得见吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 03 01}门关着，出不去！\n能从那边打开吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞门似乎上了锁……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:8:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞看来没法轻易打开……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 02 01 02 01 04 01}{F5 86 15 01 02 01 01 01 07 01}{F5 61 02 01 01 01 01 01 0B 01}嗯……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}门边装着设备。\n上面有红、蓝、黄的指示灯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 09 01 0B 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}这是……\n用卡贴一下，就能开门的机器。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}卡……？\n那就是钥匙吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 05 01 0D 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}嗯……\n医生手里有。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 04 01 01 01 01 01 07 01}也就是说，没有那种卡，\n门就打不开吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:14:0",
  "message_id": "MSG_0132",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 07 01}{F5 86 29 01 02 01 02 01 04 01}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 04 01 01 01 01 01 07 01}设备有３个……\n要打开这扇门，\n就需要３张卡吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:15:0",
  "message_id": "SEL_TALK014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 02 01}去找门禁卡吧{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:15:1",
  "message_id": "SEL_TALK014",
  "translation": "{F2 05 FF FF}{F1 41}把门破坏吧{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:15:2",
  "message_id": "SEL_TALK014",
  "translation": "{F2 05 FF FF}{F1 41}怎么办？{F5 47 02 01 03 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}只能如此了。\n这扇门很坚固，\n几乎不可能破坏。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}有卡就能打开了吧。\n那就快去找吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}那似乎不可能。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:18:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}这扇门很坚固。\n破坏它会花很多时间。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}那就去找卡吧。\n有了卡就能轻松打开！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}是啊……\n这扇门很坚固，\n几乎不可能破坏。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:20:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}只能去找充当钥匙的卡了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}有卡就能打开了嘛！\n那就快去找吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞告诉由加莉她们，\n　自己会去寻找门禁卡……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}{F5 C1 04 01 01 01 01 01 03 01}可、可是……没问题吗？\n这里好像收不到导航……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}先调查一下。\n你们留在原地。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F1 25}{F5 C1 0E 01 01 01 01 01 01 01}的声音\n{F5 61 02 01 01 01 01 01 1D 01}{F5 C1 04 01 01 01 01 01 03 01}明白了。\n我们在这里等，拜托你了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1E 01}包在我身上！\n我会救大家的！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e300/e300_091.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}{F5 C1 04 01 01 01 01 01 07 01}那么，走吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]