 },
 {
  "key": "export_base/event/e700/e722_220.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}小熊懂的熊！\n这里蕴藏着恋爱的诀窍熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_220.bf.json:4:0",
