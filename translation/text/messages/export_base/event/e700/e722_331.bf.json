  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 0D 01 65 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0B 01}喂、喂！\n大家没受伤吧！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_331.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 07 01 65 01 02 01}{F5 61 02 01 01 01 01 01 73 11}{F5 C1 03 01 01 01 01 01 04 01}真是的……！\n担心死我了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_331.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 6C 03}真是得救了！\n理世，谢谢你！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_331.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 01 01 02 01 01 01 02 01}{F5 86 0D 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}……不过，{F1 81}。\n要不是你醒来，我们就危险了。\n干得好。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_331.bf.json:2:1",
  "message_id": "MSG_002",
