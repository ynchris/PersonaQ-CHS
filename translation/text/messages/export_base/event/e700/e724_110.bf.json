[
 {
  "key": "export_base/event/e700/e724_110.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 8B 10}{F5 C1 03 01 01 01 01 01 07 01}哇！\n找到了，找到了！\n这里有火哦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这就是门角上写的\n{F2 01 03 01}“圣火”{F2 01 01 01}……吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 03 01 02 01}{F5 61 02 01 01 01 01 01 01 01}虽然不能断言，但应该是……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 84 08}{F2 01 03 01}既然说“献于神前”{F2 01 01 01}，\n是不是要运到什么地方去啊？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}创造这个迷宫的主人\n自称为神，\n在迷宫最深处等着我们……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}你们觉得怎么样？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 7D 03}{F5 C1 03 01 01 01 01 01 08 01}顺平，你挺有一套嘛。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这是顺平先生之前玩过的\n游戏里的设定。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 88 08}{F5 C1 03 01 01 01 01 01 04 01}你怎么会知道啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，就试试看吧。\n也许持有{F2 01 03 01}“圣火”{F2 01 01 01}\n就是所谓的资格。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}可这东西……要怎么搬？\n整个搬走可有点重啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}得找点能烧的东西……啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 06 01 02 01 04 01 02 01}{F5 61 02 01 01 01 01 01 23 04}唔……\n这附近的话……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:11:0",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 02 01 01 01 04 01}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 06 01 02 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 25 07}{F5 C1 03 01 01 01 01 01 0B 01}小、小雪……\n为为为、为什么看着小熊啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 AA 0C}{F5 C1 04 01 01 01 01 01 04 01}汪汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}你身后的虎狼丸\n嘴里叼着什么东西。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:14:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}也就是说，你挡住了。我看不见。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1E 07}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 04 01}呜呜！太过分了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 12 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 A9 0C}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞虎狼丸嘴里叼着一根木棍……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 E8 0C}真聪明啊，你。\n是要把火引到这根木棍上吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 AA 0C}{F5 C1 04 01 01 01 01 01 04 01}汪汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 02 01 01 01 02 01}{F5 86 15 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}原来如此……\n那接下来交给我吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞善撕下自己的披风，\n　缠在木棍上……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 B7 0D}{F5 C1 04 01 01 01 01 01 04 01}这样应该就能点着了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}原来如此……\n这样“火把”就做好了啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞获得了{F4 84 04 01 01 01 0D 07}！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，这只是临时赶制的。\n无法让火焰维持太久。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:25:1",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}如果熄灭了，\n就再点燃一次。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}也就是说……\n得趁火灭之前送过去吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“火把”的火焰\n　似乎无法维持太久……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:27:1",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞运送{F2 01 03 01}“圣火”{F2 01 01 01}时，\n　似乎需要选好路线，\n　在迷宫中前进……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_110.bf.json:27:2",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞先用圣火点燃“火把”，\n　试着带到{F2 01 03 01}被封印的门{F2 01 01 01}前吧……\n{F2 23 00 00}{F1 21}{00}"
 }
