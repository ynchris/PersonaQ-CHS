 {
  "key": "export_base/event/e700/e711_115.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}只要启动一次机关，\n两边就都能通行吧。\n{F2 23 00 00}{F1 21}{00}"
