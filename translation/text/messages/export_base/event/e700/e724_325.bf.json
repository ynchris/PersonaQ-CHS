[
 {
  "key": "export_base/event/e700/e724_325.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 0D 01 65 01 02 01}{F5 61 02 01 01 01 01 01 2F 05}{F5 C1 03 01 01 01 01 01 07 01}小心！\nＦ．Ｏ．Ｅ的样子不对劲！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 68 03}{F5 C1 03 01 01 01 01 01 07 01}啊，对了。\n因为我们带着{F2 01 03 01}“圣火”{F2 01 01 01}，\n所以它也会变化啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 03 01 02 01}{F5 61 02 01 01 01 01 01 F5 08}{F5 C1 03 01 01 01 01 01 02 01}呃！\n那是……汗吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 0C}{F5 C1 03 01 01 01 01 01 0A 01}真不想从那里经过啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}说什么呢。\n运动就会出汗，这是当然的。\n说明它在认真锻炼。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0C 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}话说，那里面没什么危险成分吧？\n比如会对人体有害的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 70 0B}久等了。\n现在报告水洼成分的调查结果。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 6C 11}{F5 C1 03 01 01 01 01 01 01 01}什、什么时候查的……！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}水洼中有１％是钠、钾、\n钙等成分……\n其余均为动物性油脂。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}虽然没有危险，但一旦踩进去，\n根据惯性定律，\n似乎就无法在原地停下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 08 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A7 02}{F5 C1 03 01 01 01 01 01 04 01}呃啊……\n谢谢你啊，小埃……\n听完更不想踩进去了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_325.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 48 0A}{F5 C1 03 01 01 01 01 01 0A 01}这、这是为了完成鸟居巡礼！\n忍、忍一忍，走吧！\n{F2 23 00 00}{F1 21}{00}"
 }
]