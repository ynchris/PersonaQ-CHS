  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 02 01 02 01}{F5 61 02 01 01 01 01 01 88 08}{F5 C1 03 01 01 01 01 01 04 01}呼、呼……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_241.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0B 01}……刚才那个，怎么看\n都差一点就完蛋了吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_241.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0C 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}根据到门前的距离\n和Ｆ．Ｏ．Ｅ的移动速度，\n经过计算……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_241.bf.json:2:0",
  "message_id": "MSG_0012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}除了“打倒它再前进”之外，\n正面突破的概率为０．０２３％……\n几乎不可能。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_241.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 84 08}{F5 C1 03 01 01 01 01 01 0A 01}果然……得用那个吧？\n那边不是有篝火吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_241.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 02 01}{F5 86 0E 01 09 01 02 01 04 01}{F5 61 02 01 01 01 01 01 05 0A}不，我也考虑过……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_241.bf.json:4:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}能将火焰运来的范围内，\n没有已经点燃的篝火。\n恐怕也行不通。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_241.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 83 08}{F5 C1 03 01 01 01 01 01 04 01}啊，也是呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
