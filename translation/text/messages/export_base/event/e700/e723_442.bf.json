 {
  "key": "export_base/event/e700/e723_442.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 AC 11}{F5 C1 03 01 01 01 01 01 05 01}又是汉字词典？\n反正也被涂得没法看了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_442.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}嗯，不过这一本，\n每一页上写的都不是“几”，\n而是{F2 01 03 01}“×”{F2 01 01 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_442.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A1 11}与其说是“×”，\n形状更像片假名{F2 01 03 01}“メ”{F2 01 01 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_442.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 03 01 02 01}{F5 61 02 01 01 01 01 01 3C 06}……大概正如天田同学所说，\n把它看作{F2 01 03 01}“メ”{F2 01 01 01}应该没错。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_442.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}笔记本残页和这本汉字词典……\n究竟有什么联系……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_442.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……继续调查吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
