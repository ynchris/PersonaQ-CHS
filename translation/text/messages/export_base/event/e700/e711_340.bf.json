 },
 {
  "key": "export_base/event/e700/e711_340.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}拿着颜料的Ｆ．Ｏ．Ｅ，\n涂完玫瑰之后，\n似乎就会回到平常的路线。\n{F2 23 00 00}{F1 21}"
