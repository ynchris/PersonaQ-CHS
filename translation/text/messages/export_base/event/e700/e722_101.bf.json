 {
  "key": "export_base/event/e700/e722_101.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 03 01}凭感觉回答简单的问题，\n就能找到新的命定对象哦。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_101.bf.json:6:2",
