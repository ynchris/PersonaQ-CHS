 },
 {
  "key": "export_base/event/e700/e722_101.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 03 01 01 01 01 01 05 01}命运可以一次又一次地改变……吗？\n{F2 23 3D 01}{F1 21}{00}"
