 },
 {
  "key": "export_base/event/e700/e722_101.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 0A 01}话说，命中注定的对象还能变……\n这算怎么回事啊。\n{F2 23 79 01}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_101.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 01 01}世上并不存在所谓命运，\n一切都是自己一次次选择\n累积而成的结果……\n{F2 23 B5 01}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_101.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……尽量往好的方向想，\n也可以这样理解。\n{F2 23 79 01}{F1 21}{00}"
 },
 {
