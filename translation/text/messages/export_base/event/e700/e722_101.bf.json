 },
 {
  "key": "export_base/event/e700/e722_101.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 02 01}{F5 61 02 01 01 01 01 01 03 01}{F5 C1 04 01 01 01 01 01 03 01}你已踏入禁忌的\n“重新选择命运”之路。\n{F2 23 00 00}{F1 21}"
