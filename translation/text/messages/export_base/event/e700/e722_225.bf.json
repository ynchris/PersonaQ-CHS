 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:2:1",
  "message_id": "SEL_002",
  "translation": "{F2 05 FF FF}{F1 41}我不这么觉得{F5 47 02 01 01 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 11 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A0 11}……。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A0 11}是我……想多了吗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}啊，这个人偶\n抱着个像箱子一样的东西呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7D 03}箱子里是小块的肉呢？\n还是大块的肉呢？？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2B 0C}{F5 C1 03 01 01 01 01 01 0A 01}呃，那个……\n我觉得里面应该根本不是肉……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}别在意她。\n她只是正长身体，特别能吃。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}啊，好的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，这个箱子\n好像打不开。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 C0 03}这样啊。\n那这里大概就只是条死路吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}走吧走吧，乾。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}嗯、嗯……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞天田似乎对这个人偶有所感触……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞也许可以在地图上做个记号……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 50 03}{F5 C1 03 01 01 01 01 01 05 01}这个人偶\n抱着个箱子呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……啊，不过打不开。\n这里没什么特别的东西吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 11 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A0 11}……。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}刚才也见到过吧？\n类似的人偶……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 06 01 01 01}{F5 61 02 01 01 01 01 01 C0 03}咦？\n有吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}因为它看起来也一样寂寞，\n所以我记得很清楚。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，那个戴的是\n红色石头项链……\n它们原本可能是一对吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:15:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}后来却不知为什么被分开了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……如果是这样，\n可不能装作没看见啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:16:1",
