 },
 {
  "key": "export_base/event/e700/e722_225.bf.json:18:0",
  "message_id": "SEL_018",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 01 01 02 01 01 01 02 01}可以{F5 47 02 01 01 01 07 01 21 01}{00}"
 },
 {
