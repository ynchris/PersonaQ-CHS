 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:18:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我只想让真心喜欢我的人收藏，\n而且这样也能避免\n被人拿去做坏事。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:19:0",
