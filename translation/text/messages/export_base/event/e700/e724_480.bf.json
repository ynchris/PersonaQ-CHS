 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}只要打倒这个迷宫的守卫……\n就能回到原来的世界了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 01 01}目前还只是可能而已……\n但即使如此，局面也会有很大变化。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0A 01 11 01 03 01 02 01}{F5 61 02 01 01 01 01 01 0A 07}{F5 C1 03 01 01 01 01 01 0A 01}唉……\n这就要结束了吗熊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 04 01}难得能和这么可爱又性感的\n月光馆女生们，\n天天像过节一样狂欢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 7F 08}不不，小熊。\n这话应该由我们来说才对。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 02 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 04 01}功夫少女、侦探女孩，\n现役高中生老板娘，还有偶像！\n这阵容也太丰富了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 02 01 65 01 02 01}{F5 86 0F 01 03 01 65 01 04 01}{F5 61 02 01 01 01 01 01 48 0B}理世果然很厉害呢！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0C 01 65 01 01 01}{F5 61 02 01 01 01 01 01 73 11}{F5 C1 03 01 01 01 01 01 0B 01}没、没有啦……\n别再说了，真是的！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0B 01 02 01 01 01 04 01}{F5 86 29 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 BB 11}呐，呐。\n偶像……很厉害吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 C2 07}嗯，那当然了。\n开一场演唱会，\n就会有好几万人来看呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}我在电视上看过，狂热粉丝\n会查出喜欢的偶像住在哪里，\n每天早上朝那个方向祈祷哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 BD 0D}原来如此。所谓偶像，\n也就是神佛之类的存在……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 E7 02}嗯，也不能说完全不对吧。\n只要是偶像用过的牙刷，\n就有人愿意花天价买呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 48 04}{F5 C1 03 01 01 01 01 01 01 01}花村，你真差劲！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 04 03}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}为什么变成骂我啊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:17:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0C 01 01 01 03 01 04 01}{F5 61 02 01 01 01 01 01 F5 08}{F5 C1 03 01 01 01 01 01 06 01}嗯？那要是我现在\n拿到理世亲的签名……\n稍微等一阵，就能升值成珍藏品！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_480.bf.json:18:0",
