[
 {
  "key": "export_base/event/e700/e715_660.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 23 04}这边好像是死路。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e715_660.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不知不觉就到６层了啊……\n单论层数，\n这已经是最高纪录了吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e715_660.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 06 01 02 01}{F5 61 02 01 01 01 01 01 C0 03}还剩多少层啊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e715_660.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这座时钟塔，从外面看时，\n有这么高吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e715_660.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}之前的每个迷宫，\n都远远超过了教室的大小。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e715_660.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}所以这座塔也是一样，\n我认为不能根据外观\n来判断高度。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e715_660.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 9E 05}也就是说只能走着调查了吧？\n正合我意！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e715_660.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}是啊……说得对。\n好，等着我们哦，玲！\n{F2 23 00 00}{F1 21}{00}"
 }
