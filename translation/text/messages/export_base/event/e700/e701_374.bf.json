  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 B3 08}{F5 C1 03 01 01 01 01 01 07 01}哦哦，开花了啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_374.bf.json:2:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}……咦？\n花怎么掉下来了……\n{F2 23 00 00}{F1 21}{00}"
