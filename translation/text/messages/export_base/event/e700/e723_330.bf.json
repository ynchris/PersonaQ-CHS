 },
 {
  "key": "export_base/event/e700/e723_330.bf.json:6:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AC 11}{F5 C1 03 01 01 01 01 01 05 01}有人……谁啊？\n{F2 23 00 00}{F1 21}{00}"
