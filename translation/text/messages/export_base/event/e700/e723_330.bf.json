 {
  "key": "export_base/event/e700/e723_330.bf.json:7:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0F 01 04 01 01 01}{F5 61 02 01 01 01 01 01 82 11}{F5 C1 03 01 01 01 01 01 0B 01}学、学长也是！\n别问得那么具体啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_330.bf.json:7:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 03 01}这世上有很多事情，\n还是不知道比较幸福！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_330.bf.json:8:0",
  "message_id": "MSG_006",
