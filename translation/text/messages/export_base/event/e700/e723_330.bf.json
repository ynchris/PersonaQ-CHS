 },
 {
  "key": "export_base/event/e700/e723_330.bf.json:9:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 01 01 02 01 01 01 04 01}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}钥匙似乎会{F2 01 03 01}因接触到光线\n而消失{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_330.bf.json:9:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}捡起钥匙之后，\n请注意不要开灯。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
