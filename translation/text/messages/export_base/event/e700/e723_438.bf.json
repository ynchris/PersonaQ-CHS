 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 01 01 02 01 01 01 04 01}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}看来只要{F2 01 03 01}按特定顺序走过{F2 01 01 01}附近的房间，\n机关门就会打开。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}“ヒム月ヒヒヒ月ヒヒ”{F2 01 01 01}这个暗号……\n看起来像是类似的排列……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞再想一想吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 AA 0C}汪汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 67 10}{F5 C1 03 01 01 01 01 01 01 01}呜、哇啊！\n吓吓吓我一跳……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞虎狼丸不知从哪里\n　叼来了一张纸片……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 9A 11}{F5 C1 03 01 01 01 01 01 07 01}这是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}和在翘起的地板下\n发现的纸片非常相似！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 A1 11}这次也排列着奇怪的汉字……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞纸片上写着\n　{F2 01 03 01}“水口止日水日止日水”{F2 01 01 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 09 01 03 01 01 01}{F5 61 02 01 01 01 01 01 72 06}{F5 C1 03 01 01 01 01 01 06 01}……原来如此！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 02 01}{F5 61 02 01 01 01 01 01 E3 08}{F5 C1 03 01 01 01 01 01 07 01}哦。\n想明白了吗！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3E 06}{F5 C1 03 01 01 01 01 01 0A 01}还、还只是个假设……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:16:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}目前发现的暗号，全都是由\n{F2 01 03 01}将汉字拆成４份后的部件{F2 01 01 01}\n组成的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:17:0",
  "message_id": "MSG_0162",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 01 01}“メ木几又”组成{F2 01 03 01}“殺”{F2 01 01 01}，\n“ム月ヒヒ”组成{F2 01 03 01}“能”{F2 01 01 01}，\n“口止水日”组成{F2 01 03 01}“踏”{F2 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:17:1",
  "message_id": "MSG_0162",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}把拆出的四个部分，\n看作四个房间……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:17:2",
  "message_id": "MSG_0162",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}按各部件的排列顺序经过房间，\n锁就会打开，应该是这样的机关。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 6E 05}{F5 C1 03 01 01 01 01 01 05 01}所以……\n到底是什么意思？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}那么，就给这张纸片上的\n{F2 01 03 01}“水口止日水日止日水”{F2 01 01 01}\n标上编号吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:20:0",
  "message_id": "MSG_0182",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 01 01}首先，左上的{F2 01 03 01}“口”{F2 01 01 01}为１，\n左下的{F2 01 03 01}“止”{F2 01 01 01}为２，右上的{F2 01 03 01}“水”{F2 01 01 01}为３，\n右下的{F2 01 03 01}“日”{F2 01 01 01}为４。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:20:1",
  "message_id": "MSG_0182",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这样，就能换成\n{F2 01 03 01}“３１２４３４２４３”{F2 01 01 01}这串数字。\n再换成刚才说的方位……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:20:2",
  "message_id": "MSG_0182",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}右上、左上、左下、右下、右上、\n右下、左下、右下、右上{F2 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:20:3",
  "message_id": "MSG_0182",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……就是这样。\n按这个顺序经过房间，应该就……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:21:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……也许就能通过了，是吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_438.bf.json:21:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}好，试试看。\n{F2 23 00 00}{F1 21}{00}"
 }
