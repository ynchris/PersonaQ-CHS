[
 {
  "key": "export_base/event/e700/e701_302.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 02 01 01 01 04 01}{F5 86 0E 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 4E 0A}涂完玫瑰后，它就开始移动了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_302.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}那个士兵似乎也只是\n在自己的地盘里规律地巡逻……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_302.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不过，它在那里来回走动，\n我们恐怕就无路可走了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_302.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0B 01 07 01 05 01 02 01}{F5 61 02 01 01 01 01 01 C2 07}啊，说起来，爱丽丝的故事里，\n好像有过类似的场景……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_302.bf.json:2:0",
  "message_id": "MSG_0012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}风花！\n有的吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_302.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 FF 0A}嗯，我记得……扑克牌士兵，\n会把白玫瑰涂成红玫瑰。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_302.bf.json:3:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不然就会受到女王的惩罚，\n所以它们才那么拼命。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_302.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 4E 0A}原来如此……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_302.bf.json:4:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}如果能{F2 01 03 01}把玫瑰变白{F2 01 01 01}，\n趁士兵把它涂红的时候，\n也许就能找到空隙……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
