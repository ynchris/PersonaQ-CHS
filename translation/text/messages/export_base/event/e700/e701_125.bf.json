 },
 {
  "key": "export_base/event/e700/e701_125.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 11 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}对面那个是楼梯吧？\n好像是往下走的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_125.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 97 11}请小心。\n下面也有阴影的气息！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_125.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这里似乎是向下延伸，\n分成了好几层。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_125.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 01 01}要不要先把那座楼梯\n作为眼前的目标呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_125.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 D5 0C}那就得从那座楼梯\n往下走了……\n{F2 23 00 00}{F1 21}"
 },
 {
