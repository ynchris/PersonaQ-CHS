[
 {
  "key": "export_base/event/e700/e723_345.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞地上掉着一张笔记本残页。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2A 06}{F5 C1 03 01 01 01 01 01 07 01}上面写着日期。\n是谁的日记吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞读读这张日记残页吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:3:0",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“○月△日”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:3:1",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“住院的孩子们\n　在玩一种奇妙的游戏。\n　似乎是在寻宝……”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:3:2",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“据说，只要按规定的顺序，\n　穿过４间相连的方形房间的门，\n　就能进入藏宝室。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:3:3",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞“通过的顺序，\n　似乎由藏东西的人用暗号告知。”\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:4:0",
  "message_id": "MSG_0023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……日记到这里就断了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:5:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 9E 05}挺温馨的嘛。\n我小时候也会自己\n想出各种游戏。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:6:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}比如超级过家家熊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:7:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 06 01 01 01}{F5 61 02 01 01 01 01 01 AB 05}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}过、过过过家家什么的，\n我才没玩过那种女孩子的游戏！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:8:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 83 08}{F5 C1 03 01 01 01 01 01 0A 01}你这反应，\n不就跟承认“玩过”一样嘛。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:9:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 09 01 02 01 03 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:10:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 05 01}小直，怎么了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:11:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3F 06}没有……\n去其他地方看看吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 09 01 02 01 03 01 02 01}{F5 61 02 01 01 01 01 01 72 06}{F5 C1 03 01 01 01 01 01 06 01}原来如此……\n信息已经齐了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:12:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}刚才的钟表图案……\n还有Ｘ光片上的数字……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:12:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}接下来，只要有个地方，\n能重现这种“奇妙的游戏”就好了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 03 01 02 01}{F5 86 0E 01 09 01 02 01 04 01}{F5 61 02 01 01 01 01 01 4E 0A}我觉得，这和Ｘ光片上\n写着的数字有关……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 03 01 01 01}{F5 61 02 01 01 01 01 01 3C 06}是啊……\n应该可以确定，那就是暗号。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:14:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}既然是暗号，\n那么提示暗号含义的线索，\n应该也在某个地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}刚才那些钟表图案？\n有什么含义吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 03 01 01 01}{F5 61 02 01 01 01 01 01 3C 06}是啊……\n我觉得那是用来\n解读某种东西的提示。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e723_345.bf.json:17:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞再读一次\n　日记残页吧……\n{F2 23 00 00}{F1 21}{00}"
 },
