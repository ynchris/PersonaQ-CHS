 },
 {
  "key": "export_base/event/e700/e724_185.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 18 07}{F5 C1 03 01 01 01 01 01 09 01}喔喔！\n偷听女生闲聊……！\n这可是男生梦寐以求的情景……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_185.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 CA 0A}{F5 C1 04 01 01 01 01 01 03 01}我觉得你不需要再瘦了呀……\n理世，你身材已经很好了哦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e724_185.bf.json:11:0",
