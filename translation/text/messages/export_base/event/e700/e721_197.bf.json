  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}涂色工具{F2 01 01 01}可以给地面上色。\n{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e721_197.bf.json:5:0",
