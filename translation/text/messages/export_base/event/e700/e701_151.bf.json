[
 {
  "key": "export_base/event/e700/e701_151.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 70 0B}确认阴影已消灭。\n解除战斗模式。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 01 01 01 01 05 01}{F5 61 02 01 01 01 01 01 A9 0C}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 5E 0B}看来虎狼丸先生\n想称赞队长。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}它说，要是只顾着看地图，\n就找不到这间隐藏的房间了，\n不愧是队长。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 12 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AC 0C}汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 84 08}{F5 C1 03 01 01 01 01 01 0A 01}果然还是没法相信，\n一声“汪”里面，\n居然能有那么多意思啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这并非通过语言功能进行传达，\n虎狼丸先生并没有\n原封不动地说出这些话。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我是体会虎狼丸先生的心情，\n再将其转换成恰当的语言。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}若说这是长期培养出的默契，\n那和顺平先生与由加莉小姐的关系，\n有相似之处。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 0C 01 02 01 01 01 04 01}{F5 86 0B 01 0F 01 04 01 02 01}{F5 61 02 01 01 01 01 01 82 11}等等，埃癸斯。\n别擅自把我们凑成一对啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}汪。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 83 11}{F5 C1 03 01 01 01 01 01 03 01}你也别叫了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e701_151.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 12 01 02 01 01 01 05 01}{F5 86 10 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}果然十分相似。\n{F2 23 00 00}{F1 21}{00}"
 },
