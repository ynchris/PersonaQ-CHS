 },
 {
  "key": "export_base/event/e700/e701_285.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 83 08}{F5 C1 03 01 01 01 01 01 04 01}啊，也是，确实……\n你这么一说，好像是有点……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
