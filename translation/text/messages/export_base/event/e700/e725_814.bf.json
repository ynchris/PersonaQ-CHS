[
 {
  "key": "export_base/event/e700/e725_814.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}真要命……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 48 06}{F5 C1 03 01 01 01 01 01 04 01}现在还觉得\n身上缠着蛛丝……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}真是的……\n太不像话了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}有什么办法。\n有些东西就是本能地受不了。\n只能靠我们想办法了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}刚才那只蜘蛛和下层那些\n行动方式不同，你看出来了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}是啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这一层的蜘蛛，好像会\n{F2 01 03 01}在蜘蛛网之间跳来跳去{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 05 01}{F5 61 02 01 01 01 01 01 01 01}专门盯上被蜘蛛网缠住，\n无法动弹的猎物……是吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}和野生蜘蛛简直一样。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这么说来……\n只要不被蜘蛛网缠住，\n不就行了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}Ｆ．Ｏ．Ｅ也就不会动。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}原来如此。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……咦？\n不过，也会有例外吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 06 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 05 01}嗯？\n比如什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}比如，想去蜘蛛网后面的地方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}原来如此……确实。\n要是通往门的路中央有蜘蛛网，\n不想走也得走。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 02 01 01 01 02 01}{F5 86 13 01 03 01 05 01 04 01}{F5 61 02 01 01 01 01 01 01 01}那种时候……对了。\n{F2 01 03 01}故意被缠住，把它引过来{F2 01 01 01}，\n怎么样？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:12:0",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}喂，阿明。\n记得刚才那只蜘蛛跳了几次吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}记得是３次。\n之后，我们就挣脱了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}没错。\n记住这一点，算好距离……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:14:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}让它跳３次也抓不到我们{F2 01 01 01}，\n算好这样的距离，\n把蜘蛛引开或许就行了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e700/e725_814.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不试试看也不知道……\n那就来试一次吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]