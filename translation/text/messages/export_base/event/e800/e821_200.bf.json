 },
 {
  "key": "export_base/event/e800/e821_200.bf.json:11:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 90 11}{F5 C1 03 01 01 01 01 01 08 01}哼。\n那就马上……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_200.bf.json:12:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 DD 09}身为队长，怎么能这样。\n我要把你的意志也好好锻炼一番。\n现在就……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_200.bf.json:13:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 17 0A}等等，明彦。\n特训还是重新准备后再开始吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_200.bf.json:13:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}我们还不熟悉这座迷宫。\n本来是要特训，结果却成了\n阴影的祭品，该怎么办？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_200.bf.json:14:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 50 09}……说得也是。\n实战训练总是伴随着危险。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_200.bf.json:14:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 D2 09}那我就正式提出委托。\n做好万全准备再来接受吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
