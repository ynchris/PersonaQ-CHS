[
 {
  "key": "export_base/event/e800/e822_510.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这是玲大人发布的委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，似乎另有隐情……\n我来代读她写在笔记本上的内容。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白拿起了笔记本。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}“你好，我是玲。\n非常感谢你承接这次的委托。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}“其实，为了表达平日里的感谢，\n我打算给善送一份惊喜礼物……”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}“可我完全不知道，\n善收到什么会高兴。\n能帮我问出来吗？”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}“因为想尽快送给他，\n这项委托请设为{F2 01 03 01}有期限{F2 01 01 01}。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:2:4",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}“那么，４６４９！”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:2:5",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 3D 11}……以上，完全照原文读出。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白放下了笔记本。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}４６４９大概是借日语谐音，\n表示“请多关照”吧。\n真是新颖的语言风格。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，这份心意确实令人动容。\n真希望迪奥也能学学这份用心。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2D 11}那么，为了让计划成功，\n我也传授几条制造“惊喜”的心得。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}开始谈话时，尽量\n{F2 01 03 01}旁敲侧击地提问{F2 01 01 01}。\n欲速则不达。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:4:4",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}机会到来时，\n{F2 01 03 01}不要反复追问{F2 01 01 01}。\n否则只会让人更加怀疑。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:4:5",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}最后还有一招秘诀：\n情况不妙时，{F2 01 03 01}故意保持沉默，\n蒙混过去{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:4:6",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}以上就是我能传授的全部。\n不妨作为参考。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:4:7",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 CF 0E}玲大人正在校内等您。\n祝您顺利。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_510.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞从菜单的{F2 01 03 01}“校内散步”{F2 01 01 01}中，\n　去找玲说话吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]