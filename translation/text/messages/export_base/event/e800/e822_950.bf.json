 {
  "key": "export_base/event/e800/e822_950.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 22 01 0E 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白凝视着珠子……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0E 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}凝视这颗珠子时，\n总有一种奇妙的感觉包围着我。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3B 11}若要形容的话……对了，是空虚。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}仿佛深渊在向我发问……\n何为无，何为有……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:3:3",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 3A 11}决定了。\n就将这颗珠子命名为{F2 01 03 01}“冥府之珠”{F2 01 01 01}吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:3:4",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}虽说是我自己取的……\n但这名字真是恰如其分。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白将{F2 01 03 01}“冥府之珠”{F2 01 01 01}\n　收进了口袋……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2D 11}那么，关于报酬。\n正如之前所说，是件好东西。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_950.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 E8 0E}想必能帮上您的忙。\n还请收下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
