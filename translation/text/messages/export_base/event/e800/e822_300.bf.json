[
 {
  "key": "export_base/event/e800/e822_300.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}自从来到这个世界，\n我就忙着治疗、研究、委托和逛摊位，\n一直工作个不停……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}而姐姐也始终\n待在天鹅绒房间里。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 04 01}啊……\n我们姐妹是多么可怜啊……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 01 FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 22 01 02 01 05 01 01 01}{F5 61 02 01 01 01 01 01 05 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 06 01}我们姐妹是多么可怜啊……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白\n　不时偷偷看向这边……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 07 01}所以，我打算休个假，\n把文化祭玩个痛快。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}希望您能担任\n我们的向导。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}不过，这样的愿望，\n可是无法压抑太久的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}要是被晾在一边太久，\n我就会和姐姐两个人\n寂寞地尽情挥霍一番。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:2:4",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}所以，如果您在意报酬，\n还请{F2 01 03 01}尽早{F2 01 01 01}完成委托。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞从菜单的{F2 01 03 01}“校内散策”{F2 01 01 01}中，\n　找伊丽莎白聊聊吧……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_300.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞另外，这项委托似乎{F2 01 03 01}有期限限制{F2 01 01 01}。\n　要注意别错过期限……\n{F2 23 00 00}{F1 21}{00}"
 }
]