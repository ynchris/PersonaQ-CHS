[
 {
  "key": "export_base/event/e800/e803_210.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这项委托来自\n桐条美鹤女士。\n我去请她过来，请稍候。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 29 11}让您久等了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 0E 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 EA 09}为了能毫无顾虑地举办庆功宴，\n我决定辅导伊织准备考试。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}虽然要麻烦你，\n但希望你也能在场。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:3:0",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}没问题{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:3:1",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}不带顺平开庆功宴吧……{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 FE 09}是吗，帮大忙了。\n只有我一个人，\n恐怕容易自说自话……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……以前从来\n没想过这些……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 0A}我也……多少改变了一点吗……\n不，也许是从今往后\n能够改变了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:5:0",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7F 0A}那么，请陪我一会儿吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞从美鹤的眼神中可以看出她很认真……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 21 0A}呵呵……别这么说。\n同伴不齐，庆功宴还有什么意义呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:7:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}只有我一个人教伊织，\n恐怕容易变得自说自话……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:7:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……以前从来\n没想过这些……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_210.bf.json:7:3",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 0A}我也……多少改变了一点吗……\n不，也许是从今往后\n能够改变了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
