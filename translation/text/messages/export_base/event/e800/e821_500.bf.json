 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:1:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 6B 03}{F5 C1 03 01 01 01 01 01 04 01}啊——不行了……\n好想回去吃个痛快……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2F 03}{F5 C1 03 01 01 01 01 01 0A 01}连恢复体力也是靠吃啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:2:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1A 03}话说，你都吃不腻的吗？\n那些摊位的味道。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 68 03}{F5 C1 03 01 01 01 01 01 07 01}咦，不是很好吃吗！\n到底哪里不好啦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A0 02}章鱼烧也好，大阪烧也好，\n基本全是酱汁味啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:4:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A7 02}{F5 C1 03 01 01 01 01 01 04 01}唉……\n真怀念火锅那种清爽的味道。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 11 01 05 01 05 01}{F5 61 02 01 01 01 01 01 23 04}花村同学，你没什么精神呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 09 01 04 01 01 01}{F5 61 02 01 01 01 01 01 5F 03}花村说，想让我们\n给他做火锅吃呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 02 01}{F5 86 06 01 02 01 01 01 05 01}{F5 61 02 01 01 01 01 01 9C 02}{F5 C1 04 01 01 01 01 01 04 01}对对对。\n想让你们做顿火锅，\n好好治愈一下我……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:7:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 03}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}才不是这么回事啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 45 04}说不定会好吃到升天哦。\n这样也没关系吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 AE 02}{F5 C1 03 01 01 01 01 01 0B 01}为什么你每次都那么有自信啊！？\n也差不多该认清现实了吧！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_500.bf.json:10:0",
  "message_id": "MSG_009",
