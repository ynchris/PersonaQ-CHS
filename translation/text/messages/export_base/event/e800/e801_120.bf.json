  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 14 01}诶……好、好的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:17:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 08 01 04 01 01 01}{F5 61 02 01 01 01 01 01 15 01}呃……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:18:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥多正在苦思……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:19:0",
