 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:33:1",
  "message_id": "SEL_034",
  "translation": "{F2 05 FF FF}{F1 41}要开诗歌大会吗？{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:34:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 01}也行。\n反正无聊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:34:1",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 27 01}{F5 C1 03 01 01 01 01 01 0B 01}……只是因为无聊哦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:35:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 11 01 04 01 01 01}{F5 61 02 01 01 01 01 01 28 01}那真是……好主意！\n向玛丽学习的话，\n一定能发现语言的深奥之处。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:36:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 29 01}不要。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:37:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 2A 01}{F5 C1 03 01 01 01 01 01 07 01}这、这样啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:38:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2B 01}只是逛逛的话，倒也行。\n反正无聊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:38:1",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}{F5 C1 03 01 01 01 01 01 0B 01}……只是因为无聊哦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:39:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛丽也一起加入了文化祭游览……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:40:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 07 01}{F5 86 25 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2D 01}迪奥，你把那个脱了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:41:0",
