[
 {
  "key": "export_base/event/e800/e801_120.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞３Ｆ　摊位街……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞从手工工坊叫来迪奥，\n　两人一起逛文化祭……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥正好奇地观察摊位上的苹果糖……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 24 01 05 01 06 01 02 01}{F5 61 02 01 01 01 01 01 02 01}苹果……糖……\n苹果外面像糖一样，\n变得很硬……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}原来还有蜜汁多到\n溢出表面的苹果啊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}记得有些鸟类会吃苹果。\n啄着这黏糊糊的蜜汁外壳，\n鸟嘴不会被粘住吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:2:0",
  "message_id": "SEL_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}你是认真的？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:2:1",
  "message_id": "SEL_002",
  "translation": "{F2 05 FF FF}{F1 41}鸟也不容易啊{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 03 01 01 01 01 01 07 01}我……我当然知道。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 06 01}那个……鸟类也会适应这种苹果，\n随之进化吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞不知为何，迪奥一副很了不起的样子……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}{F5 C1 04 01 01 01 01 01 02 01}会不会有些鸟嘴上插着苹果，\n就再也动不了了呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 04 01 01 01 01 01 02 01}说不定将来还会发现那样的化石……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 04 01 01 01 01 01 02 01}倒是有点可怜……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥望向了远方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞苹果糖摊位前，\n站着玛丽……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 25 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 0A 01}我是苹果糖……\n不知如何融化的悲哀存在……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}……太普通了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛丽正独自嘀咕着什么……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 24 01 03 01 04 01 07 01}{F5 61 02 01 01 01 01 01 0C 01}哎呀，玛丽。\n真是美丽的诗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 04 01 01 01 01 01 02 01}没错，那是美丽的诗……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 25 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}……等等，呜诶！？\n你们什么时候来的！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:12:0",
  "message_id": "SEL_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}刚刚{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:12:1",
  "message_id": "SEL_012",
  "translation": "{F2 05 FF FF}{F1 41}在你不知如何融化之前{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}是、是吗？　那就好。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}什……什么啊，莫名其妙！\n笨蛋讨厌差劲悲哀的存在！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 11 01}我觉得这些词搭配得很美……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 12 01}也希望您能教教我。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 13 01}哈？\n……那、那就……用苹果糖写首诗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:17:0",
