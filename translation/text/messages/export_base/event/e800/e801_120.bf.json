  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 19 01}６０分。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:22:0",
