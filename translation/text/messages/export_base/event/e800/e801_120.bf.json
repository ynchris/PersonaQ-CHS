 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:20:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 02 01 01 01 02 01}{F5 86 01 01 02 01 01 01 04 01}{F5 86 24 01 03 01 04 01 07 01}{F5 61 02 01 01 01 01 01 18 01}怎么样？\n我想，这些词搭配起来\n相当可爱吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_120.bf.json:21:0",
