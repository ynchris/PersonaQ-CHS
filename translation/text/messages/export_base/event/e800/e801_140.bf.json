  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞迪奥在半生不熟厨房点了薯条……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_140.bf.json:8:0",
