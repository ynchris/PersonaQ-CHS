 {
  "key": "export_base/event/e800/e801_140.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 07 01}确实，他们是这么说的。\n那么，我去点餐。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_140.bf.json:7:0",
