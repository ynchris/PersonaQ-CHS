[
 {
  "key": "export_base/event/e800/e810_810.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这份委托来自希望匿名的\n“Ｘ先生”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}名字真令人好奇，\n不过，我也不知道是哪位，\n就由我来代为转述吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 07 01 01 01}{F5 61 02 01 01 01 01 01 CE 0E}那么……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白拿起了笔记本。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}大家好，我是Ｘ先生熊！\n谜团重重、传闻中的美男子熊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}听说月光馆的女生们\n个个都是迷人的宝贝……\n不一起喝茶可不行熊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}所以，希望老师\n帮忙把人约来熊！\n拜托你了熊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 3D 11}……以上，完全照原文念的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白把笔记本放回了桌上。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}也就是说，这次委托说白了，\n就是代为搭讪。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}为了提高委托的成功率，\n我将特别传授“搭讪的秘诀”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}根据迷茫青少年的必读杂志\n《美式热狗通信》记载……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}要瞬间察觉对方的兴趣，\n并巧妙地加以利用{F2 01 01 01}。\n请务必参考。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:4:4",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 40 11}另外，这份委托设有{F2 01 03 01}期限{F2 01 01 01}，\n敬请注意。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_810.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞在{F2 01 03 01}“校内散策”{F2 01 01 01}时，\n　试着和女生们聊聊吧……\n{F2 23 00 00}{F1 21}{00}"
 }
]