[
 {
  "key": "export_base/event/e800/e824_400.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}您终于承接了那项委托……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}那么，马上……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:1:0",
  "message_id": "MSG_0002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 06 01 01 01}{F5 61 02 01 01 01 01 01 04 01}姐姐！迪奥！\n紧急情况！紧急情况！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞听到伊丽莎白的呼喊，\n　玛格丽特和迪奥赶来了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}欢迎到来，光之勇者。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:4:0",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}……勇者？{F5 47 02 01 01 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:4:1",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}怎么突然这样{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 06 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 0B 01}我、我们乃邪恶大王，\n伊丽·莎·白及其仆从！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:5:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}请、请您乖乖束手就……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 05 01 02 01}{F5 61 02 01 01 01 01 01 08 01}束手就擒。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 06 01 01 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 0B 01}束手、就、就擒！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:8:0",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}……{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:8:1",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}我能回去了吗？{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 05 01 06 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}{F5 C1 03 01 01 01 01 01 07 01}尔等的恶行，上天与\n本王伊丽·莎·白都看在眼里！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 02 01}不顾玛·格丽特的负担，\n合体出无数人格面具之罪，\n休想抵赖！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:9:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 07 01}还让迪奥·小狗任劳任怨，\n制作海量装备，\n简直有违人道！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:9:3",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}{F5 C1 03 01 01 01 01 01 07 01}更有甚者，竟将本王伊丽·莎·白\n珍藏的布丁吃得一干二净，\n实在是罪大恶极！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:9:4",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 07 01 06 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 02 01}拔剑吧！\n现在就取你首级！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:10:0",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}布丁？{F5 47 02 01 01 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:10:1",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}这是什么情况？{F5 47 02 01 01 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0B 01 02 01 05 01}{F5 61 02 01 01 01 01 01 0F 01}……这场闹剧还要演到什么时候？\n都没法谈正事了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 05 01 01 01}{F5 61 02 01 01 01 01 01 10 01}姐姐。\n无论做什么，气氛都很重要。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:13:0",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 23 01 02 01 01 01 05 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 11 01}总之，基于上述理由，\n我发布了这项委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:13:1",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}内容很简单，\n就是“与我们战斗，并取得胜利”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:13:2",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 13 01}顺便一提，刚才的理由，\n除了布丁以外，全是无理指控。\n请放心。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:13:3",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 14 01}没错，当我发现那个布丁\n突然不见的时候……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 15 01}……够了。\n还是由我来说明吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:15:0",
  "message_id": "MSG_0122",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 05 01 02 01}{F5 86 23 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 16 01}委托内容就是你听到的那样。\n希望你们与我们三人战斗，并获胜。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:16:0",
  "message_id": "SEL_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}为什么发布这种委托？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:16:1",
  "message_id": "SEL_013",
  "translation": "{F2 05 FF FF}{F1 41}怎么突然这样{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:17:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}我们始终是命运的旁观者。\n这是我们的定数……\n本不该有任何异议。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:17:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 18 01}……可是，看着被命运摆布，\n却始终靠自己的双脚前进的你们，\n我们心中萌生了一个念头。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:18:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 19 01}我们也想凭借自己的力量，\n抓住些什么……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:18:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}想看看自己的极限，\n并跨越那道界限。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:18:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}想相信，自己也能有所作为……\n就是这样的念头。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:19:0",
  "message_id": "MSG_0152",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 06 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}我还无法很好地理解\n“想要相信”这种奇妙的感情……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:19:1",
  "message_id": "MSG_0152",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 06 01 01 01}{F5 61 02 01 01 01 01 01 1D 01}但此刻，我的胸中确实\n有着“想要相信”的愿望。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:20:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 05 01}{F5 61 02 01 01 01 01 01 1E 01}你们说过，\n人会因相遇而改变……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:20:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}那么，\n我们也在这里发生了改变。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:20:2",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}让我们改变的您，\n有义务见证它最终通往何处……\n难道不是吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:21:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 21 01}还请认真与我们切磋……\n不，是全力以赴地战斗。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:21:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 01}我们想和各位一起见证，\n战斗到最后，究竟能抓住什么。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:22:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 23 01}而且，我希望你们获胜。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:22:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 24 01}战胜掌管力量的我们，\n原本是绝不可能的事……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:22:2",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}我想感受你们创造那份不可能……\n不，是想要相信。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:22:3",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 26 01}……决战地点是天鹅绒房间。\n一切开始的地方。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_400.bf.json:23:0",
  "message_id": "MSG_0182",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 27 01}做好所有准备之后，再来吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]