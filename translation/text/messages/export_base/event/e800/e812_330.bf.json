[
 {
  "key": "export_base/event/e800/e812_330.bf.json:0:0",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２Ｆ　节目走廊\n　“阿坎纳电影节”前……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:1:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 02 01}{F5 86 23 01 01 01 01 01 05 01}{F5 61 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 05 01}阿坎纳……电影节……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特似乎对电影节很感兴趣……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:2:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞即将上映的电影似乎叫\n　《烤肉情未了：八十稻羽的幻影》……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 01}烤肉……？\n和肉有关吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 02 01 01 01 05 01}{F5 86 22 01 03 01 05 01 04 01}{F5 61 02 01 01 01 01 01 04 01}二位在做什么呢？\n就快开始了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 05 01}行动真快……\n那我们也进去吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞跟在伊丽莎白后面，\n　走进了举办阿坎纳电影节的教室……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞电影以某家火腿店为舞台，\n　讲述女子与化作幽灵的男子之间，\n　连鲜肉都会烤焦的炽热纯爱……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 04 01}{F5 61 02 01 01 01 01 01 06 01}哎呀，真是的。\n有灰尘进眼睛了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:10:0",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 02 01}你哭了吗？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:10:1",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}我有手帕{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 07 01}不，是因为教室里的\n灰尘实在太多。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:11:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 08 01}况且，询问一位少女\n是否在哭泣，\n未免有些失礼吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白叹着气……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 09 01}请不必费心。\n想来只是教室里的灰尘所致。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:13:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 12 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}不过，不愧是传闻中的羁绊大师。\n真懂得如何对待淑女呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白意味深长地微笑着……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 23 01 0A 01 02 01 05 01}{F5 61 02 01 01 01 01 01 0B 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}咦，姐姐也受了灰尘的影响？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}……不，我在想事情。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}刚才的电影令我一无所获，\n不知道这是否也是\n制作者的用意……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 03 01 01 01 01 01 07 01}这样可不行，姐姐！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:18:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}我们好歹也是女子。\n至少该表现出\n“呀～纯爱满满～☆”的兴趣。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 23 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 03 01 01 01 01 01 0A 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:19:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}{F5 C1 03 01 01 01 01 01 0B 01}呀、呀～纯爱满满～☆\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 13 01}{F5 C1 03 01 01 01 01 01 03 01}您在开玩笑吗，姐姐！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:20:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}动不动就赞叹纯爱，放声大哭。\n这才是少女！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 23 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:21:1",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 16 01}你是在模仿玛丽吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 17 01}玛丽小姐是位\n非常有趣的人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:22:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 18 01}尤其是她刻在信纸上的内心呐喊……\n那些我们根本想不到的词句……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:22:2",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}实在深奥……\n令人心痒难耐，恨不得抓挠一番……\n蕴藏着如此神奇的力量。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}是啊。\n写作人鱼公主，\n却要用英文来读呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}没错。\n微苦才是此刻心情，\n追不上的黎明前夕呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}丝线断了　我是牵线人偶\n精神被侵蚀　啪地一声死去了\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:25:1",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1D 01}啊啊　被碾碎的喉咙里\n穿堂风呼呼吹过\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:25:2",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1E 01}今宵的空气　何其寒冷啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 07 01 01 01}{F5 61 02 01 01 01 01 01 1F 01}傲慢的是这世界\n纯洁的是我热血\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:26:1",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 20 01}无尽地　只是无尽地……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:26:2",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 21 01}{F5 C1 03 01 01 01 01 01 07 01}ＹＯ！　ＭＥ～Ｎ！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞不知为何，诗歌对决开始了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:28:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 05 01 04 01}{F5 86 23 01 0B 01 02 01 05 01}{F5 61 02 01 01 01 01 01 22 01}呼……差不多了吧。\n那么，你的判定呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:29:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:30:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 23 01}我与姐姐，究竟是谁\n释放了更多的“激情”……\n请说说您的看法。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:31:0",
  "message_id": "SEL_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}玛格丽特{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:31:1",
  "message_id": "SEL_030",
  "translation": "{F2 05 FF FF}{F1 41}伊丽莎白{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:31:2",
  "message_id": "SEL_030",
  "translation": "{F2 05 FF FF}{F1 41}平手{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:32:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 26 01}{F5 C1 04 01 01 01 01 01 05 01}呵呵，\n我这可谈不上什么激情，\n不过是模仿罢了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:32:1",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 27 01}{F5 C1 03 01 01 01 01 01 08 01}不过……感觉倒是挺不错的……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:33:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特露出\n完成了一件大事般的\n笑容……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:34:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 24 01}是的，其实我已完全理解\n所谓的激情。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:34:1",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}那是激射而出、顷刻消逝的\n灵魂灯火……\n美丽而短暂的生命初啼……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:35:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白深深点着头……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:36:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 28 01}不愧是姐姐。\n方才的激情令我感触颇深。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:37:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 29 01}只是模仿玛丽罢了。\n不过，你也相当不错。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:38:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞两人亲密地互相称赞着……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:39:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 02 01 01 01 05 01}{F5 86 22 01 03 01 05 01 04 01}{F5 61 02 01 01 01 01 01 2A 01}可是，姐姐。\n不能就此满足。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:39:1",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2B 01}少女的养分是“亢奋”……\n也就是胸中的怦☆怦心跳……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:39:2",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2C 01}我们是不是稍微，不，\n极其缺乏这种感受呢？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:39:3",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2D 01}少女心可能已干涸到\n连激情都无法轻易涌现的地步……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:40:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2E 01}也不是没有可能。\n和迪奥、主人、玛丽相处时，\n完全感受不到什么“亢奋”呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:40:1",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2F 01}可是，该怎么做才好？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:41:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 30 01}那么，就让我在此\n为姐姐献上一点亢奋吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_330.bf.json:41:1",
  "message_id": "MSG_040",
