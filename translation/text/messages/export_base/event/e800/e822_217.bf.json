 },
 {
  "key": "export_base/event/e800/e822_217.bf.json:3:1",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 06 01}就是那个！\n每个房间至少都有１个的，\n那个东西啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_217.bf.json:3:2",
