[
 {
  "key": "export_base/event/e800/e820_305.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0F 0A}{F5 C1 03 01 01 01 01 01 0A 01}呼……\n要同时留意２支箭的去向，\n果然很费神。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 C7 07}那个天使射得真准啊。\n箭能笔直飞出去，一点也不偏。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 98 03}啊，对哦。\n由加莉也用弓嘛。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:3:0",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 11 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}好厉害啊。\n换成我肯定会射偏。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 02 01 04 01}{F5 61 02 01 01 01 01 01 BA 02}何止射偏，弓都会折断吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 94 03}{F5 C1 03 01 01 01 01 01 03 01}你什么意思啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 0E 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 01 01}不光是那个天使射得准……\n那种箭本身的性能似乎也很好。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:6:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}虽然躲起来很费劲，\n但如果能拿来使用，\n一定会是件好武器。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 04 01}{F5 61 02 01 01 01 01 01 A5 02}{F5 C1 03 01 01 01 01 01 0B 01}难道……您是让我们去抢！？\n从那么强的Ｆ．Ｏ．Ｅ手里！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 07 01}{F5 61 02 01 01 01 01 01 51 09}原来如此，好主意！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 25 0A}我只是打个比方！\n明知危险还往里冲，\n那只是鲁莽之举。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_305.bf.json:10:0",
  "message_id": "MSG_009",
