[
 {
  "key": "export_base/event/e800/e801_100.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}这份委托来自迪奥。\n那么，请稍等。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 05 01 01 01}{F5 61 02 01 01 01 01 01 03 01}迪奥——！\n迪奥————！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白正朝门外呼喊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 09 01 04 01 05 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 0B 01}让您久等了。\n请问有什么吩咐？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}{F5 C1 04 01 01 01 01 01 02 01}迪奥，太慢了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 04 01 01 01 01 01 02 01}这位客人接受了你的委托。\n来，说明一下吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 05 01}{F5 61 02 01 01 01 01 01 07 01}明白了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 05 01}{F5 61 02 01 01 01 01 01 08 01}我已经逐渐习惯在工坊帮忙，\n也稍微有了一点余暇。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 09 01}因此，我发出了委托，\n希望您陪我实现计划已久的\n“文化祭游览”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 05 01 02 01}{F5 61 02 01 01 01 01 01 0A 01}哎呀，文化祭游览……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0A 01 04 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}为什么不邀请我呢？\n你的姐姐正独自寂寞地\n在这里数木纹呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 05 01}您又说笑了。\n我已经陪姐姐逛过好多次了吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}我不记得了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 03 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 05 01}每次您都把水气球往我脸上砸，\n还用叫作风幡的玩具打我的脸！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:9:0",
  "message_id": "SEL_0081",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}那也太过分了{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:9:1",
  "message_id": "SEL_0081",
  "translation": "{F2 05 FF FF}{F1 41}那个叫吹卷哨{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:10:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 05 01}……。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:11:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 04 01 01 01 01 01 02 01}完全不记得了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 03 01 01 01 01 01 0A 01}……总之，客人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:12:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 12 01}准备好以后，\n请来找我说话。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:12:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}……那么，告辞。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 03 01 01 01 01 01 07 01}这就是传说中的叛逆期……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:13:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 15 01}弟弟实在不省心……还请您见谅。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞从菜单的{F2 01 03 01}“校内散步”{F2 01 01 01}中，\n　找迪奥说话吧……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e801_100.bf.json:14:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞此外，这似乎是一项{F2 01 03 01}限时{F2 01 01 01}委托。\n　注意不要错过期限……\n{F2 23 00 00}{F1 21}{00}"
 }
]