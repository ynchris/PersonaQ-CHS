[
 {
  "key": "export_base/event/e800/e821_210.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这份委托来自真田明彦先生。\n我去请他过来，请稍等。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}让您久等了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 0D 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 98 09}这次特训很简单。\n在{F2 01 03 01}一次探索中{F2 01 01 01}尽可能\n{F2 01 03 01}多打几场战斗{F2 01 01 01}。仅此而已。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}地点限定在{F2 01 03 01}放学后的恶灵俱乐部{F2 01 01 01}\n的{F2 01 03 01}最初楼层{F2 01 01 01}。\n深入迷宫会有危险。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}另外，训练也需要适当休息。\n每进行３组对练，就休息１次。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 BB 09}进入那个楼层后，我会叫住你。\n到时再详细说明。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:2:4",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}做好万全准备再来！我等着你。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞真田离开了保健室……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}总觉得保健室的温度\n好像升高了１度……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_210.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 11 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D7 0E}不过，各位能变得更强，\n实在令人欣喜。\n我会在凉快的这里为各位加油。\n{F2 23 00 00}{F1 21}{00}"
 }
