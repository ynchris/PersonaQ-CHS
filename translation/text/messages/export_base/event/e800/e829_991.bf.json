[
 {
  "key": "export_base/event/e800/e829_991.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 24 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 9A 0F}欢迎光临。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}听姐姐说，您承接了\n与素材有关的委托……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 64 0F}只要是我能回答的，\n请尽管询问。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞回想一下承接的委托……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞除此之外……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞似乎没有其他需要向迪奥询问的事了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞受托寻找蛇皮素材，\n　用于调配传说之药……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 06 01 02 01}{F5 61 02 01 01 01 01 01 62 0F}蛇皮的话……\n蜕下来的皮应该也可以。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我记得，{F2 01 03 01}“联谊咖啡厅”{F2 01 01 01}里，\n有一种{F2 01 03 01}黑蛇形状的阴影{F2 01 01 01}。\n应该能从它身上取得。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:6:0",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过……想拿到完整的蛇蜕，\n可不能让它四处扭动。\n不然会弄得破破烂烂。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:6:1",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}所以，{F2 01 03 01}封住蛇的快速行动{F2 01 01 01}，\n应该就能得到完好的蛇蜕。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:6:2",
  "message_id": "MSG_0052",
  "translation": "{F2 05 01 FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……也许这是一种只有在\n特殊条件下才能取得的素材。\n不妨尝试不同的方法。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:7:0",
  "message_id": "MSG_0053",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞将阴影{F2 01 03 01}情欲之蛇{F2 01 01 01}\n　在{F2 01 03 01}速封印状态下击败{F2 01 01 01}，\n　似乎就能获得素材……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:8:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞受托寻找男孩子们都想要的\n　邪眼素材……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:9:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 06 01 02 01}{F5 61 02 01 01 01 01 01 6A 0F}邪眼……吗。\n姐姐又在订购奇怪的东西了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:9:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}出现在“放学后的恶灵俱乐部”{F2 01 01 01}的\n{F2 01 03 01}巨大搜索者{F2 01 01 01}，据说额头上的眼睛\n拥有施加诅咒的力量。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:10:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}至于取得的方法……\n要封住诅咒的力量，\n不妨试试{F2 01 03 01}反过来诅咒它{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:11:0",
  "message_id": "MSG_0073",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞将阴影{F2 01 03 01}命运搜寻者{F2 01 01 01}\n　在{F2 01 03 01}诅咒状态下击败{F2 01 01 01}，\n　似乎就能获得素材……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:12:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞受托寻找尾巴素材，\n　让委托人享受毛茸茸的触感……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:13:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 5A 0F}毛茸茸的尾巴……\n有一种阴影正好符合要求。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:13:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}“稻羽乡土展”{F2 01 01 01}里，\n有一种像轮胎与狮子结合的{F2 01 03 01}堡垒{F2 01 01 01}型\n阴影，它就长着尾巴。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:13:2",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}虽然也有白色的，但那是石膏。\n请寻找{F2 01 03 01}“绿色”的那种{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:13:3",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}想让它保持蓬松的状态，\n不妨{F2 01 03 01}用风吹拂{F2 01 01 01}一下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:14:0",
  "message_id": "MSG_0092",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞将阴影{F2 01 03 01}急速之轮{F2 01 01 01}\n　{F2 01 03 01}用风属性攻击击败{F2 01 01 01}，\n　似乎就能获得素材……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:15:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞受托寻找白金齿轮素材，\n　作为在这个世界的纪念……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:16:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 06 01 02 01}{F5 61 02 01 01 01 01 01 79 0F}那份素材，应该能从\n栖息在{F2 01 03 01}“时钟塔”{F2 01 01 01}的白金色阴影……\n{F2 01 03 01}爆裂装置{F2 01 01 01}身上取得。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:16:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}如果用魔法或物理攻击给予最后一击，\n恐怕会留下损伤。\n{F2 01 03 01}一击必杀的暗或光属性{F2 01 01 01}会派上用场。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:17:0",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……虽说如此，我记得\n它对其中一种属性有抗性。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:17:1",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}详情请查看那个叫作\n敌人图鉴的东西。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:18:0",
  "message_id": "MSG_0113",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞将阴影{F2 01 03 01}爆裂装置{F2 01 01 01}\n　{F2 01 03 01}用暗或光属性攻击击败{F2 01 01 01}，\n　似乎就能获得素材……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:19:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玲委托你寻找尖刺素材，\n　用于制作送给善的项圈……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:20:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 04 01 02 01}{F5 61 02 01 01 01 01 01 6A 0F}我已经听姐姐说了。\n真是一件美好的事情。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:21:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}关于礼物……\n后来进展如何？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:22:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 95 0F}尖刺素材由{F2 01 03 01}“稻羽乡土展”{F2 01 01 01}里的\n{F2 01 03 01}独眼巨人{F2 01 01 01}型阴影掉落。\n它被绑在圆盘状的金属上。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:22:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}如果处于魔力被封印的状态{F2 01 01 01}，\n或许也能起到护身符的作用。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:22:2",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}取得后，请去找玲大人谈谈。\n我会做好制作的准备。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:23:0",
  "message_id": "MSG_0152",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞将阴影{F2 01 03 01}愤怒独眼巨人{F2 01 01 01}\n　在{F2 01 03 01}魔封印状态下击败{F2 01 01 01}，\n　似乎就能获得素材……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:24:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 53 0F}{F5 C1 03 01 01 01 01 01 07 01}……哎呀？\n看来您已经有那份素材了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:24:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}请马上去叫玲大人过来。\n我会在这里做好准备。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:25:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞不要卖掉素材，\n　从菜单的{F2 01 03 01}“校内散步”{F2 01 01 01}中，\n　去找玲说话吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e829_991.bf.json:26:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}能帮上忙，我就很荣幸了。\n{F2 23 00 00}{F1 21}{00}"
 }
]