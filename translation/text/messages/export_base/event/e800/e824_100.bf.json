[
 {
  "key": "export_base/event/e800/e824_100.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 2D 11}您已经变得很强了……\n所以这次我准备了一项\n高难度委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_100.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}栖息在时钟塔的稀有阴影{F2 01 01 01}，\n{F2 01 03 01}荣华之手{F2 01 01 01}……击败它后\n能得到珍贵素材{F4 84 04 01 01 01 18 09}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_100.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}希望您能将它交给我。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_100.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}光是找到它就很费劲，\n好不容易遇上，它又会立刻逃跑……\n想必是相当困难的委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_100.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 E4 0E}不过，\n如今的您一定能完成……\n我对此充满期待。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_100.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 22 01 02 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_100.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 33 11}话虽如此……\n您现在身上带着的\n那个{F4 84 04 01 01 01 18 09}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_100.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}正是我刚刚委托您寻找的素材。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_100.bf.json:1:3",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}只要向我汇报并交出素材，\n现在就能完成委托。\n还请您积极考虑。\n{F2 23 00 00}{F1 21}{00}"
 }
