[
 {
  "key": "export_base/event/e800/e820_480.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞联谊咖啡厅入口……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 02 01}{F5 86 09 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 CD 06}各位。\n接下来，由我说明我们的推理……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 02 01 07 01}{F5 61 02 01 01 01 01 01 83 03}等等，迪奥先生！\n……是真的吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 91 0F}{F5 C1 03 01 01 01 01 01 04 01}是的……非常抱歉。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……就这样？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:5:0",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 04 01 01 01}{F5 61 02 01 01 01 01 01 76 03}比如肚子实在太饿了，\n或者看起来太好吃，忍不住就……\n总有个理由吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 6A 06}……有些原因，\n迪奥多先生无法亲口解释。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 09 01 04 01 01 01}{F5 61 02 01 01 01 01 01 95 03}{F5 C1 03 01 01 01 01 01 05 01}原因……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}里中学姐。\n您放肉羊羹的地方，\n就是这张桌子上，没错吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞直斗指着联谊咖啡厅入口的桌面……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 07 01}是、是没错……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}还记得那次开始探索前，\n花村学长在这张桌子的桌角上……\n那个……撞到要害的事吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 50 03}{F5 C1 04 01 01 01 01 01 07 01}嗯……咦，\n可是当时没事啊？\n肉羊羹。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 07 01}啊，对，是有这么回事。\n{F1 81}同学可能不知道……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:13:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 50 03}{F5 C1 04 01 01 01 01 01 07 01}……咦？\n可当时肉羊羹没事啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 01 01}{F5 61 02 01 01 01 01 01 3C 06}没错……\n事情发生在我们进入迷宫之后。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:14:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}花村学长撞到桌子，\n使桌上的黑板移了位。\n之后关门的震动，又让黑板倒了下来。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:14:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}于是，肉羊羹就被压在下面……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:14:3",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……我已经请虎狼丸闻过气味，\n验证了这一点。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 6B 11}{F5 C1 03 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 07 01}压、压在下面！？\n可是……这里没有那种痕迹啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 07 01}{F5 86 09 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}直到此时……\n迪奥多先生才登场。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}迪奥多先生。\n您把这一切都掩盖了，对吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 24 01 02 01 04 01 01 01}{F5 61 02 01 01 01 01 01 61 0F}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……白钟大人。\n您已经看穿了一切吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……不。\n我所查明的，到此为止。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:18:1",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}接下来，还请您亲口说明……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 24 01 02 01 04 01 01 01}{F5 61 02 01 01 01 01 01 61 0F}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:19:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……我来到这里时，\n各位刚刚进入迷宫……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:19:2",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}我也清楚地听到了花村大人的惨叫，\n以及里中大人的怒吼。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 05 01}……怒吼？\n我有怒吼吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 06 01 01 01}{F5 61 02 01 01 01 01 01 59 0F}是的……\n“这块肉羊羹要是有个三长两短，\n你的小命可就没了。”\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}里中学姐，您说过这句话吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0F 01 04 01 01 01}{F5 61 02 01 01 01 01 01 DD 03}{F5 C1 03 01 01 01 01 01 0B 01}咦，没有吧，嗯……啊哈哈……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 04 01}{F5 86 05 01 02 01 01 01 07 01}{F5 86 24 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}之后就如白钟大人推理的那样。\n门关上了，黑板倒下了，\n肉羊羹惨不忍睹地四散飞溅……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:24:1",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 04 01}目睹整个经过的，只有我。\n也就是说，掌握着花村大人命运的，\n只有我一个人……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 72 06}所以，您清理了现场，对吧？\n让肉羊羹看上去像是被人偷走了，\n以便让案件成为悬案。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 06 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……确实，\n花村大人的行为有过失。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:26:1",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}可是，即便如此……！\n这难道是足以丧命的过错吗……！\n我站在这里，反复问着自己。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:26:2",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}回过神来，我已经把这里清扫干净……\n将真相埋葬在了黑暗之中。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 64 03}{F5 C1 03 01 01 01 01 01 0A 01}不，那个……\n我说什么小命，只是夸张的说法啦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:28:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 78 0F}{F5 C1 03 01 01 01 01 01 07 01}原、原来如此！？\n我还以为……您真的要取他性命……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:29:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 62 03}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}才不会啦！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:30:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 05 01 03 01 01 01}{F5 61 02 01 01 01 01 01 CC 06}……谜题解开了。\n原来，这是迪奥多先生的好意，\n与里中学姐的毒舌共同引发的案件。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:31:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 04 01}{F5 86 05 01 07 01 01 01 07 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 04 01}呜呜……\n这就是所谓的自作自受吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:32:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}里中大人。\n我知道这不是道歉就能被原谅的事……\n但还是要说，真的非常抱歉。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:33:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0B 01}不、不会！\n都怪我说了那么过分的话，\n而且弄倒东西的是花村啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:33:1",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7C 03}{F5 C1 03 01 01 01 01 01 0A 01}倒不如说，\n害你不得不说谎，对不起！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:34:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 C1 03 01 01 01 01 01 0B 01}不、不……！里中大人，\n您不必低头道歉……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:35:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞看来事情圆满解决了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:36:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 48 06}看来这下结案了呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:37:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 A6 02}{F5 C1 03 01 01 01 01 01 0A 01}……咦？\n所以说，都是我的错？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:38:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D5 0E}不，这件事完全是迪奥的错。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:39:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}姐、姐姐……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:40:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 38 11}最不可原谅的是，\n竟然作伪证，\n想把罪名推给我这个姐姐……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:41:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 04 01 01 01}{F5 61 02 01 01 01 01 01 91 0F}{F5 C1 03 01 01 01 01 01 0B 01}非、非常抱歉！\n我以为，要想扰乱调查，\n姐姐是最合适的人选……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:42:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 59 11}我可不记得把弟弟教成了这样……！\n姐姐好伤心……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:43:0",
  "message_id": "MSG_0412",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 07 01 01 01}{F5 61 02 01 01 01 01 01 4F 11}{F5 C1 03 01 01 01 01 01 0B 01}呜呜……！\n哇啊啊……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:44:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白装哭的样子\n　十分明显……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:45:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 DC 0F}啊，迪奥。\n这样可不行哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:46:0",
  "message_id": "MSG_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 01 01}{F5 61 02 01 01 01 01 01 8F 0F}{F5 C1 03 01 01 01 01 01 07 01}啊，不，那个……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_480.bf.json:47:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 FD 0E}为了表达歉意，就……\n请各位吃顿饭吧。\n在场所有人都要请哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
