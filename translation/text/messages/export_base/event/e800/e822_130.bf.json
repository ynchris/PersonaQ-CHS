  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}不用客气，尽管使出全力。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_130.bf.json:3:0",
