 {
  "key": "export_base/event/e800/e822_130.bf.json:1:0",
  "message_id": "MSG_0002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 04 01}这次会比上次稍微加点力。\n请不必客气……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_130.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0D 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 05 01}你才是，太小看我们，\n可是要吃苦头的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_130.bf.json:2:1",
