[
 {
  "key": "export_base/event/e800/e821_510.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这项委托来自花村阳介先生。\n我这就叫他过来，请稍等。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 29 11}让您久等了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 04 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 91 02}紧急事态。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 C0 02}{F5 C1 03 01 01 01 01 01 04 01}就因为我不小心说了句想吃火锅……\n她们就开始行动了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:3:0",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}她们？{F5 47 02 01 01 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:3:1",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}辛苦了{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 BE 02}{F5 C1 02 01 01 01 01 01 02 01}还用问吗！？\n就是那几个怪物女生啊！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}她们说要做火锅给我吃！\n还要集合所有人的力量！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 BF 02}{F5 C1 02 01 01 01 01 01 02 01}别在一旁看戏啊！！\n这可是同伴的危机！\n你是队长吧！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}她们说要做火锅给我吃啊！\n而且是集合所有人的力量啊！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 F1 02}还记得上次的火锅风波吗？\n女生们说要做火锅，\n我们就偷偷溜走的那次。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}看来那个计划\n至今还在进行。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 A7 02}{F5 C1 03 01 01 01 01 01 04 01}那些料理怪物\n会追我们到天涯海角吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 C0 02}她们的料理……不，那根本就是垃圾，\n已经害我吃尽苦头了……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}再这样下去，我的胃……\n会烂掉的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:7:2",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A8 02}所以，我想拜托身为队长的你，\n去盯着她们做饭。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:7:3",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}她们擅自占了个摊位。\n快在她们做好之前过去。\n我把委托设成{F2 01 03 01}有期限的{F2 01 01 01}了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:7:4",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 03}那就拜托你了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_510.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞从菜单的{F2 01 03 01}“校内散步”{F2 01 01 01}\n　前往摊位那边看看吧……\n{F2 23 00 00}{F1 21}{00}"
 },
