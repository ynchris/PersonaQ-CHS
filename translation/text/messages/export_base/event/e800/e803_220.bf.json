[
 {
  "key": "export_base/event/e800/e803_220.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞美食广场……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞美鹤和顺平摊开了笔记本。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 02 01 01 01 02 01}{F5 86 01 01 02 01 01 01 04 01}{F5 86 0E 01 0B 01 02 01 07 01}{F5 61 02 01 01 01 01 01 F5 09}你来了啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:2:0",
  "message_id": "MSG_0012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……那么，伊织，怎么样？\n课本上的范围我都讲过一遍了，\n理解了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 C0 08}{F5 C1 03 01 01 01 01 01 07 01}……不可能啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:3:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0B 01}我要是有那种能一下记住\n咒语似的公式的脑子，\n就不用在这里请您教我了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 0A}{F5 C1 03 01 01 01 01 01 04 01}别破罐子破摔……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 88 08}{F5 C1 03 01 01 01 01 01 0A 01}而且这里正在办文化祭啊？\n也太不适合学习了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0E 01 02 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1F 0A}……。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 A8 08}{F5 C1 03 01 01 01 01 01 07 01}啊，骗、骗您的啦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3D 0A}……说得也是。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 03 01}{F5 86 0C 01 04 01 03 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 05 01}诶？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}伊织。\n换一种教学方式吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:10:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 0A}难得是文化祭。\n把它当成问答游戏之类的吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}游戏？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 4E 0A}游戏需要对手呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:12:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F1 81}。\n就拜托你了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:13:0",
  "message_id": "SEL_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}交给我吧{F5 47 02 01 01 01 03 01 01 01}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:13:1",
  "message_id": "SEL_012",
  "translation": "{F2 05 FF FF}{F1 41}没什么自信{F5 47 02 01 01 01 07 01 01 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 21 0A}呵呵……真可靠。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 16 0A}{F5 C1 04 01 01 01 01 01 07 01}那你也在这里学会吧。\n你的考试范围和伊织一样吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 0E 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 01 01}一共３道题。\n都是４选１，但不抢答。\n可以慢慢想。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 0A}答对更多题目的人获胜。\n我会给出你们想要的奖品。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 13 09}哦哦哦，好嘞——！\n我绝对不会输！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞要和顺平展开问答对决了……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3D 0A}第１题……开始之前。\n伊织，考试范围是什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 83 08}呃，历史是……战国时代。\n不过小野老师一直都在讲战国。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:20:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}战国时代平民的文化什么的……\n啊，说过什么祭典、什么舞蹈来着……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:21:0",
  "message_id": "MSG_0192",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 88 08}{F5 C1 03 01 01 01 01 01 04 01}完全……没兴趣……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:22:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 4E 0A}那首先，\n就让你对文化产生兴趣吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:23:0",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}第１题。\n各个国家和地区的祭典形式多样，\n也有令人惊讶的内容。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:23:1",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}下面我会举出４种祭典。\n其中３种我参加过，\n还有１种是我临时编造的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:23:2",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3D 0A}那么，哪一种是我临时想出来的、\n“不存在的祭典”呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:24:0",
  "message_id": "SEL_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}围着基督的坟墓跳舞{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:24:1",
  "message_id": "SEL_021",
  "translation": "{F2 05 FF FF}{F1 41}发射自制火箭{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:24:2",
  "message_id": "SEL_021",
  "translation": "{F2 05 FF FF}{F1 41}喝下１００升水{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:24:3",
  "message_id": "SEL_021",
  "translation": "{F2 05 FF FF}{F1 41}５秒内结束{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:25:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 E2 08}我选５秒内结束的祭典。\n那根本没意义吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:26:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 22 0A}哼……\n两个人都答错了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:27:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 86 08}{F5 C1 03 01 01 01 01 01 01 01}诶，真的！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:28:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}答案是喝下１００升水的祭典。\n世界再大，也不会有这么危险的祭典吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:28:1",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……大概。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:29:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞双方都是０分……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:30:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 E2 08}我选５秒内结束的祭典。\n那根本没意义吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:31:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 56 0A}{F1 81}，答对了。\n世界再大，也不会有\n喝下１００升水这种祭典吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:32:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 86 08}{F5 C1 03 01 01 01 01 01 01 01}诶，真的！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:33:0",
  "message_id": "MSG_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞获得了１分！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:34:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 E2 08}我也选５秒内结束的祭典。\n那根本没意义吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:35:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 22 0A}哼……\n两个人都答错了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:36:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 86 08}{F5 C1 03 01 01 01 01 01 01 01}诶，真的！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:37:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}答案是喝下１００升水的祭典。\n世界再大，也不会有这么危险的祭典吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:37:1",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……大概。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:38:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞双方都是０分……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:39:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 88 11}{F5 C1 03 01 01 01 01 01 0B 01}话说，其他祭典真的存在？\n而且您还参加过！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:40:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 21 0A}我和父亲一起受邀参加的……\n这也是常有的事。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:41:0",
  "message_id": "MSG_0372",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 65 0A}怎么样？\n说起文化，往往让人觉得严肃枯燥，\n但归根结底就是人们的生活。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:41:1",
  "message_id": "MSG_0372",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}是不是稍微觉得亲近一点了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:42:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0B 01 03 01 01 01}{F5 61 02 01 01 01 01 01 84 08}{F5 C1 03 01 01 01 01 01 0A 01}算是吧……\n奇怪祭典的事，我倒是弄明白了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:43:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 13 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}祭典与文化、宗教、历史、地理……\n乃至社会学的各个方面相通。\n掌握这些知识总没有坏处。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:44:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 B4 08}原来如此……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:45:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}那么，第２题。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:45:1",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}一般认为夏秋两季祭典较多。\n夏季多为祈求健康，\n毕竟过去夏季容易发生饥荒。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:45:2",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3D 0A}那么，秋季举行的祭典，\n一般以什么为目的？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:46:0",
  "message_id": "SEL_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}祈求天气安稳{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:46:1",
  "message_id": "SEL_042",
  "translation": "{F2 05 FF FF}{F1 41}感谢五谷丰收{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
