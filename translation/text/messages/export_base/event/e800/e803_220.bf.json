  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……那个在下个月。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e803_220.bf.json:109:0",
  "message_id": "MSG_104",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 03 01 01 01}{F5 61 02 01 01 01 01 01 86 08}{F5 C1 03 01 01 01 01 01 02 01}不会吧！？\n那不是根本不用学习了吗！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
