  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我本想立刻向您展示……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e829_993.bf.json:0:3",
