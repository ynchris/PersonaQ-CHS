[
 {
  "key": "export_base/event/e800/e821_310.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}放学后的恶灵俱乐部{F2 01 03 01}第一怪{F2 01 01 01}……\n有一间传出钢琴声的音乐教室，\n那里有一扇{F2 01 03 01}打不开的门{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}希望您前去调查，\n把那扇门打开。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 04}{F5 C1 04 01 01 01 01 01 03 01}打扰了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 0D 04}咦，{F1 81}。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 05 01 01 01}{F5 61 02 01 01 01 01 01 35 11}哦，天城雪子小姐。\n请问有什么事吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 73 04}那个，我想来\n发布一项委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我想查清楚，为什么放学后的恶灵\n俱乐部里，音乐教室的门打不开……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2C 11}{F5 C1 04 01 01 01 01 01 02 01}哎呀，真是太巧了。\n我也正好在为这件事，\n向这位提出委托呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A0 04}啊，原来是这样。\n那我也搭个便车吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}有件事想拜托你……\n能带上我一起去吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}做这个委托的时候，\n记得把我编入队伍哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D7 0E}有无所畏惧的天城雪子小姐同行，\n想必一定能揭开\n这起怪异现象的真相。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_310.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2A 11}啊，另外……\n这项委托{F2 01 03 01}有期限限制{F2 01 01 01}。\n还请尽早完成。\n{F2 23 00 00}{F1 21}{00}"
 }
]