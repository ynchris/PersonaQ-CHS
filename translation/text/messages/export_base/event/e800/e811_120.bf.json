 },
 {
  "key": "export_base/event/e800/e811_120.bf.json:11:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞难道玛丽是因为找不到诗歌题材，\n　所以才心情不好……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e811_120.bf.json:12:0",
  "message_id": "MSG_011",
