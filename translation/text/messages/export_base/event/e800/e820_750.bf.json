 {
  "key": "export_base/event/e800/e820_750.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3B 11}{F5 C1 04 01 01 01 01 01 02 01}如果要形容的话，没错，是丰饶。\n{F2 23 00 00}{F1 21}"
 },
 {
