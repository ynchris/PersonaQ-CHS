[
 {
  "key": "export_base/event/e800/e810_832.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞过了一会儿……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞由加莉来了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 E3 06}{F5 C1 03 01 01 01 01 01 07 01}啊，小由！\n这边熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 AA 07}咦，这不是小熊嘛。\n你怎么在这儿？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 9E 07}熊也被邀请来了。\n被神秘男子Ｘ先生邀请的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 04 01 04 01}{F5 61 02 01 01 01 01 01 3E 08}啊，Ｘ先生还挺有名呢。\n看来这趟没白来。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 81 07}{F5 C1 03 01 01 01 01 01 08 01}对对，来对了熊！\n因为，不瞒你说，Ｘ先生就是……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 DA 07}改变过上千人人生的，\n超级灵验的占卜师……对吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0B 01 01 01 02 01}{F5 86 0B 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 D8 07}{F5 C1 03 01 01 01 01 01 08 01}果然名不虚传呢。\n好期待他能说中些好事。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 75 07}{F5 C1 03 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}占、占卜，什么……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:8:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 02 01 01 01 04 01}{F5 86 0A 01 11 01 03 01 02 01}{F5 61 02 01 01 01 01 01 F6 06}……小由，抱歉熊。\n那个人不是Ｘ先生……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:9:0",
  "message_id": "MSG_0073",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 09 01 06 01 02 01}{F5 61 02 01 01 01 01 01 01 07}{F5 C1 03 01 01 01 01 01 0A 01}真正的Ｘ先生，是所谓的……\n疯狂棍术高手熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:10:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 7F 11}{F5 C1 03 01 01 01 01 01 05 01}疯……？\n抱歉，那是什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:11:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 B5 11}{F5 C1 03 01 01 01 01 01 0B 01}小由看了大概也会觉得\n一点都不好玩熊。\n还是回去比较好熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 11 01 02 01 04 01}{F5 61 02 01 01 01 01 01 7D 11}什么嘛……\n那我还是去\n玛格丽特小姐那里看看吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0A 07}这样比较好熊。\n玛格丽特大人算得很准熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞由加莉回去了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 0A 01 11 01 03 01 02 01}{F5 61 02 01 01 01 01 01 0C 07}{F5 C1 03 01 01 01 01 01 0A 01}老师？\n到底怎么邀请才能变成这样熊？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:15:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 00 06}唔……\n对后面也有种不好的预感……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_832.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞等其他女生来吧……\n{F2 23 00 00}{F1 21}{00}"
 }
]