  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 07 01 02 01 02 01}{F5 61 02 01 01 01 01 01 07 01}那种话就免了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e811_100.bf.json:5:0",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 08 01}总之就是很无聊。\n来邀请我。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e811_100.bf.json:5:1",
