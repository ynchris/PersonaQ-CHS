 },
 {
  "key": "export_base/event/e800/e811_100.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0E 01 05 01 01 01}{F5 61 02 01 01 01 01 01 06 01}真是不含任何多余信息的说明。\n不愧是……\n{F2 23 00 00}{F1 21}{00}"
