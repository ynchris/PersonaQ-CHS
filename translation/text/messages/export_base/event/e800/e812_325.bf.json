[
 {
  "key": "export_base/event/e800/e812_325.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２Ｆ　节目走廊\n　“兴奋畅玩乐园”前……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 23 01 02 01 01 01 05 01}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}“兴奋畅玩乐园”……！\n多么令人心动的名字。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}……是吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 04 01}咦，那边似乎\n正在举办什么比赛。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}“套圈”……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 06 01}{F5 C1 03 01 01 01 01 01 05 01}把圆环扔出去……\n是要切开空气吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:4:0",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}把圆环扔向木棒{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:4:1",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}把圆环扔向人{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 07 01}也就是说，\n要用扔出的圆环\n把木棒劈成两半吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}{F5 C1 03 01 01 01 01 01 07 01}……啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}我听说过。\n万物都有某个“点”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:5:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}只要击中那个点，\n无论多么巨大的物体，\n都会立刻粉碎。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:5:4",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}说不定能请教到那秘孔所在。\n容我去一趟。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白自顾自地想通了，\n　走进兴奋畅玩乐园……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}{F5 C1 03 01 01 01 01 01 07 01}哎呀，是要切开人吗？\n竟在这种庆典中举办这种活动……\n人性当真可怕……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}虽说兴致不高，\n但似乎有必要调查一下具体形式。\n容我去一趟。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白步履轻快地\n　走进兴奋畅玩乐园……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 05 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}还是这么随心所欲呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:10:0",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}这样才有趣{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:10:1",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}是姐姐没管教好{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}也可以这么说呢……\n不过，她偶尔会做出\n令人无法理解的举动。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 10 01}呵呵，可无论被她怎么折腾，\n就是讨厌不起来呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特露出温和的微笑……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}{F5 C1 04 01 01 01 01 01 05 01}我做不到。\n不如说，谁都做不到。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:14:0",
  "message_id": "MSG_0132",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}……说起来，你好像\n和一个小女孩住在一起吧？\n不如让我见识一下你的本事。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特叹着气……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0C 01 02 01 01 01}{F5 61 02 01 01 01 01 01 13 01}那孩子一定是想拓宽自己的世界吧。\n感兴趣的事物总在不断变化……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}一转眼，就又不知\n消失到哪里去了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特望着伊丽莎白离去的方向……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞她们之间发生过什么吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:18:0",
  "message_id": "SEL_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}发生什么事了吗？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:18:1",
  "message_id": "SEL_017",
  "translation": "{F2 05 FF FF}{F1 41}……{00}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}……没想到，你也会这样\n冒冒失失地闯入少女的内心呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特避开了话题……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}……你真温柔。\n面对这么意味深长的沉默，\n也没有忍不住追问呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特微笑着……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}其实……告诉你也无妨。\n关于我和伊丽莎白的事……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:23:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}不，应该说，\n在你我原来的世界里，\n伊丽莎白正在做什么……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:23:2",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}……但如果说出来，\n你一定会为此苦恼。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:23:3",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}那或许会改变\n你前进的道路……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:23:4",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}所以，总有一天……\n等那个“时刻”到来，再告诉你吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特凝望着远方……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1C 01}{F5 C1 03 01 01 01 01 01 05 01}……咦？\n那是什么？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特迈开了脚步……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_325.bf.json:26:1",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞跟上去吧……\n{F2 23 00 00}{F1 21}{00}"
 }
]