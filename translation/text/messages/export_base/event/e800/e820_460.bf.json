 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 0F}哎呀……真是自信满满呢。\n那么，你有证据吗？\n为什么认定我就是犯人？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞告诉玛格丽特，\n　自己把她的证词反过来考虑了一遍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 01 01}把证词反过来吗。\n那就试试看吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我不是犯人。\n玛丽没有说谎。\n把这两句话反过来，就是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我是犯人。\n玛丽在说谎……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:6:3",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……这不是很奇怪吗？\n这样一来，玛丽也是犯人了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:6:4",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 02 01}{F5 61 02 01 01 01 01 01 EE 0E}这与“犯人会说谎”和\n“犯人只有一个”的前提相矛盾……\n没关系吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 08 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特说得确实没错……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0D 0F}那么……\n冤枉我的代价会是什么呢？\n我很期待哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞看来玛格丽特不是犯人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞重新考虑一下吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 C1 0F}{F5 C1 03 01 01 01 01 01 03 01}哈？\n都说了我什么也没做。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 05 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}大家总是这样随便认定。\n太卑鄙了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞告诉玛丽，\n　自己把她的证词反过来考虑了一遍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 01 01}反过来？\n呃……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我不是犯人，犯人在说谎。\n反过来就是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:12:2",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我是犯人。\n犯人没有说谎……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:13:0",
  "message_id": "MSG_0122",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……很奇怪啊，太奇怪了。\n前提不是说，犯人在说谎吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:13:1",
  "message_id": "MSG_0122",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}连最初的前提都矛盾了。\n矛盾，知道吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛丽说得确实没错……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 25 01 05 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F2 0F}……笨蛋讨厌矛盾侦探！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 08 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞看来玛丽不是犯人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞重新考虑一下吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞以{F2 01 03 01}犯人一定在说谎，\n　而且犯人只有一人{F2 01 01 01}为前提，\n　回想一下各人的证词吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛丽说：\n　{F2 01 03 01}“我不是犯人，\n　犯人会说谎。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:17:2",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特说：\n　{F2 01 03 01}“玛丽没有说谎，\n　我不是犯人。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:17:3",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥说：\n　{F2 01 03 01}“我不是犯人，\n　伊丽莎白才是犯人。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:17:4",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白只说：\n　{F2 01 03 01}“犯人就在我们姐弟三人之中。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_460.bf.json:17:5",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞犯人究竟是谁呢……\n{F2 23 00 00}{F1 21}{00}"
 }
]