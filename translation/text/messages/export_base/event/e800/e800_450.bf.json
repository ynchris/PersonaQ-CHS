[
 {
  "key": "export_base/event/e800/e800_450.bf.json:0:0",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２Ｆ　节目走廊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:1:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 48 06}四人的证词已经收集齐了。\n在这里回顾一下吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 02 01}{F5 61 02 01 01 01 01 01 01 01}首先是玛丽小姐，她说，\n{F2 01 03 01}自己不是犯人，\n犯人在说谎{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:2:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}接着是玛格丽特小姐，她说，\n{F2 01 03 01}玛丽小姐没有说谎，\n自己不是犯人{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:2:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}接着是迪奥多先生，他说，\n{F2 01 03 01}自己不是犯人，\n伊丽莎白小姐才是犯人{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:2:3",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}最后是伊丽莎白小姐，她只说，\n{F2 01 03 01}犯人是玛丽小姐以外的人{F2 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:2:4",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}假设犯人在说谎，\n其他人都说真话……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:2:5",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}把证词的意思反过来，\n与前提对照{F2 01 01 01}，\n也许就能找到突破口。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:3:0",
  "message_id": "SEL_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}有个可疑的人{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:3:1",
  "message_id": "SEL_002",
  "translation": "{F2 05 FF FF}{F1 41}犯人不是我！{F5 47 02 01 01 01 05 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:3:2",
  "message_id": "SEL_002",
  "translation": "{F2 05 FF FF}{F1 41}请再说一遍{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 44 06}{F5 C1 03 01 01 01 01 01 07 01}咦，您已经明白了？\n真厉害……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:4:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}那么，就可以认为，\n说谎的人是犯人，\n或者隐瞒了某些信息。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 67 06}{F5 C1 03 01 01 01 01 01 0A 01}是、是的……\n我知道啦。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:5:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}不是您，而是这四个人之中，\n有人在说谎。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:5:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}那么，就可以认为，\n说谎的人是犯人，\n或者隐瞒了某些信息。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}那么，再考虑一次吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 03 01 03 01 02 01}{F5 61 02 01 01 01 01 01 01 01}不过，犯人为什么要这样做呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:7:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 09 01 04 01 03 01 01 01}{F5 61 02 01 01 01 01 01 58 06}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:7:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 04 01 03 01 01 01}{F5 61 02 01 01 01 01 01 01 01}其实，还有１件事让我在意。\n那次探索的时候，似乎发生过什么……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:8:0",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 9C 06}……抱歉。\n我可以暂时去调查另一件事吗？\n有点事情想确认一下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:9:0",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}犯人怎么办？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:9:1",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}我该做什么？{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:10:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 02 01}{F5 61 02 01 01 01 01 01 73 06}说得也是……\n那就把重任交给您了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:11:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}确定犯人是谁后，\n请到那人所在的设施，\n当面指出犯人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:11:1",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}虽然不知道我的调查能否赶上，\n但也许能阻止犯人继续行动。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:11:2",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}不过，随便指认很失礼，\n请{F2 01 03 01}不要胡乱点名{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:11:3",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}建议您在指认之前，\n先回想一下推理的前提和各人的证词。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:12:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞查明犯人后，就去{F2 01 03 01}设施{F2 01 01 01}吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:13:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 35 06}接下来，我们分头行动。\n那么，回头见。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_450.bf.json:14:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞与直斗告别。\n{F2 23 00 00}{F1 21}{00}"
 }
]