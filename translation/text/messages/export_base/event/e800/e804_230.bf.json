[
 {
  "key": "export_base/event/e800/e804_230.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 04 01}{F5 86 02 01 02 01 01 01 07 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}欢迎。\n还是第一次在这里见面呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}准备万全了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 04 01}嗯，没问题。\n不过，有件事想先问清楚。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}为什么指定要我们“两人”来？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}这个嘛……\n简而言之，是兴趣。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 01 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 07 01}{F5 C1 03 01 01 01 01 01 07 01}兴……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}你们两位都拥有\n“不羁”的特质。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}“不羁”的特质是“０”……\n代表着开始与可能性。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}我想亲身感受一下，\n你们所拥有的未知可能性……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:5:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}……这就是叫你们来的理由。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:5:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}怎么样？\n能理解了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:6:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 10 01}我只明白了一点，\n看来你是不会手下留情的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:7:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}呵呵，这就够了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:8:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0F 01 02 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 12 01}既然如此，\n我们也只有全力以赴了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:8:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}是吧，队长。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:9:0",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}上吧！{F5 47 02 01 03 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:9:1",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}真麻烦{F5 47 02 01 03 01 05 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:9:2",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}是时候解放右眼了……！{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:10:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 14 01}呵呵，来吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:11:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 15 01}哎呀，若不能齐心协力，\n可别想让我屈服哦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_230.bf.json:12:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 07 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 16 01}{F5 C1 03 01 01 01 01 01 07 01}原来还有这种机关……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
