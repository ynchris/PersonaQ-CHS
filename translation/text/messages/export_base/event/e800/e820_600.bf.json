[
 {
  "key": "export_base/event/e800/e820_600.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}听埃癸斯大人说，\n保健室的老师负责调配药品。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}既然我也占据了保健室，\n就不能怠慢自己的职责。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我在这间保健室里，\n找到了一种传说之药的配方……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}可是，其中需要的{F2 01 03 01}蛇皮{F2 01 01 01}，\n我还没有弄到。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}因此，我发布了委托，\n希望请您取得这份素材。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:0:5",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}如果我没记错……\n名为{F4 84 04 01 01 01 48 08}的素材，\n应该符合我的要求……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:0:6",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2B 11}关于素材的详情，是我那愚弟……\n{F2 01 03 01}迪奥{F2 01 01 01}擅长的领域。\n不妨向他打听一下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 22 01 02 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E2 0E}虽然这么说……\n您现在持有的那份\n{F4 84 04 01 01 01 48 08}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}和我委托中要求的素材几乎一致……\n倒不如说，就是它本身……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_600.bf.json:1:3",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}只要向我报告并交出素材，\n立刻就能完成委托。\n还请积极考虑。\n{F2 23 00 00}{F1 21}{00}"
 }
]