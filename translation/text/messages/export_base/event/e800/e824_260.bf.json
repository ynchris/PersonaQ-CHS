 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0C 01 02 01 05 01}{F5 86 22 01 09 01 05 01 02 01}{F5 61 02 01 01 01 01 01 0A 01}姐姐，感觉如何？\n不羁与不羁奏出的和声……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 04 01 01 01 01 01 05 01}非常舒畅……\n同时，又充满混沌。\n{F2 23 00 00}{F1 21}"
 },
 {
