 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 05 01}我只是效仿姐姐，\n也提出了一个假说。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 06 01}那么，\n是新的人格面具萌芽了吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}我去请姐姐过来，请稍候。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:3:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白请来了玛格丽特。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:4:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 19 01}假说得到了证实，\n你们也觉醒了新的力量……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:5:0",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}对我来说，这也是一次美妙的体验。\n谢谢你们。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_260.bf.json:5:1",
  "message_id": "MSG_0052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1B 01}这是我的一点谢意。\n请收下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
