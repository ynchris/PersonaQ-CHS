 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:3:0",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 06 01}这份委托原本是为您提出的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:3:1",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}如今却可能渐渐\n变成了为我自己的委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:3:2",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}我就是如此期待\n与您交手。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:3:3",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 09 01}“想活动身体”……\n“因为无聊”……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:3:4",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}不……\n并不只是这些理由。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:3:5",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}那么，究竟为什么\n如此渴望与您战斗呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:3:6",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0C 01}其中的理由究竟是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:3:7",
