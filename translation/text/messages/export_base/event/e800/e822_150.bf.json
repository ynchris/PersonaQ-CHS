 },
 {
  "key": "export_base/event/e800/e822_150.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 04 01}持有此物，便能通过合体\n召唤“某个新的人格面具”。\n{F2 23 00 00}{F1 21}"
 },
 {
