 },
 {
  "key": "export_base/event/e800/e820_960.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 39 07}{F5 C1 03 01 01 01 01 01 08 01}找到了熊！\n这就是小熊追寻多年的秘宝……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_960.bf.json:3:0",
