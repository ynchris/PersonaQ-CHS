 },
 {
  "key": "export_base/event/e800/e820_960.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}那么，回去向伊丽莎白小姐报告吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_960.bf.json:4:0",
  "message_id": "MSG_004",
