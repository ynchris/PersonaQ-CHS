 },
 {
  "key": "export_base/event/e800/e820_960.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 33 09}喂，怎么了？\n这就是委托要的东西吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_960.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 09 01 06 01 02 01}{F5 61 02 01 01 01 01 01 FB 06}……这是小熊的熊。\n跟什么委托没有关系熊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_960.bf.json:7:0",
