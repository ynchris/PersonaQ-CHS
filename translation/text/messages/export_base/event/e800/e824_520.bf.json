[
 {
  "key": "export_base/event/e800/e824_520.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞将{F4 84 04 01 01 01 CE 07}\n　交给了伊丽莎白。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 48 11}确实是白花发饰。\n谢谢您。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}竟然能打败那头野兽，\n您的成长真让我瞪大了眼睛。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}哪天我的眼珠子掉下来，\n可就是您的责任了。\n还请注意。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:1:3",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}顺便一提，您交来的这件发饰，\n我打算拿来做花瓣占卜。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:1:4",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}迪奥和我轮流摘一片花瓣，\n摘下最后一片的人\n就请客吃章鱼烧……就是这种占卜。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:1:5",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 E5 10}一共有５片花瓣……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:1:6",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……那就让迪奥先摘吧。\n这可是姐姐特意让着他。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:1:7",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 E8 0E}那么，这是报酬。\n请收下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_520.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞收到了{F4 45 04 01 00 00 01 01}！\n{F2 23 00 00}{F1 21}{00}"
 }
]