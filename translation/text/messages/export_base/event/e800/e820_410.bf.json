[
 {
  "key": "export_base/event/e800/e820_410.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这是白钟直斗大人发布的委托。\n我去请她过来，请稍候。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 02 01}{F5 86 22 01 03 01 05 01 05 01}{F5 61 02 01 01 01 01 01 29 11}让您久等了。\n名侦探登场了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 02 01}{F5 C1 03 01 01 01 01 01 0A 01}{F5 61 02 01 01 01 01 01 67 06}您这样让我很难开口……\n还是先说委托内容吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:3:0",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}刚才发生了一起盗窃案。\n受害者……姑且称为Ｓ小姐吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:3:1",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 86 09 01 01 01 03 01 01 01}被偷的似乎是一种叫“肉羊羹”的东西，\n她特意留着犒劳自己。\n实在难以想象是什么味道。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:3:2",
  "message_id": "MSG_0022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}无论物品价值如何，犯罪就是犯罪……\n为了查明真相，\n我发布了这项委托。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 05 01 07 01 01 01}{F5 61 02 01 01 01 01 01 4D 11}好！名侦探！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3E 06}{F5 C1 03 01 01 01 01 01 0A 01}呃，那个……\n不过，因为有些特殊情况，\n我也希望能得到您的帮助。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 05 01 07 01 01 01}{F5 61 02 01 01 01 01 01 4D 11}好！助手！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 09 01 0A 01 01 01 01 01}{F5 61 02 01 01 01 01 01 77 11}{F5 C1 03 01 01 01 01 01 0A 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:7:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 67 06}{F5 C1 03 01 01 01 01 01 0B 01}那、那么……\n事不宜迟，有些话想和您说。\n我们到外面谈吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 07 01 05 01 01 01}{F5 61 02 01 01 01 01 01 CC 0E}哎呀，在这里谈不就好了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 38 06}……抱歉。\n这关系到受害者的隐私，\n我想秘密展开调查。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D2 0E}原来如此……\n明白了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 05 01 05 01}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}啊，还有。\n这起案件，我希望能尽早解决。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_410.bf.json:11:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 B4 06}因此，这是一项\n{F2 01 03 01}有期限{F2 01 01 01}的委托。\n请尽快着手处理。\n{F2 23 00 00}{F1 21}{00}"
 }
]