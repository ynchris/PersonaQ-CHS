[
 {
  "key": "export_base/event/e800/e820_490.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 28 11}真是精彩的推理。\n那么，我去请白钟直斗大人过来。\n请稍候。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 01 01 02 01}{F5 86 22 01 03 01 05 01 05 01}{F5 61 02 01 01 01 01 01 29 11}让您久等了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 08 01 02 01 02 01}{F5 61 02 01 01 01 01 01 36 06}谢谢您……\n帮助我解决了案件。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 02 01 02 01}{F5 61 02 01 01 01 01 01 3A 06}这是给您的谢礼。\n请收下。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞收下了{F4 45 04 01 00 00 01 01}！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 D5 06}一次也没有认错，就找到了犯人。\n您真的很适合当侦探，绝不是客套话。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}为了表达敬意……\n我还准备了这个。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞收下了{F4 45 04 01 00 00 02 01}！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 02 01}{F5 61 02 01 01 01 01 01 01 01}这起案件里，\n善与恶、正与邪的界限十分模糊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}也许这世上，\n到处都是这样的案件吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:7:0",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}如果侦探的职责，\n就是找出隐藏在黑暗中的因果……\n我再一次觉得，这是份很棒的职业。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:7:1",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}无论如何，能查明真相，真是太好了。\n多亏有您。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_490.bf.json:7:2",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 35 06}那么，回头见。\n{F2 23 00 00}{F1 21}{00}"
 }
