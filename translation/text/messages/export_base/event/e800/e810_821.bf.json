[
 {
  "key": "export_base/event/e800/e810_821.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞３Ｆ　摊位街\n　“半生不熟厨房”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞遇到了正在往厨房里看的风花。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 0F 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 AD 0A}啊，{F1 81}。\n你好。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 4C 0B}我正感叹这里的厨师动作好利落。\n我也算是会做点料理，\n所以想学一学。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞风花似乎很佩服。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞向风花说明了Ｘ先生的委托。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 DC 0A}Ｘ先生……吗。\n是虚构作品里\n很常见的化名呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 C8 0A}不过，是个什么样的人呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:4:0",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}据说是料理高手{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:4:1",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}据说是太鼓达人{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:4:2",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}据说是玩偶装大师{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 CF 0A}{F5 C1 03 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}料理……那是荒垣学长吗？\n不过，他好像不会\n取Ｘ先生这么俏皮的名字……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3E 0B}Ｘ先生……真想和他聊聊。\n说不定能学到很多东西！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞风花似乎产生了兴趣。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 F6 0A}这样啊。\n无论哪一行，要成为达人都很难，\n真厉害呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 D1 0A}{F5 C1 03 01 01 01 01 01 0A 01}不过，能聊得来吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞风花似乎很困惑……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 95 11}玩偶装……？\n那个有小熊就够了啦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞风花似乎不感兴趣……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 C1 0A}我会考虑一下。\n谢谢你邀请我。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……一直盯着厨房，\n肚子都看饿了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:11:2",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}虽然刚才也吃过……\n再吃一点点，应该没事……吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞风花似乎正和自己的肚子商量……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_821.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞继续逛逛吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]