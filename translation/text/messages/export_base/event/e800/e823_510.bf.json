[
 {
  "key": "export_base/event/e800/e823_510.bf.json:0:0",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里似乎只是一条死路……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:0:1",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞同伴们正在猜测这座迷宫的机关……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:1:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 D5 0C}联谊咖啡厅有尖刺地板，\n鬼屋有灯光和开关，\n祭典那里还得带着火走……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:1:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这么一想，这里应该也有\n“时钟塔”特有的机关吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 7C 08}感觉很难对付啊。\n毕竟是最后的迷宫了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:3:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 18 07}{F5 C1 03 01 01 01 01 01 06 01}……啊！\n小熊想到了个好主意！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:3:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2B 07}把这里的齿轮带回去，\n当作这次文化祭的纪念吧！\n棒球少年也会带土回家熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:4:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 89 11}{F5 C1 03 01 01 01 01 01 0A 01}笨蛋！\n刚说可能有机关，\n别出这种吓人的主意啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:4:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AF 08}还有，棒球少年带土回家，\n是输了比赛的时候！\n笨蛋！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:5:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 11 01 03 01 01 01}{F5 61 02 01 01 01 01 01 3F 07}{F5 C1 03 01 01 01 01 01 04 01}原、原来如此……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:5:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0F 01 03 01 01 01}{F5 61 02 01 01 01 01 01 57 07}小熊……不会输的！\n所以什么都不带回去熊！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:6:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 F1 07}没想到，居然有一天\n能听见你骂别人笨蛋……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:7:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 04 01 01 01}{F5 61 02 01 01 01 01 01 07 09}{F5 C1 03 01 01 01 01 01 08 01}哼哼。\n本大爷升级啦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_510.bf.json:8:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞新增委托\n　{F2 01 03 01}“带回一份纪念”{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 }
]