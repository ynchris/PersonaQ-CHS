[
 {
  "key": "export_base/event/e800/e821_030.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 09 01 02 01 02 01}{F5 61 02 01 01 01 01 01 02 01}恭候多时了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}太过沉迷研究，\n身体似乎都僵硬了。\n硬得咔咔作响。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:1:0",
  "message_id": "MSG_0002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 04 01}首先，就以热身运动的程度\n奉陪吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 0A 01 11 01 03 01 04 01}{F5 61 02 01 01 01 01 01 05 01}姐姐……\n为什么非得战斗不可熊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 06 01}小熊大人……答案很简单。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:3:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}或许是因为这里\n既不是塔尔塔罗斯，也不是电视内部，\n各位稍微有些……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:3:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}稍微……还远远……极其漫长地\n处于成长阶段……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 09 01}{F5 C1 03 01 01 01 01 01 05 01}咦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0A 01}简单来说，就是弱。\n非常弱。完全不行。弱得令人侧目。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0B 01 01 01 04 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}晴天霹雳！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 0C 01}因此，请容我冒昧地\n助各位一臂之力。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:7:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}请使出当前的全力吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0F 01 03 01 04 01}{F5 61 02 01 01 01 01 01 0E 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 03 01}气死熊了！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:8:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}{F5 C1 02 01 01 01 01 01 02 01}这位姐姐真讨厌熊！\n必须给她点教训熊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_030.bf.json:8:2",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}{F5 C1 02 01 01 01 01 01 02 01}千万别手下留情熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
