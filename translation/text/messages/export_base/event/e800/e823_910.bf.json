[
 {
  "key": "export_base/event/e800/e823_910.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 2F 11}{F2 01 03 01}我在时钟塔的６层{F2 01 01 01}散步时，\n发现了一个上锁的宝箱。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_910.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不知道箱子里装着什么，\n实在令人坐立不安。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_910.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我让迪奥做了备用钥匙，\n可以请您去查看里面的东西吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_910.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 E4 0E}不过，迪奥似乎想节省素材，\n用了几乎不要钱的水，\n做成了一把冰钥匙。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_910.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}他说已经在{F2 01 03 01}１层入口附近{F2 01 01 01}，\n放了大量这样的钥匙。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_910.bf.json:0:5",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 CF 0E}麻烦您在它融化之前，\n赶到那个宝箱前。\n{F2 23 00 00}{F1 21}{00}"
 }
]