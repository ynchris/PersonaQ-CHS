 {
  "key": "export_base/event/e800/e820_710.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}想请您去那里调查……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_710.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 56 11}不过，附近似乎出现了\n{F2 01 03 01}陌生阴影{F2 01 01 01}的气息。\n请务必小心。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_710.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}最后，本次委托的报酬，\n是我心爱的一件饰品。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_710.bf.json:0:5",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}等您回来报告时，\n也能成为时尚番长吧。\n敬请期待。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_710.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 22 01 02 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
