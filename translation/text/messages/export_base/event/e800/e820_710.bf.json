 {
  "key": "export_base/event/e800/e820_710.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}我在不可思议之国的你的最终章{F2 01 01 01}，\n感知到了一处{F2 01 03 01}奇妙的空间{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
