  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞美鹤似乎已经和对方交谈过了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 0E 01 0A 01 02 01 02 01}{F5 61 02 01 01 01 01 01 0F 0A}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0A 01 02 01 02 01}{F5 61 02 01 01 01 01 01 01 01}是小熊吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:9:2",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 13 01 02 01 02 01}{F5 61 02 01 01 01 01 01 11 0A}……也罢，没什么理由拒绝。\n我也对他奇妙的生态很感兴趣。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞美鹤似乎产生了兴趣。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 04 0A}……我会考虑一下。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 FC 09}总之，先假装自己\n还是主办人员，\n在走廊里巡视一番吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞美鹤又开始沿走廊行走……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这样就和月高组的\n　所有女生都聊过了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:12:2",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞受邀的女生们\n　究竟会不会来呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_824.bf.json:12:3",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞去Ｘ先生等候的\n　美食广场看看吧。\n{F2 23 00 00}{F1 21}{00}"
 }
