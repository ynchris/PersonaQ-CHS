[
 {
  "key": "export_base/event/e800/e824_050.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 0F 01 05 01 02 01}{F5 61 02 01 01 01 01 01 19 01}感谢各位陪我完成召唤宙斯的委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1A 01}召唤这位宙斯，正是我的目的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}自从落入这个世界，\n我就一直感受到“某种气息”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}于是，我开设了研究所，\n着手调查这股不明气息的真面目。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 02 01}可、可是……能问一下吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}如果有这么强的反应，\n我应该也能感知到才对……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 1D 01}您说得没错。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 02 01 01 01 07 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 1E 01}不过，那是宙斯\n“被封印在这个世界之中”的情况。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1F 01}宙斯其实是\n“被排斥在这个世界之外”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 20 01}在天鹅绒房间里首次发现\n那个“扭曲空间”之前，\n我也没有察觉……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}{F5 C1 03 01 01 01 01 01 05 01}被排斥在外……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 21 01}{F5 C1 04 01 01 01 01 01 02 01}从扭曲空间中得到的“珠子”……\n正是与宙斯相连的东西。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 01}{F5 C1 04 01 01 01 01 01 02 01}只要集齐全部珠子，\n也许就能将宙斯召唤到这个世界……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:5:0",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 23 01}所以，我向您发布了委托，\n一步步走到了现在。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:5:1",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 24 01}从一开始，我就从宙斯的反应中，\n感受到了强大的“力量”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:5:2",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 25 01}即使找到了宙斯，\n就这样直接交给您，也太危险了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:5:3",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 26 01}因为过于强大的人格面具，\n有可能侵占使用者的自我。\n没错，就像刚才的我一样……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:5:4",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 27 01}因此，必须让各位变得足够强大，\n强大到能够安全地召唤宙斯。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 03 01 01 01}{F5 61 02 01 01 01 01 01 05 01}原来如此……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 28 01}各位弱小的模样，早已成为过去……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:7:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 29 01}随着不断深入迷宫、接近真相，\n一次次完成委托……\n各位的力量突飞猛进。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:7:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2A 01}没错，终于成长到，\n连宙斯本人也给予认可的程度……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:7:3",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2B 01}人能够发生何等变化，\n我已经亲眼见证、亲身感受到了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:8:0",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2C 01}请拿好这个。\n这是留在我这里的祝福之证。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:9:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞获得了{F4 45 04 01 00 00 01 01}！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:10:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2D 01}真是符合宙斯神风格的象征，\n毕竟他热爱自由与女性。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:10:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2E 01}有了它，就能通过合体，\n将宙斯作为人格面具召唤出来。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:10:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2F 01}至此，我的“主要”研究\n终于圆满落幕了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:10:3",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 30 01}各位，期待日后有缘再会……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:11:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 31 01}……虽然气氛像是一切都结束了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:11:1",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 32 01}请放心。\n我依然是保健室的主人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:11:2",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 33 01}各位和我发布的委托，\n以及对各位身心的照顾，\n都将和往常一样，照常营业。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_050.bf.json:11:3",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 34 01}请随时光临。\n{F2 23 00 00}{F1 21}{00}"
 }
]