[
 {
  "key": "export_base/event/e800/e823_400.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这项委托来自迪奥。\n那么，请稍等片刻。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 02 01}{F5 86 22 01 03 01 05 01 05 01}{F5 61 02 01 01 01 01 01 29 11}让您久等了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 56 0F}非常感谢您接受委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}为了测试正在开发的箭，\n我进入了{F2 01 03 01}稻羽乡土展{F2 01 01 01}。\n可惜似乎失了准头……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 01 01}{F5 61 02 01 01 01 01 01 61 0F}{F2 01 03 01}第四夜{F2 01 01 01}西南侧有Ｆ．Ｏ．Ｅ的\n房间里，３支箭全都扎进了地板……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}这３支箭的名字分别是\n迪奥多６４号、６５号、６６号。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:2:4",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}其中写着{F2 01 03 01}“迪奥多６６号”{F2 01 01 01}的箭，\n更是我所制造武器中的最高杰作……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:2:5",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 87 0F}虽然要给您添麻烦，\n但还请您帮我回收那支箭……\n这就是本次的委托。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 12 01 04 01 02 01}{F5 86 22 01 07 01 05 01 05 01}{F5 61 02 01 01 01 01 01 5B 11}迪奥。\n你自己去回收不就行了吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}自己能做的事情不自己做，\n你迟早会变成一头大肥猪哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 57 0F}{F5 C1 03 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 02 01}肥、肥猪……吗。\n真是抱歉……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}我也试过拔箭，\n可Ｆ．Ｏ．Ｅ全都聚了过来，\n让我根本无从下手……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 61 0F}{F5 C1 04 01 01 01 01 01 02 01}最后它们竟不知从哪里\n抬来了神轿，\n我实在是束手无策……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 D2 0E}{F5 C1 04 01 01 01 01 01 05 01}原来如此。\n那就没办法了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 05 01 05 01}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 79 0F}那支箭使用了特殊的隐形材料，\n{F2 01 03 01}只有在被光照到时，\n才能用肉眼看见{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}所以，要确认箭的位置，\n不妨利用散布在那里的{F2 01 03 01}篝火{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0B 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}为了多少帮上一点忙，\n我已经把附近的篝火点燃了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 07 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}也就是说，你已经做完了\n自己力所能及的事……对吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 11 01 04 01 01 01}{F5 61 02 01 01 01 01 01 57 0F}是的……\n剩下的，就只能麻烦您了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_400.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 05 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 CE 0E}虽说是舍弟的委托，\n但还是请您多多关照。\n{F2 23 00 00}{F1 21}{00}"
 }
]