 },
 {
  "key": "export_base/event/e800/e813_230.bf.json:6:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 06}嗯，虽然还没决定\n要当老师……\n{F2 23 00 00}{F1 21}"
