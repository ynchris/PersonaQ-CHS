 {
  "key": "export_base/event/e800/e813_230.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 7E 05}这是给学长的谢礼！\n请收下！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e813_230.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞收到了{F4 45 04 01 00 00 01 01}！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e813_230.bf.json:4:0",
