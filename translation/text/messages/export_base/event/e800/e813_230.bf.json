 {
  "key": "export_base/event/e800/e813_230.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 29 11}让您久等了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e813_230.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 08 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 7A 05}学长！\n这次真是多谢您了！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e813_230.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 08 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 85 05}虽然总觉得反倒是\n被天田教了一课……\n算了，是错觉吧！\n{F2 23 00 00}{F1 21}"
