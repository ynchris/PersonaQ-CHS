[
 {
  "key": "export_base/event/e800/e804_250.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 01 01 01 01 07 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 02 01}这到底是……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 01}人拥有无限的可能性。\n你们觉醒的力量，也是其中之一。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}本来，你们应该依循自身的命运，\n去抓住新的可能性……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:2:0",
  "message_id": "MSG_0012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}……可已经不能再等了。\n因为你们在这里\n还有必须完成的事。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:2:1",
  "message_id": "MSG_0012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}所以我想，能否用强硬的办法\n把这份力量引出来。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 07 01}所以才要战斗……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}人被逼入绝境时，\n会变得与平时截然不同。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:4:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 09 01}有些力量，正因为直面“死亡”，\n才会涌现出来。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:5:0",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 02 01 01 01 01 01}那也太极端了……{F5 47 02 01 03 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:5:1",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}你是想杀了我们吧？{F5 47 02 01 03 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 0A 01}呵呵……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 0D 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 0B 01}那为什么指定“只有我们两人”？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:8:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这场战斗究竟是怎么回事呢……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:8:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞试着询问了玛格丽特。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:9:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}所谓不羁，可以说\n就像数字“０”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:9:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0D 01}而你也知道吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:9:2",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0E 01}两个“０”合在一起，\n就成了象征无限大的符号\n“∞”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:9:3",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}我将希望寄托在你们无限的可能性上。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:9:4",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}……另外，身为掌管力量之人，\n我也想与你们的力量亲自交锋。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:10:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 07 01 01 01 01 01}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 11 01}{F5 C1 03 01 01 01 01 01 0A 01}力量交锋……\n你分明是想杀了我们吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:11:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 12 01}还有别的问题吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 13 01}{F5 C1 04 01 01 01 01 01 07 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}有问题吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 15 01}{F5 C1 04 01 01 01 01 01 07 01}……没有。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 02 01}{F5 61 02 01 01 01 01 01 16 01}太好了，\n看来你们理解了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:15:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 02 01 02 01 01 01 07 01}{F5 61 02 01 01 01 01 01 17 01}{F5 C1 04 01 01 01 01 01 02 01}另外，只叫你们两位来，\n还有１个理由……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:15:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}{F5 C1 04 01 01 01 01 01 02 01}也有些事情\n需要向你们的同伴说明。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:15:3",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}接下来去天鹅绒房间再说。\n跟我来吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特说完，\n便离开了房间……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e804_250.bf.json:17:0",
  "message_id": "MSG_0142",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞跟随玛格丽特，\n前往天鹅绒房间……\n{F2 23 00 00}{F1 21}{00}"
 }
]