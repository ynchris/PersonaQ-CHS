[
 {
  "key": "export_base/event/e800/e812_320.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞３Ｆ，“占卜馆”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞与伊丽莎白交谈后，\n　她请来了玛格丽特……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 23 01 02 01 01 01 05 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}让您久等了。\n姐姐登场了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 03 01}提出这么奇怪的委托，真不好意思。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}我想四处逛逛，放松一下，\n不过这种类似现实世界的地方，\n我实在不太熟悉。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 05 01 01 01}{F5 61 02 01 01 01 01 01 05 01}那么，先从哪里开始逛起呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 06 01}伊丽莎白。\n你以为这位是什么人？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}他可是“罕见的羁绊大师”……\n就连主人也佩服他的手腕。\n大概吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:5:0",
  "message_id": "MSG_0042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 05 01 02 01}{F5 86 23 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 08 01}所以，这位羁绊大师\n一定会领会我们话语中的深意，\n巧妙地让我们放松下来。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 09 01}原来如此，不愧是羁绊大师。\n那就全部交给您了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:6:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}我们也会根据满意程度，\n准备额外报酬。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……感受到了两人热切的期待。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}{F5 C1 03 01 01 01 01 01 07 01}那么，导览……开幕！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e812_320.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……总之，先去活动街\n　随意逛逛吧。\n{F2 23 00 00}{F1 21}{00}"
 }
]