[
 {
  "key": "export_base/event/e800/e820_210.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这是善大人发布的委托。\n下面请本人为您说明……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 29 01 02 01 01 01 02 01}{F5 86 15 01 02 01 01 01 05 01}{F5 61 02 01 01 01 01 01 78 0D}我要和小熊进行一种叫作\n“以物易物对决”的比赛。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}我不能输，\n可我连具体该做什么都不知道。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 00 0D}所以只能拜托你。\n希望你能帮我进行这场对决。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 05 01 06 01 01 01}{F5 61 02 01 01 01 01 01 A5 10}可、可是呀？\n规则好像是，谁带来的东西\n更合我心意，谁就赢了哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 6D 0D}嗯，这个我听说了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}所、所以呀？\n只要是善带来的东西，\n不管是什么，我都……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 B0 11}{F5 C1 04 01 01 01 01 01 05 01}会吃掉吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 09 01 06 01 01 01}{F5 61 02 01 01 01 01 01 37 10}{F5 C1 03 01 01 01 01 01 07 01}对呀对呀，我什么都会吃掉！\n不对啦！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 05 01}玲，你在这里等着。\n我和他会带些东西回来。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:8:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 B7 0D}带些东西……吗。\n虽然还毫无头绪。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AE 10}{F5 C1 03 01 01 01 01 01 04 01}真是的……不理你了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 2A 11}另外，这项委托设有\n{F2 01 03 01}期限{F2 01 01 01}，\n还请留意。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 29 01 08 01 01 01 02 01}{F5 86 15 01 02 01 01 01 05 01}{F5 61 02 01 01 01 01 01 01 01}我还想了解更多信息。\n把对手小熊也叫上，一起谈谈吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:11:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 79 0D}你方便的时候，\n来找我就好。\n那么，再见。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_210.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞通过菜单中的{F2 01 03 01}“校内散步”{F2 01 01 01}，\n　去听听善怎么说吧……\n{F2 23 00 00}{F1 21}{00}"
 }
]