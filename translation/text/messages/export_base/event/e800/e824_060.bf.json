[
 {
  "key": "export_base/event/e800/e824_060.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 23 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 02 01}欢迎来到天鹅绒房间……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}你来得正好。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}刚才伊丽莎白来过，\n向我讲了她的研究。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}你得到的人格面具“宙斯”……\n以及创造这个世界的“柯罗诺斯”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 06 01}在神话中，\n两者有着很深的联系。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:0:5",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 07 01}当然，神话与这个世界并非一回事……\n不过，我还是告诉你吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特重新坐好……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 08 01}柯罗诺斯挥舞镰刀，\n收割“生命”“时间”等一切事物……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 09 01}他可谓是“冷酷无情的破坏者”，\n也拥有堪称“死亡象征”的神格。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}传说他凶残得连自己的孩子都会吞食。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 01 FF}{F1 41}{F5 61 02 01 01 01 01 01 0B 01}而宙斯……在神话中，\n也被描述为柯罗诺斯的孩子。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:3:0",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}宙斯也被吃了？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:3:1",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}原来他们是父子？{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}不……正相反。\n宙斯斩断了那样的命运。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}嗯……不过，\n宙斯不但没有被吞食，\n反而斩断了那样的命运。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}宙斯亲手讨伐了柯罗诺斯。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}因此，人们心中的宙斯形象，\n也许就与柯罗诺斯截然相反了吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}也就是“生命的象征”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:7:0",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 11 01}……宙斯无法进入这个世界，\n恐怕也是这个原因。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:7:1",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}“死亡的象征”创造的世界，\n容不下“生命的象征”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:7:2",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}然而，你们闯入这个死亡世界之后，\n情况就改变了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:8:0",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}是因为我们？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:8:1",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}为什么？{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 14 01}拥有生命的你们，\n可以说和宙斯一样，\n也是“生命的象征”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 15 01}与此呼应，\n宙斯才得以被召唤到这个世界。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:10:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 16 01}……怎么样？虽说是推测，\n但你不觉得很有道理吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:11:0",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}我也这么想{F5 47 02 01 01 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:11:1",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}只是纸上谈兵{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:11:2",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}不太明白{F5 47 02 01 01 01 09 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:12:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}嗯……一切都只是我的猜测。\n神话和这个世界完全不同。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:13:0",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 18 01}……也许也不能如此断言。\n心之海中浮现的人格面具，\n还有神话，都由人创造……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:13:1",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 19 01}都是因人的渴望而诞生的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:13:2",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 23 01 0A 01 02 01 01 01}{F5 61 02 01 01 01 01 01 1A 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:14:0",
  "message_id": "MSG_0103",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1B 01}那么，总之……\n现在可以通过合体，\n召唤人格面具“宙斯”了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_060.bf.json:14:1",
  "message_id": "MSG_0103",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 1C 01}他的能力确实非常强大，\n不妨试试吧？\n{F2 23 00 00}{F1 21}{00}"
 }
]