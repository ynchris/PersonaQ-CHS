 },
 {
  "key": "export_base/event/e800/e822_630.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D0 0E}辛苦各位了。\n那我就收下了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_630.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 03 09}{F5 C1 03 01 01 01 01 01 07 01}啊，要不要试穿一下，\n看看尺寸合不合适！？\n需要的话我可以帮忙！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_630.bf.json:6:0",
  "message_id": "MSG_006",
