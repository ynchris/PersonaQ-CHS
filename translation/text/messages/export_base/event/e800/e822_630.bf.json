 },
 {
  "key": "export_base/event/e800/e822_630.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D5 0E}不，没必要担心。\n因为这不是我穿的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
