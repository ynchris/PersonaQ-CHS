 },
 {
  "key": "export_base/event/e800/e822_520.bf.json:27:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}有很多呀！\n食欲、空腹、肚子饿之类的！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_520.bf.json:28:0",
