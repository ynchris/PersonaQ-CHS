 },
 {
  "key": "export_base/event/e800/e822_520.bf.json:19:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……你们在说什么？\n事先商量过吗？\n{F2 23 00 00}{F1 21}{00}"
