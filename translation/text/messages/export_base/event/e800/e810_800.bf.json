[
 {
  "key": "export_base/event/e800/e810_800.bf.json:0:0",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里似乎只是一条死路……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:0:1",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞同伴们正在谈论\n　这一层的Ｆ．Ｏ．Ｅ……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:1:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 D6 0C}这附近好像没有那种\n相互凝视的天使Ｆ．Ｏ．Ｅ。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 D5 09}真次郎。\n下次用那种Ｆ．Ｏ．Ｅ\n比比胆量吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:2:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}看谁敢让它靠得更近。\n先移开视线的人就算输！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 56 0D}{F5 C1 03 01 01 01 01 01 04 01}不比，笨蛋。\n别拿Ｆ．Ｏ．Ｅ玩，笨蛋。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 01 01 07 01 04 01}{F5 61 02 01 01 01 01 01 88 09}呃……！\n笨蛋说１次我就听到了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 06 01 02 01}{F5 61 02 01 01 01 01 01 57 0D}听到了也不改，\n所以才要说你啊，笨蛋。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 06 01 02 01 01 01 04 01}{F5 86 03 01 07 01 01 01 02 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 5B 02}{F5 C1 03 01 01 01 01 01 0A 01}又开始了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 03 01 01 01 04 01}{F5 61 02 01 01 01 01 01 3D 04}呵呵，感觉你每天都挺辛苦呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0D 01 01 01 02 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 ED 01}嗯，已经习惯了吧。\n一开始倒是吓了一跳。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 A0 04}这样啊。\n我的同伴里没有学长，\n所以感觉有点新鲜。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 57 04}说起来，{F5 C1 0A 01 01 01 01 01 01 01}，\n你和大家认识很久了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0D 01 01 01 02 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 13 02}也没有。\n大概半年前转来之后，\n才认识的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 BC 04}啊，你是转学生呀。\n和{F1 81}一样呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 01 01 01 01 02 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 11 02}啊，是这样吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 27 0D}{F5 C1 0A 01 01 01 01 01 01 01}，\n来帮忙，让这笨蛋闭嘴。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 03 01 0B 01 01 01 02 01}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 E3 01}{F5 C1 03 01 01 01 01 01 0B 01}帮忙……\n等一下，不能拿东西堵嘴啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞{F5 C1 0B 01 01 01 01 01 01 01}跑向了荒垣和真田……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 7E 04}这样啊，转学生……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 12 07}怎么怎么？\n小雪，新的男生出现，\n让你心动如雷大将军了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0B 01 01 01 04 01}{F5 61 02 01 01 01 01 01 31 04}{F5 C1 03 01 01 01 01 01 07 01}才、才不是那样！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:19:0",
  "message_id": "MSG_0172",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 06 01 07 01 04 01}{F5 61 02 01 01 01 01 01 A9 04}{F5 C1 03 01 01 01 01 01 03 01}……还有，刚才那个真的不好笑。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:20:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 54 07}{F5 C1 03 01 01 01 01 01 02 01}呜噗……\n顺平教的段子不行吗熊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:21:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 40 04}这样也会被月光馆的女生们\n狠狠嫌弃哦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:22:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 82 07}那倒也挺让熊开心的？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:22:1",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 77 07}不过，小鹤冷冰冰的，\n小由又很会无视熊……\n实在没机会接近她们熊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:23:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 9D 04}比如……{F5 C1 0A 01 01 01 01 01 01 01}就有种神秘感，\n应该会有不少女生在意他呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:23:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 1D 04}你一定是神秘感不够。\n小熊，你的坏心思全写在脸上了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:24:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 0B 01 06 01 02 01}{F5 C1 03 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 9E 07}熊、熊也很神秘啊熊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:24:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}比如突然长出来的里面？\n还有能变得扁扁的！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:25:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 4E 04}{F5 C1 03 01 01 01 01 01 0A 01}那不叫神秘，叫诡异。\n好了，走吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:26:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 11 01 03 01 02 01}{F5 61 02 01 01 01 01 01 00 06}嗯，这下不妙熊……\n有没有什么好办法……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:27:0",
  "message_id": "MSG_0242",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 F9 06}{F5 C1 03 01 01 01 01 01 06 01}唔唔唔唔……啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:28:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞小熊似乎想到了什么。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:29:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 0A 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 EE 06}老、老师！\n有好好查看委托吗熊？\n熊觉得好像有新委托了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:30:0",
  "message_id": "MSG_0262",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0A 01 09 01 06 01 02 01}{F5 61 02 01 01 01 01 01 2B 07}{F5 C1 03 01 01 01 01 01 0B 01}……只是觉得而已熊！\n绝对没有别的意思熊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_800.bf.json:31:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞新增委托\n　{F2 01 03 01}“Ｘ先生的委托”{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 }
]