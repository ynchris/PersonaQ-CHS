[
 {
  "key": "export_base/event/e800/e821_340.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 D9 0E}原来如此……\n竟然发生了这样的怪异现象……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 E0 10}多谢您。\n也请替我向天城雪子小姐\n转达谢意。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}说起来，虽然不是同一个故事……\n但我听过一个类似的怪谈。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}故事稍微有些长，\n您愿意听一听吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:1:0",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}说来听听{F5 47 02 01 01 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:1:1",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}还是算了{F5 47 02 01 01 01 05 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 E3 10}遵命。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D7 0E}很久很久以前……\n有六个感情很好的姐妹，\n和母亲一起生活在同一个屋檐下。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}六姐妹每天唱歌、玩人偶剧……\n据说，那个家里\n总是充满了欢声笑语。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……可是，这样快乐的日子\n并没能一直持续下去。\n她们的母亲病倒了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:3:3",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}既无亲人可以依靠，也无谋生之计，\n那六个姐妹不久后也一个接着一个……\n失去了生命。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:4:0",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2E 11}{F5 C1 04 01 01 01 01 01 02 01}……然后，时间来到了现代。\n据说，有个男人在建筑工地上，\n发现了一个奇怪的“箱子”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:4:1",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 02 01}男人战战兢兢地打开箱子，\n里面却空无一物，正当他失望之时……\n就在下一瞬间……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:4:2",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}“啊哈哈哈哈。啊哈哈哈哈哈哈。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:4:3",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……不知从哪里，\n传来了孩子们这样的笑声……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:5:0",
  "message_id": "MSG_0033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……也许，她们跨越漫长的岁月\n终于重逢，直到如今\n还在玩着人偶游戏……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:5:1",
  "message_id": "MSG_0033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}也说不定呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:6:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……作为即兴编出的故事，\n这可真是相当出色。\n想必会作为名作流传后世吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:7:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 E3 10}遵命。\n有些事，还是不知道\n对自己比较好……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:8:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 3E 11}那么……\n这是您的报酬。\n请收下吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:9:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞获得了{F4 45 04 01 00 00 01 01}！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_340.bf.json:10:0",
  "message_id": "MSG_0062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 3E 11}那么……\n这是您的报酬。\n请收下吧。\n{F2 23 00 00}{F1 21}{00}"
 }
