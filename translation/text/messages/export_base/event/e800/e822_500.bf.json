 },
 {
  "key": "export_base/event/e800/e822_500.bf.json:24:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 01 01 02 01 01 01 02 01}{F5 86 29 01 05 01 02 01 04 01}{F5 61 02 01 01 01 01 01 BC 11}{F1 82}同学！\n善很过分吧！\n一点人情味都没有！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
