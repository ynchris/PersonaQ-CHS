[
 {
  "key": "export_base/event/e800/e824_210.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}这是姐姐发布的委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}我去请姐姐过来，请稍候。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白离开了保健室。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞等一会儿吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白带着玛格丽特回来了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 01}你承接委托了呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 05 01}我想和你战斗，\n不过，并不是普通地打一场就行。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:3:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}请“你”和“另一位不羁者”\n两个人一起来，可以吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:4:0",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}为什么是２人？{F5 47 02 01 01 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:4:1",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}我接受挑战{F5 47 02 01 01 01 0D 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 07 01}理由嘛……来了就知道了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞难道有什么不便说明的理由吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 08 01}呵呵……很有气势嘛。\n你们来了，我就解释。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0B 01 02 01 01 01}{F5 61 02 01 01 01 01 01 09 01}伊丽莎白。\n帮我找一个适合战斗的地方。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 05 01 05 01}{F5 61 02 01 01 01 01 01 0A 01}明白了。\n正好有一处合适的地方。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:10:0",
  "message_id": "MSG_0092",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 02 01 01 01 02 01}{F5 86 22 01 01 01 05 01 05 01}{F5 61 02 01 01 01 01 01 0C 01}具体位置……\n可以借我一下地图吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞把地图递给伊丽莎白后，\n　她开始在上面画标记……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 23 01 02 01 01 01 05 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 0D 01}谢谢您。\n地图还给您。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞从伊丽莎白手中接回了地图……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:13:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞{F2 01 03 01}不可思议之国的你的第三章{F2 01 01 01}\n　留有标记……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}响应时代潮流，\n我使用的是会消失的墨水。\n很环保。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:14:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0F 01}请您自行另做标记。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞在地图上做好标记吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 10 01}那么，就选那里吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 09 01 05 01 01 01}{F5 61 02 01 01 01 01 01 11 01}明白了。\n正好有一处合适的地方。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:17:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 12 01}在“不可思议之国的你”地下３层……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:17:2",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 01}楼层正中央有间小房间。\n您看那里如何？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 14 01}{F5 C1 04 01 01 01 01 01 05 01}很好。谢谢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 15 01}再说一次，\n请“你”和“另一位不羁者”一起来。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 16 01}也就是两位不羁者齐聚一堂……对吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 17 01}因为只有两个人，\n一定要做好充分准备。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:21:1",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 18 01}可别让我觉得……\n毫无挑战性哦。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:22:0",
  "message_id": "MSG_0202",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 03 01 02 01 01 01}{F5 61 02 01 01 01 01 01 19 01}那么，我等着你们。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_210.bf.json:23:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特离开了保健室……\n{F2 23 00 00}{F1 21}{00}"
 }
