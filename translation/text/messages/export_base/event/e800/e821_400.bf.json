[
 {
  "key": "export_base/event/e800/e821_400.bf.json:0:0",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里似乎只是一条死路……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:0:1",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞同伴们正在谈论婴儿Ｆ．Ｏ．Ｅ……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:1:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 A6 11}{F5 C1 03 01 01 01 01 01 04 01}啧，那个Ｆ．Ｏ．Ｅ……\n明明是婴儿，却一点都不可爱。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:1:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}干脆给它塞个奶嘴吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 4F 04}荒垣学长也会\n觉得小宝宝可爱啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 AC 11}{F5 C1 03 01 01 01 01 01 0A 01}……你把我当成恶魔之类的了？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 1A 04}对、对不起……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:4:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}因为您太像以前电影里\n见过的德古拉了。\n没想到会觉得婴儿可爱……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:4:2",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 56 04}{F5 C1 03 01 01 01 01 01 07 01}……啊，因为婴儿的血新鲜！？\n所以才觉得可爱……！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 06 01 01 01}{F5 61 02 01 01 01 01 01 A8 11}{F5 C1 03 01 01 01 01 01 0B 01}什！？\n为什么会想到那儿去啊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 04 01 02 01 01 01 04 01}{F5 86 0C 01 01 01 06 01 02 01}{F5 61 02 01 01 01 01 01 B3 08}{F5 C1 03 01 01 01 01 01 0A 01}厉害……\n荒垣学长居然被压制了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 02 01 01 01}{F5 61 02 01 01 01 01 01 BA 02}可别小看我们天城哦？\n别看她这样，可是把好多男生的心\n从里到外都戳得千疮百孔了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 86 13 01 02 01 01 01 02 01}{F5 86 29 01 07 01 02 01 04 01}{F5 61 02 01 01 01 01 01 30 10}小、小真……\n你会喝……婴儿的血……是真的吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AB 11}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}算了，我长得就这副样子。\n随你们怎么想吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 79 10}{F5 C1 03 01 01 01 01 01 0B 01}我……相信你哦！\n小真！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}你……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0D 01 02 01 01 01}{F5 61 02 01 01 01 01 01 36 10}因为我听风花说过。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:12:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}你其实很会做菜，\n还会给小虎做饭……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:13:0",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 01 01 0B 01 01 01}{F5 61 02 01 01 01 01 01 24 10}我知道的。\n这一切都是为了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:13:1",
  "message_id": "MSG_0112",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 0A 01 0B 01 01 01}{F5 61 02 01 01 01 01 01 01 01}把大家养得圆滚滚的……\n等着鲜美的血液\n养成吧……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A8 11}{F5 C1 03 01 01 01 01 01 01 01}啊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 07 01 03 01 07 01}{F5 61 02 01 01 01 01 01 56 04}玲，大蒜！\n快拿大蒜来！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 29 01 05 01 0D 01 01 01}{F5 61 02 01 01 01 01 01 50 10}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}大蒜！？\n那个那个……\n我只有大蒜甜甜圈啊！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:16:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 4E 10}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}而且已经吃掉了！？\n口气行吗！？哈——地吹口气！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:17:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0E 01 01 01 01 01}{F5 86 01 01 02 01 01 01 04 01}{F5 86 13 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 1E 0D}{F5 C1 03 01 01 01 01 01 04 01}喂……\n奶嘴再多找几个。\n把她们的嘴也堵上。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_400.bf.json:18:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞新增委托\n　{F2 01 03 01}“取得地狱奶嘴”{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 }
