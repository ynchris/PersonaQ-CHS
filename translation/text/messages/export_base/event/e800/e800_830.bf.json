[
 {
  "key": "export_base/event/e800/e800_830.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞美食广场……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞女生们还一个都没出现……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 09}{F5 C1 04 01 01 01 01 01 03 01}在神秘文化祭中突然现身的神秘男子……\n无人知晓他的真实身份……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 03 01}当谜团与谜团相结合，\n新的谜团便会降临！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 04 01 01 01 01 01 03 01}人称Ｘ先生！\n在此参上！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 04 01 02 01}{F5 61 02 01 01 01 01 01 08 09}{F5 C1 03 01 01 01 01 01 08 01}锵锵锵！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:3:0",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}我就知道……{F5 47 02 01 01 01 0B 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:3:1",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}原、来、是、你、啊{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 02 01 02 01}{F5 61 02 01 01 01 01 01 FF 08}真的？\n不过，无所谓啦。\n被你认出来也没关系。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 09 01 04 01 02 01}{F5 61 02 01 01 01 01 01 11 09}喂，你那毫无感情的语气是什么啊！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 0C 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 03 09}听好了？\n我的计划是这样的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}你邀请的女生们来了，\n我和你在这里等着。\n然后我找个机会去趟厕所。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 EF 08}接着，披上斗篷、戴上墨镜的我，\n就会以Ｘ先生的身份登场……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞顺平展示的是\n　保健室的窗帘和假鼻子眼镜……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 09 01 01 01 01 01}{F5 61 02 01 01 01 01 01 87 11}{F5 C1 03 01 01 01 01 01 09 01}女生们对突然出现的神秘男子\nＸ先生产生浓厚兴趣！\n我大受欢迎，剧本就是这样！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 04 09}{F5 C1 03 01 01 01 01 01 08 01}怎么样！\n这完美的计划。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:9:0",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}马上就会被识破{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:9:1",
  "message_id": "SEL_009",
  "translation": "{F2 05 FF FF}{F1 41}好、厉、害、啊{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 0F 01 02 01 01 01}{F5 61 02 01 01 01 01 01 AB 08}识破也没关系。\n能逗她们开心就行。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 05 01 01 01 01 01}{F5 61 02 01 01 01 01 01 BF 08}{F5 C1 03 01 01 01 01 01 03 01}别用那种棒读语气！！\n识破也没关系。\n能逗她们开心就行。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 9B 08}只要关系更近一点，\n我们的队伍也会更热闹吧？\n也就是说，这是为了活跃气氛。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0C 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}好了，事情就是这样，\n一起等着吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞顺平兴致高昂……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_830.bf.json:13:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞和顺平一起等大家来吧……\n{F2 23 00 00}{F1 21}{00}"
 }
