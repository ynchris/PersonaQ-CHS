[
 {
  "key": "export_base/event/e800/e823_000.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}{F2 01 03 01}在稻羽乡土展的第三夜{F2 01 01 01}，\n共有１２处巨大的胯下……\n我在每一处都放了抽奖券。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不过，只有１张中奖……\n其余全是空奖。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}请根据接下来给出的提示，\n找到符合条件的地点，\n并在那里搜寻。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:1:0",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}为什么要做这种事？{F5 47 02 01 01 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:1:1",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}你真闲啊……{F5 47 02 01 01 01 0B 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D4 0E}除了闲得发慌……\n我也没有其他答案。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 D7 0E}确实如此。\n请陪我消磨片刻时光吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 CE 0E}那么，现在开始公布提示。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}第一。\n{F2 01 03 01}那处胯下允许“圣火”通过{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}第二。{F2 01 03 01}那处胯下附近，\n有“风”吹动{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}第三。\n{F2 01 03 01}那处胯下围着“北”的兜裆布{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:4:4",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}提示到此结束。\n找到符合这些提示的地点，\n就是本次的委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:4:5",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}另外，如果翻开２张抽奖券，\n就会发生不得了的事。\n请小心。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_000.bf.json:4:6",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 2A 11}这项委托也设有{F2 01 03 01}期限{F2 01 01 01}。\n还请一并留意。\n{F2 23 00 00}{F1 21}{00}"
 }
]