[
 {
  "key": "export_base/event/e800/e824_105.bf.json:0:0",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里似乎只是条死路……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:0:1",
  "message_id": "MSG_999",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞直斗正在分析这座迷宫……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:1:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 03 01 02 01}{F5 61 02 01 01 01 01 01 48 06}终于要迎来最后的高潮了……\n有种这样的感觉呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:1:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}迷宫又大又复杂，\n敌人也很强，没那么容易应付……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:2:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 69 0B}正因为如此，才不能着急。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:2:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}要是因为心急而全军覆没，\n可就正中敌人下怀了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:3:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3C 06}……嗯，说得对。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:3:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}觉得危险就立刻撤退。\n越是接近终点，越要稳扎稳打。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:4:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}完善装备、完成委托……\n结交新伙伴、充实人格面具……\n还有完成剩下的委托……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:4:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}或者完成委托之类的……\n大家有没有遗漏什么呢？\n请仔细检查一下身边的事。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 42 06}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:5:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 BB 06}{F5 C1 03 01 01 01 01 01 0A 01}……伊丽莎白小姐\n拜托你做什么了吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 71 0B}是的。\n她拜托我宣传委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:6:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}听说今后还会增加委托。\n她让我转告大家，请不要忘记。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 47 06}{F5 C1 03 01 01 01 01 01 0A 01}这、这样啊……\n真是辛苦你了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 65 0B}谢谢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e824_105.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞新增委托\n　{F2 01 03 01}“获取荣华碎片”{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 }
]