[
 {
  "key": "export_base/event/e800/e820_475.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞正在寻找“肉羊羹失窃案”的犯人……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:1:0",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}犯人是伊丽莎白！{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:1:1",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}回想证词{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:1:2",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}下次再说{00}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 D2 0E}原来如此……\n您终于要逮捕我了？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}虽然那似乎也很有趣，\n不过，请先说说您的根据。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞告诉伊丽莎白，\n　自己把她的证词反过来考虑了一遍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}把证词反过来……\n虽然不太习惯，还是试试看吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我说的是，\n犯人是我们姐弟三人中的某一个……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}反过来就是，\n犯人不在我们姐弟三人之中……\n也就是说，玛丽小姐是犯人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……这不是很奇怪吗？\n因为我说了谎，所以我是犯人……\n可玛丽小姐也是犯人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:4:4",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 CC 0E}如此一来，“犯人只有一人”这个前提，\n就完全不成立了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白说得确实没错……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E1 0E}名侦探。\n看来这次是您输了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 08 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞看来伊丽莎白不是犯人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞重新考虑一下吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞以{F2 01 03 01}犯人一定在说谎，\n　而且犯人只有一人{F2 01 01 01}为前提，\n　回想一下各人的证词吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:8:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛丽说：\n　{F2 01 03 01}“我不是犯人，\n　犯人会说谎。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:8:2",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特说：\n　{F2 01 03 01}“玛丽没有说谎，\n　我不是犯人。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:8:3",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥说：\n　{F2 01 03 01}“我不是犯人，\n　伊丽莎白才是犯人。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:8:4",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白只说：\n　{F2 01 03 01}“犯人就在我们姐弟三人之中。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_475.bf.json:8:5",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞犯人究竟是谁呢……\n{F2 23 00 00}{F1 21}{00}"
 }
]