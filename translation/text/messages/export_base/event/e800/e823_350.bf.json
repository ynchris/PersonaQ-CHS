[
 {
  "key": "export_base/event/e800/e823_350.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}感谢您陪我完成委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}这是本次的报酬。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞收下了{F4 45 04 01 00 00 01 01}！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 04 01}持有这个，就能通过合体，\n召唤“某个新的人格面具”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 05 01}请收下。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}现在的您，想必也能驾驭\n{F2 01 03 01}“那个人格面具”{F2 01 01 01}吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:3:0",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}那个人格面具是？{F5 47 02 01 01 01 09 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:3:1",
  "message_id": "SEL_003",
  "translation": "{F2 05 FF FF}{F1 41}之前你也说过……{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 07 01}……以后我会再向您说明。\n那个机会，大概很快就会到来。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 22 01 02 01 05 01 01 01}{F5 61 02 01 01 01 01 01 08 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 09 01}话说……\n我有１个问题。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0A 01}您……究竟是什么人？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:5:0",
  "message_id": "SEL_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}{F1 83}啊……{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:5:1",
  "message_id": "SEL_005",
  "translation": "{F2 05 FF FF}{F1 41}还在寻找答案{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:5:2",
  "message_id": "SEL_005",
  "translation": "{F2 05 FF FF}{F1 41}是个受欢迎的人{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0B 01}那只是您的名字……\n并非您的本质，\n只是表象罢了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0C 01}哎呀……您也一样吗……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0D 01}原来如此……\n因为有他人，才有自己。\n是这个意思吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 0E 01}聚集在天鹅绒房间的人，\n都注定要不断探寻自我……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 0F 01}所以，我也一直在寻找，\n自己究竟是什么人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:9:2",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 10 01}而您，正是会给我\n那个“答案”的人……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:9:3",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 11 01}……也许吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 12 01}总之，距离那个“答案”，\n还需要再等一会儿……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e823_350.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0F 01 05 01 01 01}{F5 61 02 01 01 01 01 01 13 01}还请您一边完成其他委托，\n一边耐心等候。\n{F2 23 00 00}{F1 21}{00}"
 }
]