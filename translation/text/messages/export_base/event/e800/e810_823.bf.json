[
 {
  "key": "export_base/event/e800/e810_823.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２Ｆ　节目走廊\n　“阿坎纳电影节”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞遇到了刚看完电影的埃癸斯。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 5C 0B}{F1 82}，辛苦了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}刚才我在这间教室里，\n观看了一部描写机器人\n与人类战争的电影。根据电影内容……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 7D 0B}终有一天，机器人与人类\n将无法共存。\n到那时，我该怎么办呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞埃癸斯似乎产生了\n　机器人特有的疑问。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞向埃癸斯讲了Ｘ先生的委托。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 AD 0B}{F5 C1 03 01 01 01 01 01 05 01}Ｘ先生吗？\n那是怎样的一位人物呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:4:0",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}像电影导演一样的人{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:4:1",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}呼吁反战的人{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:4:2",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}根本就不是人{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 70 0B}只是像电影导演，\n并不是电影导演，对吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 AF 0B}……也就是说，\n依旧是可疑人物。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞埃癸斯有些犹豫……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 70 0B}是呼吁反战的人啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 B0 0B}其实，美鹤小姐曾下达禁令，\n不许我跟陌生人走。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞埃癸斯有些犹豫……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 B4 0B}{F5 C1 03 01 01 01 01 01 02 01}那么，是与我一样的\n机械人士吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:9:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 C8 0B}其实，美鹤小姐曾下达禁令，\n不许我跟陌生人走……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:9:2",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 C9 0B}既然不是人，\n那应该就可以去了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞埃癸斯似乎产生了兴趣。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 01 01 07 01 02 01}{F5 61 02 01 01 01 01 01 63 0B}那么，我继续\n巡视文化祭了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:11:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 10 01 03 01 07 01 02 01}{F5 61 02 01 01 01 01 01 D7 0B}接下来是兴奋畅玩乐园……\n打靶让我跃跃欲试！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞埃癸斯离开了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e810_823.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞继续逛逛吧……\n{F2 23 00 00}{F1 21}{00}"
 }
]