[
 {
  "key": "export_base/event/e800/e822_700.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}这是玲大人发布的委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}和上次一样，\n她托我带话，请容我代读。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白拿起了笔记本。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}“你好，我是玲。\n非常感谢你承接这次的委托。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:2:1",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}“我努力想做一个项圈，\n当作礼物送给善……\n可做出来总是软塌塌的。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:2:2",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}“想去问迪奥先生怎么做好，\n还有需要哪些素材，\n可是又不能带善一起去……”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:2:3",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}“请再帮我一次。\n因为想尽快送给他，\n这次也照例设了{F2 01 03 01}期限{F2 01 01 01}。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:2:4",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}“那么，４６４９！”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:2:5",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 3D 11}……以上，完全照原文读出。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白放下了笔记本。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2B 11}看来这次是制作物品的委托。\n先去找{F2 01 03 01}迪奥{F2 01 01 01}商量比较好。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e822_700.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 CE 0E}那么……\n愿这两位幸福美满。\n{F2 23 00 00}{F1 21}{00}"
 }
]