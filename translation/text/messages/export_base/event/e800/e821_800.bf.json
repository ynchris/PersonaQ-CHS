[
 {
  "key": "export_base/event/e800/e821_800.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E7 0E}据说，这世上有一种叫{F2 01 03 01}邪眼{F2 01 01 01}的\n禁忌之眼，拥有\n将对方诅咒致死的力量。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_800.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}正值青春期的少年们，\n似乎无时无刻不在寻找\n解放那只眼睛的机会……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_800.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}真想亲自体验一下呢。\n能请您为我取来\n符合条件的素材吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_800.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 DE 0E}如果我没记错的话……\n名叫{F4 84 04 01 01 01 9D 08}的素材，\n应该符合我的要求……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_800.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 2B 11}另外，有关素材的事，\n去请教{F2 01 03 01}迪奥{F2 01 01 01}应该最合适。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_800.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 05 01}{F5 86 22 01 02 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_800.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 E2 0E}虽然我刚才这么说……\n不过，您现在带着的\n那个{F4 84 04 01 01 01 9D 08}素材……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_800.bf.json:1:2",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}和我委托中要求的素材\n条件几乎一致……不，就是它……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_800.bf.json:1:3",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}只要向我汇报并交出素材，\n立刻就能完成委托。\n还请您积极考虑。\n{F2 23 00 00}{F1 21}{00}"
 }
]