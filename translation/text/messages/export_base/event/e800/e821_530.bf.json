[
 {
  "key": "export_base/event/e800/e821_530.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２楼　节目走廊\n　“兴奋畅玩乐园”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞遇到了荒垣。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 13 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 BE 0C}哟。\n干什么呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞向荒垣说明了情况……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 F5 0C}{F5 C1 03 01 01 01 01 01 0A 01}啊——该怎么说呢……真够倒霉的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:3:1",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 04 01}不过我现在有点事……\n抱歉，帮不了你。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:4:0",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 C4 0C}这样吧，我教你几个做火锅的诀窍，\n就当作补偿。\n别怪我啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞荒垣决定传授做火锅的诀窍……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AB 11}首先要说清楚，火锅没有标准答案。\n所以这只是我的做法。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:6:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 E9 0C}我会刻意把食材控制在{F2 01 03 01}３种{F2 01 01 01}左右，\n免得味道混得太杂。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:6:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}选食材时，先定{F2 01 03 01}主料{F2 01 01 01}，\n再选搭配合适的{F2 01 03 01}蔬菜{F2 01 01 01}，\n最后选用来{F2 01 03 01}点缀{F2 01 01 01}的食材。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:6:3",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……就这些。\n还有什么想问的吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞要向荒垣请教什么呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:8:0",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}什么蔬菜适合配肉？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:8:1",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}什么蔬菜适合配鱼？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:8:2",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}用什么食材点缀？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:8:3",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}谢谢{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}肉会煮出不少油脂。\n配上吸油的{F2 01 03 01}大葱{F2 01 01 01}或{F2 01 03 01}白菜{F2 01 01 01}，\n应该会很合适。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，肉丸不会出那么多油。\n我觉得与其放大葱，\n不如用{F2 01 03 01}蘑菇{F2 01 01 01}来丰富味道。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}鱼总会带点腥味。\n配上清爽的{F2 01 03 01}水菜{F2 01 01 01}或{F2 01 03 01}大葱{F2 01 01 01}，\n算是常见做法。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:10:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}不过，贝类的话，\n比起大葱，我更推荐{F2 01 03 01}蘑菇{F2 01 01 01}。\n看着也丰盛。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}点缀的食材要配合蔬菜来选。\n不用管主料。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:11:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}选白菜的话，稳妥点就用{F2 01 03 01}油豆腐{F2 01 01 01}……\n或者选{F2 01 03 01}豆腐皮{F2 01 01 01}，也挺有意思。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:11:2",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}大葱配{F2 01 03 01}豆腐皮{F2 01 01 01}也不错。\n或者放{F2 01 03 01}粉丝{F2 01 01 01}也行。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:11:3",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}水菜配{F2 01 03 01}豆腐{F2 01 01 01}肯定没错。\n另外，{F2 01 03 01}粉丝{F2 01 01 01}应该也很合适。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:11:4",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}蘑菇就别冒险了，配{F2 01 03 01}豆腐{F2 01 01 01}或{F2 01 03 01}油豆腐{F2 01 01 01}吧。\n蘑菇本身就能提味了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 C4 0C}{F5 C1 03 01 01 01 01 01 04 01}抱歉，没法帮忙。\n我被某个笨蛋缠上了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:12:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 AE 11}不随便应付他一下，\n事情恐怕会变得很麻烦……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 06 01 05 01}{F5 61 02 01 01 01 01 01 8A 11}哦，你是在说我吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞真田不知从哪里冒了出来……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 B2 0C}{F5 C1 03 01 01 01 01 01 04 01}唉……说的就是你。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 04 01 01 01 01 01 05 01}今天一定要分出胜负。\n就用这个套圈！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 09 01 02 01 01 01}{F5 61 02 01 01 01 01 01 A8 11}扔几个圈能分出什么胜负啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 B7 09}{F5 C1 04 01 01 01 01 01 05 01}走吧，真次郎！\n从选圈的那一刻起，\n比赛就已经开始了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 05 01 01 01 01 01}{F5 86 13 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 AB 11}{F5 C1 03 01 01 01 01 01 0A 01}那家伙……到底几岁啊……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:19:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 C1 0C}……总之，就是这么回事。\n接下来你自己加油。再见。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞荒垣几乎是被真田拖走的……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:20:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞食材收集得还顺利吗……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_530.bf.json:20:2",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞回半生不熟厨房看看吧……\n{F2 23 00 00}{F1 21}{00}"
 }
]