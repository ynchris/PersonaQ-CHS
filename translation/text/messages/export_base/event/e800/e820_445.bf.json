[
 {
  "key": "export_base/event/e800/e820_445.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 02 01 05 01 02 01}{F5 86 09 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 38 06}打扰一下。\n伊丽莎白小姐，有些事情想请教您。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞直斗简要说明了\n　“肉羊羹失窃案”的经过……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}请问您当时在做什么？\n方便的话，可以告诉我们吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 02 01}{F5 61 02 01 01 01 01 01 D2 0E}原来如此……\n承接委托时没有当面说，\n是出于这个原因啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}抱歉……\n我们不能向嫌疑人透露信息。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}原来如此……\n那么，我只有一句话可以说……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}犯人就在我们姐弟三人之中{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 04 01}{F5 61 02 01 01 01 01 01 42 06}姐弟三人，指的是玛格丽特小姐、\n迪奥多先生，还有您……对吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 09 01 02 01 03 01 01 01}{F5 61 02 01 01 01 01 01 58 06}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 02 01 03 01 01 01}{F5 61 02 01 01 01 01 01 01 01}一般来说，不是会否认自己有错，\n就是会袒护自己的姐弟才对……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 01 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}如果我就是犯人，\n自然不能向侦探提供情报。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}当然，也有可能是假情报。\n请您充分斟酌。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 09 01 02 01 03 01 01 01}{F5 61 02 01 01 01 01 01 77 11}{F5 C1 03 01 01 01 01 01 07 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:9:0",
  "message_id": "MSG_0082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}坦白说，您刚才的话\n会让自己陷入不利的境地……\n即便如此也没关系吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 11 01 05 01 02 01}{F5 61 02 01 01 01 01 01 D7 0E}呵呵……我是做好觉悟才说的。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 36 06}原来如此……\n感谢您的配合。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_445.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞听取了伊丽莎白的证词。\n{F2 23 00 00}{F1 21}{00}"
 }
]