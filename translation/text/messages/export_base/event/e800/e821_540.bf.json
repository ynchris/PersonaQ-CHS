[
 {
  "key": "export_base/event/e800/e821_540.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞再次来到“半生不熟厨房”前……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞这里摆着１２种食材……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 7F 03}挑了这个又想要那个，\n结果就拿了这么多。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:1:1",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}总之，随便挑、随便放！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 07 01 01 01 05 01}{F5 61 02 01 01 01 01 01 29 04}{F5 C1 03 01 01 01 01 01 04 01}没找到海星……\n捞金鱼的池子里也没有……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 09 01 04 01 01 01}{F5 61 02 01 01 01 01 01 66 03}啊——那里都没有的话，\n学校里应该就找不到了吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:4:0",
  "message_id": "MSG_0032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 50 03}{F5 C1 03 01 01 01 01 01 05 01}……咦？\n荒垣学长呢？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:5:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 02 01 01 01 05 01}{F5 86 01 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞把从荒垣那里学到的知识\n　告诉了大家……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:6:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 42 04}这样啊……\n他有事的话，那也没办法。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:6:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}那就不好意思，\n要拜托{F1 81}了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:7:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 07 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 F8 04}锅已经找来了。\n水也已经烧开了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:8:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 05 01}{F5 61 02 01 01 01 01 01 E4 0A}高汤暂时只放了昆布。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 DA 03}那么，{F1 81}！\n这锅就交给你啦！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我们还要准备秘密绝招，\n就拜托你了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞女生们各自开始\n　准备着什么……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:10:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞总之，先做火锅吧……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:10:2",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞首先，要决定主料……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:10:3",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞可以作为主料的有\n　{F2 01 03 01}扇贝、真鳕、肉丸、五花肉{F2 01 01 01}\n　这４种。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:10:4",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞要选哪种主料呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:11:0",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}扇贝{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:11:1",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}真鳕{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:11:2",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}肉丸{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:11:3",
  "message_id": "SEL_010",
  "translation": "{F2 05 FF FF}{F1 41}五花肉{00}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定以{F2 01 03 01}五花肉{F2 01 01 01}作为主料。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 EE 03}{F5 C1 03 01 01 01 01 01 08 01}哦，很懂嘛！\n果然还是要吃肉，肉！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:13:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}就这样一路钻研肉之道吧。\n嗯！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:14:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定以{F2 01 03 01}肉丸{F2 01 01 01}作为主料。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 04 04}哦，真是行家啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:15:1",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}有了肉丸，\n感觉才像在吃火锅呢！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定以{F2 01 03 01}真鳕{F2 01 01 01}作为主料。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:17:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 05 01 05 01 02 01}{F5 61 02 01 01 01 01 01 3B 04}鱼肉火锅呢。\n整条放进去的话，鱼头和鱼尾\n应该能熬出很鲜的汤吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:18:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定以{F2 01 03 01}扇贝{F2 01 01 01}作为主料。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 2B 04}用贝类当主料，感觉很成熟呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:19:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 B0 04}说起来，你知道吗？\n扇贝会用力合上贝壳，\n借喷出海水的冲力游泳。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:19:2",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}很帅气吧。全力以赴呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞接下来决定蔬菜吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:20:1",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞女生们带来的蔬菜有\n　{F2 01 03 01}白菜、大葱、水菜、蘑菇{F2 01 01 01}\n　这４种。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:20:2",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞要选哪种蔬菜呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:21:0",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}白菜{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:21:1",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}大葱{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:21:2",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}水菜{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:21:3",
  "message_id": "SEL_020",
  "translation": "{F2 05 FF FF}{F1 41}蘑菇{00}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定选择{F2 01 03 01}白菜{F2 01 01 01}作为蔬菜。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:23:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 E4 0A}火锅果然还是要放白菜呢。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:23:1",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我以前试过用白菜做焗菜。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:23:2",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}明明是白菜和白酱，\n却做出了黑乎乎的焗菜。\n很不可思议吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:24:0",
  "message_id": "MSG_023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定选择{F2 01 03 01}大葱{F2 01 01 01}作为蔬菜。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:25:0",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 E7 0A}大葱是很厉害的配角呢。\n这里有葱，那里也有葱……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:25:1",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}有时候回过神来，\n餐桌上每个盘子里都有葱……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:25:2",
  "message_id": "MSG_024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 01 01}既然这样，一开始就在桌上\n放一整根大葱不就好了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:26:0",
  "message_id": "MSG_025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定选择{F2 01 03 01}水菜{F2 01 01 01}作为蔬菜。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:27:0",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 48 0B}水菜很方便呢。\n和什么都能搭配。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:27:1",
  "message_id": "MSG_026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}灵活应变，和谁都合得来，\n就像队长一样。\n简直是蔬菜界的“不羁”！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:28:0",
  "message_id": "MSG_027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定选择{F2 01 03 01}蘑菇{F2 01 01 01}作为蔬菜。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:29:0",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 F7 04}你知道吗？\n蘑菇其实是真菌。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:29:1",
  "message_id": "MSG_028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}第一个吃它的人，\n当时一定饿坏了吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:30:0",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞最后决定用来点缀的食材吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:30:1",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞可以用来点缀的食材有\n　{F2 01 03 01}豆腐、油豆腐、豆腐皮、粉丝{F2 01 01 01}\n　这４种。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:30:2",
  "message_id": "MSG_029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞要选哪种食材点缀呢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:31:0",
  "message_id": "SEL_030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}豆腐{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:31:1",
  "message_id": "SEL_030",
  "translation": "{F2 05 FF FF}{F1 41}油豆腐{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:31:2",
  "message_id": "SEL_030",
  "translation": "{F2 05 FF FF}{F1 41}豆腐皮{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:31:3",
  "message_id": "SEL_030",
  "translation": "{F2 05 FF FF}{F1 41}粉丝{00}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:32:0",
  "message_id": "MSG_031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定用{F2 01 03 01}豆腐{F2 01 01 01}来点缀。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:33:0",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 E7 04}{F5 C1 03 01 01 01 01 01 08 01}我我我！\n那个是我拿来的。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:33:1",
  "message_id": "MSG_032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}奶奶说过，\n只要吃豆腐，\n其他就没什么好担心的了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:34:0",
  "message_id": "MSG_033",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定用{F2 01 03 01}油豆腐{F2 01 01 01}来点缀。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:35:0",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 F8 04}油豆腐在日语里就叫“油炸”……\n这么说，天妇罗、可乐饼，\n所有油炸食品不都算吗？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:35:1",
  "message_id": "MSG_034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}我从小就觉得奇怪了。\n不过好吃就行。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:36:0",
  "message_id": "MSG_035",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定用{F2 01 03 01}豆腐皮{F2 01 01 01}来点缀。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:37:0",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3D 04}旅馆的晚餐可少不了豆腐皮。\n我们主厨说，放上它，\n一下就有旅馆料理的感觉了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:37:1",
  "message_id": "MSG_036",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}确实，旅馆的料理\n也很讲究氛围呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:38:0",
  "message_id": "MSG_037",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞决定用{F2 01 03 01}粉丝{F2 01 01 01}来点缀。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:39:0",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 7D 03}粉丝在日语里叫“春雨”，\n据说是因为它看起来\n就像春天落下的细雨。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:39:1",
  "message_id": "MSG_038",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 05 01}不过，不是春天\n也会下细雨吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:40:0",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}＞所有食材都选好了！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:40:1",
  "message_id": "MSG_039",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞调好味，\n　这就开始炖煮吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:41:0",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:41:1",
  "message_id": "MSG_040",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞………\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:42:0",
  "message_id": "MSG_041",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞飘出了诱人的热气……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:43:0",
  "message_id": "MSG_042",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 FF 03}{F5 C1 03 01 01 01 01 01 08 01}啊，好香！\n你真厉害，{F1 81}！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:44:0",
  "message_id": "MSG_043",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 05 01 05 01 05 01}{F5 61 02 01 01 01 01 01 59 04}我们也准备好了。\n就等花村同学来了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:45:0",
  "message_id": "SEL_044",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}准备什么？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:45:1",
  "message_id": "SEL_044",
  "translation": "{F2 05 FF FF}{F1 41}真的没问题吗？{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:46:0",
  "message_id": "MSG_045",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 11 01 02 01 01 01}{F5 61 02 01 01 01 01 01 7F 03}惊喜留到后面再揭晓！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:47:0",
  "message_id": "MSG_046",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 6D 03}嗯，当然！\n这次也是我们信心十足的杰作！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:48:0",
  "message_id": "MSG_047",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 02 01}{F5 86 07 01 05 01 02 01 04 01}{F5 61 02 01 01 01 01 01 CC 04}我把花村学长叫来啦！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:49:0",
  "message_id": "MSG_048",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 83 02}哟！让你们久等了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:50:0",
  "message_id": "MSG_0482",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 E6 02}哎呀，好期待啊。\n居然能吃到你们亲手做的料理。\n真是太期待了啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:51:0",
  "message_id": "MSG_0483",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 A7 02}{F5 C1 03 01 01 01 01 01 04 01}{F5 C1 04 01 01 01 01 01 04 01}唉……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:52:0",
  "message_id": "SEL_049",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 01 01 02 01 01 01 02 01}没问题的{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:52:1",
  "message_id": "SEL_049",
  "translation": "{F2 05 FF FF}{F1 41}辛苦了{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:53:0",
  "message_id": "MSG_050",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 3B 03}{F5 C1 03 01 01 01 01 01 01 01}咦！？\n你搞定了！？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:53:1",
  "message_id": "MSG_050",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A0 02}{F5 C1 03 01 01 01 01 01 0A 01}……不，我还不能上当。\n到现在为止，相信她们\n就从来没有好下场……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:54:0",
  "message_id": "MSG_051",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 17 03}{F5 C1 03 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 04 01}嗯……\n我已经吃过胃药了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:55:0",
  "message_id": "MSG_052",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 8E 03}好啦好啦。\n我们这次的手艺\n可是和以前不一样哦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:56:0",
  "message_id": "MSG_053",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 02 01 01 01}{F5 61 02 01 01 01 01 01 2D 03}你们以前做出来的东西，\n可不只是手艺差一点吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:57:0",
  "message_id": "MSG_054",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 F1 0A}那么……我要开盖了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:58:0",
  "message_id": "MSG_055",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞风花打开了锅盖！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:59:0",
  "message_id": "MSG_056",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 D2 02}{F5 C1 03 01 01 01 01 01 07 01}……哦！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:60:0",
  "message_id": "MSG_057",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞无论气味还是外观，\n　都像一锅正经火锅……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:61:0",
  "message_id": "MSG_058",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 03 01 01 01}{F5 61 02 01 01 01 01 01 D3 02}这、这个……\n好像真的可以期待一下……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:62:0",
  "message_id": "MSG_059",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 02 01 02 01}{F5 61 02 01 01 01 01 01 FC 04}所以我就说嘛！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:63:0",
  "message_id": "MSG_060",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 01 01}{F5 61 02 01 01 01 01 01 EC 02}里面没放海星之类的东西吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:64:0",
  "message_id": "MSG_061",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 2B 04}没有哦？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:65:0",
  "message_id": "MSG_062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 98 02}{F5 C1 03 01 01 01 01 01 0A 01}也、也是啊。\n再怎么说，海星也想得太夸张了……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:65:1",
  "message_id": "MSG_062",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 63 11}那、那我开动了……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:66:0",
  "message_id": "MSG_063",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞阳介开始吃火锅了……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:67:0",
  "message_id": "MSG_064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 04 01}{F5 61 02 01 01 01 01 01 B8 02}{F5 C1 03 01 01 01 01 01 07 01}……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:67:1",
  "message_id": "MSG_064",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这、这是……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:68:0",
  "message_id": "MSG_065",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 01 01 01 01}{F5 61 02 01 01 01 01 01 F5 02}{F5 C1 03 01 01 01 01 01 08 01}好吃啊啊啊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:69:0",
  "message_id": "MSG_066",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 E3 03}{F5 C1 03 01 01 01 01 01 01 01}真的！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:70:0",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 09 01 05 01 01 01}{F5 61 02 01 01 01 01 01 BA 02}去掉了多余的东西，\n每一种食材的美味\n都发挥出了１２０％……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:70:1",
  "message_id": "MSG_067",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}简单，却又回味无穷……！\n我从没吃过这么好吃的火锅！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:71:0",
  "message_id": "MSG_068",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 12 0B}{F5 C1 03 01 01 01 01 01 07 01}太、太好了……！\n我们成功了，队长！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:72:0",
  "message_id": "MSG_069",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞阳介似乎特别满意！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:73:0",
  "message_id": "MSG_070",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 F4 02}虽然有些地方有点在意……\n不过还挺好吃的嘛？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:74:0",
  "message_id": "MSG_071",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 01 01 02 01}{F5 61 02 01 01 01 01 01 6E 03}{F5 C1 03 01 01 01 01 01 08 01}好耶。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:75:0",
  "message_id": "MSG_072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 03 01 01 01}{F5 61 02 01 01 01 01 01 FA 02}话说，这可是能正经吃下去的东西啊！\n光这样就够了，足够了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:76:0",
  "message_id": "MSG_073",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 11 0B}那、那个……\n也就是说，他很满意……对吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:77:0",
  "message_id": "MSG_074",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞阳介似乎很满意！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:78:0",
  "message_id": "MSG_075",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 E7 02}还……不坏……吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:79:0",
  "message_id": "MSG_076",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 6A 03}{F5 C1 03 01 01 01 01 01 07 01}咦——？就这样？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:80:0",
  "message_id": "MSG_077",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 01 01}……嗯。\n还……不坏……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:80:1",
  "message_id": "MSG_077",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 BA 02}{F5 C1 03 01 01 01 01 01 0A 01}说真的，没想到你们居然\n能端出一锅正常的火锅，\n反倒让我有点措手不及。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:81:0",
  "message_id": "MSG_078",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 11 0B}总、总之，\n我们应该可以高兴一下吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:82:0",
  "message_id": "MSG_079",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞似乎没能打动阳介……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:83:0",
  "message_id": "MSG_080",
  "translation": "{F2 05 FF FF}{F1 41}{F4 87 0C 01 01 01 01 01}{F5 86 04 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 D7 02}哎呀，多谢款待。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:83:1",
  "message_id": "MSG_080",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 93 02}那我也差不多该告辞了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:84:0",
  "message_id": "MSG_081",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 03 01 02 01 02 01}{F5 61 02 01 01 01 01 01 C9 03}站——住！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:85:0",
  "message_id": "MSG_0812",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 01 01}{F5 61 02 01 01 01 01 01 BC 03}花村。\n接下来才是重头戏。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:86:0",
  "message_id": "MSG_082",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0B 01 01 01 01 01}{F5 61 02 01 01 01 01 01 65 11}{F5 C1 03 01 01 01 01 01 05 01}……此话怎讲？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e821_540.bf.json:87:0",
  "message_id": "MSG_083",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 06 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 24 04}趁{F1 81}帮忙煮火锅的时候，\n我们试着做了蘸酱。\n{F2 23 00 00}{F1 21}"
 },
 {
