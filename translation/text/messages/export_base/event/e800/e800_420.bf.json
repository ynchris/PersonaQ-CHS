[
 {
  "key": "export_base/event/e800/e800_420.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞２Ｆ　节目走廊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 09 01 02 01 01 01 02 01}{F5 61 02 01 01 01 01 01 77 11}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞直斗正在观察四周……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 48 06}呼……走到这里，应该就没事了。\n那么，开始推理“肉羊羹失窃案”吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:4:0",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}你在警戒？{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:4:1",
  "message_id": "SEL_004",
  "translation": "{F2 05 FF FF}{F1 41}伊丽莎白也是嫌疑人？{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 3C 06}是的……刚才也说过，\n我希望尽量秘密解决这件事。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}因为犯人就在我们身边的可能性\n非常高……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:5:2",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}我按顺序说明吧。\n首先，整理一下案发情况。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 57 06}{F5 C1 03 01 01 01 01 01 07 01}……！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 68 06}真敏锐……\n把委托交给您，\n果然没错。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:6:2",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我按顺序说明吧。\n首先，整理一下案发情况。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 02 01}{F5 61 02 01 01 01 01 01 01 01}首先，推测案发时间，\n应该是在我们探索迷宫期间。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}据此判断，\n有机会作案的共有四人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:7:2",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}迪奥多先生、玛格丽特小姐、\n玛丽小姐，以及伊丽莎白小姐。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:7:3",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}其他同伴都一起参加了探索，\n文化祭的居民则没有自主意识。\n因此，嫌疑人就是这四位。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:7:4",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}另外，据受害者Ｓ小姐所说，\n从迷宫回来时，\n她看到了一个逃走的背影。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:7:5",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}因为只是一瞬间，\n她不记得对方的衣着和身高，\n但基本可以认为是单独作案。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:8:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 43 06}以上就是目前的推理。\n您怎么看？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:9:0",
  "message_id": "SEL_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}我也这么想{F5 47 02 01 01 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:9:1",
  "message_id": "SEL_008",
  "translation": "{F2 05 FF FF}{F1 41}不愧是侦探王子{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:9:2",
  "message_id": "SEL_008",
  "translation": "{F2 05 FF FF}{F1 41}我不是犯人！！{F5 47 02 01 01 01 05 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 36 06}谢谢您。\n就沿着这条线索调查吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:10:1",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}那么……接下来去收集证词，\n不过在那之前，\n先向您传授调查的诀窍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 09 01 01 01 02 01}{F5 61 02 01 01 01 01 01 65 06}{F5 C1 03 01 01 01 01 01 0B 01}请、请不要取笑我！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:11:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}那、那么……接下来去收集证词，\n不过在那之前，\n先向您传授调查的诀窍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:12:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 02 01}{F5 61 02 01 01 01 01 01 42 06}{F5 C1 03 01 01 01 01 01 0A 01}不、不是……\n您有在听吧？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:12:1",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}那、那么……接下来去收集证词，\n不过在那之前，\n先向您传授调查的诀窍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:13:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}基本上，{F2 01 03 01}犯人会说谎{F2 01 01 01}。\n反过来说，说谎的嫌疑人，\n就可以认为是犯人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:13:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这时，刚才提到的前提\n就很重要了。\n以这次的情况来说……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:13:2",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F2 01 03 01}犯人只有一个{F2 01 01 01}。\n{F2 01 03 01}犯人会说谎{F2 01 01 01}。\n{F2 01 03 01}其他人都说真话{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:13:3",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}这就是本次推理的前提。\n请记在心里。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:13:4",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}以上就是调查的诀窍。\n您明白了吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:14:0",
  "message_id": "SEL_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}完全明白了{F5 47 02 01 01 01 03 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:14:1",
  "message_id": "SEL_013",
  "translation": "{F2 05 01 FF}{F1 41}请再说一遍{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:15:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}那么，我再说明一次。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:16:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 AE 06}那么，出发吧。\n先到他们所在的{F2 01 03 01}设施{F2 01 01 01}，\n收集证词。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e800_420.bf.json:16:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}等收集完所有人的证词，\n我们再谈。\n{F2 23 00 00}{F1 21}{00}"
 }
]