[
 {
  "key": "export_base/event/e800/e820_470.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞正在寻找“肉羊羹失窃案”的犯人……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:1:0",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 01 01}犯人是迪奥多！{F5 47 02 01 01 01 01 01 21 01}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:1:1",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}回想证词{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:1:2",
  "message_id": "SEL_001",
  "translation": "{F2 05 FF FF}{F1 41}下次再说{00}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 A4 0F}我、我是犯人！？\n您有什么根据，竟然这样说……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞告诉迪奥，\n　自己把他的证词反过来考虑了一遍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 06 01 02 01}{F5 61 02 01 01 01 01 01 01 01}把证词反过来……？\n那、那么，就试试看吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:4:1",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我不是犯人，\n伊丽莎白姐姐很可疑。\n反过来就是……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:4:2",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}我是犯人。\n伊丽莎白姐姐并不可疑……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:4:3",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 96 0F}意思倒是说得通……\n可这能算是什么证据吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 08 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞确实如此……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}虽然很对不起您、白钟大人，\n还有里中大人，\n但我并不是犯人。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:6:1",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}还请你们去别处调查……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 24 06}打扰了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:8:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞直斗回来了……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:9:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}调查辛苦了。\n我刚才也在解释，\n我真的不是犯人……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:10:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 01 01}嗯……刚才的对话，\n我已经听到了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:10:1",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 C5 06}迪奥多先生……\n果然，犯人就是您吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:11:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 13 01 04 01 02 01}{F5 61 02 01 01 01 01 01 A4 0F}{F5 C1 03 01 01 01 01 01 01 01}为、为什么！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:12:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 07 01}{F5 61 02 01 01 01 01 01 01 01}我是这样对您说的吧？\n“Ｓ小姐的肉羊羹不见了。”\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:12:1",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 05 01 03 01 07 01}{F5 61 02 01 01 01 01 01 01 01}那么，您刚才为什么会知道，\n受害者就是里中学姐呢！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:13:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 24 01 14 01 04 01 01 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 02 01}……！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:14:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 01 01}现在坦白的话，\n还可以从轻处理。\n您打算怎么办？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:15:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 24 01 02 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:15:1",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}不、不……\n非常抱歉……\n请容我……拒绝。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:16:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 60 06}……明白了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:17:0",
  "message_id": "MSG_0162",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 13 01 02 01 07 01}{F5 61 02 01 01 01 01 01 01 01}那么，麻烦您……\n把大家召集到联谊咖啡厅入口，\n好吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:18:0",
  "message_id": "SEL_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}这样就可以了吗？{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:18:1",
  "message_id": "SEL_017",
  "translation": "{F2 05 FF FF}{F1 41}为什么？{00}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:19:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 07 01}{F5 61 02 01 01 01 01 01 01 01}我的调查也有了进展，\n已经形成了一个假说。\n希望能向各位说明。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:19:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}……迪奥多先生。\n您不必发言，\n只要跟我们来就好，可以吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:20:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 1A 01 01 01 01 01 01 01}{F5 86 24 01 02 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:21:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞召集了大家，\n　前往联谊咖啡厅入口……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:22:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞以{F2 01 03 01}犯人一定在说谎，\n　而且犯人只有一人{F2 01 01 01}为前提，\n　回想一下各人的证词吧。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:22:1",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛丽说：\n　{F2 01 03 01}“我不是犯人，\n　犯人会说谎。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:22:2",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞玛格丽特说：\n　{F2 01 03 01}“玛丽没有说谎，\n　我不是犯人。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:22:3",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞迪奥说：\n　{F2 01 03 01}“我不是犯人，\n　伊丽莎白才是犯人。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:22:4",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞伊丽莎白只说：\n　{F2 01 03 01}“犯人就在我们姐弟三人之中。”{F2 01 01 01}\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_470.bf.json:22:5",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞犯人究竟是谁呢……\n{F2 23 00 00}{F1 21}{00}"
 }
]