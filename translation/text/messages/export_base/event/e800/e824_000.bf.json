[
 {
  "key": "export_base/event/e800/e824_000.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 02 01}欢迎来到“伊丽莎白的房间”……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_000.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 03 01}有件事要通知您。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_000.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 04 01}您已经变得足够强大，\n有资格驾驭{F2 01 03 01}“那个人格面具”{F2 01 01 01}了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_000.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 05 01}本想立即向您展示……\n不过，现在还不能交给您。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_000.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 06 01}{F2 01 03 01}因为您似乎还没有完成\n调查各迷宫最深处的“４项委托”{F2 01 01 01}……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_000.bf.json:0:5",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 07 01}这些委托对我的研究……\n也就是对您的力量，至关重要。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_000.bf.json:0:6",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 08 01}因此，\n还请先完成这些委托。\n{F2 23 00 00}{F1 21}{00}"
 }
]