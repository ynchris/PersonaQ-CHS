 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:8:1",
  "message_id": "SEL_007",
  "translation": "{F2 05 FF FF}{F1 41}听起来很难吃{F5 47 02 01 01 01 01 01 21 01}{00}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 6A 03}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}诶诶诶，你们不知道！？\n就是那个大名鼎鼎的\n“肉类甜品界的革命先锋”啊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:9:1",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 EE 03}明明是肉却甜甜的，\n明明是肉却滑溜溜的……\n就是集矛盾于一身的肉羊羹啊！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 C6 07}{F5 C1 03 01 01 01 01 01 0A 01}你说得再激动也没用啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:11:0",
  "message_id": "MSG_010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0B 01 02 01 01 01 04 01}{F5 86 05 01 0D 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}我把它放在这个迷宫入口的桌上，\n准备探索结束后，\n拿来犒劳自己的！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:12:0",
  "message_id": "MSG_0102",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 13 01 02 01 02 01}{F5 61 02 01 01 01 01 01 D9 03}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}可它不见了啊！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:13:0",
  "message_id": "MSG_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 CA 02}{F5 C1 03 01 01 01 01 01 0A 01}谁让你放在那种地方啊？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:14:0",
  "message_id": "MSG_012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 05 01 01 01 02 01}{F5 61 02 01 01 01 01 01 83 03}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 03 01}哈！？难道凶手就是你！？\n先给我道歉！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:15:0",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 05 01 01 01 04 01}{F5 61 02 01 01 01 01 01 AF 02}{F5 C1 02 01 01 01 01 01 02 01}{F5 C1 03 01 01 01 01 01 0B 01}求我吃我都不吃！！\n该道歉的是你吧！！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:15:1",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}你在前面磨磨蹭蹭地\n把那什么“肉羊羹”放到桌上，\n害我堵在后面，摔了一跤！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:15:2",
  "message_id": "MSG_013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 05 01 01 01 04 01}{F5 61 02 01 01 01 01 01 C0 02}{F5 C1 03 01 01 01 01 01 03 01}桌角直击我的要害，\n我还以为自己要死了！\n这绝对是全世界最窝囊的死法！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:16:0",
  "message_id": "MSG_014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}……你也不容易啊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:17:0",
  "message_id": "MSG_015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 B7 02}{F5 C1 03 01 01 01 01 01 04 01}呜呜……您能理解我吗……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:18:0",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0D 01 01 01 02 01}{F5 61 02 01 01 01 01 01 83 03}{F5 C1 03 01 01 01 01 01 07 01}等、等等……当时我也说过吧！\n我的肉羊羹要是有个三长两短，\n你的小命可就没了！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:18:1",
  "message_id": "MSG_016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}你那不叫差点死掉，\n而是捡回一条命了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:19:0",
  "message_id": "MSG_017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 11 01 07 01 04 01}{F5 61 02 01 01 01 01 01 BF 02}{F5 C1 03 01 01 01 01 01 04 01}你、你这家伙……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:20:0",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 07 01}{F5 61 02 01 01 01 01 01 6A 06}{F5 C1 03 01 01 01 01 01 0A 01}请、请冷静一点……\n那个……这样很难看哦……？\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:20:1",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 03 01 07 01}{F5 61 02 01 01 01 01 01 B9 06}不过，既然是盗窃案，\n就不能坐视不理了。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:20:2",
  "message_id": "MSG_018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 42 06}说不定犯人就在我们身边……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:21:0",
  "message_id": "MSG_019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 0B 01 01 01 02 01}{F5 61 02 01 01 01 01 01 6E 11}{F5 C1 03 01 01 01 01 01 01 01}花村！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:22:0",
  "message_id": "MSG_020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 04 01 05 01 01 01 04 01}{F5 61 02 01 01 01 01 01 9F 02}{F5 C1 03 01 01 01 01 01 03 01}都说了我不吃！！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:23:0",
  "message_id": "MSG_021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 05 01 02 01 01 01 02 01}{F5 86 04 01 02 01 01 01 04 01}{F5 86 09 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 01 01}……里中学姐。\n之后请向我说明一下情况。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:24:0",
  "message_id": "MSG_0212",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 02 01}{F5 86 09 01 0D 01 01 01 07 01}{F5 61 02 01 01 01 01 01 B4 06}我会把这件事作为委托发布。\n一起推理这起案件吧。\n拜托您了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_400.bf.json:25:0",
  "message_id": "MSG_022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞新增委托\n　{F2 01 03 01}“抓住偷吃东西的小偷”{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 }
