[
 {
  "key": "export_base/event/e800/e820_440.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 02 01 04 01 02 01}{F5 86 09 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 38 06}打扰一下。\n迪奥多先生，有些事情想请教您。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:1:0",
  "message_id": "MSG_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}＞直斗简要说明了\n　“肉羊羹失窃案”的经过……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:2:0",
  "message_id": "MSG_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 01 01 01 01 04 01}{F5 61 02 01 01 01 01 01 01 01}请问您当时在做什么？\n方便的话，可以告诉我们吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:3:0",
  "message_id": "MSG_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 04 01 02 01}{F5 61 02 01 01 01 01 01 8F 0F}{F5 C1 03 01 01 01 01 01 0B 01}我、我什么都没做！\n真的，请相信我！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:4:0",
  "message_id": "MSG_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 07 01 01 01 04 01}{F5 61 02 01 01 01 01 01 6A 06}{F5 C1 03 01 01 01 01 01 07 01}请、请冷静一点！\n我们并没有认定您就是犯人！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:5:0",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}是、是吗……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:5:1",
  "message_id": "MSG_005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 07 01 04 01 02 01}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 04 01}姐姐总是把莫须有的罪名推到我身上，\n所以一不小心就……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:6:0",
  "message_id": "MSG_006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}{F5 C1 03 01 01 01 01 01 0A 01}{F5 C1 04 01 01 01 01 01 04 01}您、您也不容易啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:7:0",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}{F5 61 02 01 01 01 01 01 88 0F}不过，正如刚才所说，\n我可以断言，{F2 01 03 01}我不是犯人{F2 01 01 01}。\n虽然……很难证明……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:7:1",
  "message_id": "MSG_007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}顺便一提，在学校里四处走动最多的，\n毫无疑问是伊丽莎白姐姐。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:8:0",
  "message_id": "MSG_0072",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 05 01 06 01 02 01}{F5 61 02 01 01 01 01 01 01 01}这话只对你们说，\n我怀疑……{F2 01 03 01}犯人是伊丽莎白姐姐{F2 01 01 01}。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:9:0",
  "message_id": "MSG_008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 09 01 0D 01 01 01 04 01}{F5 61 02 01 01 01 01 01 36 06}明白了。\n感谢您的配合。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/event/e800/e820_440.bf.json:10:0",
  "message_id": "MSG_009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}＞听取了迪奥的证词。\n{F2 23 00 00}{F1 21}{00}"
 }
]