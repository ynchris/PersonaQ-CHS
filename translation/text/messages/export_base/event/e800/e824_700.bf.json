[
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:0",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 01 01 02 01 01 01 04 01}{F5 86 22 01 03 01 05 01 02 01}{F5 61 02 01 01 01 01 01 25 11}感谢您接受委托。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:1",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 E7 0E}这次的委托是讨伐\n{F2 01 03 01}稻羽乡土展{F2 01 01 01}的Ｆ．Ｏ．Ｅ……\n{F2 01 03 01}“祭典男”{F2 01 01 01}。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:2",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}此外，请带回\n{F2 01 03 01}“浓密的眉毛”{F2 01 01 01}，\n作为讨伐成功的证明。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:3",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}那种Ｆ．Ｏ．Ｅ会在祭典气氛高涨的\n{F2 01 03 01}第二夜{F2 01 01 01}和{F2 01 03 01}第四夜{F2 01 01 01}，抬着神轿，\n喊着“嘿咻嘿咻”。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:4",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这场战斗想必会相当艰难。\n所以，我来给您一个提示。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:5",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 05 01 01 01}{F5 61 02 01 01 01 01 01 01 01}祭典是祭神的仪式……\n而祭神仪式总是讲究礼节……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:6",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}既然是斗祭，\n{F2 01 03 01}双方人数相等{F2 01 01 01}再交手，\n才合乎规矩。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:7",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}若再让那些抬神轿的家伙喜欢的\n{F2 01 03 01}年轻男子们{F2 01 01 01}前去挑战……\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/event/e800/e824_700.bf.json:0:8",
  "message_id": "MSG_000",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 01 01}{F5 61 02 01 01 01 01 01 CF 0E}……那么，无论从哪种意义上说，\n都希望您能平安归来。\n{F2 23 00 00}{F1 21}{00}"
 }
]