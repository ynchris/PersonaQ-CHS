[
 {
  "key": "export_base/facility/msg_item.bmd.json:0:0",
  "message_id": "ISHOP_MSG_EITHER",
  "translation": "{F2 05 FF FF}{F1 41}是{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:0:1",
  "message_id": "ISHOP_MSG_EITHER",
  "translation": "{F2 05 FF FF}{F1 41}否{00}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:1:0",
  "message_id": "ISHOP_BUY_MSG2",
  "translation": "{F2 05 FF FF}{F1 41}＞{F2 44 02 01}个是{F2 44 03 01}元。\n　要购买吗？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:8:0",
  "message_id": "ISHOP_ADDNEW",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}进了些新商品哦。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:8:1",
  "message_id": "ISHOP_ADDNEW",
  "translation": "{F2 05 FF FF}{F1 41}多买点带回去吧。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:9:0",
  "message_id": "ISHOP_HELLO",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀，欢迎光临。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:10:0",
  "message_id": "SPECIAL_SELL",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}今天下雨，是特卖日哦。\n一下雨就没什么客人来了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:10:1",
  "message_id": "SPECIAL_SELL",
  "translation": "{F2 05 FF FF}{F1 41}所有商品都降价２成，\n多买些回去吧。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:18:0",
  "message_id": "ISHOP_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀，小伙子，\n咱们是头一次见吧？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:18:1",
  "message_id": "ISHOP_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}你从城里来的？\n哎哟，那可真辛苦啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:18:2",
  "message_id": "ISHOP_TALK001",
  "translation": "{F2 05 FF FF}{F1 41}店里虽然乱糟糟的，\n还是慢慢看看吧。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:19:0",
  "message_id": "ISHOP_TALK034",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}小伙子，你从城里来的？\n哎哟，那可真辛苦啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:19:1",
  "message_id": "ISHOP_TALK034",
  "translation": "{F2 05 FF FF}{F1 41}店里虽然乱糟糟的，\n还是慢慢看看吧。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:20:0",
  "message_id": "ISHOP_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}来来来，瞧一瞧。\n小伙子，仔细挑挑吧。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:20:1",
  "message_id": "ISHOP_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}这些可都是大婶引以为豪的货。\n尽管放心买吧。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:20:2",
  "message_id": "ISHOP_TALK002",
  "translation": "{F2 05 FF FF}{F1 41}女人靠胆量，男人靠讨喜嘛。\n帅小伙还能有赠品哦。\n啊哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:21:0",
  "message_id": "ISHOP_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}想在咱们这儿卖东西？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:21:1",
  "message_id": "ISHOP_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}不好意思啊…\n咱们店不收东西哦。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:21:2",
  "message_id": "ISHOP_TALK003",
  "translation": "{F2 05 FF FF}{F1 41}这样吧…去隔两间的“达伊达拉”\n问问如何？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:22:0",
  "message_id": "ISHOP_TALK004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀…好久没见巽屋的\n完二了呢。身体不舒服吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:22:1",
  "message_id": "ISHOP_TALK004",
  "translation": "{F2 05 FF FF}{F1 41}前阵子在电视上见过他，\n难道当上艺人了？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:22:2",
  "message_id": "ISHOP_TALK004",
  "translation": "{F2 05 FF FF}{F1 41}大婶很担心他，\n帮忙转告哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:23:0",
  "message_id": "ISHOP_TALK005",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}最近没见到完二呢。\n以前常来买零食的。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:23:1",
  "message_id": "ISHOP_TALK005",
  "translation": "{F2 05 FF FF}{F1 41}还会教训想偷东西的孩子…\n真是个好孩子啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:23:2",
  "message_id": "ISHOP_TALK005",
  "translation": "{F2 05 FF FF}{F1 41}买远足带的零食，\n也严格遵守预算呢…啊哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:24:0",
  "message_id": "ISHOP_TALK006",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}说起来，完二来买过东西呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:24:1",
  "message_id": "ISHOP_TALK006",
  "translation": "{F2 05 FF FF}{F1 41}他说交到了很帅气的前辈…\n笑得可高兴了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:24:2",
  "message_id": "ISHOP_TALK006",
  "translation": "{F2 05 FF FF}{F1 41}之前一直闷闷不乐的，\n大婶这下可放心了。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:25:0",
  "message_id": "ISHOP_TALK007",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}那么，今天要买什么？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:25:1",
  "message_id": "ISHOP_TALK007",
  "translation": "{F2 05 FF FF}{F1 41}小伙子，你老买些奇怪的东西…\n大婶有点担心啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:25:2",
  "message_id": "ISHOP_TALK007",
  "translation": "{F2 05 FF FF}{F1 41}去林间学校带多余的东西，\n会被老师骂哦。啊哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:26:0",
  "message_id": "ISHOP_TALK008",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}对了，你们去林间学校了吧？\n好多孩子提着行李走过呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:26:1",
  "message_id": "ISHOP_TALK008",
  "translation": "{F2 05 FF FF}{F1 41}哎…被推下瀑布？\n从高处跳下去了？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:26:2",
  "message_id": "ISHOP_TALK008",
  "translation": "{F2 05 FF FF}{F1 41}真淘气啊～\n啊哈哈哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:27:0",
  "message_id": "ISHOP_TALK009",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}最近有些怪人来打听\n理世的各种事情呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:27:1",
  "message_id": "ISHOP_TALK009",
  "translation": "{F2 05 FF FF}{F1 41}问她以前是什么样，\n有没有照片之类的…\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:27:2",
  "message_id": "ISHOP_TALK009",
  "translation": "{F2 05 FF FF}{F1 41}理世退出演艺圈，\n有那么罪大恶极吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:27:3",
  "message_id": "ISHOP_TALK009",
  "translation": "{F2 05 FF FF}{F1 41}丸久家也得做生意啊…\n他们说真是难办呢。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:28:0",
  "message_id": "ISHOP_TALK010",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}丸久家的理世，\n最近没见到了呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:28:1",
  "message_id": "ISHOP_TALK010",
  "translation": "{F2 05 FF FF}{F1 41}不当艺人了，也还是很辛苦吧？\n连咱们这儿都有怪记者来呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:28:2",
  "message_id": "ISHOP_TALK010",
  "translation": "{F2 05 FF FF}{F1 41}是不是该进点防身用品了…\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:28:3",
  "message_id": "ISHOP_TALK010",
  "translation": "{F2 05 FF FF}{F1 41}小伙子，你们见到理世，\n帮我问问她要不要吧。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:29:0",
  "message_id": "ISHOP_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}来来，今天要买什么？\n哎呀，还拿不定主意吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:29:1",
  "message_id": "ISHOP_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}要不学学隔壁的理世，\n大婶也给你现场示范推销？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:29:2",
  "message_id": "ISHOP_TALK011",
  "translation": "{F2 05 FF FF}{F1 41}啊哈哈，开玩笑的！\n慢慢挑吧。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:30:0",
  "message_id": "ISHOP_TALK012",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀…小伙子。\n…可怜见的，受苦了吧？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:30:1",
  "message_id": "ISHOP_TALK012",
  "translation": "{F2 05 FF FF}{F1 41}你们班主任被杀了吧？\n…我听别的孩子说了…\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:30:2",
  "message_id": "ISHOP_TALK012",
  "translation": "{F2 05 FF FF}{F1 41}真是的…怎么会\n这么不太平呢。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:31:0",
  "message_id": "ISHOP_TALK013",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}暑假过得开心吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:31:1",
  "message_id": "ISHOP_TALK013",
  "translation": "{F2 05 FF FF}{F1 41}…每天都很忙？\n上了高中，也真不容易啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:31:2",
  "message_id": "ISHOP_TALK013",
  "translation": "{F2 05 FF FF}{F1 41}觉得热了，随时来\n乘凉啊。啊哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:32:0",
  "message_id": "ISHOP_TALK014",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}最近夜里也能听到铃虫叫了，\n夏天快结束了呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:32:1",
  "message_id": "ISHOP_TALK014",
  "translation": "{F2 05 FF FF}{F1 41}小伙子，作业和\n图画日记都写好了吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:32:2",
  "message_id": "ISHOP_TALK014",
  "translation": "{F2 05 FF FF}{F1 41}…没有图画日记？\n哎呀，真是的～啊哈哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:33:0",
  "message_id": "ISHOP_TALK015",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀，看着很开心嘛？\n要去哪儿吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:33:1",
  "message_id": "ISHOP_TALK015",
  "translation": "{F2 05 FF FF}{F1 41}修学旅行…去城里？\n…哎哟，真不错啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:33:2",
  "message_id": "ISHOP_TALK015",
  "translation": "{F2 05 FF FF}{F1 41}大婶不了解城里的事，\n真羡慕你们呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:33:3",
  "message_id": "ISHOP_TALK015",
  "translation": "{F2 05 FF FF}{F1 41}等着你的伴手礼哦！\n啊哈哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:34:0",
  "message_id": "ISHOP_TALK016",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}城里怎么样？\n久违地回去玩得开心吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:34:1",
  "message_id": "ISHOP_TALK016",
  "translation": "{F2 05 FF FF}{F1 41}城里的便利店…是２４小时\n营业的吧？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:34:2",
  "message_id": "ISHOP_TALK016",
  "translation": "{F2 05 FF FF}{F1 41}店员可真辛苦啊…\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:34:3",
  "message_id": "ISHOP_TALK016",
  "translation": "{F2 05 FF FF}{F1 41}对了，有没有卖什么\n有趣的东西啊？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:35:0",
  "message_id": "ISHOP_TALK017",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}这就是“侦探王子”的效应吗…\n前阵子电视台来采访了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:35:1",
  "message_id": "ISHOP_TALK017",
  "translation": "{F2 05 FF FF}{F1 41}说想把咱们店放进\n“王子走访店铺百选”…我当然拒绝了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:35:2",
  "message_id": "ISHOP_TALK017",
  "translation": "{F2 05 FF FF}{F1 41}比起游客，我更想招待\n你们这样的孩子嘛…啊哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:36:0",
  "message_id": "ISHOP_TALK018",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}最近，朱尼斯一个叫熊田的\n可爱孩子经常来买东西呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:36:1",
  "message_id": "ISHOP_TALK018",
  "translation": "{F2 05 FF FF}{F1 41}说是你们推荐了这家店，\n然后就成了忠实顾客。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:36:2",
  "message_id": "ISHOP_TALK018",
  "translation": "{F2 05 FF FF}{F1 41}大婶可高兴了…\n谢谢你们啊。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:37:0",
  "message_id": "ISHOP_TALK019",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}入秋了，差不多该在店里\n摆些新米了吧。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:37:1",
  "message_id": "ISHOP_TALK019",
  "translation": "{F2 05 FF FF}{F1 41}还是说…柿饼…\n不对…松茸呢？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:37:2",
  "message_id": "ISHOP_TALK019",
  "translation": "{F2 05 FF FF}{F1 41}别看大婶这样，也有想过\n改变风格哦。啊哈哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:38:0",
  "message_id": "ISHOP_TALK020",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀…小伙子，\n今天看起来很忙啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:38:1",
  "message_id": "ISHOP_TALK020",
  "translation": "{F2 05 FF FF}{F1 41}…准备文化祭？\n是啊，又到这个时候了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:38:2",
  "message_id": "ISHOP_TALK020",
  "translation": "{F2 05 FF FF}{F1 41}大婶每年都很期待呢。\n有海报的话，随时拿来贴哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:39:0",
  "message_id": "ISHOP_TALK021",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}我去看文化祭了哦。\n小伙子，你穿女装了吧？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:39:1",
  "message_id": "ISHOP_TALK021",
  "translation": "{F2 05 FF FF}{F1 41}啊哈哈，大婶我啊，\n还给你投票了呢！\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:39:2",
  "message_id": "ISHOP_TALK021",
  "translation": "{F2 05 FF FF}{F1 41}下次叫上街坊邻居，\n一起去看吧。啊哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:40:0",
  "message_id": "ISHOP_TALK022",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}…小伙子，看着不舒服，\n没事吧？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:40:1",
  "message_id": "ISHOP_TALK022",
  "translation": "{F2 05 FF FF}{F1 41}有什么烦心事吗？\n有好好睡觉吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:40:2",
  "message_id": "ISHOP_TALK022",
  "translation": "{F2 05 FF FF}{F1 41}身体才是本钱啊…\n可别逞强哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:41:0",
  "message_id": "ISHOP_TALK023",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀，小伙子。\n怎么了？脸色这么差？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:41:1",
  "message_id": "ISHOP_TALK023",
  "translation": "{F2 05 FF FF}{F1 41}…菜菜子的情况不好吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:41:2",
  "message_id": "ISHOP_TALK023",
  "translation": "{F2 05 FF FF}{F1 41}虽然担心，身体也是本钱啊…\n可别逞强哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:42:0",
  "message_id": "ISHOP_TALK024",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}…大婶最近总觉得身体不舒服。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:42:1",
  "message_id": "ISHOP_TALK024",
  "translation": "{F2 05 FF FF}{F1 41}小伙子，你也要注意啊。\n这雾…总觉得让人不舒服…\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:43:0",
  "message_id": "ISHOP_TALK025",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}啊…真冷啊。\n都到年末了，也没办法啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:43:1",
  "message_id": "ISHOP_TALK025",
  "translation": "{F2 05 FF FF}{F1 41}去商店街开会，\n好多人都感冒了呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:43:2",
  "message_id": "ISHOP_TALK025",
  "translation": "{F2 05 FF FF}{F1 41}小伙子，你也要注意哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:44:0",
  "message_id": "ISHOP_TALK026",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀，好久不见了。\n最近过得好吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:44:1",
  "message_id": "ISHOP_TALK026",
  "translation": "{F2 05 FF FF}{F1 41}…这样啊。你要离开这里了…\n真舍不得啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:44:2",
  "message_id": "ISHOP_TALK026",
  "translation": "{F2 05 FF FF}{F1 41}以后再来这边，\n记得来店里看看哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:45:0",
  "message_id": "ISHOP_TALK027",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}你问有没有孩子\n在这里打过工？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:45:1",
  "message_id": "ISHOP_TALK027",
  "translation": "{F2 05 FF FF}{F1 41}大婶自己就能看店，\n所以没雇过打工的孩子哦。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:45:2",
  "message_id": "ISHOP_TALK027",
  "translation": "{F2 05 FF FF}{F1 41}不好意思啊。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:46:0",
  "message_id": "ISHOP_TALK028",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀，小伙子。\n外面的雾终于散了呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:46:1",
  "message_id": "ISHOP_TALK028",
  "translation": "{F2 05 FF FF}{F1 41}之前总让人不舒服呢。\n大婶这下也放心了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:46:2",
  "message_id": "ISHOP_TALK028",
  "translation": "{F2 05 FF FF}{F1 41}要是你们出了什么事，\n我会担心的啊。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:47:0",
  "message_id": "ISHOP_TALK029",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}真冷啊，冻死人了。\n听说今年特别冷呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:47:1",
  "message_id": "ISHOP_TALK029",
  "translation": "{F2 05 FF FF}{F1 41}大婶年轻时，也会在\n雪地里跑来跑去地玩…\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:47:2",
  "message_id": "ISHOP_TALK029",
  "translation": "{F2 05 FF FF}{F1 41}到了这个年纪，可就不行了。\n啊哈哈哈。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:48:0",
  "message_id": "ISHOP_TALK030",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}今年也快结束了啊。\n真是一眨眼的事。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:48:1",
  "message_id": "ISHOP_TALK030",
  "translation": "{F2 05 FF FF}{F1 41}有你和朋友们来光顾，\n大婶今年可开心了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:48:2",
  "message_id": "ISHOP_TALK030",
  "translation": "{F2 05 FF FF}{F1 41}明年也要\n再来玩哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:49:0",
  "message_id": "ISHOP_TALK031",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}好好，\n新年快乐啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:49:1",
  "message_id": "ISHOP_TALK031",
  "translation": "{F2 05 FF FF}{F1 41}小伙子，收了\n不少压岁钱吧？\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:49:2",
  "message_id": "ISHOP_TALK031",
  "translation": "{F2 05 FF FF}{F1 41}今年也记得\n多来咱们店买东西哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:50:0",
  "message_id": "ISHOP_TALK032",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 02 01 01 01 02 01}哎呀，小伙子。\n欢迎你来啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:50:1",
  "message_id": "ISHOP_TALK032",
  "translation": "{F2 05 FF FF}{F1 41}过完年之后，\n一下就安静下来了啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:50:2",
  "message_id": "ISHOP_TALK032",
  "translation": "{F2 05 FF FF}{F1 41}来来，外头很冷吧？\n在店里暖和暖和再走。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:51:2",
  "message_id": "ISHOP_TALK033",
  "translation": "{F2 05 FF FF}{F1 41}……啊！\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_item.bmd.json:51:3",
  "message_id": "ISHOP_TALK033",
  "translation": "{F2 05 FF FF}{F1 41}真是的，大婶我啊，\n竟然睁着眼就睡着了…啊哈哈。\n{F1 21}{00}"
 }
]