 },
 {
  "key": "export_base/facility/weapon.bf.json:1:0",
  "message_id": "WSHOP_HELLO_THEODORE",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0D 01 06 01 02 01}{F5 61 08 01 01 01 01 01 1C 01}欢迎，欢迎光临。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:2:0",
  "message_id": "WSHOP_WARNING",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}您似乎持有与委托有关的素材…\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:2:1",
  "message_id": "WSHOP_WARNING",
  "translation": "{F2 05 FF FF}{F1 41}还请留意，\n不要误卖了。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:3:0",
  "message_id": "WSHOP_DISCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 03 01 04 01 02 01}哦…\n{F4 84 04 01 01 01 CA 07}和{F4 84 04 01 01 01 CB 07}，\n您已经集齐２张了呢。\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:3:1",
  "message_id": "WSHOP_DISCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}每张可减免１０％，\n今后所有商品都能以\n减免２０％的价格购买。\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:3:2",
  "message_id": "WSHOP_DISCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}今后也请您\n多多惠顾。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:6:0",
  "message_id": "WSHOP_OUT_MARGARET",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 05 01 05 01 02 01}{F5 61 08 01 01 01 01 01 12 01}那么，下次再见。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:7:0",
  "message_id": "WSHOP_OUT_THEODORE",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 24 01 0D 01 06 01 02 01}{F5 61 08 01 01 01 01 01 1D 01}期待您的再次光临。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:8:0",
  "message_id": "WSHOP_TUTORIAL_1ST_IN",
  "translation": "{F2 05 FF FF}{F1 41}在“手工工坊”里，\n{F2 01 03 01}出售获得的素材道具，\n就会增加新的商品{F2 01 01 01}。\n　\n试着出售持有的素材吧。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:9:0",
  "message_id": "WSHOP_HELLO_NEWYEAR",
  "translation": "{F2 05 FF FF}{F1 41}欢迎光临。新年快乐。\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:9:1",
  "message_id": "WSHOP_HELLO_NEWYEAR",
  "translation": "{F2 05 FF FF}{F1 41}新年才刚开始，创作欲就涌上来了。\n不知道能不能弄到些稀奇的素材啊…\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:10:0",
  "message_id": "WSHOP_HELLO_RAIN",
  "translation": "{F2 05 FF FF}{F1 41}欢迎光临。今天下雨啊…\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:10:1",
  "message_id": "WSHOP_HELLO_RAIN",
  "translation": "{F2 05 FF FF}{F1 41}这种日子，总让人创作欲高涨。\n不知道能不能弄到些稀奇的素材啊…\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:11:0",
  "message_id": "WSHOP_HELLO_THUNDER",
  "translation": "{F2 05 FF FF}{F1 41}欢迎光临。今天雨真大啊…\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:11:1",
  "message_id": "WSHOP_HELLO_THUNDER",
  "translation": "{F2 05 FF FF}{F1 41}就算这种天气，创作欲也压不住啊。\n不知道能不能弄到些稀奇的素材啊…\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:12:0",
  "message_id": "WSHOP_HELLO_SNOW",
  "translation": "{F2 05 FF FF}{F1 41}欢迎光临。\n今天可真够冷的。\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:12:1",
  "message_id": "WSHOP_HELLO_SNOW",
  "translation": "{F2 05 FF FF}{F1 41}这种日子，总让人创作欲高涨。\n不知道能不能弄到些稀奇的素材啊…\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:13:0",
  "message_id": "WSHOP_HELLO_SELL_RAIN",
  "translation": "{F2 05 FF FF}{F1 41}哎呀，一时创作欲大发，\n不知不觉就到这个时候了…\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:13:1",
  "message_id": "WSHOP_HELLO_SELL_RAIN",
  "translation": "{F2 05 FF FF}{F1 41}嘿，你小子来得正是时候。\n今晚给你算便宜点。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:14:0",
  "message_id": "WSHOP_HELLO_SELL_THUNDER",
  "translation": "{F2 05 FF FF}{F1 41}可恶，这雨真够大的。\n等着雨停，结果都没能回去…\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:14:1",
  "message_id": "WSHOP_HELLO_SELL_THUNDER",
  "translation": "{F2 05 FF FF}{F1 41}这种天气你还特地跑来啊。\n算我优待你，给你便宜点。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:15:0",
  "message_id": "MSG_WSHOP_QUSET_00_000",
  "translation": "{F2 05 FF FF}{F1 41}对了，你知道{F4 45 04 01 00 00 02 01}吗？\n鲛川能钓到，那可是下酒的好东西。\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:15:1",
  "message_id": "MSG_WSHOP_QUSET_00_000",
  "translation": "{F2 05 FF FF}{F1 41}你要是会钓鱼，\n能不能替老夫钓来啊？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:16:0",
  "message_id": "MSG_WSHOP_QUSET_00_010",
  "translation": "{F2 05 FF FF}{F1 41}虽说有点独特，倒也算不错的“艺术”…\n连老夫的创作欲都被点燃了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:16:1",
  "message_id": "MSG_WSHOP_QUSET_00_010",
  "translation": "{F2 05 FF FF}{F1 41}那就拜托你了。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:17:0",
  "message_id": "MSG_WSHOP_QUSET_02_001",
  "translation": "{F2 05 FF FF}{F1 41}什么嘛，你不是已经有了吗。\n怎么样？能不能给老夫？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:18:0",
  "message_id": "SEL_WSHOP_QUSET_02_010",
  "translation": "{F2 05 FF FF}{F1 41}是{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:18:1",
  "message_id": "SEL_WSHOP_QUSET_02_010",
  "translation": "{F2 05 FF FF}{F1 41}否{00}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:19:0",
  "message_id": "MSG_WSHOP_QUSET_02_021",
  "translation": "{F2 05 FF FF}{F1 41}那可真遗憾。\n也不能勉强你啊。\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:19:1",
  "message_id": "MSG_WSHOP_QUSET_02_021",
  "translation": "{F2 05 FF FF}{F1 41}等你有这个心情了也行。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:20:0",
  "message_id": "MSG_WSHOP_QUSET_02_000",
  "translation": "{F2 05 FF FF}{F1 41}对了，你拿着的那个，\n不就是之前拜托你的{F4 45 04 01 00 00 02 01}吗？\n{F1 21}"
 },
 {
  "key": "export_base/facility/weapon.bf.json:20:1",
  "message_id": "MSG_WSHOP_QUSET_02_000",
  "translation": "{F2 05 FF FF}{F1 41}怎么样？能不能给老夫？\n{F1 21}{00}"
