 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:1:0",
  "message_id": "cure_check",
  "translation": "{F2 05 FF FF}{F1 41}＞需要{F2 44 01 01}日元，\n可以吗？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:2:0",
  "message_id": "cure_check_E",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 08 01 01 01 01 01 0A 01}治疗需要\n{F2 44 01 01}日元。\n可以吗？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:3:0",
  "message_id": "cure_check_M",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 08 01 01 01 01 01 13 01}治疗需要\n{F2 44 01 01}日元。\n可以吗？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:4:0",
  "message_id": "cure_not_E",
  "translation": "{F2 05 FF FF}{F1 41}各位都精神饱满。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:5:0",
  "message_id": "cure_not_M",
  "translation": "{F2 05 FF FF}{F1 41}似乎不需要治疗呢。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:6:0",
  "message_id": "cure_ng_E",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 08 01 01 01 01 01 0C 01}恕我冒昧，\n您的钱似乎不够。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:7:0",
  "message_id": "cure_ng_M",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 08 01 01 01 01 01 15 01}想接受治疗，\n你的钱似乎还不够哦…\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:8:0",
  "message_id": "not_accept_E",
  "translation": "{F2 05 FF FF}{F1 41}目前没有\n可供接受的委托。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:9:0",
  "message_id": "full_accept_E",
  "translation": "{F2 05 FF FF}{F1 41}您已经接受了\n５个委托，\n暂时无法提供新的委托。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:10:0",
  "message_id": "not_report_E",
  "translation": "{F2 05 FF FF}{F1 41}没有可以报告的委托。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:11:0",
  "message_id": "not_cancel_E",
  "translation": "{F2 05 FF FF}{F1 41}没有可以放弃的委托。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:12:0",
  "message_id": "accept_check_E",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 08 01 01 01 01 01 06 01}您愿意接受这项委托吗？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:13:0",
  "message_id": "cancel_check_E",
  "translation": "{F2 05 FF FF}{F1 41}要放弃这项委托吗？\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:14:0",
  "message_id": "NHELP001_CURE_E",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}接受“治疗”后，各位身心的疲劳\n想必会立刻消除。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:14:1",
  "message_id": "NHELP001_CURE_E",
  "translation": "{F2 05 FF FF}{F1 41}无论无法战斗还是已经石化…\n甚至不在队伍里的各位，\n都会得到彻底的治疗。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:14:2",
  "message_id": "NHELP001_CURE_E",
  "translation": "{F2 05 FF FF}{F1 41}不过，帮助需要收取报酬。\n还请谅解。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:15:0",
  "message_id": "NHELP001_CURE_M",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 23 01 0D 01 01 01 02 01}接受“治疗”后，各位身心的疲劳\n都会立刻消除。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:15:1",
  "message_id": "NHELP001_CURE_M",
  "translation": "{F2 05 FF FF}{F1 41}无论无法战斗还是已经石化…\n包括不在队伍里的人，\n我都会为大家治疗。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:15:2",
  "message_id": "NHELP001_CURE_M",
  "translation": "{F2 05 FF FF}{F1 41}不过，帮助需要收取报酬。\n还请谅解哦。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:16:0",
  "message_id": "NHELP001_CURE_E_BLUE",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 0D 01 01 01 02 01}接受“治疗”后，各位身心的疲劳\n想必会立刻消除。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:16:1",
  "message_id": "NHELP001_CURE_E_BLUE",
  "translation": "{F2 05 FF FF}{F1 41}无论无法战斗还是已经石化…\n甚至不在队伍里的各位，\n都会得到彻底的治疗。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:16:2",
  "message_id": "NHELP001_CURE_E_BLUE",
  "translation": "{F2 05 FF FF}{F1 41}不过，帮助需要收取报酬。\n还请谅解。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:17:0",
  "message_id": "NHELP002_QUEST_E",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}所谓委托，就是完成我或各位的\n请求后便能获得报酬，\n非常划算的一种安排。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:17:1",
  "message_id": "NHELP002_QUEST_E",
  "translation": "{F2 05 FF FF}{F1 41}不过，并不是非得\n完成委托不可。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:17:2",
  "message_id": "NHELP002_QUEST_E",
  "translation": "{F2 05 FF FF}{F1 41}探索疲惫或遇到瓶颈时…\n建议用它来转换心情。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:17:3",
  "message_id": "NHELP002_QUEST_E",
  "translation": "{F2 05 FF FF}{F1 41}因此，同时接受的委托\n最多为５个。\n太过埋头苦干可就本末倒置了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:17:4",
  "message_id": "NHELP002_QUEST_E",
  "translation": "{F2 05 FF FF}{F1 41}不过…我也准备了\n值得各位付出的好东西作为报酬。\n若能稍加留意，我会很高兴。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:18:0",
  "message_id": "NHELP003_QUEST_REWARD_E",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}完成委托后，\n一定会为您送上“报酬”。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:18:1",
  "message_id": "NHELP003_QUEST_REWARD_E",
  "translation": "{F2 05 FF FF}{F1 41}另外，凭借完成委托的“经验”，\n各位想必也会\n突飞猛进地成长。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:18:2",
  "message_id": "NHELP003_QUEST_REWARD_E",
  "translation": "{F2 05 FF FF}{F1 41}这种成长与队伍编成无关，\n应该会惠及所有人。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:18:3",
  "message_id": "NHELP003_QUEST_REWARD_E",
  "translation": "{F2 05 FF FF}{F1 41}委托就是这样好处多多…\n还请务必接受。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:19:0",
  "message_id": "NHELP004_QUEST_TIMELIMIT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}有些委托\n设有期限。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:19:1",
  "message_id": "NHELP004_QUEST_TIMELIMIT",
  "translation": "{F2 05 FF FF}{F1 41}一旦超过期限，\n就再也无法进行\n与该委托有关的事情了。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:19:2",
  "message_id": "NHELP004_QUEST_TIMELIMIT",
  "translation": "{F2 05 FF FF}{F1 41}还请多加注意。\n{F1 21}{00}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:20:0",
  "message_id": "NHELP005_QUEST_CANCEL_E",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 22 01 03 01 05 01 02 01}即使已经接受的委托，\n之后也可以取消。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:20:1",
  "message_id": "NHELP005_QUEST_CANCEL_E",
  "translation": "{F2 05 FF FF}{F1 41}而且，只要尚未超过期限，\n便可多次重新接受。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:20:2",
  "message_id": "NHELP005_QUEST_CANCEL_E",
  "translation": "{F2 05 FF FF}{F1 41}至于您关心的钱包问题…\n放弃委托不收取费用。\n{F1 21}"
 },
 {
  "key": "export_base/facility/msg_noffice.bmd.json:20:3",
  "message_id": "NHELP005_QUEST_CANCEL_E",
  "translation": "{F2 05 FF FF}{F1 41}如果接受了太多，或是不知\n该做些什么的时候，\n不妨果断放弃吧。\n{F1 21}{00}"
 }
]