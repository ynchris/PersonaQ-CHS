[
 {
  "key": "export_base/battle/event/boss725.bf.json:0:0",
  "message_id": "MSG_BTL_BOSS_001_ENCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这次的人格面具，\n正是您期待已久的“宙斯”。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:1:0",
  "message_id": "MSG_BTL_BOSS_001_ENCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}怀着对您一路协助研究的\n敬意与感谢……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:2:0",
  "message_id": "MSG_BTL_BOSS_001_ENCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}还请千万\n不要中途倒下……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:4:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这是何等充实的时光。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:5:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不过，宴会才刚刚开始……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:6:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}还请让我\n更加尽兴。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:7:0",
  "message_id": "MSG_BTL_BOSS_001_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}宴会或许已经过半了吧。\n真让人恋恋不舍。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:8:0",
  "message_id": "MSG_BTL_BOSS_001_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}不过，接下来才是高潮。\n请您一刻也不要移开视线。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:9:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}啊……终于到了\n盛大终幕的时刻。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:10:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}这场演出没有返场，\n在帷幕落下的那一刻之前，\n请尽情使出全力……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss725.bf.json:11:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 01 01}那么……我要来了！\n{F2 23 00 00}{F1 21}{00}"
 }
]