[
 {
  "key": "export_base/battle/event/boss722.bf.json:0:0",
  "message_id": "MSG_BTL_BOSS_001_ENCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 25 10}这次与您交手的，\n是我和这位人格面具。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:1:0",
  "message_id": "MSG_BTL_BOSS_001_ENCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 26 10}请让我充分感受\n您目前的“力量”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:4:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 27 10}哦，比起上次，\n您更有嚼劲了呢。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:5:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 28 10}不过，还远远不够。\n要打个比方的话……对，就像章鱼烧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:6:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 29 10}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:7:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 2A 10}我开始想吃章鱼烧了。\n稍微加快一点节奏吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:8:0",
  "message_id": "MSG_BTL_BOSS_001_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 2B 10}看来您真的\n变强了呢……\n实在令人欣喜。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:9:0",
  "message_id": "MSG_BTL_BOSS_001_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 2C 10}请向我证明，\n这份强大并非昙花一现。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:10:0",
  "message_id": "MSG_BTL_BOSS_001_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 2D 10}我会进一步加快节奏。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:11:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 2E 10}……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:12:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 2F 10}这种感觉究竟是什么……？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:13:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 30 10}似乎能在与您的战斗尽头找到答案……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:14:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 31 10}……不，还是先\n专注于眼前这一战吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss722.bf.json:15:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 32 10}还请不要就此咽气……\n{F2 23 00 00}{F1 21}{00}"
 }
