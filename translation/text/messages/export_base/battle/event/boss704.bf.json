[
 {
  "key": "export_base/battle/event/boss704.bf.json:4:0",
  "message_id": "MSG_BTL_BOSS_002_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 03 10}违抗神明·无礼羔羊！\n这种家伙·给我立誓·呼！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:5:0",
  "message_id": "MSG_BTL_BOSS_002_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 0B 10}嘿，兄弟！\n素面条！\n来碗素面条！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:6:0",
  "message_id": "MSG_BTL_BOSS_002_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 0C 10}不信神明的圣言！\n这种家伙·罪孽深重！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:7:0",
  "message_id": "MSG_BTL_BOSS_002_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 0D 10}迷途羔羊·五花大绑！\n立下誓约·改过自新·哟！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:8:0",
  "message_id": "MSG_BTL_BOSS_002_HP_50_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 0D 01 65 01 02 01}{F5 61 02 01 01 01 01 01 58 10}喂！关于那个牧师的“誓约”，\n我发现了一件事！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:9:0",
  "message_id": "MSG_BTL_BOSS_002_HP_50_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 59 10}誓约所禁止的行动，\n似乎和那些飘在空中的棺材\n有关系。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:10:0",
  "message_id": "MSG_BTL_BOSS_002_HP_50_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 07 01 65 01 02 01}{F5 61 02 01 01 01 01 01 5A 10}禁止普通攻击时，棺材会发红光。\n禁止使用技能时，\n则会发黄光，对吧？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:11:0",
  "message_id": "MSG_BTL_BOSS_002_HP_50_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 65 01 01 01}{F5 61 02 01 01 01 01 01 5B 10}禁止使用道具时是绿色……\n禁止队长技能时，\n则会发蓝光。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:12:0",
  "message_id": "MSG_BTL_BOSS_002_HP_50_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 03 01 65 01 02 01}{F5 61 02 01 01 01 01 01 5C 10}所以，只要看棺材发出什么颜色的光，\n就能知道现在\n禁止的是什么行动了！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:13:0",
  "message_id": "MSG_BTL_BOSS_002_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 0E 10}听见了吗·神明的声音！\n信者得救·皆大欢喜！\n没能得救·全都怪你！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:14:0",
  "message_id": "MSG_BTL_BOSS_002_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 0F 10}现在去见神还太早！\n请怜悯这份命运！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:15:0",
  "message_id": "MSG_BTL_BOSS_002_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 56 10}神明救赎·是的·无私大爱！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss704.bf.json:16:0",
  "message_id": "MSG_BTL_BOSS_002_BTLEND_",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 10 10}前往……神的身边……我这就去……\n{F2 23 00 00}{F1 21}{00}"
 }
]