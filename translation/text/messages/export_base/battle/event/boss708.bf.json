[
 {
  "key": "export_base/battle/event/boss708.bf.json:4:0",
  "message_id": "MSG_BTL_BOSS_006_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F2 0F}时刻已至。\n履行本来职责的时刻。\n回归本来姿态的时刻。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:5:0",
  "message_id": "MSG_BTL_BOSS_006_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F3 0F}你遗忘了职责。\n恢复记忆后，仍执意反抗。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:6:0",
  "message_id": "MSG_BTL_BOSS_006_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F4 0F}你已沦为人类。\n沦为无用之物。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:7:0",
  "message_id": "MSG_BTL_BOSS_006_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F5 0F}吾将抹消吾自身。\n抹消身为吾之一部分的你。\n将这世界的一切化为灰烬。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:8:0",
  "message_id": "MSG_BTL_BOSS_006_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F6 0F}时刻已至。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:9:0",
  "message_id": "MSG_BTL_BOSS_006_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F7 0F}演员们，你们已经尽职了。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:10:0",
  "message_id": "MSG_BTL_BOSS_006_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 57 10}然而，为何还不归去。\n舞台的帷幕早已落下……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:11:0",
  "message_id": "MSG_BTL_BOSS_006_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F8 0F}区区注定一死的人类，\n为何要与吾为敌。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:12:0",
  "message_id": "MSG_BTL_BOSS_006_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 F9 0F}人类啊，需要庇护的弱小物种啊。\n若这便是你们所愿，\n就与吾之一部分一同消失吧……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:13:0",
  "message_id": "MSG_BTL_BOSS_006_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 FA 0F}吾乃柯罗诺斯……\n诞生于人类，\n与人类同行于旅途之中……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:14:0",
  "message_id": "MSG_BTL_BOSS_006_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 FB 0F}漂浮于短暂梦境中的无常众生啊。\n正因生命短暂，\n你们才兼具不折的坚强……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:15:0",
  "message_id": "MSG_BTL_BOSS_006_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 FC 0F}自身的生，究竟为何……\n自身的死，究竟为何……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:17:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_FUK",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 03 01 66 01 02 01}{F5 61 02 01 01 01 01 01 5D 10}我们已经改变了。\n善、玲，还有八十神高中的大家，\n都成了我们重要的同伴！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:18:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_RIS",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 07 01 66 01 04 01}{F5 61 02 01 01 01 01 01 5E 10}没错！\n所以我们才要一起战斗！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:18:1",
  "message_id": "MSG_BTL_BOSS_LAST_PC_RIS",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 5F 10}玲和善，\n也是我们的一部分！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:19:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_P3H",
  "translation": "{F2 05 FF FF}{F1 41}{F1 25}{F5 C1 12 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 C9 02}这里的相遇改变了我们……\n也改变了他们……\n这就是活着的意义。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:20:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_YUK",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 83 08}在这个不可思议的世界里的相遇，\n打破了我的迷茫与软弱……\n温柔地……指引了我……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:21:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_JUN",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 52 09}要回去的话，\n当然得所有人一起开开心心地回去啊。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:21:1",
  "message_id": "MSG_BTL_BOSS_LAST_PC_JUN",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 60 10}不是那样的结局，我可不接受。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:22:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_SAN",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 22 0A}经历虽奇妙，却很充实……\n遇见了新的同志、新的学弟学妹……\n这些都成了我的力量。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:23:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_MIT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 FA 0A}与他们的相遇，\n又让我明白了许多事……\n那是无可替代的宝物。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:24:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_AMA",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 AB 0C}我觉得自己在这里\n获得了新的勇气。\n为了现在……也为了明天……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:25:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_AEG",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 D6 0B}人会为了他人发挥力量。\n若是重要的人，更是如此……\n我也要这样去做！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:26:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_KOR",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 D4 0C}汪汪！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:27:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_ARA",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 A4 0D}就是这么回事……\n我……绝不会放过\n对我同伴出手的家伙。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:27:1",
  "message_id": "MSG_BTL_BOSS_LAST_PC_ARA",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 61 10}这就是……与你战斗的理由。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:28:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_P4H",
  "translation": "{F2 05 FF FF}{F1 41}{F1 25}{F5 C1 0F 01 01 01 01 01 01 01}　\n{F5 61 02 01 01 01 01 01 E1 01}我知道，羁绊能带来力量。\n在这个不可思议的世界里，\n我们结下了新的羁绊。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:29:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_YOU",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 9D 03}战斗的理由或许各不相同，\n但也有绝对不能退让的东西。\n我们就是为了它才站在这里！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:30:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_CHI",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 6D 04}来到这里之后，我明白了。\n我想为了朋友而战。\n为了笑容，为了信念而战！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:31:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_YUK",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 3C 05}不管这里是哪，不管你是什么，\n只要你想毁掉我们珍视的东西，\n我们就绝不会手下留情！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:32:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_KAN",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 13 06}不需要什么道理！\n为了那帮家伙拼上性命，\n才算男子汉吧！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:33:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_KUM",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 B4 07}小玲、善，\n还有月光馆的大家，\n都成了小熊重要的朋友熊！\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:33:1",
  "message_id": "MSG_BTL_BOSS_LAST_PC_KUM",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 62 10}小熊只是为了朋友而战熊！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:34:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_NAO",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 DF 06}我们也在这个世界里改变了。\n这就是我们站在这里，\n与你战斗的理由！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:35:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_ZEN",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 9C 0E}柯罗诺斯……你明白吗？\n你……\n不，过去的我所没有的东西。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:35:1",
  "message_id": "MSG_BTL_BOSS_LAST_PC_ZEN",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 63 10}短暂生命的坚强。\n还有它的美丽……\n你能明白吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:36:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_ZEN",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 9D 0E}是他们教会了我。\n而现在，我来到这里，\n就是为了打倒你，抹消我自身。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:37:0",
  "message_id": "MSG_BTL_BOSS_LAST_PC_ZEN",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 9E 0E}我要救玲……\n这是我现在的职责，也是我的意志。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:38:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_FU",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 0D 01 65 01 02 01}{F5 C1 03 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 A7 10}刚才那一招究竟是……\n而、而且，队长身上\n出现了某种倒计时！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:39:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_FU",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 0D 01 65 01 02 01}{F5 C1 03 01 01 01 01 01 07 01}{F5 61 02 01 01 01 01 01 A8 10}刚才那一招究竟是……\n而、而且，队长身上\n出现了某种倒计时！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:40:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_RI",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 0B 01 65 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A3 10}刚才那是什么招式？\n而、而且，队长身上\n出现了奇怪的倒计时！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:41:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_RI",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 07 01 0B 01 65 01 02 01}{F5 C1 03 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 A4 10}刚才那是什么招式？\n而、而且，学长身上\n出现了奇怪的倒计时！\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:42:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_ZE",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 93 0E}是“刻命齿轮”。倒计时\n会随时间减少，降到０时，\n那个人就会陷入无法战斗状态。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:43:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_FU",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0B 01 65 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 A9 10}怎么会……\n没有解除方法吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:44:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_RI",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 05 01 65 01 02 01}{F5 C1 03 01 01 01 01 01 02 01}{F5 61 02 01 01 01 01 01 A5 10}怎么会……\n就不能想想办法吗！？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:45:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_ZE",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 94 0E}使用具有复活效果的技能或道具，\n可以延长一些倒计时。\n{F2 23 00 00}{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:45:1",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_ZE",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 02 01 01 01 01 01 95 0E}但除非陷入无法战斗状态，\n否则无法消除倒计时。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:46:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_FU",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0F 01 0D 01 65 01 02 01}{F5 61 02 01 01 01 01 01 AA 10}也就是说，除了体力，\n还得留意那个倒计时啊……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:47:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_RI",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 07 01 0D 01 65 01 02 01}{F5 61 02 01 01 01 01 01 A6 10}也就是说，除了体力，\n我们还必须注意倒计时。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss708.bf.json:48:0",
  "message_id": "MSG_BTL_BOSS_LIMIT_PC_ZE",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 01 01}{F5 61 02 01 01 01 01 01 96 0E}它掌管着死亡与时间……\n请小心。\n{F2 23 00 00}{F1 21}{00}"
 }
]