[
 {
  "key": "export_base/battle/event/boss721.bf.json:0:0",
  "message_id": "MSG_BTL_BOSS_001_ENCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 1A 10}这次与您交手的，\n是我和这位人格面具。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:1:0",
  "message_id": "MSG_BTL_BOSS_001_ENCOUNT",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 1B 10}请让我充分感受\n您目前的“力量”……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:4:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 1C 10}您的力量，\n就只有这种程度吗？\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:5:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 1D 10}不才伊丽莎白，\n对打打杀杀也略知一二。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:6:0",
  "message_id": "MSG_BTL_BOSS_001_HP_75_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 1E 10}请不必客气，\n尽管抱着杀死我的决心来吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:7:0",
  "message_id": "MSG_BTL_BOSS_001_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 1F 10}哦……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:8:0",
  "message_id": "MSG_BTL_BOSS_001_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 20 10}虽然只有一瞬，\n但刚才那一击让我看到了闪光。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:9:0",
  "message_id": "MSG_BTL_BOSS_001_HP_50_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 21 10}不过，时间还很充裕。\n还请不要就此耗尽力气……\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:10:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 22 10}呵呵……就是这股气势。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:11:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 23 10}那么，接下来，\n我们稍微提升一点强度吧。\n{F2 23 00 00}{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss721.bf.json:12:0",
  "message_id": "MSG_BTL_BOSS_001_HP_25_0",
  "translation": "{F2 05 FF FF}{F1 41}{F5 C1 04 01 01 01 01 01 03 01}{F5 61 02 01 01 01 01 01 24 10}请尽情享受，直到最后。\n{F2 23 00 00}{F1 21}{00}"
 }
]