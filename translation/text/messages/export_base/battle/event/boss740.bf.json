[
 {
  "key": "export_base/battle/event/boss740.bf.json:4:0",
  "message_id": "MSG_BTL_TUTORIAL_001",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 13 01 01 01 01 01 02 01}这么快就有阴影登场了啊……\n{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:5:0",
  "message_id": "MSG_BTL_TUTORIAL_002",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 15 01 01 01 01 01 02 01}我们没问题。\n战斗的方法早已熟悉。\n{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:5:1",
  "message_id": "MSG_BTL_TUTORIAL_002",
  "translation": "{F2 05 FF FF}{F1 41}只要攻击对手的弱点，\n就能把损失降到最低。\n{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:6:0",
  "message_id": "MSG_BTL_TUTORIAL_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 01 01 01 01 04 01}……原来如此。\n看来基本要领已经掌握了。\n{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:6:1",
  "message_id": "MSG_BTL_TUTORIAL_003",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0E 01 0D 01 01 01 04 01}不过，\n那家伙的弱点还不清楚……\n{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:7:0",
  "message_id": "MSG_BTL_TUTORIAL_004",
  "translation": "{F2 05 FF FF}{F1 41}{F5 86 0D 01 03 01 01 01 02 01}哼，那又怎么样？\n来到这里之后，我早就跃跃欲试了。\n{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:7:1",
  "message_id": "MSG_BTL_TUTORIAL_004",
  "translation": "{F2 05 FF FF}{F1 41}不知道就战斗看看。\n打着打着，自然就能找到弱点。\n总之，我会全力以赴。\n{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:8:0",
  "message_id": "MSG_BTL_TUTORIAL_005",
  "translation": "{F2 05 FF FF}{F1 41}与阴影战斗时，\n用敌人弱点对应的属性攻击\n十分重要。\n{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:8:1",
  "message_id": "MSG_BTL_TUTORIAL_005",
  "translation": "{F2 05 FF FF}{F1 41}击中敌人的属性弱点，\n即可让发动攻击的角色\n进入{F2 01 03 01}“ＢＯＯＳＴ状态”{F2 01 01 01}。\n{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:8:2",
  "message_id": "MSG_BTL_TUTORIAL_005",
  "translation": "{F2 05 FF FF}{F1 41}{F2 01 03 01}进入“ＢＯＯＳＴ状态”{F2 01 01 01}后，\n下次行动回合可以获得２项优势：\n　・以最快速度行动\n　・使用技能时消耗为零\n{F1 21}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:8:3",
  "message_id": "MSG_BTL_TUTORIAL_005",
  "translation": "{F2 05 FF FF}{F1 41}不同种类的敌人，弱点也不同。\n请尝试各种攻击。\n{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:9:0",
  "message_id": "MSG_BTL_TUTORIAL_011",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 07 01 01 01 01 01 F5 02}{F5 86 0F 01 0D 01 65 01 02 01}阴影的数据由我来管理。\n需要时请告诉我。\n{F1 21}{00}"
 },
 {
  "key": "export_base/battle/event/boss740.bf.json:10:0",
  "message_id": "MSG_BTL_TUTORIAL_012",
  "translation": "{F2 05 FF FF}{F1 41}按Ｌ键选择“ＡＮＡＬＹＺＥ”，\n即可查看敌方阴影的信息。\n{F1 21}{00}"
 }
]