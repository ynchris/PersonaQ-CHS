  "message_id": "SANADA_FOE_FOLLOW_START3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 2B 03}被Ｆ．Ｏ．Ｅ盯上了，\n小心！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/sanada_support.bf.json:3:0",
  "message_id": "SANADA_FOE_SENSOR1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 2C 03}哼……Ｆ．Ｏ．Ｅ登场了！\n{F2 26 00 00}{00}"
 },
 {
