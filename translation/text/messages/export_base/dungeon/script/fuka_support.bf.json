[
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:0:0",
  "message_id": "FUKA_FOE_FOLLOW_START1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 85 03}不好了！\nＦ．Ｏ．Ｅ正在靠近！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:1:0",
  "message_id": "FUKA_FOE_FOLLOW_START2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 86 03}我们正被Ｆ．Ｏ．Ｅ追踪，\n请小心！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:2:0",
  "message_id": "FUKA_FOE_FOLLOW_START3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 87 03}危险！\nＦ．Ｏ．Ｅ追过来了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:3:0",
  "message_id": "FUKA_FOE_SENSOR1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 88 03}确认附近有Ｆ．Ｏ．Ｅ的\n气息。请小心！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:4:0",
  "message_id": "FUKA_FOE_SENSOR2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 89 03}Ｆ．Ｏ．Ｅ就在附近，\n请小心。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:5:0",
  "message_id": "FUKA_FOE_SENSOR3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 8A 03}感觉到Ｆ．Ｏ．Ｅ的气息！\n请保持警惕！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:6:0",
  "message_id": "FUKA_FOE_FOLLOW_END1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 8B 03}Ｆ．Ｏ．Ｅ似乎停止追踪了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:7:0",
  "message_id": "FUKA_FOE_FOLLOW_END2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 8C 03}太好了，\nＦ．Ｏ．Ｅ好像放弃了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:8:0",
  "message_id": "FUKA_FOE_FOLLOW_END3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 8D 03}好险…\n看来总算逃掉了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:9:0",
  "message_id": "FUKA_PARTY_HARF_DEAD1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 8E 03}这样前进很危险。\n要不要先回去？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:10:0",
  "message_id": "FUKA_PARTY_HARF_DEAD2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 8F 03}大家还好吗！？\n别勉强，先重整状态吧。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:11:0",
  "message_id": "FUKA_PARTY_HARF_DEAD3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 90 03}这样下去很危险！\n请先好好调整状态！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:12:0",
  "message_id": "FUKA_PARTY_HPTP10_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 91 03}队长，你还好吗！？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:13:0",
  "message_id": "FUKA_PARTY_HPTP10_2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 92 03}队长！\n请不要再勉强了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:14:0",
  "message_id": "FUKA_PARTY_HPTP10_3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 93 03}请小心！\n队长的状态很危险！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:15:0",
  "message_id": "FUKA_PARTY_HP10_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 94 03}队长！\n体力告急，请小心！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:16:0",
  "message_id": "FUKA_PARTY_HP10_2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 95 03}体力下降了！\n队长，请小心！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:17:0",
  "message_id": "FUKA_PARTY_HP10_3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 96 03}队长！\n体力还撑得住吗！？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:18:0",
  "message_id": "FUKA_PARTY_TP10_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 97 03}队长，你还好吗？\n看起来很累了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:19:0",
  "message_id": "FUKA_PARTY_TP10_2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 98 03}队长，是不是精力不足？\n要不先回来吧？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:20:0",
  "message_id": "FUKA_PARTY_TP10_3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 99 03}队长，\n你很累了…我很担心。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:21:0",
  "message_id": "FUKA_STAIR1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 9A 03}发现楼梯了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:22:0",
  "message_id": "FUKA_STAIR2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 9B 03}前方有楼梯！\n请小心前进。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:23:0",
  "message_id": "FUKA_STAIR3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 9C 03}啊！是楼梯！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:24:0",
  "message_id": "FUKA_TREASURE1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 9D 03}啊，有宝箱！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:25:0",
  "message_id": "FUKA_TREASURE2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 9E 03}附近有宝箱，\n要打开看看吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:26:0",
  "message_id": "FUKA_TREASURE3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 9F 03}啊，是宝箱！\n真让人心动呢。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:27:0",
  "message_id": "FUKA_FOUNTAIN1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A0 03}前方发现之前那种能量点。\n看得见吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:28:0",
  "message_id": "FUKA_FOUNTAIN2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 FB 03}发现能量点。\n说不定又会发生什么…\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:29:0",
  "message_id": "FUKA_FOUNTAIN3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A2 03}又有那个能量点了。\n要不要顺路去看看？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:30:0",
  "message_id": "FUKA_SEARCH_OBJ1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A3 03}前方有东西…\n请调查一下。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:31:0",
  "message_id": "FUKA_SEARCH_OBJ2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A4 03}那一带好像有什么。\n请看看。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:32:0",
  "message_id": "FUKA_SEARCH_OBJ3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A5 03}前方能看见什么东西…\n请小心。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:33:0",
  "message_id": "FUKA_SWITCH1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A6 03}附近似乎有开关…\n请找找看。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:34:0",
  "message_id": "FUKA_SWITCH2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A7 03}那个…\n前方是不是有开关？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:35:0",
  "message_id": "FUKA_SWITCH3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A8 03}附近应该有开关。\n请调查一下。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:36:0",
  "message_id": "FUKA_KARITORUMONO1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 A9 03}探测到Ｆ．Ｏ．Ｅ反应！\n这气息…是“收割者”！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:37:0",
  "message_id": "FUKA_KARITORUMONO2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 AA 03}探测到“收割者”的反应！\n请小心！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:38:0",
  "message_id": "FUKA_KARITORUMONO3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 AB 03}“收割者”正在靠近！\n请小心！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:39:0",
  "message_id": "FUKA_ARROW_DIZZINESS1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 AC 03}不、不好了！\n好像没法直走了！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:40:0",
  "message_id": "FUKA_ARROW_DIZZINESS2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 AD 03}队、队长！？\n你在往哪里走？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:41:0",
  "message_id": "FUKA_ARROW_DIZZINESS3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 AE 03}方向感似乎暂时失常了。\n请振作起来！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:42:0",
  "message_id": "FUKA_ARROW_FASCINATION1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 AF 03}咦？\n是不是被Ｆ．Ｏ．Ｅ吸过去了？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:43:0",
  "message_id": "FUKA_ARROW_FASCINATION2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B0 03}队长！\n请保持清醒！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:44:0",
  "message_id": "FUKA_ARROW_FASCINATION3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B1 03}靠近Ｆ．Ｏ．Ｅ很危险！\n队长，听得见吗！？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:45:0",
  "message_id": "FUKA_SHORTCUT1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B2 03}那面墙似乎可以通过。\n请看看。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:46:0",
  "message_id": "FUKA_SHORTCUT2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B3 03}前面的墙有点奇怪…\n能调查一下吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:47:0",
  "message_id": "FUKA_SHORTCUT3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B4 03}那面墙好像藏着什么…\n调查一下吧！\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:48:0",
  "message_id": "FUKA_TRAVEL1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B5 03}呵呵…这一层的情况，\n已经了解得差不多了。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:49:0",
  "message_id": "FUKA_TRAVEL2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B6 03}走了这么多路，这一层的\n信息差不多都掌握了呢。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:50:0",
  "message_id": "FUKA_TRAVEL3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B7 03}这一层的情况，\n问大家就全都知道了呢。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:51:0",
  "message_id": "FUKA_ITEM_NOYHAVE1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B8 03}好像没带“回归道具”…\n回去时没问题吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:52:0",
  "message_id": "FUKA_ITEM_NOYHAVE2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 B9 03}也做好返程准备了吗？\n请仔细检查携带的物品。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:53:0",
  "message_id": "FUKA_ITEM_NOYHAVE3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 BA 03}那个…没忘东西吧？\n带了“回归道具”吗？\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:54:0",
  "message_id": "FUKA_ITEM_MAX1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 BB 03}物品快要装不下了。\n请注意哦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:55:0",
  "message_id": "FUKA_ITEM_MAX2",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 BC 03}那个…带这么多东西\n没问题吗？整理也很重要哦。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:56:0",
  "message_id": "FUKA_ITEM_MAX3",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 BD 03}请好好整理行李。\n能带的数量是有限的。\n{F2 26 00 00}{00}"
 },
 {
  "key": "export_base/dungeon/script/fuka_support.bf.json:57:0",
  "message_id": "FUKA_PARTY_HPTP15_1",
  "translation": "{F2 05 FF FF}{F1 41}{F5 61 04 01 01 01 07 01 91 03}队长，你还好吗！？\n{F2 26 00 00}{00}"
 },
 {
